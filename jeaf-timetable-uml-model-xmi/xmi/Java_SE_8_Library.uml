                <ownedComment xmi:id="931e7c4d-575d-4b3b-a7dd-926bf943e047" body="A {@link Value} that weakly references the referent.&#xA;" annotatedElement="d564db68-9716-496f-ab0b-d88441e0237c"/>
                <ownedTemplateSignature xmi:type="uml:RedefinableTemplateSignature" xmi:id="c57e7721-0ed7-4faa-b9f2-616d440128f9" name="" visibility="public" parameter="e7f2e2f8-4028-4720-8b08-b27b686892a3">
