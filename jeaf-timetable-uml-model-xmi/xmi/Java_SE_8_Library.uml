                  <packagedElement xmi:type="uml:Package" xmi:id="aa7beafb-30cc-4941-a945-27e106d1d20d" name="parsers">
                    <packagedElement xmi:type="uml:Class" xmi:id="0df766ec-848c-45b9-a841-ca8e016c9463" name="AbstractDOMParser">
                      <ownedComment xmi:id="fe563fb7-b93a-4ee5-b702-2ee102de471f" body="This is the base class of all DOM parsers. It implements the XNI&#xA;callback methods to create the DOM tree. After a successful parse of&#xA;an XML document, the DOM Document object can be queried using the&#xA;&lt;code>getDocument&lt;/code> method. The actual pipeline is defined in&#xA;parser configuration.&#xA;&#xA;@author Arnaud Le Hors, IBM&#xA;@author Andy Clark, IBM&#xA;@author Elena Litani, IBM&#xA;&#xA;@version $Id: AbstractDOMParser.java,v 1.10 2010-11-01 04:40:09 joehw Exp $&#xA;" annotatedElement="0df766ec-848c-45b9-a841-ca8e016c9463"/>
                      <generalization xmi:id="ab88a943-060b-4eaf-99f2-3bc722c72926" isSubstitutable="true" general="6785266c-6849-447c-92c8-dc9eabba6011"/>
