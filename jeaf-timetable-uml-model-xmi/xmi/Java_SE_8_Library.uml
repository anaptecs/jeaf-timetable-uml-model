                  </packagedElement>
                  <packagedElement xmi:type="uml:Class" xmi:id="03826935-346e-455a-8072-cdc8a85b58a4" name="ServerProvider" clientDependency="c477a77c-60c3-432b-9521-e933cbb956e9">
