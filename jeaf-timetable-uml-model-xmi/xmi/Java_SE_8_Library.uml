                    </packagedElement>
                    <packagedElement xmi:type="uml:Class" xmi:id="9ba4a5b9-04eb-48a5-9c91-67ba21cda64d" name="LocalVariableTable">
                      <ownedComment xmi:id="f1f711bf-04aa-42d6-9398-d37f86b4029e" body="This class represents colection of local variables in a&#xA;method. This attribute is contained in the &lt;em>Code&lt;/em> attribute.&#xA;&#xA;@author  &lt;A HREF=&quot;mailto:markus.dahm@berlin.de&quot;>M. Dahm&lt;/A>&#xA;@see     Code&#xA;@see LocalVariable&#xA;" annotatedElement="9ba4a5b9-04eb-48a5-9c91-67ba21cda64d"/>
