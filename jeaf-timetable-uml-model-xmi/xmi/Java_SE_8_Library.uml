              </ownedParameter>
            </ownedTemplateSignature>
            <generalization xmi:id="2691813b-50a4-4117-90ae-4a8978253390" isSubstitutable="true" general="1c556d25-a577-4c5b-9617-bf5add81b9ea"/>
