            <nestedClassifier xmi:type="uml:Class" xmi:id="ad43cc48-31d0-4dce-b2af-c8be064fec8a" name="FlipSubRegionBufferStrategy" visibility="private">
              <ownedComment xmi:id="5e1e8db1-c016-4ec6-a637-7404cc37e7e1" body="Private class to perform sub-region flipping.&#xA;" annotatedElement="ad43cc48-31d0-4dce-b2af-c8be064fec8a"/>
              <generalization xmi:id="e9d2e9be-3170-4cee-a10e-8c05bdbed882" isSubstitutable="true" general="656972ff-e312-4dc9-940a-f2876d4d4795"/>
