                <ownedParameter xmi:type="uml:ClassifierTemplateParameter" xmi:id="c2d7778c-6c2f-46a4-b627-53fa3278bfb2" parameteredElement="1a761bb6-3fd0-4a37-abc8-427b4c6e4bea" constrainingClassifier="1f3ff787-6bdf-417e-92ba-513cd354fc6d">
