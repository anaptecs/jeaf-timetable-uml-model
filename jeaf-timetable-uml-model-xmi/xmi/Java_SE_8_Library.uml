              <generalization xmi:id="3a0ee33f-9499-4206-89cb-09fcdfff95bc" isSubstitutable="true" general="04589d10-bb5c-4bee-810b-050c08bef31b"/>
            </nestedClassifier>
            <nestedClassifier xmi:type="uml:Class" xmi:id="82416e76-756a-43c0-99df-c85ffa4aad23" name="LinkInfo" visibility="private"/>
            <nestedClassifier xmi:type="uml:Class" xmi:id="2dec647d-2ab1-4fca-b48a-b74af10dc428" name="ComponentInfo" visibility="private">
              <ownedComment xmi:id="39908503-c384-4fec-9d21-a8e03e153a58" body="Tracks the horizontal/vertical Springs for a Component.&#xA;This class is also used to handle Springs that have their sizes&#xA;linked.&#xA;" annotatedElement="2dec647d-2ab1-4fca-b48a-b74af10dc428"/>
