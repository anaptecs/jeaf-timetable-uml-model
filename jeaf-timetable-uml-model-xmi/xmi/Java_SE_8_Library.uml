              <nestedClassifier xmi:type="uml:Interface" xmi:id="9ea5362a-faf4-49ec-88e9-809663d1d537" name="AsynchronousCompletionTask" isAbstract="true">
                <ownedComment xmi:id="d5161312-f39b-457a-bb7e-51887ebc598f" body="A marker interface identifying asynchronous tasks produced by&#xA;{@code async} methods. This may be useful for monitoring,&#xA;debugging, and tracking asynchronous activities.&#xA;&#xA;@since 1.8&#xA;" annotatedElement="9ea5362a-faf4-49ec-88e9-809663d1d537"/>
              </nestedClassifier>
