                  </nestedClassifier>
                </nestedClassifier>
                <nestedClassifier xmi:type="uml:Class" xmi:id="113259ed-68fe-462a-ab13-823e4d795238" name="InfoDestination" visibility="package" clientDependency="7e6d0f03-c6d9-4b4b-b5b6-d582cb372fb6">
                  <ownedComment xmi:id="6d348643-9dc9-4503-b63e-71eb05c67a23" body="Handles the info group. Currently no info keywords are recognized&#xA;so this is a subclass of DiscardingDestination." annotatedElement="113259ed-68fe-462a-ab13-823e4d795238"/>
                  <generalization xmi:id="5d97f2df-f630-4104-83a2-977bb4ef73e5" isSubstitutable="true" general="c19cb2b6-32b5-40a4-9a5f-a016852484b5"/>
                  <interfaceRealization xmi:id="7e6d0f03-c6d9-4b4b-b5b6-d582cb372fb6" name="" supplier="dacb9deb-2228-4e5d-b033-f02645fa9bea" client="113259ed-68fe-462a-ab13-823e4d795238" contract="dacb9deb-2228-4e5d-b033-f02645fa9bea"/>
                </nestedClassifier>
                <nestedClassifier xmi:type="uml:Class" xmi:id="d92b770d-9bae-49f2-a892-654ea829dd1e" name="AttributeTrackingDestination" visibility="package" clientDependency="dd692d9d-9265-4cf1-9ad6-d712efb7ad23" isAbstract="true">
                  <ownedComment xmi:id="b31d2c42-55e8-418d-aa20-81283b9c35ad" body="RTFReader.TextHandlingDestination is an abstract RTF destination&#xA;which simply tracks the attributes specified by the RTF control words&#xA;in internal form and can produce acceptable AttributeSets for the&#xA;current character, paragraph, and section attributes. It is up&#xA;to the subclasses to determine what is done with the actual text." annotatedElement="d92b770d-9bae-49f2-a892-654ea829dd1e"/>
                  <interfaceRealization xmi:id="dd692d9d-9265-4cf1-9ad6-d712efb7ad23" name="" supplier="dacb9deb-2228-4e5d-b033-f02645fa9bea" client="d92b770d-9bae-49f2-a892-654ea829dd1e" contract="dacb9deb-2228-4e5d-b033-f02645fa9bea"/>
                </nestedClassifier>
                <nestedClassifier xmi:type="uml:Class" xmi:id="a8049121-02c9-46ec-9585-621364a61991" name="TextHandlingDestination" visibility="package" clientDependency="cfcd284d-7bbb-4fd7-ab26-c7498ffe04be" isAbstract="true">
                  <ownedComment xmi:id="98abdba5-2417-4e13-b40e-fbdc6353fdef" body="RTFReader.TextHandlingDestination provides basic text handling&#xA;functionality. Subclasses must implement: &lt;dl>&#xA;&lt;dt>deliverText()&lt;dd>to handle a run of text with the same&#xA;attributes&#xA;&lt;dt>finishParagraph()&lt;dd>to end the current paragraph and&#xA;set the paragraph's attributes&#xA;&lt;dt>endSection()&lt;dd>to end the current section&#xA;&lt;/dl>&#xA;" annotatedElement="a8049121-02c9-46ec-9585-621364a61991"/>
                  <generalization xmi:id="f02d4412-f320-4052-ae89-e2aeaab3d8f4" isSubstitutable="true" general="d92b770d-9bae-49f2-a892-654ea829dd1e"/>
                  <interfaceRealization xmi:id="cfcd284d-7bbb-4fd7-ab26-c7498ffe04be" name="" supplier="dacb9deb-2228-4e5d-b033-f02645fa9bea" client="a8049121-02c9-46ec-9585-621364a61991" contract="dacb9deb-2228-4e5d-b033-f02645fa9bea"/>
                </nestedClassifier>
                <nestedClassifier xmi:type="uml:Class" xmi:id="3d90548f-be29-4acd-9913-9411b68748ef" name="DocumentDestination" visibility="package" clientDependency="8ede2cf1-d89d-4c72-81a7-990bda0b5944">
                  <ownedComment xmi:id="2b73bc8b-db0b-491a-9181-bdf70afc8c4c" body="RTFReader.DocumentDestination is a concrete subclass of&#xA;TextHandlingDestination which appends the text to the&#xA;StyledDocument given by the &lt;code>target&lt;/code> ivar of the&#xA;containing RTFReader.&#xA;" annotatedElement="3d90548f-be29-4acd-9913-9411b68748ef"/>
                  <generalization xmi:id="c502dac6-3a2c-4f95-b2d3-18bf2f24db96" isSubstitutable="true" general="a8049121-02c9-46ec-9585-621364a61991"/>
                  <interfaceRealization xmi:id="8ede2cf1-d89d-4c72-81a7-990bda0b5944" name="" supplier="dacb9deb-2228-4e5d-b033-f02645fa9bea" client="3d90548f-be29-4acd-9913-9411b68748ef" contract="dacb9deb-2228-4e5d-b033-f02645fa9bea"/>
                </nestedClassifier>
              </packagedElement>
