                  <generalization xmi:id="1f3fdce9-5a01-4c11-982a-ac6a5cd508c0" isSubstitutable="true" general="c15504bb-c7e6-4bfb-aeab-fad059cb0243"/>
                </packagedElement>
                <packagedElement xmi:type="uml:Class" xmi:id="12b2581b-f2a4-447a-b5ff-2f19afc6d3b5" name="COMMarkerSegment" visibility="package">
                  <ownedComment xmi:id="a33edbc7-d29b-4117-90d0-d11e1966a126" body="A Comment marker segment.  Retains an array of bytes representing the&#xA;comment data as it is read from the stream.  If the marker segment is&#xA;constructed from a String, then local default encoding is assumed&#xA;when creating the byte array.  If the marker segment is created from&#xA;an &lt;code>IIOMetadataNode&lt;/code>, the user object, if present is&#xA;assumed to be a byte array containing the comment data.  If there is&#xA;no user object then the comment attribute is used to create the&#xA;byte array, again assuming the default local encoding.&#xA;" annotatedElement="12b2581b-f2a4-447a-b5ff-2f19afc6d3b5"/>
                  <generalization xmi:id="0897e3a0-1fc6-4104-9d4c-37323f137f12" isSubstitutable="true" general="c15504bb-c7e6-4bfb-aeab-fad059cb0243"/>
                </packagedElement>
                <packagedElement xmi:type="uml:Class" xmi:id="e96fb885-6086-4a05-a0bb-7408877bb802" name="DHTMarkerSegment" visibility="package">
                  <ownedComment xmi:id="585dfe73-6207-44d3-b19e-cadb533e23e3" body="A DHT (Define Huffman Table) marker segment.&#xA;" annotatedElement="e96fb885-6086-4a05-a0bb-7408877bb802"/>
                  <generalization xmi:id="0757dfe1-52b6-46e8-8ed3-6ee39adc6420" isSubstitutable="true" general="c15504bb-c7e6-4bfb-aeab-fad059cb0243"/>
