              </packagedElement>
              <packagedElement xmi:type="uml:Class" xmi:id="049680bf-e53c-4ea7-a1ce-160ef1304b8e" name="NameCallback" clientDependency="ce3c7615-927c-412e-9773-b154df169805 b612739c-3e45-48d8-a954-88ebeeb8a824">
                <ownedComment xmi:id="9becf6bf-5c9e-4761-9e1e-e8c923bfdfcc" body="&lt;p> Underlying security services instantiate and pass a&#xA;{@code NameCallback} to the {@code handle}&#xA;method of a {@code CallbackHandler} to retrieve name information.&#xA;&#xA;@see javax.security.auth.callback.CallbackHandler&#xA;" annotatedElement="049680bf-e53c-4ea7-a1ce-160ef1304b8e"/>
                <interfaceRealization xmi:id="b612739c-3e45-48d8-a954-88ebeeb8a824" name="" supplier="82f4385f-427a-4cb2-b1dd-75deafd1cb31" client="049680bf-e53c-4ea7-a1ce-160ef1304b8e" contract="82f4385f-427a-4cb2-b1dd-75deafd1cb31"/>
                <interfaceRealization xmi:id="ce3c7615-927c-412e-9773-b154df169805" name="" supplier="41f4a654-a713-47bf-a391-e112be100ec5" client="049680bf-e53c-4ea7-a1ce-160ef1304b8e" contract="41f4a654-a713-47bf-a391-e112be100ec5"/>
              </packagedElement>
              <packagedElement xmi:type="uml:Class" xmi:id="cb659630-a979-48f2-9a63-eb143622ff4a" name="PasswordCallback" clientDependency="5f89eca3-9b14-4483-8216-e56384434749 f2173a65-9c9a-44c6-b8fa-78f34a348af5">
                <ownedComment xmi:id="6c63afc7-a389-4805-8dae-79a95ca548d4" body="&lt;p> Underlying security services instantiate and pass a&#xA;{@code PasswordCallback} to the {@code handle}&#xA;method of a {@code CallbackHandler} to retrieve password information.&#xA;&#xA;@see javax.security.auth.callback.CallbackHandler&#xA;" annotatedElement="cb659630-a979-48f2-9a63-eb143622ff4a"/>
                <interfaceRealization xmi:id="5f89eca3-9b14-4483-8216-e56384434749" name="" supplier="82f4385f-427a-4cb2-b1dd-75deafd1cb31" client="cb659630-a979-48f2-9a63-eb143622ff4a" contract="82f4385f-427a-4cb2-b1dd-75deafd1cb31"/>
