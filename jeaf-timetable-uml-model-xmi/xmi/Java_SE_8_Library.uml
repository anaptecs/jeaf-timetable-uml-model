                  </templateBinding>
                </packagedElement>
                <packagedElement xmi:type="uml:Class" xmi:id="38e853b7-0ae0-471c-9e20-8ac052b3fbd2" name="LinkedList&lt;SolarisNumericGroupPrincipal>">
                  <templateBinding xmi:id="ce3eb678-b6c7-4720-80e9-c0c74a04fc00" signature="6faadde3-a8ea-4599-9bb9-bd7a6ae3e469">
                    <parameterSubstitution xmi:id="2ffbe016-47b4-47ad-a5c1-2392972a7986" formal="6761d5be-2c6b-4eb1-86f9-6b8c98ec6af7" actual="b6f47592-deb3-4166-be48-6b07c5e6c64d"/>
