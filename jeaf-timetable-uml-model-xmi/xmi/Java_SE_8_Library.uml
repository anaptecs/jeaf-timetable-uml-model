                        <packagedElement xmi:type="uml:Class" xmi:id="7a5dd64d-d9b9-4bee-a257-e45bb19d7e37" name="RangeToken" visibility="package" clientDependency="ff199f96-1441-4c67-ba6d-4517abdd15d7">
                          <ownedComment xmi:id="acabeeeb-3b49-4e12-b804-cd2ac7fa480d" body="This class represents a character class such as [a-z] or a period.&#xA;&#xA;@xerces.internal&#xA;&#xA;" annotatedElement="7a5dd64d-d9b9-4bee-a257-e45bb19d7e37"/>
