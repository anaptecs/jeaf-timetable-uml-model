            <packagedElement xmi:type="uml:Class" xmi:id="1e52301f-85d7-4b3a-a4cb-a320c6e5e247" name="DynamicImplementation" isAbstract="true">
              <ownedComment xmi:id="03ad5f45-78c0-4233-a2a5-ff7a7d8dff8c" body="Allows dynamic handling of object invocations.  POA-based DSI&#xA;servants inherit from the&#xA;standard &lt;code>DynamicImplementation&lt;/code> class, this class inherits&#xA;from the &lt;code>Servant&lt;/code> class. Based on IDL to Java spec.&#xA;CORBA V 2.3.1 ptc/00-01-08.pdf.&#xA;" annotatedElement="1e52301f-85d7-4b3a-a4cb-a320c6e5e247"/>
