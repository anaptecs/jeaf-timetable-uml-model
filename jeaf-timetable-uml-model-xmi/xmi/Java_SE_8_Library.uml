            <nestedClassifier xmi:type="uml:Class" xmi:id="3708c15e-ef69-4323-a1e3-2fce669bb96a" name="AccessibleJSpinner" visibility="protected" clientDependency="54580fda-e879-4744-999b-5699958069ed 4519bc2d-f8d8-441f-bd0d-b9d1ed28f06f 059fa412-4ce0-4e2a-ae5f-e434ca3e5d87 875b05fe-7b94-4fc9-892e-b0a7e6f8a0cd 12983544-f0ce-40e7-af27-e8c936f3d7bf">
              <ownedComment xmi:id="9f93f353-5d21-4ef3-bb4d-8d9985a3acb8" body="&lt;code>AccessibleJSpinner&lt;/code> implements accessibility&#xA;support for the &lt;code>JSpinner&lt;/code> class.&#xA;@since 1.5&#xA;" annotatedElement="3708c15e-ef69-4323-a1e3-2fce669bb96a"/>
              <generalization xmi:id="4504b7d1-a339-417f-83d6-1be58531ee87" isSubstitutable="true" general="68e47b36-9d7c-40f8-88ff-0e6dd14e72ad"/>
