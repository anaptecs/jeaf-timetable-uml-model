                          <ownedComment xmi:id="e2367600-8f90-4356-a8fd-f664feb63c3e" body="Implementation of &lt;code>com.sun.org.apache.xerces.internal.xs.datatypes.ByteList&lt;/code>.&#xA;&#xA;@xerces.internal&#xA;&#xA;@author Ankit Pasricha, IBM&#xA;&#xA;@version $Id: ByteListImpl.java,v 1.7 2010-11-01 04:39:46 joehw Exp $&#xA;" annotatedElement="486b8189-eab3-472c-9986-290a16ba932d"/>
