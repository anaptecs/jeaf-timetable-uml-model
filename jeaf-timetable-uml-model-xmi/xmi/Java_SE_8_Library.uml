                </ownedParameter>
              </ownedTemplateSignature>
            </packagedElement>
            <packagedElement xmi:type="uml:Interface" xmi:id="6a552e78-1fbe-4149-ae2c-486166978ad7" name="IntPredicate" isAbstract="true">
              <ownedComment xmi:id="64904c2c-53dc-4afe-8758-7a1a8d5033cc" body="Represents a predicate (boolean-valued function) of one {@code int}-valued&#xA;argument. This is the {@code int}-consuming primitive type specialization of&#xA;{@link Predicate}.&#xA;&#xA;&lt;p>This is a &lt;a href=&quot;package-summary.html&quot;>functional interface&lt;/a>&#xA;whose functional method is {@link #test(int)}.&#xA;&#xA;@see Predicate&#xA;@since 1.8&#xA;" annotatedElement="6a552e78-1fbe-4149-ae2c-486166978ad7"/>
            </packagedElement>
            <packagedElement xmi:type="uml:Interface" xmi:id="27348003-60e6-4bde-ade8-3a23e6059f15" name="IntSupplier" isAbstract="true">
              <ownedComment xmi:id="44d99157-6531-4ac9-b386-5c131a40f77c" body="Represents a supplier of {@code int}-valued results.  This is the&#xA;{@code int}-producing primitive specialization of {@link Supplier}.&#xA;&#xA;&lt;p>There is no requirement that a distinct result be returned each&#xA;time the supplier is invoked.&#xA;&#xA;&lt;p>This is a &lt;a href=&quot;package-summary.html&quot;>functional interface&lt;/a>&#xA;whose functional method is {@link #getAsInt()}.&#xA;&#xA;@see Supplier&#xA;@since 1.8&#xA;" annotatedElement="27348003-60e6-4bde-ade8-3a23e6059f15"/>
            </packagedElement>
            <packagedElement xmi:type="uml:Interface" xmi:id="3382f382-715b-462f-9453-a317b95a8037" name="IntToDoubleFunction" isAbstract="true">
              <ownedComment xmi:id="7e8bb748-cabe-4bf7-bd08-60689d39bb17" body="Represents a function that accepts an int-valued argument and produces a&#xA;double-valued result.  This is the {@code int}-to-{@code double} primitive&#xA;specialization for {@link Function}.&#xA;&#xA;&lt;p>This is a &lt;a href=&quot;package-summary.html&quot;>functional interface&lt;/a>&#xA;whose functional method is {@link #applyAsDouble(int)}.&#xA;&#xA;@see Function&#xA;@since 1.8&#xA;" annotatedElement="3382f382-715b-462f-9453-a317b95a8037"/>
            </packagedElement>
            <packagedElement xmi:type="uml:Interface" xmi:id="404e9828-c711-4800-b2fb-5cf6cb7e04f3" name="IntToLongFunction" isAbstract="true">
              <ownedComment xmi:id="29fe2c06-159c-4a95-8d7c-7b0947d05d0c" body="Represents a function that accepts an int-valued argument and produces a&#xA;long-valued result.  This is the {@code int}-to-{@code long} primitive&#xA;specialization for {@link Function}.&#xA;&#xA;&lt;p>This is a &lt;a href=&quot;package-summary.html&quot;>functional interface&lt;/a>&#xA;whose functional method is {@link #applyAsLong(int)}.&#xA;&#xA;@see Function&#xA;@since 1.8&#xA;" annotatedElement="404e9828-c711-4800-b2fb-5cf6cb7e04f3"/>
            </packagedElement>
            <packagedElement xmi:type="uml:Interface" xmi:id="23f83b22-2ae8-44ce-8556-a767470b3c75" name="IntUnaryOperator" isAbstract="true">
              <ownedComment xmi:id="5e3ebc48-1f15-4478-8dda-70e554eafe71" body="Represents an operation on a single {@code int}-valued operand that produces&#xA;an {@code int}-valued result.  This is the primitive type specialization of&#xA;{@link UnaryOperator} for {@code int}.&#xA;&#xA;&lt;p>This is a &lt;a href=&quot;package-summary.html&quot;>functional interface&lt;/a>&#xA;whose functional method is {@link #applyAsInt(int)}.&#xA;&#xA;@see UnaryOperator&#xA;@since 1.8&#xA;" annotatedElement="23f83b22-2ae8-44ce-8556-a767470b3c75"/>
