                </templateBinding>
              </packagedElement>
              <packagedElement xmi:type="uml:Interface" xmi:id="5b6ccf46-1446-4fa1-88c1-b6959bc85be1" name="DirectoryStream&lt;Path>">
                <templateBinding xmi:id="34542f8c-693b-4de9-bcf7-93d8a26e1bfb" signature="a022bb17-a2fd-4fe8-aab3-cf34426bafc5">
