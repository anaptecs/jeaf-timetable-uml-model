                <nestedClassifier xmi:type="uml:Class" xmi:id="29c48414-36f4-4760-8431-2dce7f0750d0" name="TreePageAction">
                  <ownedComment xmi:id="8b65f441-de00-47cc-ae8e-c7692cd5eae5" body="TreePageAction handles page up and page down events.&#xA;" annotatedElement="29c48414-36f4-4760-8431-2dce7f0750d0"/>
                  <generalization xmi:id="1f6179b8-3244-459f-adad-abc7bfd11969" isSubstitutable="true" general="37db1b87-b22d-45bf-b084-60ec1e3df251"/>
