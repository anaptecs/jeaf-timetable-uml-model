                  <nestedClassifier xmi:type="uml:Class" xmi:id="40272046-0cd0-4c9e-8e9a-6c777d42f6dd" name="ICCMarkerSegment" visibility="package">
                    <ownedComment xmi:id="d79e31dc-5305-40ae-93cd-3777670d4978" body="An APP2 marker segment containing an ICC profile.  In the stream&#xA;a profile larger than 64K is broken up into a series of chunks.&#xA;This inner class represents the complete profile as a single object,&#xA;combining chunks as necessary.&#xA;" annotatedElement="40272046-0cd0-4c9e-8e9a-6c777d42f6dd"/>
                    <generalization xmi:id="522d8a47-1e05-4c65-a4f1-1b911fb7b903" isSubstitutable="true" general="c15504bb-c7e6-4bfb-aeab-fad059cb0243"/>
