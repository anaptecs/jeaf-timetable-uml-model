            </nestedClassifier>
            <nestedClassifier xmi:type="uml:Class" xmi:id="4f198914-2a44-4227-ac46-ea3fa7fdc525" name="SwingDragGestureRecognizer" visibility="private">
              <generalization xmi:id="6cd3d7ea-b159-400d-afd3-dd09b3b7f5f8" isSubstitutable="true" general="02d2a9db-32be-4b0b-aa73-dc94dde11077"/>
            </nestedClassifier>
            <nestedClassifier xmi:type="uml:Class" xmi:id="4b09448f-13e9-482b-a456-adf7c5dca865" name="TransferAction" visibility="package" clientDependency="2f3edace-97a8-49f0-b36b-cc48e89b2870">
              <interfaceRealization xmi:id="2f3edace-97a8-49f0-b36b-cc48e89b2870" name="" supplier="157caddf-a166-42dd-aeee-51e517c24af2" client="4b09448f-13e9-482b-a456-adf7c5dca865" contract="157caddf-a166-42dd-aeee-51e517c24af2"/>
