                <packagedElement xmi:type="uml:Class" xmi:id="1aba8a27-e84e-48e5-9cd7-3c56daec3441" name="WBMPImageWriter">
                  <ownedComment xmi:id="0d26c9b2-56d4-4493-bd69-fa70c42f122d" body="The Java Image IO plugin writer for encoding a binary RenderedImage into&#xA;a WBMP format.&#xA;&#xA;The encoding process may clip, subsample using the parameters&#xA;specified in the &lt;code>ImageWriteParam&lt;/code>.&#xA;&#xA;@see com.sun.media.imageio.plugins.WBMPImageWriteParam&#xA;" annotatedElement="1aba8a27-e84e-48e5-9cd7-3c56daec3441"/>
                  <generalization xmi:id="9ff15b87-0ab7-4b45-a98d-0ba8a89c4733" isSubstitutable="true" general="d2ca091b-aedd-4a05-9a87-f00e89e30a46"/>
