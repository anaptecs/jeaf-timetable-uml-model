                          <ownedComment xmi:id="179e74ce-ab23-44bf-b9c9-f4c4eb82c0c8" body="format validation&#xA;&#xA;This class encodes/decodes hexadecimal data&#xA;&#xA;@xerces.internal&#xA;&#xA;@author Jeffrey Rodriguez&#xA;" annotatedElement="258a628f-4689-40a1-ba7b-7dfae2d80a9d"/>
