                      <packagedElement xmi:type="uml:Class" xmi:id="a00011de-6c59-4fe8-9d3d-b2db87d6080a" name="InvalidDigestValueException">
                        <ownedComment xmi:id="3860d1e9-f9a0-4dc9-8327-bed2a1107b7d" body="Raised when the computed hash value doesn't match the given &lt;i>DigestValue&lt;/i>.&#xA;Additional human readable info is passed to the constructor -- this being the benefit&#xA;of raising an exception or returning a value.&#xA;&#xA;@author Christian Geuer-Pollmann&#xA;" annotatedElement="a00011de-6c59-4fe8-9d3d-b2db87d6080a"/>
                        <generalization xmi:id="fe6ec375-ac43-4356-933a-02a6bdd499ed" isSubstitutable="true" general="54239a2d-d633-4a0c-a4f2-05c59b93acc9"/>
                      </packagedElement>
                      <packagedElement xmi:type="uml:Class" xmi:id="9a21e509-ba0b-404d-8719-b89ce6e0a380" name="InvalidSignatureValueException">
                        <ownedComment xmi:id="6cd69c24-35b2-4273-bb40-0875310a5d8a" body="Raised if testing the signature value over &lt;i>DigestValue&lt;/i> fails because of invalid signature.&#xA;&#xA;@see InvalidDigestValueException  MissingKeyFailureException  MissingResourceFailureException&#xA;@author Christian Geuer-Pollmann&#xA;" annotatedElement="9a21e509-ba0b-404d-8719-b89ce6e0a380"/>
                        <generalization xmi:id="6c7db9f7-9db8-4c17-aaea-fd23af7cd23c" isSubstitutable="true" general="54239a2d-d633-4a0c-a4f2-05c59b93acc9"/>
                      </packagedElement>
                      <packagedElement xmi:type="uml:Class" xmi:id="76d0638f-35fd-47b1-a667-d373b0b39ce4" name="Manifest">
                        <ownedComment xmi:id="8a0b5dc8-0ead-48f3-bb8c-c60b2f8ae43e" body="Handles &lt;code>&amp;lt;ds:Manifest&amp;gt;&lt;/code> elements.&#xA;&lt;p> This element holds the &lt;code>Reference&lt;/code> elements&lt;/p>&#xA;" annotatedElement="76d0638f-35fd-47b1-a667-d373b0b39ce4"/>
                        <generalization xmi:id="35e5642d-15a0-4161-a707-2187532401bb" isSubstitutable="true" general="4d57b1b5-dd39-4f86-8fac-1ddfcf201444"/>
                      </packagedElement>
                      <packagedElement xmi:type="uml:Class" xmi:id="5dc350d8-8495-47c1-b266-1ff25e12ff74" name="MissingResourceFailureException">
                        <ownedComment xmi:id="6dfcf42f-9f55-4aae-9385-6e5f07a5c355" body="Thrown by {@link com.sun.org.apache.xml.internal.security.signature.SignedInfo#verify()} when&#xA;testing the signature fails because of uninitialized&#xA;{@link com.sun.org.apache.xml.internal.security.signature.Reference}s.&#xA;&#xA;@author Christian Geuer-Pollmann&#xA;@see ReferenceNotInitializedException&#xA;" annotatedElement="5dc350d8-8495-47c1-b266-1ff25e12ff74"/>
                        <generalization xmi:id="d2a62641-4ab9-4872-afe0-166c98d9a259" isSubstitutable="true" general="54239a2d-d633-4a0c-a4f2-05c59b93acc9"/>
                      </packagedElement>
                      <packagedElement xmi:type="uml:Interface" xmi:id="06ff7190-7cbe-4ca9-8f63-b9bb32a5d5b0" name="NodeFilter" isAbstract="true">
                        <ownedComment xmi:id="dbc878a0-4cda-4d4f-8bdc-217eb4f3e49c" body="An interface to tell to the c14n if a node is included or not in the output&#xA;" annotatedElement="06ff7190-7cbe-4ca9-8f63-b9bb32a5d5b0"/>
                      </packagedElement>
                      <packagedElement xmi:type="uml:Class" xmi:id="db380ebe-8884-4875-be2e-b31a9c96550e" name="ObjectContainer">
                        <ownedComment xmi:id="48f553e9-09f2-498a-b887-e38059e3e961" body="Handles &lt;code>&amp;lt;ds:Object&amp;gt;&lt;/code> elements&#xA;&lt;code>Object&lt;code> {@link Element} supply facility which can contain any kind data&#xA;&#xA;@author Christian Geuer-Pollmann&#xA;$todo$ if we remove childen, the boolean values are not updated&#xA;" annotatedElement="db380ebe-8884-4875-be2e-b31a9c96550e"/>
                        <generalization xmi:id="ea45d5d3-0225-460c-8de4-6e816a01945a" isSubstitutable="true" general="4d57b1b5-dd39-4f86-8fac-1ddfcf201444"/>
                      </packagedElement>
                      <packagedElement xmi:type="uml:Class" xmi:id="4b5d5942-8207-46a0-8a8a-aaae6ec2668f" name="Reference">
                        <ownedComment xmi:id="cb790784-ed0d-4a47-8c61-384b17910a94" body="Handles &lt;code>&amp;lt;ds:Reference&amp;gt;&lt;/code> elements.&#xA;&#xA;This includes:&#xA;&#xA;Constructs a &lt;CODE>ds:Reference&lt;/CODE> from an {@link org.w3c.dom.Element}.&#xA;&#xA;&lt;p>Create a new reference&lt;/p>&#xA;&lt;pre>&#xA;Document doc;&#xA;MessageDigestAlgorithm sha1 = MessageDigestAlgorithm.getInstance(&quot;http://#sha1&quot;);&#xA;Reference ref = new Reference(new XMLSignatureInput(new FileInputStream(&quot;1.gif&quot;),&#xA;&quot;http://localhost/1.gif&quot;,&#xA;(Transforms) null, sha1);&#xA;Element refElem = ref.toElement(doc);&#xA;&lt;/pre>&#xA;&#xA;&lt;p>Verify a reference&lt;/p>&#xA;&lt;pre>&#xA;Element refElem = doc.getElement(&quot;Reference&quot;); // PSEUDO&#xA;Reference ref = new Reference(refElem);&#xA;String url = ref.getURI();&#xA;ref.setData(new XMLSignatureInput(new FileInputStream(url)));&#xA;if (ref.verify()) {&#xA;System.out.println(&quot;verified&quot;);&#xA;}&#xA;&lt;/pre>&#xA;&#xA;&lt;pre>&#xA;&amp;lt;element name=&quot;Reference&quot; type=&quot;ds:ReferenceType&quot;/&amp;gt;&#xA;&amp;lt;complexType name=&quot;ReferenceType&quot;&amp;gt;&#xA;&amp;lt;sequence&amp;gt;&#xA;&amp;lt;element ref=&quot;ds:Transforms&quot; minOccurs=&quot;0&quot;/&amp;gt;&#xA;&amp;lt;element ref=&quot;ds:DigestMethod&quot;/&amp;gt;&#xA;&amp;lt;element ref=&quot;ds:DigestValue&quot;/&amp;gt;&#xA;&amp;lt;/sequence&amp;gt;&#xA;&amp;lt;attribute name=&quot;Id&quot; type=&quot;ID&quot; use=&quot;optional&quot;/&amp;gt;&#xA;&amp;lt;attribute name=&quot;URI&quot; type=&quot;anyURI&quot; use=&quot;optional&quot;/&amp;gt;&#xA;&amp;lt;attribute name=&quot;Type&quot; type=&quot;anyURI&quot; use=&quot;optional&quot;/&amp;gt;&#xA;&amp;lt;/complexType&amp;gt;&#xA;&lt;/pre>&#xA;&#xA;@author Christian Geuer-Pollmann&#xA;@see ObjectContainer&#xA;@see Manifest&#xA;" annotatedElement="4b5d5942-8207-46a0-8a8a-aaae6ec2668f"/>
                        <generalization xmi:id="c266e16a-2f77-405a-b95b-c2aa03ff0122" isSubstitutable="true" general="4d57b1b5-dd39-4f86-8fac-1ddfcf201444"/>
                      </packagedElement>
                      <packagedElement xmi:type="uml:Class" xmi:id="1242c430-3631-4d3a-a976-56f625941c66" name="ReferenceNotInitializedException">
                        <ownedComment xmi:id="b2594b34-1f3f-4c84-9502-67ef59e7ed71" body="Raised if verifying a {@link com.sun.org.apache.xml.internal.security.signature.Reference} fails&#xA;because of an uninitialized {@link com.sun.org.apache.xml.internal.security.signature.XMLSignatureInput}&#xA;&#xA;@author Christian Geuer-Pollmann&#xA;" annotatedElement="1242c430-3631-4d3a-a976-56f625941c66"/>
                        <generalization xmi:id="4bf8c9a1-a2c2-4845-8251-b79b268f9640" isSubstitutable="true" general="54239a2d-d633-4a0c-a4f2-05c59b93acc9"/>
                      </packagedElement>
                      <packagedElement xmi:type="uml:Class" xmi:id="0f25ae8a-4f7b-4cb6-88d3-a639c82618cc" name="SignatureProperties">
                        <ownedComment xmi:id="5b365541-273b-49bf-8f2b-8211d3c93e7e" body="Handles &lt;code>&amp;lt;ds:SignatureProperties&amp;gt;&lt;/code> elements&#xA;This Element holds {@link SignatureProperty} that contian additional information items&#xA;concerning the generation of the signature.&#xA;for example, data-time stamp, serial number of cryptographic hardware.&#xA;&#xA;@author Christian Geuer-Pollmann&#xA;" annotatedElement="0f25ae8a-4f7b-4cb6-88d3-a639c82618cc"/>
                        <generalization xmi:id="2f5c041a-d622-4703-9130-814fc799af62" isSubstitutable="true" general="4d57b1b5-dd39-4f86-8fac-1ddfcf201444"/>
                      </packagedElement>
                      <packagedElement xmi:type="uml:Class" xmi:id="adc5ed8d-3195-4392-8199-b8af000d3618" name="SignatureProperty">
                        <ownedComment xmi:id="6524824a-ab95-4ff1-bf3f-46f0303ba99b" body="Handles &lt;code>&amp;lt;ds:SignatureProperty&amp;gt;&lt;/code> elements&#xA;Additional information item concerning the generation of the signature(s) can&#xA;be placed in this Element&#xA;&#xA;@author Christian Geuer-Pollmann&#xA;" annotatedElement="adc5ed8d-3195-4392-8199-b8af000d3618"/>
                        <generalization xmi:id="4a47b5c5-ffc4-4d79-a46d-da3aa05cf049" isSubstitutable="true" general="4d57b1b5-dd39-4f86-8fac-1ddfcf201444"/>
                      </packagedElement>
                      <packagedElement xmi:type="uml:Class" xmi:id="03b6558e-5d6d-48b8-b6da-cfa46f4b8818" name="SignedInfo">
                        <ownedComment xmi:id="1558d921-38c6-4e55-ac7e-ad1979a82e2c" body="Handles &lt;code>&amp;lt;ds:SignedInfo&amp;gt;&lt;/code> elements&#xA;This &lt;code>SignedInfo&lt;code> element includes the canonicalization algorithm,&#xA;a signature algorithm, and one or more references.&#xA;&#xA;@author Christian Geuer-Pollmann&#xA;" annotatedElement="03b6558e-5d6d-48b8-b6da-cfa46f4b8818"/>
                        <generalization xmi:id="4a971be6-6b98-4e93-b7d6-41e0c67718e5" isSubstitutable="true" general="76d0638f-35fd-47b1-a667-d373b0b39ce4"/>
                      </packagedElement>
                      <packagedElement xmi:type="uml:Class" xmi:id="a233848b-5202-4f2f-a922-d861f73ef2e4" name="XMLSignature">
                        <ownedComment xmi:id="6a3c9fc4-9688-456d-8d7d-643261dc90cb" body="Handles &lt;code>&amp;lt;ds:Signature&amp;gt;&lt;/code> elements.&#xA;This is the main class that deals with creating and verifying signatures.&#xA;&#xA;&lt;p>There are 2 types of constructors for this class. The ones that take a&#xA;document, baseURI and 1 or more Java Objects. This is mostly used for&#xA;signing purposes.&#xA;The other constructor is the one that takes a DOM Element and a baseURI.&#xA;This is used mostly with for verifying, when you have a SignatureElement.&#xA;&#xA;There are a few different types of methods:&#xA;&lt;ul>&lt;li>The addDocument* methods are used to add References with optional&#xA;transforms during signing. &lt;/li>&#xA;&lt;li>addKeyInfo* methods are to add Certificates and Keys to the&#xA;KeyInfo tags during signing. &lt;/li>&#xA;&lt;li>appendObject allows a user to add any XML Structure as an&#xA;ObjectContainer during signing.&lt;/li>&#xA;&lt;li>sign and checkSignatureValue methods are used to sign and validate the&#xA;signature. &lt;/li>&lt;/ul>&#xA;" annotatedElement="a233848b-5202-4f2f-a922-d861f73ef2e4"/>
                        <generalization xmi:id="89a7b528-8076-41ba-ab03-24454aece59c" isSubstitutable="true" general="4d57b1b5-dd39-4f86-8fac-1ddfcf201444"/>
                      </packagedElement>
                      <packagedElement xmi:type="uml:Class" xmi:id="54239a2d-d633-4a0c-a4f2-05c59b93acc9" name="XMLSignatureException">
                        <ownedComment xmi:id="34c5675d-f53f-48fe-85d8-d28d9ca19ceb" body="All XML Signature related exceptions inherit herefrom.&#xA;&#xA;@see MissingResourceFailureException InvalidDigestValueException InvalidSignatureValueException&#xA;@author Christian Geuer-Pollmann&#xA;" annotatedElement="54239a2d-d633-4a0c-a4f2-05c59b93acc9"/>
                        <generalization xmi:id="773f8a6e-f528-408c-a130-625002b4c804" isSubstitutable="true" general="bc0931f7-9af6-4cdf-a868-60cfee0ee84c"/>
                      </packagedElement>
                      <packagedElement xmi:type="uml:Class" xmi:id="4c2954bc-0c1e-461b-a43e-41ddd4c045cf" name="XMLSignatureInput">
                        <ownedComment xmi:id="ef3fd0d9-8037-49f3-bc16-2faa55baca0c" body="Class XMLSignatureInput&#xA;&#xA;@author Christian Geuer-Pollmann&#xA;$todo$ check whether an XMLSignatureInput can be _both_, octet stream _and_ node set?&#xA;" annotatedElement="4c2954bc-0c1e-461b-a43e-41ddd4c045cf"/>
                      </packagedElement>
                      <packagedElement xmi:type="uml:Class" xmi:id="c935481c-438d-40af-94dc-2d10bb441e11" name="XMLSignatureInputDebugger">
                        <ownedComment xmi:id="e4929599-9ec6-40fe-9002-33577a7ff316" body="Class XMLSignatureInputDebugger&#xA;" annotatedElement="c935481c-438d-40af-94dc-2d10bb441e11"/>
                      </packagedElement>
                      <packagedElement xmi:type="uml:Interface" xmi:id="5c640dbd-ad14-4681-aa70-d996d2732e28" name="List&lt;Reference>">
                        <templateBinding xmi:id="1a5a6b28-ef13-4bd0-b5bf-e2afcae4d1cb" signature="3e71fc6e-9a72-4a79-82dc-c9a0ddc40a6d">
                          <parameterSubstitution xmi:id="7d68ab52-4574-4fca-b51f-a8bc1d820a4d" formal="5d8b8a6a-c59b-4de0-9ece-820c205828df" actual="4b5d5942-8207-46a0-8a8a-aaae6ec2668f"/>
                        </templateBinding>
                      </packagedElement>
                      <packagedElement xmi:type="uml:Interface" xmi:id="35c5ce47-fe9a-4638-8e30-a50352702fac" name="List&lt;ResourceResolver>">
                        <templateBinding xmi:id="ffe0a008-6ddd-4520-9d8d-5417538ee27b" signature="3e71fc6e-9a72-4a79-82dc-c9a0ddc40a6d">
                          <parameterSubstitution xmi:id="096d9b94-5352-40f1-8468-07d2f9dfbbd1" formal="5d8b8a6a-c59b-4de0-9ece-820c205828df" actual="e8d0a055-39b6-45ea-adcb-f401894adc1c"/>
                        </templateBinding>
                      </packagedElement>
                    </packagedElement>
                    <packagedElement xmi:type="uml:Package" xmi:id="23730a6a-5ea1-48c0-a099-40c9a1e4e4d5" name="transforms">
                      <packagedElement xmi:type="uml:Package" xmi:id="a2518f16-c946-424f-b0cd-35c7d87e90a4" name="implementations">
                        <packagedElement xmi:type="uml:Class" xmi:id="ee9ba53c-a5e1-4d58-b8c2-eceaf608cf8b" name="FuncHere">
                          <ownedComment xmi:id="ffcca504-ecbf-4aad-bfaf-799e4681b15d" body="The 'here()' function returns a node-set containing the attribute or&#xA;processing instruction node or the parent element of the text node&#xA;that directly bears the XPath expression.  This expression results&#xA;in an error if the containing XPath expression does not appear in the&#xA;same XML document against which the XPath expression is being evaluated.&#xA;&#xA;Mainpart is stolen from FuncId.java&#xA;&#xA;This does crash under Xalan2.2.D7 and works under Xalan2.2.D9&#xA;&#xA;To get this baby to work, a special trick has to be used. The function needs&#xA;access to the Node where the XPath expression has been defined. This is done&#xA;by constructing a {@link FuncHere} which has this Node as 'owner'.&#xA;&#xA;@see &quot;http://www.w3.org/Signature/Drafts/xmldsig-core/Overview.html#function-here&quot;&#xA;" annotatedElement="ee9ba53c-a5e1-4d58-b8c2-eceaf608cf8b"/>
                          <generalization xmi:id="ccb3b9dc-f3c6-45f3-8568-43f2d2983bc5" isSubstitutable="true" general="9dcdad47-6327-4f8c-b559-f7e6adfc3090"/>
                        </packagedElement>
                        <packagedElement xmi:type="uml:Class" xmi:id="ffca926a-efda-477c-9344-0cf0932645ae" name="TransformBase64Decode">
                          <ownedComment xmi:id="1705c9a7-5ac0-4285-a041-bdb38f5f402e" body="Implements the &lt;CODE>http://www.w3.org/2000/09/xmldsig#base64&lt;/CODE> decoding&#xA;transform.&#xA;&#xA;&lt;p>The normative specification for base64 decoding transforms is&#xA;&lt;A HREF=&quot;http://www.w3.org/TR/2001/CR-xmldsig-core-20010419/#ref-MIME&quot;>[MIME]&lt;/A>.&#xA;The base64 Transform element has no content. The input&#xA;is decoded by the algorithms. This transform is useful if an&#xA;application needs to sign the raw data associated with the encoded&#xA;content of an element. &lt;/p>&#xA;&#xA;&lt;p>This transform requires an octet stream for input.&#xA;If an XPath node-set (or sufficiently functional alternative) is&#xA;given as input, then it is converted to an octet stream by&#xA;performing operations logically equivalent to 1) applying an XPath&#xA;transform with expression self::text(), then 2) taking the string-value&#xA;of the node-set. Thus, if an XML element is identified by a barename&#xA;XPointer in the Reference URI, and its content consists solely of base64&#xA;encoded character data, then this transform automatically strips away the&#xA;start and end tags of the identified element and any of its descendant&#xA;elements as well as any descendant comments and processing instructions.&#xA;The output of this transform is an octet stream.&lt;/p>&#xA;&#xA;@author Christian Geuer-Pollmann&#xA;@see com.sun.org.apache.xml.internal.security.utils.Base64&#xA;" annotatedElement="ffca926a-efda-477c-9344-0cf0932645ae"/>
                          <generalization xmi:id="1dadf807-9abb-4c1b-8842-a6ae4fc3eeff" isSubstitutable="true" general="92f8ad7d-d35c-4fec-863d-5121d671b600"/>
                        </packagedElement>
                        <packagedElement xmi:type="uml:Class" xmi:id="6ec6ea9c-4358-405b-a2ed-5d247a5c6e92" name="TransformC14N">
                          <ownedComment xmi:id="e5093505-a90e-4aeb-a967-2935588bd0f2" body="Implements the &lt;CODE>http://www.w3.org/TR/2001/REC-xml-c14n-20010315&lt;/CODE>&#xA;transform.&#xA;&#xA;@author Christian Geuer-Pollmann&#xA;" annotatedElement="6ec6ea9c-4358-405b-a2ed-5d247a5c6e92"/>
                          <generalization xmi:id="1e7ab127-b26e-40b7-abd8-d7edbee07d70" isSubstitutable="true" general="92f8ad7d-d35c-4fec-863d-5121d671b600"/>
                        </packagedElement>
                        <packagedElement xmi:type="uml:Class" xmi:id="cabd8a6a-dc42-44d7-8984-90f7a431eb4d" name="TransformC14N11">
                          <ownedComment xmi:id="c9538b7f-268f-4bb2-8a6b-56edb0bc4e0a" body="Implements the &lt;CODE>http://www.w3.org/2006/12/xml-c14n11&lt;/CODE>&#xA;(C14N 1.1) transform.&#xA;&#xA;@author Sean Mullan&#xA;" annotatedElement="cabd8a6a-dc42-44d7-8984-90f7a431eb4d"/>
                          <generalization xmi:id="e7c80636-ab3b-45de-bb31-6f05d6cdbfd1" isSubstitutable="true" general="92f8ad7d-d35c-4fec-863d-5121d671b600"/>
                        </packagedElement>
                        <packagedElement xmi:type="uml:Class" xmi:id="7ca7d618-169e-427a-af68-9520eb3a9398" name="TransformC14N11_WithComments">
                          <ownedComment xmi:id="0ea96392-9309-4927-bea3-6f05bff01a18" body="Implements the &lt;CODE>http://www.w3.org/2006/12/xml-c14n-11#WithComments&lt;/CODE>&#xA;(C14N 1.1 With Comments) transform.&#xA;&#xA;@author Sean Mullan&#xA;" annotatedElement="7ca7d618-169e-427a-af68-9520eb3a9398"/>
                          <generalization xmi:id="49ec163e-1819-4996-87a5-3d6e1d5f6d32" isSubstitutable="true" general="92f8ad7d-d35c-4fec-863d-5121d671b600"/>
                        </packagedElement>
                        <packagedElement xmi:type="uml:Class" xmi:id="72d44180-29b4-40f5-921a-0465a052f2b0" name="TransformC14NExclusive">
                          <ownedComment xmi:id="afa906c4-6c4f-41db-9ca4-b2bb56554591" body="Class TransformC14NExclusive&#xA;&#xA;" annotatedElement="72d44180-29b4-40f5-921a-0465a052f2b0"/>
                          <generalization xmi:id="0dbb0702-0603-45d6-a6b6-5bc4c0517336" isSubstitutable="true" general="92f8ad7d-d35c-4fec-863d-5121d671b600"/>
                        </packagedElement>
                        <packagedElement xmi:type="uml:Class" xmi:id="cde7affb-dd62-49a2-8302-6d58cc550cb2" name="TransformC14NExclusiveWithComments">
                          <ownedComment xmi:id="00014b09-b062-46fb-853e-0dcb8ac4daec" body="Implements the &lt;CODE>http://www.w3.org/TR/2001/REC-xml-c14n-20010315#WithComments&lt;/CODE>&#xA;transform.&#xA;&#xA;@author Christian Geuer-Pollmann&#xA;" annotatedElement="cde7affb-dd62-49a2-8302-6d58cc550cb2"/>
                          <generalization xmi:id="4a8f29c7-9b73-4458-8117-17af5559aaee" isSubstitutable="true" general="92f8ad7d-d35c-4fec-863d-5121d671b600"/>
