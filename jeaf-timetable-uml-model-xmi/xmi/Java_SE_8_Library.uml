                      </packagedElement>
                      <packagedElement xmi:type="uml:Class" xmi:id="8cc1f6fb-3c3a-460e-b247-7fabca31713c" name="WrappedSAXException">
                        <ownedComment xmi:id="9d1c75a4-7e45-4719-9c1e-3a8997c20715" body="Wraps {@link SAXException} and make it an unchecked exception.&#xA;&lt;p>&#xA;Xerces XNI doesn't allow {@link SAXException} to be thrown.&#xA;So when the user-supplied error handler throws it,&#xA;it needs to be tunneled through Xerces.&#xA;&#xA;&lt;p>&#xA;It is a bug if this exception &quot;leaks&quot; to the application.&#xA;&#xA;FIXME: use XNIException for this purpose. It's already doing this&#xA;kind of SAXException tunneling.&#xA;&#xA;@author&#xA;Kohsuke Kawaguchi (kohsuke.kawaguchi@sun.com)&#xA;" annotatedElement="8cc1f6fb-3c3a-460e-b247-7fabca31713c"/>
                        <generalization xmi:id="15e09570-8b68-441a-8044-513a68378f8c" isSubstitutable="true" general="c2be1008-4fc6-4a94-9ff7-fd4e5cca5f78"/>
                      </packagedElement>
