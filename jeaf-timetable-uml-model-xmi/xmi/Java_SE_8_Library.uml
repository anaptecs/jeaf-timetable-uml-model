                </nestedClassifier>
                <nestedClassifier xmi:type="uml:Class" xmi:id="6200567b-c6bd-436d-a1a3-919b16293863" name="SplitPaneBorder" clientDependency="8dda24f3-8552-4927-afa7-f7956c07c95d ddddc2ff-3e07-4fb1-ba18-f95512f02edb">
                  <ownedComment xmi:id="8a3162eb-7e97-4020-b577-df5f7c33b6e6" body="Draws the border around the splitpane. To work correctly you should&#xA;also install a border on the divider (property SplitPaneDivider.border).&#xA;" annotatedElement="6200567b-c6bd-436d-a1a3-919b16293863"/>
