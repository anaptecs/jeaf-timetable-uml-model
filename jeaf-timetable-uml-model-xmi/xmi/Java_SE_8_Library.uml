                    <packagedElement xmi:type="uml:Interface" xmi:id="da8e02db-747c-4c12-ad9f-99f6fb60518b" name="DynamicStub" isAbstract="true">
                      <ownedComment xmi:id="af307977-f228-49f2-85b2-c16d7ccf588c" body="Interface used to support dynamically generated stubs.&#xA;This supplies some methods that are found in&#xA;org.omg.CORBA.portable.ObjectImpl that are not available&#xA;in org.omg.CORBA.Object.&#xA;" annotatedElement="da8e02db-747c-4c12-ad9f-99f6fb60518b"/>
                      <generalization xmi:id="cc0a0fb8-0b92-4429-82ec-fccf3ac87030" isSubstitutable="true" general="b9b8a38d-9489-45b5-8efa-c474c2cb87d3"/>
