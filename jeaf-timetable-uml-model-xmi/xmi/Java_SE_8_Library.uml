            <packagedElement xmi:type="uml:Interface" xmi:id="9a6f059b-6d43-4c51-9ee5-e9b06ff6b34e" name="LifespanPolicy" isAbstract="true">
              <ownedComment xmi:id="0b0b1658-2adc-435c-8b34-a9d0e7a8ecb7" body="The LifespanPolicy specifies the lifespan of the&#xA;objects implemented in the created POA. The default&#xA;is TRANSIENT.&#xA;" annotatedElement="9a6f059b-6d43-4c51-9ee5-e9b06ff6b34e"/>
              <generalization xmi:id="e1ce31c7-aad5-451d-b9a9-7a275a750b9d" isSubstitutable="true" general="21ccbd98-2728-4428-b29c-ad582cac4095"/>
              <generalization xmi:id="eab7f8a9-4440-45be-8eb1-1d1b5f885646" isSubstitutable="true" general="ee833f56-d6e4-40a7-8139-27f06ad40de0"/>
              <generalization xmi:id="59bb6ffe-4aee-4cd1-9d22-561522d85367" isSubstitutable="true" general="b38468cc-c261-4f52-86ea-658766759ede"/>
            </packagedElement>
            <packagedElement xmi:type="uml:Interface" xmi:id="21ccbd98-2728-4428-b29c-ad582cac4095" name="LifespanPolicyOperations" isAbstract="true">
              <ownedComment xmi:id="03419ff4-bc68-416b-9d25-9a155b343291" body="The LifespanPolicy specifies the lifespan of the&#xA;objects implemented in the created POA. The default&#xA;is TRANSIENT.&#xA;" annotatedElement="21ccbd98-2728-4428-b29c-ad582cac4095"/>
              <generalization xmi:id="f6fde23c-05cc-406c-b9d3-43b8a9a3ae7b" isSubstitutable="true" general="a4b9f0a6-546e-4245-8d6d-26133984a5a5"/>
            </packagedElement>
            <packagedElement xmi:type="uml:Class" xmi:id="4c7a1f65-3a86-4da0-a62d-45ee1442b312" name="LifespanPolicyValue" clientDependency="a2c66ff1-97e6-484b-be7e-c2cc75e9c481">
              <ownedComment xmi:id="81167d83-7b42-4e78-9799-3a044244aad6" body="The LifespanPolicyValue can have the following values.&#xA;TRANSIENT - The objects implemented in the POA&#xA;cannot outlive the POA instance in which they are&#xA;first created.&#xA;PERSISTENT - The objects implemented in the POA can&#xA;outlive the process in which they are first created.&#xA;" annotatedElement="4c7a1f65-3a86-4da0-a62d-45ee1442b312"/>
              <interfaceRealization xmi:id="a2c66ff1-97e6-484b-be7e-c2cc75e9c481" name="" supplier="b38468cc-c261-4f52-86ea-658766759ede" client="4c7a1f65-3a86-4da0-a62d-45ee1442b312" contract="b38468cc-c261-4f52-86ea-658766759ede"/>
            </packagedElement>
            <packagedElement xmi:type="uml:Interface" xmi:id="a685f40e-4177-41a8-8eeb-30312632d4c3" name="POA" isAbstract="true">
              <ownedComment xmi:id="2bf52bc3-bc76-4c0f-8fdf-fd45aeca262a" body="A POA object manages the implementation of a&#xA;collection of objects. The POA supports a name space&#xA;for the objects, which are identified by Object Ids.&#xA;A POA also provides a name space for POAs. A POA is&#xA;created as a child of an existing POA, which forms a&#xA;hierarchy starting with the root POA. A POA object&#xA;must not be exported to other processes, or&#xA;externalized with ORB::object_to_string.&#xA;" annotatedElement="a685f40e-4177-41a8-8eeb-30312632d4c3"/>
              <generalization xmi:id="107b1959-3210-468a-8d48-5023ab4aa31b" isSubstitutable="true" general="80c179bd-e24d-4963-b933-dd4ec98b2db7"/>
              <generalization xmi:id="7bf527db-a63f-46de-9b4d-9210ab51d690" isSubstitutable="true" general="b9b8a38d-9489-45b5-8efa-c474c2cb87d3"/>
              <generalization xmi:id="aa34c343-8d03-42d4-82c0-5731b036f768" isSubstitutable="true" general="b38468cc-c261-4f52-86ea-658766759ede"/>
            </packagedElement>
            <packagedElement xmi:type="uml:Class" xmi:id="550e0017-693d-4ef5-afd2-23d4ac393537" name="POAHelper" isAbstract="true">
              <ownedComment xmi:id="99f53328-073b-4101-a24f-34f91078cde9" body="A POA object manages the implementation of a&#xA;collection of objects. The POA supports a name space&#xA;for the objects, which are identified by Object Ids.&#xA;A POA also provides a name space for POAs. A POA is&#xA;created as a child of an existing POA, which forms a&#xA;hierarchy starting with the root POA. A POA object&#xA;must not be exported to other processes, or&#xA;externalized with ORB::object_to_string.&#xA;" annotatedElement="550e0017-693d-4ef5-afd2-23d4ac393537"/>
            </packagedElement>
            <packagedElement xmi:type="uml:Interface" xmi:id="48ebfed4-cd02-4057-be42-e3d274390e5d" name="POAManager" isAbstract="true">
              <ownedComment xmi:id="4e837de0-ef90-4d1e-890a-4f4009fb441c" body="Each POA object has an associated POAManager object.&#xA;A POA manager may be associated with one or more&#xA;POA objects. A POA manager encapsulates the processing&#xA;state of the POAs it is associated with.&#xA;" annotatedElement="48ebfed4-cd02-4057-be42-e3d274390e5d"/>
              <generalization xmi:id="d23e1986-bba7-4767-b136-1ffbd33ca7e4" isSubstitutable="true" general="c7181184-07c2-4920-98c7-71bff7f54907"/>
              <generalization xmi:id="4795aa62-1e34-46ba-8d1f-500ffbc14818" isSubstitutable="true" general="b9b8a38d-9489-45b5-8efa-c474c2cb87d3"/>
              <generalization xmi:id="577d9d8d-6062-46d8-8ba4-2426d2106e11" isSubstitutable="true" general="b38468cc-c261-4f52-86ea-658766759ede"/>
            </packagedElement>
            <packagedElement xmi:type="uml:Interface" xmi:id="c7181184-07c2-4920-98c7-71bff7f54907" name="POAManagerOperations" isAbstract="true">
              <ownedComment xmi:id="ddd29176-de51-4ab5-9303-ddf8fcc9fead" body="Each POA object has an associated POAManager object.&#xA;A POA manager may be associated with one or more&#xA;POA objects. A POA manager encapsulates the processing&#xA;state of the POAs it is associated with.&#xA;" annotatedElement="c7181184-07c2-4920-98c7-71bff7f54907"/>
            </packagedElement>
            <packagedElement xmi:type="uml:Interface" xmi:id="80c179bd-e24d-4963-b933-dd4ec98b2db7" name="POAOperations" isAbstract="true">
              <ownedComment xmi:id="5dcf8483-c13f-490d-af89-20552a073385" body="A POA object manages the implementation of a&#xA;collection of objects. The POA supports a name space&#xA;for the objects, which are identified by Object Ids.&#xA;A POA also provides a name space for POAs. A POA is&#xA;created as a child of an existing POA, which forms a&#xA;hierarchy starting with the root POA. A POA object&#xA;must not be exported to other processes, or&#xA;externalized with ORB::object_to_string.&#xA;" annotatedElement="80c179bd-e24d-4963-b933-dd4ec98b2db7"/>
            </packagedElement>
            <packagedElement xmi:type="uml:Interface" xmi:id="6f61f618-8036-42e1-ac4d-3c3f0f8c0ee1" name="REQUEST_PROCESSING_POLICY_ID" isAbstract="true">
              <ownedComment xmi:id="e7c2db76-f8aa-4c69-b189-1cfdbe85fc70" body="org/omg/PortableServer/REQUEST_PROCESSING_POLICY_ID.java .&#xA;Generated by the IDL-to-Java compiler (portable), version &quot;3.2&quot;&#xA;from d:/re/workspace/8-2-build-windows-amd64-cygwin/jdk8u40/3098/corba/src/share/classes/org/omg/PortableServer/poa.idl&#xA;Saturday, March 7, 2015 1:53:26 PM PST&#xA;" annotatedElement="6f61f618-8036-42e1-ac4d-3c3f0f8c0ee1"/>
            </packagedElement>
            <packagedElement xmi:type="uml:Interface" xmi:id="3547a14c-8730-4048-b25f-a78dd47140ee" name="RequestProcessingPolicy" isAbstract="true">
              <ownedComment xmi:id="5b133a77-1a8e-4e12-89b9-b9b73d226442" body="This policy specifies how requests are processed by&#xA;the created POA.  The default is&#xA;USE_ACTIVE_OBJECT_MAP_ONLY.&#xA;" annotatedElement="3547a14c-8730-4048-b25f-a78dd47140ee"/>
              <generalization xmi:id="7c6a30bd-c34b-441e-8937-b04ba8018533" isSubstitutable="true" general="ff431f29-2522-4b8a-8665-8405e9476a85"/>
              <generalization xmi:id="6b810209-7123-4301-b4cf-2eae7c12e8c0" isSubstitutable="true" general="ee833f56-d6e4-40a7-8139-27f06ad40de0"/>
              <generalization xmi:id="c8c1a402-47cd-462b-b582-bd1865af202e" isSubstitutable="true" general="b38468cc-c261-4f52-86ea-658766759ede"/>
            </packagedElement>
            <packagedElement xmi:type="uml:Interface" xmi:id="ff431f29-2522-4b8a-8665-8405e9476a85" name="RequestProcessingPolicyOperations" isAbstract="true">
              <ownedComment xmi:id="6f6d37cf-e7c1-49cf-95c9-04119d94baf8" body="This policy specifies how requests are processed by&#xA;the created POA.  The default is&#xA;USE_ACTIVE_OBJECT_MAP_ONLY.&#xA;" annotatedElement="ff431f29-2522-4b8a-8665-8405e9476a85"/>
              <generalization xmi:id="c005d36c-2142-4fa3-9ba9-2a3a815626f3" isSubstitutable="true" general="a4b9f0a6-546e-4245-8d6d-26133984a5a5"/>
            </packagedElement>
            <packagedElement xmi:type="uml:Class" xmi:id="a4512410-e19f-4c5f-a289-a0e45bc6fdcd" name="RequestProcessingPolicyValue" clientDependency="4d5d39c1-7130-483d-b527-386a05ff6984">
              <ownedComment xmi:id="31c463d4-56a9-4096-8fa6-cb4c53dc2d35" body="The RequestProcessingPolicyValue can have the following&#xA;values.  USE_ACTIVE_OBJECT_MAP_ONLY - If the Object Id&#xA;is not found in the Active Object Map,&#xA;an OBJECT_NOT_EXIST exception is returned to the&#xA;client. The RETAIN policy is also required.&#xA;USE_DEFAULT_SERVANT - If the Object Id is not found in&#xA;the Active Object Map or the NON_RETAIN policy is&#xA;present, and a default servant has been registered&#xA;with the POA using the set_servant operation,&#xA;the request is dispatched to the default servant.&#xA;USE_SERVANT_MANAGER - If the Object Id is not found&#xA;in the Active Object Map or the NON_RETAIN policy&#xA;is present, and a servant manager has been registered&#xA;with the POA using the set_servant_manager operation,&#xA;the servant manager is given the opportunity to&#xA;locate a servant or raise an exception.&#xA;" annotatedElement="a4512410-e19f-4c5f-a289-a0e45bc6fdcd"/>
              <interfaceRealization xmi:id="4d5d39c1-7130-483d-b527-386a05ff6984" name="" supplier="b38468cc-c261-4f52-86ea-658766759ede" client="a4512410-e19f-4c5f-a289-a0e45bc6fdcd" contract="b38468cc-c261-4f52-86ea-658766759ede"/>
            </packagedElement>
            <packagedElement xmi:type="uml:Class" xmi:id="e1b07f53-d461-4d33-9783-90498129f7a5" name="Servant" isAbstract="true">
              <ownedComment xmi:id="67b4af55-15f8-47b6-bee4-766b27dd591b" body="Defines the native &lt;code>Servant&lt;/code> type. In Java, the&#xA;&lt;code>Servant&lt;/code> type is mapped to the Java&#xA;&lt;code>org.omg.PortableServer.Servant&lt;/code> class.&#xA;It serves as the base class for all POA servant&#xA;implementations and provides a number of methods that may&#xA;be invoked by the application programmer, as well as methods&#xA;which are invoked by the POA itself and may be overridden by&#xA;the user to control aspects of servant behavior.&#xA;Based on IDL to Java spec. (CORBA V2.3.1) ptc/00-01-08.pdf.&#xA;" annotatedElement="e1b07f53-d461-4d33-9783-90498129f7a5"/>
            </packagedElement>
