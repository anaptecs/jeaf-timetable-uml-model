              <ownedComment xmi:id="4dc1e77c-6ca0-4e83-9106-d818788911fe" body="The Holder for &lt;tt>BooleanSeq&lt;/tt>.  For more information on&#xA;Holder files, see &lt;a href=&quot;doc-files/generatedfiles.html#holder&quot;>&#xA;&quot;Generated Files: Holder Files&quot;&lt;/a>.&lt;P>&#xA;org/omg/CORBA/BooleanSeqHolder.java&#xA;Generated by the IDL-to-Java compiler (portable), version &quot;3.0&quot;&#xA;from streams.idl&#xA;13 May 1999 22:41:36 o'clock GMT+00:00&#xA;" annotatedElement="c7da9cd6-f3b8-4679-87ca-67ad0c93bf9c"/>
              <interfaceRealization xmi:id="4b944529-cddf-4e9a-adbe-9e0d8cecbeb3" name="" supplier="95d4163a-b227-4300-a95d-a805a45eb927" client="c7da9cd6-f3b8-4679-87ca-67ad0c93bf9c" contract="95d4163a-b227-4300-a95d-a805a45eb927"/>
            </packagedElement>
            <packagedElement xmi:type="uml:Class" xmi:id="1f702679-5aab-4903-9742-1dcea6c40ee4" name="Bounds">
              <ownedComment xmi:id="0435a3a7-126c-4f86-97c7-5f3a620add3c" body="A user exception thrown when a parameter is not within&#xA;the legal bounds for the object that a method is trying&#xA;to access.&#xA;&#xA;@see &lt;A href=&quot;../../../../technotes/guides/idl/jidlExceptions.html&quot;>documentation on&#xA;Java&amp;nbsp;IDL exceptions&lt;/A>&#xA;" annotatedElement="1f702679-5aab-4903-9742-1dcea6c40ee4"/>
