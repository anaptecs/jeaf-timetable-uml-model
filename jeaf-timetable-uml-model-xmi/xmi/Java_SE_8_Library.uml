                  </packagedElement>
                  <packagedElement xmi:type="uml:Class" xmi:id="8bda2379-0548-4bd7-b9b2-6382d210bd9a" name="IIOPProxyImpl" clientDependency="8ec3a3da-2db8-42cc-b0a3-186dd6d5e08e">
                    <ownedComment xmi:id="2d97f77d-2d35-460a-bb33-5c71e6337fa5" body="An implementation of IIOPProxy that simply delegates to the appropriate&#xA;RMI-IIOP and CORBA APIs.&#xA;" annotatedElement="8bda2379-0548-4bd7-b9b2-6382d210bd9a"/>
                    <interfaceRealization xmi:id="8ec3a3da-2db8-42cc-b0a3-186dd6d5e08e" name="" supplier="63be6a04-168b-42ce-b9b7-2ed524d4205d" client="8bda2379-0548-4bd7-b9b2-6382d210bd9a" contract="63be6a04-168b-42ce-b9b7-2ed524d4205d"/>
