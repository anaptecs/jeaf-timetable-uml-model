                <generalization xmi:id="6c6cb927-6914-4bca-b006-2341090948dd" isSubstitutable="true" general="5edaee5a-9152-45cf-bc8d-3fc0984feb58"/>
                <interfaceRealization xmi:id="a4dded98-ad19-41dd-99a3-fbeb56b8270c" name="" supplier="bb0a33a2-7330-4036-9f32-81cdd2197901" client="e0b63602-ba8f-494d-944c-0a114fa085e1" contract="bb0a33a2-7330-4036-9f32-81cdd2197901"/>
