            <interfaceRealization xmi:id="7cb2e241-0900-435c-bf2a-5439abae5dd0" name="" supplier="169a963b-2432-4be8-9853-68419a3aa0b4" client="8b643c00-8803-4824-a40b-36dcdbd65758" contract="169a963b-2432-4be8-9853-68419a3aa0b4"/>
            <interfaceRealization xmi:id="e8394a8b-caa1-4cf1-ad4b-08351e524c2a" name="" supplier="f6cf9105-45d4-4c02-a1be-dae444075b07" client="8b643c00-8803-4824-a40b-36dcdbd65758" contract="f6cf9105-45d4-4c02-a1be-dae444075b07"/>
