                <nestedClassifier xmi:type="uml:Class" xmi:id="44f2d212-9da3-419e-a0b2-8d60b731859a" name="ListMouseHandler" visibility="protected">
                  <ownedComment xmi:id="2077fc8d-e9ac-49d1-97c9-310fd7da85d9" body="This listener hides the popup when the mouse is released in the list.&#xA;" annotatedElement="44f2d212-9da3-419e-a0b2-8d60b731859a"/>
                  <generalization xmi:id="ebf312aa-74e0-4038-9e87-418bff0210ec" isSubstitutable="true" general="0184255e-aab0-4235-95cf-9ccb6b839c6e"/>
                </nestedClassifier>
                <nestedClassifier xmi:type="uml:Class" xmi:id="d48ffff5-d6d4-4e14-8263-63a9e239f64e" name="ListMouseMotionHandler" visibility="protected">
                  <ownedComment xmi:id="830308f9-51fa-416e-a34a-6a6a6a7e23c2" body="This listener changes the selected item as you move the mouse over the list.&#xA;The selection change is not committed to the model, this is for user feedback only.&#xA;" annotatedElement="d48ffff5-d6d4-4e14-8263-63a9e239f64e"/>
                  <generalization xmi:id="d1362fb5-31ee-4652-8f35-a0573ac4e6f7" isSubstitutable="true" general="4631f424-ccd4-4e75-8a7c-11a3a13a586d"/>
                </nestedClassifier>
                <nestedClassifier xmi:type="uml:Class" xmi:id="d5136ba9-187b-4044-9e1a-2ba1b84a8f9e" name="ItemHandler" visibility="protected" clientDependency="2622a1c2-03c3-4c2f-9db5-7c788fc7c7fe">
                  <ownedComment xmi:id="4725dc4b-91de-46bc-a1ae-4dd9c254255d" body="This listener watches for changes to the selection in the&#xA;combo box.&#xA;" annotatedElement="d5136ba9-187b-4044-9e1a-2ba1b84a8f9e"/>
                  <interfaceRealization xmi:id="2622a1c2-03c3-4c2f-9db5-7c788fc7c7fe" name="" supplier="169a963b-2432-4be8-9853-68419a3aa0b4" client="d5136ba9-187b-4044-9e1a-2ba1b84a8f9e" contract="169a963b-2432-4be8-9853-68419a3aa0b4"/>
