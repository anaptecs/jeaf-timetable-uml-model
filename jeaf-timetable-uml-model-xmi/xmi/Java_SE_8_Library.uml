                        <ownedComment xmi:id="2e7c7dbe-cf65-46b5-8eab-24dc6e8f81f1" body="If the user stops the process, this exception will be thrown.&#xA;" annotatedElement="f4135460-9dbd-4d83-96bd-279f9891fae6"/>
                        <generalization xmi:id="4bba716d-9873-49ec-ba6c-5f96606a768c" isSubstitutable="true" general="c2be1008-4fc6-4a94-9ff7-fd4e5cca5f78"/>
                      </nestedClassifier>
                    </packagedElement>
