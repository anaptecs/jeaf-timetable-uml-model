              </nestedClassifier>
              <nestedClassifier xmi:type="uml:Class" xmi:id="14f2ec6f-4e89-4b15-b76c-068ccec06dc8" name="AccessibleAWTFocusHandler" visibility="protected" clientDependency="69469382-db77-4793-a6fd-53199c1fe998">
