          <packagedElement xmi:type="uml:Class" xmi:id="af1c08b6-a350-4030-a436-229730e8596a" name="AncestorNotifier" visibility="package" clientDependency="af50cc1a-88d5-4b26-9041-5fae7f105dc8 b510bfaf-aa30-41a7-a4f7-060dfae694cd a8fb6b66-4000-472a-8cd3-acf7edf376eb">
            <ownedComment xmi:id="34252cc4-c8a5-4ff1-9759-2abc8001a57d" body="@author Dave Moore&#xA;" annotatedElement="af1c08b6-a350-4030-a436-229730e8596a"/>
