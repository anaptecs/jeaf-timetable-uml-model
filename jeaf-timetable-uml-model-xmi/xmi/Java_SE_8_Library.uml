                        <nestedClassifier xmi:type="uml:Class" xmi:id="6a10c200-e749-413d-9952-d638d332686d" name="CachedDocument"/>
                      </packagedElement>
                      <packagedElement xmi:type="uml:Class" xmi:id="ae1cde42-ecae-4bd3-9681-493bf4d0626c" name="DOMAdapter" clientDependency="df3b09e5-49f9-4d35-9c0c-9aee30fbfd71">
                        <ownedComment xmi:id="a1b605b5-4784-4acc-a33c-567d54e07cb6" body="@author Jacek Ambroziak&#xA;@author Morten Jorgensen&#xA;" annotatedElement="ae1cde42-ecae-4bd3-9681-493bf4d0626c"/>
