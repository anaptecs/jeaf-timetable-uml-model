            <packagedElement xmi:type="uml:Interface" xmi:id="f7cf9215-3349-4b3c-8534-0710939ceac2" name="DynStruct" isAbstract="true">
              <ownedComment xmi:id="b56145c9-c76d-4405-a5ed-3b70640c096e" body="The representation of a &lt;code>DynAny&lt;/code> object that is associated&#xA;with an IDL struct.&#xA;@deprecated Use the new &lt;a href=&quot;../DynamicAny/DynStruct.html&quot;>DynStruct&lt;/a> instead&#xA;" annotatedElement="f7cf9215-3349-4b3c-8534-0710939ceac2"/>
