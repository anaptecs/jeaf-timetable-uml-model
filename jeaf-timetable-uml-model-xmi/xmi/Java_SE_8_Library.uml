            </templateBinding>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="68ecc6fe-5bb7-4573-979e-d75e0339f798" name="WeakHashMap&lt;AWTEventListener, SelectiveAWTEventListener>">
            <templateBinding xmi:id="1a038111-f6cd-4a40-8f7b-03e2f105a0ae" signature="653ebda2-6aa0-4213-951f-5676913d2adf">
