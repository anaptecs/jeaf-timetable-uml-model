                      <generalization xmi:id="79107d8a-fd97-46d8-971b-26a4517eac98" isSubstitutable="true" general="3ece70ca-530f-40d1-afda-0b72ee109b21"/>
                    </packagedElement>
                    <packagedElement xmi:type="uml:Class" xmi:id="d58e6642-a84f-4ca4-bf9a-f64803b5e3af" name="SAXLocatorWrapper" clientDependency="dfa7ea98-17d3-4470-a419-6f540e38822e">
                      <ownedComment xmi:id="e2005fa3-0198-4ade-ba3b-2b224eeb9057" body="&lt;p>A light wrapper around a SAX locator. This is useful&#xA;when bridging between SAX and XNI components.&lt;/p>&#xA;&#xA;@author Michael Glavassevich, IBM&#xA;&#xA;" annotatedElement="d58e6642-a84f-4ca4-bf9a-f64803b5e3af"/>
