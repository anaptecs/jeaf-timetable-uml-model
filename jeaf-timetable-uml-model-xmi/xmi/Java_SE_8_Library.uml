                      </packagedElement>
                      <packagedElement xmi:type="uml:Interface" xmi:id="ef489a93-1726-4d31-a08b-61157cf2f003" name="DOMBuilder" isAbstract="true">
                        <ownedComment xmi:id="9c486d1a-2276-469f-849a-371c3c0d4098" body="@author Morten Jorgensen&#xA;" annotatedElement="ef489a93-1726-4d31-a08b-61157cf2f003"/>
                        <generalization xmi:id="35ebb33a-a2f3-42d6-bc4d-1857322a62d6" isSubstitutable="true" general="350bf9c4-9bc1-4749-9902-f5945d909941"/>
                      </packagedElement>
                      <packagedElement xmi:type="uml:Class" xmi:id="3b49a488-823d-4c7d-84bd-44e88137a902" name="DOMWSFilter" clientDependency="66eae063-2607-4628-8f35-b448aaa00aee">
                        <ownedComment xmi:id="87370d40-cef0-4481-9405-786276b99fd0" body="A wrapper class that adapts the&#xA;{@link com.sun.org.apache.xml.internal.dtm.DTMWSFilter DTMWSFilter} interface to the XSLTC&#xA;DOM {@link com.sun.org.apache.xalan.internal.xsltc.StripFilter StripFilter} interface.&#xA;" annotatedElement="3b49a488-823d-4c7d-84bd-44e88137a902"/>
                        <interfaceRealization xmi:id="66eae063-2607-4628-8f35-b448aaa00aee" name="" supplier="907e520e-2fd7-40e1-b7e4-9bf9aeafebd7" client="3b49a488-823d-4c7d-84bd-44e88137a902" contract="907e520e-2fd7-40e1-b7e4-9bf9aeafebd7"/>
                      </packagedElement>
                      <packagedElement xmi:type="uml:Class" xmi:id="9e0b69a2-df8f-42a8-9c7f-42f2d7cd85ee" name="DupFilterIterator">
                        <ownedComment xmi:id="b210ad46-0a23-4ec2-a93b-0c0d4f737aa7" body="Removes duplicates and sorts a source iterator. The nodes from the&#xA;source are collected in an array upon calling setStartNode(). This&#xA;array is later sorted and duplicates are ignored in next().&#xA;@author G. Todd Miller&#xA;" annotatedElement="9e0b69a2-df8f-42a8-9c7f-42f2d7cd85ee"/>
                        <generalization xmi:id="a4501555-11b9-439c-bc9f-6f927a0e40aa" isSubstitutable="true" general="59ccc38a-d7f7-42b4-ab67-fed330dbe0f9"/>
                      </packagedElement>
                      <packagedElement xmi:type="uml:Class" xmi:id="857b0802-9f71-4e0d-8103-c392c2204fbe" name="EmptyFilter" clientDependency="bc6c44ba-0a75-4714-a54b-5af24994e3c5">
                        <ownedComment xmi:id="08d4450f-9a22-44e3-9cb2-e821505a487c" body="@author Jacek Ambroziak&#xA;@author Santiago Pericas-Geertsen&#xA;" annotatedElement="857b0802-9f71-4e0d-8103-c392c2204fbe"/>
                        <interfaceRealization xmi:id="bc6c44ba-0a75-4714-a54b-5af24994e3c5" name="" supplier="b54d873c-0f6b-40bd-ac75-d98b3f95035e" client="857b0802-9f71-4e0d-8103-c392c2204fbe" contract="b54d873c-0f6b-40bd-ac75-d98b3f95035e"/>
                      </packagedElement>
                      <packagedElement xmi:type="uml:Interface" xmi:id="350bf9c4-9bc1-4749-9902-f5945d909941" name="ExtendedSAX" isAbstract="true">
                        <ownedComment xmi:id="7411cf5d-0af6-47a7-906c-e08a5e2c2764" body="@author Morten Jorgensen&#xA;" annotatedElement="350bf9c4-9bc1-4749-9902-f5945d909941"/>
                        <generalization xmi:id="2515e3b6-0a08-4390-87e6-d5547d9a4e8e" isSubstitutable="true" general="c1ba9edb-3b3b-4e75-a057-ba7df9208c25"/>
                        <generalization xmi:id="7d708775-e913-44ff-9301-e23b0722c301" isSubstitutable="true" general="4ced7e8f-069f-4000-b177-b7124a2c522c"/>
                        <generalization xmi:id="e1776f06-df8a-4065-a246-422fbab22cf8" isSubstitutable="true" general="4035121a-78e9-4e11-bd96-66685990e1a3"/>
                        <generalization xmi:id="a0415dbc-ac8e-4dc0-84d4-54d5ecf3ad6f" isSubstitutable="true" general="4259219a-95e0-485a-9579-c3ae71836ac0"/>
                      </packagedElement>
                      <packagedElement xmi:type="uml:Interface" xmi:id="b54d873c-0f6b-40bd-ac75-d98b3f95035e" name="Filter" isAbstract="true">
                        <ownedComment xmi:id="7ec34682-b447-462b-8dce-ce77e26b6fc6" body="@author Jacek Ambroziak&#xA;@author Santiago Pericas-Geertsen&#xA;" annotatedElement="b54d873c-0f6b-40bd-ac75-d98b3f95035e"/>
                      </packagedElement>
                      <packagedElement xmi:type="uml:Class" xmi:id="d70a7dfa-4951-4f55-8d20-d59f99f704d1" name="FilteredStepIterator">
                        <ownedComment xmi:id="a574e940-d925-4891-bc1f-6b5623798153" body="Extends a StepIterator by adding the ability to filter nodes. It&#xA;uses filters similar to those of a FilterIterator.&#xA;@author Jacek Ambroziak&#xA;@author Santiago Pericas-Geertsen&#xA;@author Morten Jorgensen&#xA;" annotatedElement="d70a7dfa-4951-4f55-8d20-d59f99f704d1"/>
                        <generalization xmi:id="4328f48d-2e70-4f28-bdbe-50d7aab76875" isSubstitutable="true" general="955af52e-f3ce-4c87-9b3b-46bd91ae59b9"/>
                      </packagedElement>
                      <packagedElement xmi:type="uml:Class" xmi:id="10a8c79c-b8cd-45d3-85ea-4e115aab6a00" name="FilterIterator">
                        <ownedComment xmi:id="5b8cd1fb-5fc1-4da6-b8ce-70dc4c50cf0b" body="Similar to a CurrentNodeListIterator except that the filter has a&#xA;simpler interface (only needs the node, no position, last, etc.)&#xA;It takes a source iterator and a Filter object and returns nodes&#xA;from the source after filtering them by calling filter.test(node).&#xA;@author Jacek Ambroziak&#xA;@author Santiago Pericas-Geertsen&#xA;" annotatedElement="10a8c79c-b8cd-45d3-85ea-4e115aab6a00"/>
                        <generalization xmi:id="651d457c-ddcf-44c0-a347-1ff4a53adcef" isSubstitutable="true" general="59ccc38a-d7f7-42b4-ab67-fed330dbe0f9"/>
                      </packagedElement>
                      <packagedElement xmi:type="uml:Class" xmi:id="ed92ddfc-8eaf-4e29-abf7-ef0aa559d72c" name="ForwardPositionIterator">
                        <ownedComment xmi:id="20f58092-79fb-457c-bc0f-2e1c83ae5927" body="This iterator is a wrapper that always returns the position of&#xA;a node in document order. It is needed for the case where&#xA;a call to position() occurs in the context of an XSLT element&#xA;such as xsl:for-each, xsl:apply-templates, etc.&#xA;&#xA;The getPosition() methods in DTMAxisIterators defined&#xA;in DTMDefaultBaseIterators always return the position&#xA;in document order, which is backwards for XPath in the&#xA;case of the ancestor, ancestor-or-self, previous and&#xA;previous-sibling.&#xA;&#xA;XSLTC implements position() with the&#xA;BasisLibrary.positionF() method, and uses the&#xA;DTMAxisIterator.isReverse() method to determine&#xA;whether the result of getPosition() should be&#xA;interpreted as being equal to position().&#xA;But when the expression appears in apply-templates of&#xA;for-each, the position() function operates in document&#xA;order.&#xA;&#xA;The only effect of the ForwardPositionIterator is to force&#xA;the result of isReverse() to false, so that&#xA;BasisLibrary.positionF() calculates position() in a way&#xA;that's consistent with the context in which the&#xA;iterator is being used.&quot;&#xA;&#xA;(Apparently the correction of isReverse() occurs&#xA;implicitly, by inheritance. This class also appears&#xA;to maintain its own position counter, which seems&#xA;redundant.)&#xA;&#xA;@deprecated This class exists only for backwards compatibility with old&#xA;translets.  New code should not reference it.&#xA;" annotatedElement="ed92ddfc-8eaf-4e29-abf7-ef0aa559d72c"/>
                        <generalization xmi:id="db397d0c-6e8e-4d1a-aaa5-5cdcab331aec" isSubstitutable="true" general="59ccc38a-d7f7-42b4-ab67-fed330dbe0f9"/>
                      </packagedElement>
                      <packagedElement xmi:type="uml:Class" xmi:id="ccdea01f-90ab-4e10-af70-a968bf3acad4" name="KeyIndex">
                        <ownedComment xmi:id="38da9ffd-5c9d-49fd-bdc8-b64d57f031d0" body="Stores mappings of key values or IDs to DTM nodes.&#xA;&lt;em>Use of an instance of this class as a {@link DTMAxisIterator} is&#xA;&lt;b>deprecated.&lt;/b>&lt;/em>&#xA;@author Morten Jorgensen&#xA;@author Santiago Pericas-Geertsen&#xA;" annotatedElement="ccdea01f-90ab-4e10-af70-a968bf3acad4"/>
                        <generalization xmi:id="ebf24d6e-0461-4cb8-a7a9-4d349f85392a" isSubstitutable="true" general="59ccc38a-d7f7-42b4-ab67-fed330dbe0f9"/>
                        <nestedClassifier xmi:type="uml:Class" xmi:id="4d751d74-2e5f-4f8c-b388-b5acbb8ab417" name="KeyIndexIterator">
                          <ownedComment xmi:id="77d3d9f8-fe98-40e8-b530-6aee9d07746c" body="An iterator representing the result of a reference to either the&#xA;XSLT &lt;code>key&lt;/code> function or the XPath &lt;code>id&lt;/code> function.&#xA;" annotatedElement="4d751d74-2e5f-4f8c-b388-b5acbb8ab417"/>
                          <generalization xmi:id="64238261-1499-44b7-b39c-3aec74d1ce0a" isSubstitutable="true" general="ba080260-e705-41ac-8246-0e6bd37fcf26"/>
                          <nestedClassifier xmi:type="uml:Class" xmi:id="a594fbbf-abdc-4918-9c1a-b6b41e0ead4f" name="KeyIndexHeapNode" visibility="protected">
                            <ownedComment xmi:id="3a524e41-70a6-4381-9028-f08dd1ad8765" body="Represents the DTM nodes retrieved for one key value or one string&#xA;argument to &lt;code>id&lt;/code> for use as one heap node in a&#xA;{@link MultiValuedNodeHeapIterator}.&#xA;" annotatedElement="a594fbbf-abdc-4918-9c1a-b6b41e0ead4f"/>
                            <generalization xmi:id="f6f8a87c-7d90-4a8f-a33e-f3295b4f3cbe" isSubstitutable="true" general="1d85e690-8aae-4435-865f-5c8b6caa429f"/>
                          </nestedClassifier>
                        </nestedClassifier>
                      </packagedElement>
                      <packagedElement xmi:type="uml:Class" xmi:id="e6f7b3c5-27ad-4275-bb2e-578f242f3475" name="LoadDocument">
                        <ownedComment xmi:id="d1a7f08a-be18-4c68-a651-20ee71a2a155" body="@author Morten Jorgensen&#xA;" annotatedElement="e6f7b3c5-27ad-4275-bb2e-578f242f3475"/>
                      </packagedElement>
                      <packagedElement xmi:type="uml:Class" xmi:id="d072c4ae-ac16-4d30-ada9-405c8093c0a7" name="MatchingIterator">
                        <ownedComment xmi:id="592e62a8-a9dc-4167-939c-976168f54a61" body="This is a special kind of iterator that takes a source iterator and a&#xA;node N. If initialized with a node M (the parent of N) it computes the&#xA;position of N amongst the children of M. This position can be obtained&#xA;by calling getPosition().&#xA;It is an iterator even though next() will never be called. It is used to&#xA;match patterns with a single predicate like:&#xA;&#xA;BOOK[position() = last()]&#xA;&#xA;In this example, the source iterator will return elements of type BOOK,&#xA;a call to position() will return the position of N. Notice that because&#xA;of the way the pattern matching is implemented, N will always be a node&#xA;in the source since (i) it is a BOOK or the test sequence would not be&#xA;considered and (ii) the source iterator is initialized with M which is&#xA;the parent of N. Also, and still in this example, a call to last() will&#xA;return the number of elements in the source (i.e. the number of BOOKs).&#xA;@author Jacek Ambroziak&#xA;@author Santiago Pericas-Geertsen&#xA;" annotatedElement="d072c4ae-ac16-4d30-ada9-405c8093c0a7"/>
                        <generalization xmi:id="49f3d54d-cf68-4185-9207-0c96cd17f4bf" isSubstitutable="true" general="59ccc38a-d7f7-42b4-ab67-fed330dbe0f9"/>
                      </packagedElement>
