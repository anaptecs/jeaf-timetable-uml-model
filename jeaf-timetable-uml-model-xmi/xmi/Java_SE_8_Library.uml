                <nestedClassifier xmi:type="uml:Class" xmi:id="ce8dc976-de25-4b31-b784-36807408ab75" name="TreeHomeAction">
                  <ownedComment xmi:id="b150a61b-3d7f-42f1-8ddb-0be3c64818d7" body="TreeHomeAction is used to handle end/home actions.&#xA;Scrolls either the first or last cell to be visible based on&#xA;direction.&#xA;" annotatedElement="ce8dc976-de25-4b31-b784-36807408ab75"/>
                  <generalization xmi:id="1dd4253c-84be-4765-a3de-640c0899585c" isSubstitutable="true" general="37db1b87-b22d-45bf-b084-60ec1e3df251"/>
