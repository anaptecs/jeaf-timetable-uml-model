                      <interfaceRealization xmi:id="a5622ccf-955f-46ac-99f2-4ae5b8cada37" name="" supplier="72b2deb9-6b9b-48ed-abb9-756a9483a7c2" client="d2748738-8842-4b94-894d-5fdcdbe585ec" contract="72b2deb9-6b9b-48ed-abb9-756a9483a7c2"/>
                    </packagedElement>
                    <packagedElement xmi:type="uml:Class" xmi:id="890c55a4-53e9-4b57-9726-ca804eb950f8" name="INVOKEINTERFACE">
                      <ownedComment xmi:id="55b3a636-29b8-4ce3-a6c7-aa4b59f8f961" body="INVOKEINTERFACE - Invoke interface method&#xA;&lt;PRE>Stack: ..., objectref, [arg1, [arg2 ...]] -&amp;gt; ...&lt;/PRE>&#xA;&#xA;@author  &lt;A HREF=&quot;mailto:markus.dahm@berlin.de&quot;>M. Dahm&lt;/A>&#xA;" annotatedElement="890c55a4-53e9-4b57-9726-ca804eb950f8"/>
