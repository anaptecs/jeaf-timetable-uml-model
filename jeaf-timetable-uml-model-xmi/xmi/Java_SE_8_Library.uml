                  <interfaceRealization xmi:id="b759bd9f-717c-4b21-9652-fccf73c6f67b" name="" supplier="93a66f3d-d261-4a7c-89c3-b032b4651759" client="f71c6c5e-4d12-4462-8703-8525e6736083" contract="93a66f3d-d261-4a7c-89c3-b032b4651759"/>
                  <interfaceRealization xmi:id="986e6d7b-9acc-48c6-be12-da2d67a9eaa4" name="" supplier="3bd993c9-d922-4c36-9102-f37ea6b42d56" client="f71c6c5e-4d12-4462-8703-8525e6736083" contract="3bd993c9-d922-4c36-9102-f37ea6b42d56"/>
                  <interfaceRealization xmi:id="b7f67e98-c1da-410b-b42e-d5bb1b1cb83f" name="" supplier="32231950-fea0-4f8f-b912-c868ac74f6f0" client="f71c6c5e-4d12-4462-8703-8525e6736083" contract="32231950-fea0-4f8f-b912-c868ac74f6f0"/>
                  <interfaceRealization xmi:id="e952b0a3-9507-46c6-be10-5cc32a0750d4" name="" supplier="a555795b-0df9-4e62-935b-190926cba9b5" client="f71c6c5e-4d12-4462-8703-8525e6736083" contract="a555795b-0df9-4e62-935b-190926cba9b5"/>
                </nestedClassifier>
                <nestedClassifier xmi:type="uml:Class" xmi:id="f9c5b1a3-8d35-4cbe-9053-7ea84a90e632" name="MenuKeyboardHelper" visibility="package" clientDependency="d4cdce60-89ac-4b4d-a48c-66cab570fd4b 3de5bceb-e5e7-4475-b147-bee994d5f663">
                  <ownedComment xmi:id="0f24224d-94b8-467e-9fc2-3f9575cb4a95" body="This helper is added to MenuSelectionManager as a ChangeListener to&#xA;listen to menu selection changes. When a menu is activated, it passes&#xA;focus to its parent JRootPane, and installs an ActionMap/InputMap pair&#xA;on that JRootPane. Those maps are necessary in order for menu&#xA;navigation to work. When menu is being deactivated, it restores focus&#xA;to the component that has had it before menu activation, and uninstalls&#xA;the maps.&#xA;This helper is also installed as a KeyListener on root pane when menu&#xA;is active. It forwards key events to MenuSelectionManager for mnemonic&#xA;keys handling.&#xA;" annotatedElement="f9c5b1a3-8d35-4cbe-9053-7ea84a90e632"/>
                  <interfaceRealization xmi:id="d4cdce60-89ac-4b4d-a48c-66cab570fd4b" name="" supplier="93a66f3d-d261-4a7c-89c3-b032b4651759" client="f9c5b1a3-8d35-4cbe-9053-7ea84a90e632" contract="93a66f3d-d261-4a7c-89c3-b032b4651759"/>
                  <interfaceRealization xmi:id="3de5bceb-e5e7-4475-b147-bee994d5f663" name="" supplier="8ea0cda4-78b6-4093-963f-086e8384408a" client="f9c5b1a3-8d35-4cbe-9053-7ea84a90e632" contract="8ea0cda4-78b6-4093-963f-086e8384408a"/>
                </nestedClassifier>
