            <packagedElement xmi:type="uml:Class" xmi:id="04b8e2de-5ea5-407c-91e0-7508afc89d7e" name="Vector&lt;>">
              <templateBinding xmi:id="00641527-915a-4244-86f1-d3c19a5a5a1d" signature="f1a14f96-df41-4636-b28a-9d52a0c301fe">
