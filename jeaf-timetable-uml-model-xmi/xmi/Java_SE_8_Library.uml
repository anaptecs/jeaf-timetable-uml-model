            </packagedElement>
            <packagedElement xmi:type="uml:Class" xmi:id="70e96ff3-643c-4573-95f7-a537a4e7423f" name="Reference&lt;T>">
              <templateBinding xmi:id="236b6ab7-377b-45b0-98da-69991a42d606" signature="4db6b828-9cb4-4284-965a-067f160f3dd6">
                <parameterSubstitution xmi:id="f65d34d9-c3da-4f4c-94bb-849d3b965c31" formal="877e2e71-6bad-40b7-8a08-5d21f8975ed9" actual="eef1aa73-036f-4a23-8d3e-c3d4681b5f08"/>
