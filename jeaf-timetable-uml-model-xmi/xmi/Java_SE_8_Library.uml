                    </packagedElement>
                    <packagedElement xmi:type="uml:Class" xmi:id="4ad0268e-8bd0-4494-82d9-9ec9342c2d9e" name="ConstantString" clientDependency="1b41add5-b755-48a5-80dc-a493b3c5bd95">
