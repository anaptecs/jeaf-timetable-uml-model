              <nestedClassifier xmi:type="uml:Class" xmi:id="e5382e99-8ccd-4f50-836b-c3623cc48931" name="AsyncRun" visibility="package" clientDependency="1025f46c-43b0-4fbf-ab88-0b8a84cfc3c9 6b19dbf9-0b8b-4c86-8621-333f7164c6a4">
                <generalization xmi:id="2d03067e-e18e-4f8f-9e8c-953da153f82e" isSubstitutable="true" general="5edaee5a-9152-45cf-bc8d-3fc0984feb58"/>
