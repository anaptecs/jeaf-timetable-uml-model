            <packagedElement xmi:type="uml:Interface" xmi:id="9728e8f9-fc17-4a36-ab8e-39cc41e07cf3" name="Transferable" isAbstract="true">
              <ownedComment xmi:id="e3aecd67-9e29-4e3e-81ec-859bfaf4932d" body="Defines the interface for classes that can be used to provide data&#xA;for a transfer operation.&#xA;&lt;p>&#xA;For information on using data transfer with Swing, see&#xA;&lt;a href=&quot;https://docs.oracle.com/javase/tutorial/uiswing/dnd/index.html&quot;>&#xA;How to Use Drag and Drop and Data Transfer&lt;/a>,&#xA;a section in &lt;em>The Java Tutorial&lt;/em>, for more information.&#xA;&#xA;@author      Amy Fowler&#xA;" annotatedElement="9728e8f9-fc17-4a36-ab8e-39cc41e07cf3"/>
            </packagedElement>
