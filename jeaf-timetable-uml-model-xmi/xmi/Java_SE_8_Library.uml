              <nestedClassifier xmi:type="uml:Class" xmi:id="b37fbb49-0c9a-473c-9aaf-4ae2838a440b" name="Type"/>
            </nestedClassifier>
          </packagedElement>
          <packagedElement xmi:type="uml:Interface" xmi:id="831bd01d-0d1e-49d8-b5a6-fd83e06db0c9" name="MutableComboBoxModel" isAbstract="true">
            <ownedComment xmi:id="7d2e9804-3b9a-4160-b657-d3ac81d6ee95" body="A mutable version of &lt;code>ComboBoxModel&lt;/code>.&#xA;&#xA;@param &lt;E> the type of the elements of this model&#xA;&#xA;@author Tom Santos&#xA;" annotatedElement="831bd01d-0d1e-49d8-b5a6-fd83e06db0c9"/>
            <ownedTemplateSignature xmi:type="uml:RedefinableTemplateSignature" xmi:id="50ae9302-3f61-42f7-8836-1b65e6ad1cea" name="" visibility="public" parameter="7c865b93-9746-42eb-8402-828dee7e9f2d">
              <ownedParameter xmi:type="uml:ClassifierTemplateParameter" xmi:id="7c865b93-9746-42eb-8402-828dee7e9f2d" parameteredElement="4bf43d08-3de0-4f03-b219-6ab884f6e6ed">
