                  <packagedElement xmi:type="uml:Class" xmi:id="be30074b-f1b9-4e0a-8e5d-f4964f996adc" name="ProcessMonitorThread">
                    <ownedComment xmi:id="c953d43c-85cf-4348-9504-2f207f8bc096" body="ProcessMonitorThread is started when ServerManager is instantiated. The&#xA;thread wakes up every minute (This can be changed by setting sleepTime) and&#xA;makes sure that all the processes (Servers) registered with the ServerTool&#xA;are healthy. If not the state in ServerTableEntry will be changed to&#xA;De-Activated.&#xA;Note: This thread can be killed from the main thread by calling&#xA;interrupThread()&#xA;" annotatedElement="be30074b-f1b9-4e0a-8e5d-f4964f996adc"/>
                    <generalization xmi:id="125af1f1-fc7e-44c5-962c-df83ef8d29dd" isSubstitutable="true" general="d63a61bd-3268-4361-8c7b-40c49af0dbf1"/>
