            </nestedClassifier>
            <nestedClassifier xmi:type="uml:Class" xmi:id="cb17172f-3dd0-4a8e-8731-982a5455e26a" name="DragHandler" visibility="private" clientDependency="d43b7993-8e41-4266-90c0-fc35daf86967 9b9ed294-bdcc-4515-85f0-e6929616fbc2">
              <ownedComment xmi:id="64e09a0b-b8b7-436f-bf9c-db569f83f5eb" body="This is the default drag handler for drag and drop operations that&#xA;use the &lt;code>TransferHandler&lt;/code>.&#xA;" annotatedElement="cb17172f-3dd0-4a8e-8731-982a5455e26a"/>
              <interfaceRealization xmi:id="9b9ed294-bdcc-4515-85f0-e6929616fbc2" name="" supplier="283b7c69-3ab9-42c8-9aea-d8ad9eb1f36c" client="cb17172f-3dd0-4a8e-8731-982a5455e26a" contract="283b7c69-3ab9-42c8-9aea-d8ad9eb1f36c"/>
