                        <ownedComment xmi:id="7e3e1ceb-ae0d-4626-a737-ecbce54c5efc" body="@author Jacek Ambroziak&#xA;@author Morten Jorgensen&#xA;" annotatedElement="eefe26b2-c2aa-486c-b1da-cde88cc19737"/>
                        <generalization xmi:id="59acf115-066e-407e-ab96-bd33a3b64826" isSubstitutable="true" general="59ccc38a-d7f7-42b4-ab67-fed330dbe0f9"/>
                      </packagedElement>
                      <packagedElement xmi:type="uml:Class" xmi:id="ecfad7c0-ea66-429a-bce2-5cc8d4cdb6bb" name="SAXImpl" clientDependency="b2837a27-0a30-451c-8710-74481ba3ce4a a91f6948-c03f-4d71-a969-5241d3a50c94">
                        <ownedComment xmi:id="7641d421-2324-44ae-bad2-4fcea3fec34d" body="SAXImpl is the core model for SAX input source. SAXImpl objects are&#xA;usually created from an XSLTCDTMManager.&#xA;&#xA;&lt;p>DOMSource inputs are handled using DOM2SAX + SAXImpl. SAXImpl has a&#xA;few specific fields (e.g. _node2Ids, _document) to keep DOM-related&#xA;information. They are used when the processing behavior between DOM and&#xA;SAX has to be different. Examples of these include id function and&#xA;unparsed entity.&#xA;&#xA;&lt;p>SAXImpl extends SAX2DTM2 instead of SAX2DTM for better performance.&#xA;@author Jacek Ambroziak&#xA;@author Santiago Pericas-Geertsen&#xA;@author Morten Jorgensen&#xA;@author Douglas Sellers &lt;douglasjsellers@hotmail.com>&#xA;" annotatedElement="ecfad7c0-ea66-429a-bce2-5cc8d4cdb6bb"/>
                        <generalization xmi:id="5bb4b2f5-d587-4b73-a595-aa1c1aed9bfa" isSubstitutable="true" general="eec353fa-9d80-48ac-8e09-ac8dd4a342d2"/>
                        <interfaceRealization xmi:id="b2837a27-0a30-451c-8710-74481ba3ce4a" name="" supplier="d084253c-7170-4d41-a9fe-d727206cc57f" client="ecfad7c0-ea66-429a-bce2-5cc8d4cdb6bb" contract="d084253c-7170-4d41-a9fe-d727206cc57f"/>
                        <interfaceRealization xmi:id="a91f6948-c03f-4d71-a969-5241d3a50c94" name="" supplier="ef489a93-1726-4d31-a08b-61157cf2f003" client="ecfad7c0-ea66-429a-bce2-5cc8d4cdb6bb" contract="ef489a93-1726-4d31-a08b-61157cf2f003"/>
                        <nestedClassifier xmi:type="uml:Class" xmi:id="8358d50a-dd64-45e5-8760-d92bc1bfbd87" name="TypedNamespaceIterator">
                          <ownedComment xmi:id="9cebee03-42fe-4e1a-8452-b77bbfb3d767" body="Iterator that returns the namespace nodes as defined by the XPath data&#xA;model for a given node, filtered by extended type ID.&#xA;" annotatedElement="8358d50a-dd64-45e5-8760-d92bc1bfbd87"/>
                        </nestedClassifier>
                        <nestedClassifier xmi:type="uml:Class" xmi:id="9a77a8ab-f8ea-4600-938a-153491945f84" name="NodeValueIterator" visibility="private">
                          <ownedComment xmi:id="d6067498-f4ab-48a0-aaa5-97ed4aca7f1a" body="This is a specialised iterator for predicates comparing node or&#xA;attribute values to variable or parameter values.&#xA;" annotatedElement="9a77a8ab-f8ea-4600-938a-153491945f84"/>
                        </nestedClassifier>
                        <nestedClassifier xmi:type="uml:Class" xmi:id="efd36551-f3a2-4c59-8aa8-10cd9e097fce" name="NamespaceWildcardIterator">
                          <ownedComment xmi:id="87735b7a-928a-4b24-a876-a6f0b7ae52e1" body="Iterator that handles node tests that test for a namespace, but have&#xA;a wild card for the local name of the node, i.e., node tests of the&#xA;form &lt;axis>::&lt;prefix>:&#xA;" annotatedElement="efd36551-f3a2-4c59-8aa8-10cd9e097fce"/>
                        </nestedClassifier>
                        <nestedClassifier xmi:type="uml:Class" xmi:id="669be03d-ab29-48a4-8f87-eabddcf1b26b" name="NamespaceChildrenIterator">
                          <ownedComment xmi:id="4f2480b6-f8c5-4fe6-b0cc-9bbaa000f5d8" body="Iterator that returns children within a given namespace for a&#xA;given node. The functionality chould be achieved by putting a&#xA;filter on top of a basic child iterator, but a specialised&#xA;iterator is used for efficiency (both speed and size of translet).&#xA;" annotatedElement="669be03d-ab29-48a4-8f87-eabddcf1b26b"/>
                        </nestedClassifier>
                        <nestedClassifier xmi:type="uml:Class" xmi:id="848fc1b1-e3a7-4f1e-b0f8-a695b637abc0" name="NamespaceAttributeIterator">
                          <ownedComment xmi:id="6d050905-10c1-4267-90c1-d37b65aa3a77" body="Iterator that returns attributes within a given namespace for a node.&#xA;" annotatedElement="848fc1b1-e3a7-4f1e-b0f8-a695b637abc0"/>
                        </nestedClassifier>
                      </packagedElement>
                      <packagedElement xmi:type="uml:Class" xmi:id="54df1fa5-79a0-47c0-b4d9-626e5078996e" name="SimpleResultTreeImpl" clientDependency="edf8640f-f93d-4ffd-9a7d-0d6d81fbbe69 ffc04ccb-cfc6-4856-9bb0-904280850e70">
                        <ownedComment xmi:id="a9152e97-baed-408d-b077-4e1d869b762a" body="This class represents a light-weight DOM model for simple result tree fragment(RTF).&#xA;A simple RTF is an RTF that has only one Text node. The Text node can be produced by a&#xA;combination of Text, xsl:value-of and xsl:number instructions. It can also be produced&#xA;by a control structure (xsl:if or xsl:choose) whose body is pure Text.&#xA;&lt;p>&#xA;A SimpleResultTreeImpl has only two nodes, i.e. the ROOT node and its Text child. All DOM&#xA;interfaces are overridden with this in mind. For example, the getStringValue() interface&#xA;returns the value of the Text node. This class receives the character data from the&#xA;characters() interface.&#xA;&lt;p>&#xA;This class implements DOM and SerializationHandler. It also implements the DTM interface&#xA;for support in MultiDOM. The nested iterators (SimpleIterator and SingletonIterator) are&#xA;used to support the nodeset() extension function.&#xA;" annotatedElement="54df1fa5-79a0-47c0-b4d9-626e5078996e"/>
                        <generalization xmi:id="36df1c44-1a07-49e2-a1fe-01e74eb8c9b6" isSubstitutable="true" general="b3d59f07-fd62-48f7-b2f6-0f0cfb669b72"/>
                        <interfaceRealization xmi:id="edf8640f-f93d-4ffd-9a7d-0d6d81fbbe69" name="" supplier="48701943-3385-4c82-bc9f-eb255958d4d2" client="54df1fa5-79a0-47c0-b4d9-626e5078996e" contract="48701943-3385-4c82-bc9f-eb255958d4d2"/>
                        <interfaceRealization xmi:id="ffc04ccb-cfc6-4856-9bb0-904280850e70" name="" supplier="c7d7311d-0067-4490-8e4f-336672c94b2c" client="54df1fa5-79a0-47c0-b4d9-626e5078996e" contract="c7d7311d-0067-4490-8e4f-336672c94b2c"/>
                        <nestedClassifier xmi:type="uml:Class" xmi:id="f172a516-b1f7-4840-a8dd-661e764446fc" name="SimpleIterator">
                          <ownedComment xmi:id="b7663b23-4056-475d-8205-4f9aef26e641" body="The SimpleIterator is designed to support the nodeset() extension function. It has&#xA;a traversal direction parameter. The DOWN direction is used for child and descendant&#xA;axes, while the UP direction is used for parent and ancestor axes.&#xA;&#xA;This iterator only handles two nodes (RTF_ROOT and RTF_TEXT). If the type is set,&#xA;it will also match the node type with the given type.&#xA;" annotatedElement="f172a516-b1f7-4840-a8dd-661e764446fc"/>
                          <generalization xmi:id="61b88580-ab34-48c1-a5ba-9d03d41c1bfc" isSubstitutable="true" general="59ccc38a-d7f7-42b4-ab67-fed330dbe0f9"/>
                        </nestedClassifier>
                        <nestedClassifier xmi:type="uml:Class" xmi:id="722705e7-7000-4466-8553-be789f54cf0c" name="SingletonIterator">
                          <ownedComment xmi:id="863643d0-483c-44f1-8f61-452ab2b722cc" body="The SingletonIterator is used for the self axis.&#xA;" annotatedElement="722705e7-7000-4466-8553-be789f54cf0c"/>
                          <generalization xmi:id="679f121b-1714-4da0-9a71-dfb5852d2735" isSubstitutable="true" general="59ccc38a-d7f7-42b4-ab67-fed330dbe0f9"/>
                        </nestedClassifier>
                      </packagedElement>
                      <packagedElement xmi:type="uml:Class" xmi:id="80fd786e-530a-4936-a854-5bc53d1de95a" name="SingleNodeCounter" isAbstract="true">
                        <ownedComment xmi:id="d9ca70a4-2c1d-458c-8459-68b63561e3bd" body="@author Jacek Ambroziak&#xA;@author Santiago Pericas-Geertsen&#xA;" annotatedElement="80fd786e-530a-4936-a854-5bc53d1de95a"/>
                        <generalization xmi:id="e05903c6-29bd-457c-86a0-760c27c02c4d" isSubstitutable="true" general="11bc98d9-1ccc-4e34-8997-dce8bdea21a5"/>
                        <nestedClassifier xmi:type="uml:Class" xmi:id="6e018079-bd24-4d38-b5de-1f20dd7a816e" name="DefaultSingleNodeCounter" visibility="package">
                          <generalization xmi:id="9f8697c2-5149-4d68-83cf-030304f005f3" isSubstitutable="true" general="80fd786e-530a-4936-a854-5bc53d1de95a"/>
                        </nestedClassifier>
                      </packagedElement>
                      <packagedElement xmi:type="uml:Class" xmi:id="6e7472da-741a-411a-bf68-7deb60be0842" name="SingletonIterator">
                        <ownedComment xmi:id="99112908-9792-4b04-904f-a2c83e21d33e" body="@author Jacek Ambroziak&#xA;@author Santiago Pericas-Geertsen&#xA;" annotatedElement="6e7472da-741a-411a-bf68-7deb60be0842"/>
                        <generalization xmi:id="191f4820-787c-4d12-96bd-68ebd356d059" isSubstitutable="true" general="59ccc38a-d7f7-42b4-ab67-fed330dbe0f9"/>
