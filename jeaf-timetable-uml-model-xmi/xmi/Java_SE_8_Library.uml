                  <generalization xmi:id="7c30692d-8429-4ce9-ad58-402fbe4dde98" isSubstitutable="true" general="579b8a89-787c-4874-82d7-ee965a568f75"/>
                </packagedElement>
                <packagedElement xmi:type="uml:Class" xmi:id="e695611d-5169-4429-913a-71c6f89500b8" name="WaitQ" visibility="package">
                  <ownedComment xmi:id="9ddc9bfb-961b-4d2e-865b-428c4fb1f0c7" body="This vector manages the inform requests to be retried to the manager.&#xA;" annotatedElement="e695611d-5169-4429-913a-71c6f89500b8"/>
                  <generalization xmi:id="97c3b34e-a932-454f-9f7e-4c0e3369c2b9" isSubstitutable="true" general="579b8a89-787c-4874-82d7-ee965a568f75"/>
                </packagedElement>
                <packagedElement xmi:type="uml:Class" xmi:id="8339f5a4-30c3-4478-b10f-a8170213055d" name="SnmpRequestCounter" visibility="package">
                  <ownedComment xmi:id="c8f956fa-3b22-4b1f-b717-c954de492e37" body="A static instance of this class is usually created.  It contains a&#xA;counter that is incremented every time it is accessed.  For example,&#xA;this class can be used in &lt;CODE>SnmpSession&lt;/CODE> to generate a request&#xA;identifier that is used to identify a message in a client-server session.&#xA;The class wraps around when it reaches the maximum positive value, 2^31 - 1.&#xA;" annotatedElement="8339f5a4-30c3-4478-b10f-a8170213055d"/>
                </packagedElement>
                <packagedElement xmi:type="uml:Class" xmi:id="a39d32d5-021e-4762-a93d-b78fcd462e0b" name="SnmpRequestHandler" visibility="package" clientDependency="fdd83097-9d63-47da-9302-2745af2bcef7">
                  <generalization xmi:id="b3c06078-10fe-479b-b358-0df1d3a78688" isSubstitutable="true" general="b9842005-7f2e-4a7a-84e0-b383c057e45d"/>
                  <interfaceRealization xmi:id="fdd83097-9d63-47da-9302-2745af2bcef7" name="" supplier="d779f34f-0a7c-425a-b6d1-51a00fff4977" client="a39d32d5-021e-4762-a93d-b78fcd462e0b" contract="d779f34f-0a7c-425a-b6d1-51a00fff4977"/>
                </packagedElement>
                <packagedElement xmi:type="uml:Class" xmi:id="fc495393-9329-4e74-8a50-7d3c2597c6d4" name="SnmpResponseHandler" visibility="package">
                  <ownedComment xmi:id="5ba37989-fc1b-4c28-bcac-a74c668bdc9b" body="This class is used to handle received inform request responses.&#xA;This classes parses the SNMP inform response packet to obtain the corresponding inform request.&#xA;" annotatedElement="fc495393-9329-4e74-8a50-7d3c2597c6d4"/>
                </packagedElement>
                <packagedElement xmi:type="uml:Class" xmi:id="a3cdf845-2f48-4fe8-8c8e-d493b8f94369" name="SnmpSendServer" visibility="package">
                  <ownedComment xmi:id="8b35e97d-3fb2-49d1-8ea4-2d03e11804ab" body="This class starts a thread which picks up a session from the queue&#xA;and prepares the inform request protocol data unit (PDU) packet and sends&#xA;it to the manager. The request is then added to the wait queue and&#xA;marked as one that is waiting for a response.&#xA;" annotatedElement="a3cdf845-2f48-4fe8-8c8e-d493b8f94369"/>
                  <generalization xmi:id="04fac186-0645-48c7-b42e-b74005e0cfcf" isSubstitutable="true" general="d63a61bd-3268-4361-8c7b-40c49af0dbf1"/>
                </packagedElement>
                <packagedElement xmi:type="uml:Class" xmi:id="11273e64-2b72-4206-b43d-c8f5c0f1987e" name="SnmpSession" visibility="package" clientDependency="cf6cb5f5-08ef-4798-a10d-52694930651c 44f9334a-c60e-418f-b8a3-af2083cbd5a2">
                  <ownedComment xmi:id="42c84964-64a7-44af-93fb-147d89d87571" body="This class is used for sending INFORM REQUESTS from an agent to a manager.&#xA;&#xA;Creates, controls, and manages one or more inform requests.&#xA;&#xA;The SnmpSession maintains the list of all active inform requests and inform responses.&#xA;Each SnmpSession has a dispatcher that is a thread used to service all the inform requests it creates&#xA;and each SnmpSession uses a separate socket for sending/receiving inform requests/responses.&#xA;&#xA;An SnmpSession object is associated with an SNMP adaptor server.&#xA;It is created the first time an inform request is sent by the SNMP adaptor server&#xA;and is destroyed (with its associated SnmpSocket) when the SNMP adaptor server is stopped.&#xA;&#xA;" annotatedElement="11273e64-2b72-4206-b43d-c8f5c0f1987e"/>
                  <interfaceRealization xmi:id="44f9334a-c60e-418f-b8a3-af2083cbd5a2" name="" supplier="d779f34f-0a7c-425a-b6d1-51a00fff4977" client="11273e64-2b72-4206-b43d-c8f5c0f1987e" contract="d779f34f-0a7c-425a-b6d1-51a00fff4977"/>
                  <interfaceRealization xmi:id="cf6cb5f5-08ef-4798-a10d-52694930651c" name="" supplier="bb0a33a2-7330-4036-9f32-81cdd2197901" client="11273e64-2b72-4206-b43d-c8f5c0f1987e" contract="bb0a33a2-7330-4036-9f32-81cdd2197901"/>
                </packagedElement>
                <packagedElement xmi:type="uml:Class" xmi:id="92542242-201c-43da-bdf3-5835f64b9fd3" name="SnmpSocket" visibility="package" clientDependency="830f51c0-392f-43d3-83cf-a873ad34e546">
                  <ownedComment xmi:id="47ee5a44-d7eb-480d-ac6d-5f8282ff041f" body="This class creates an SNMP Datagram Socket. This class has methods helpful&#xA;to send SNMP inform request packets to an arbitrary port of a specified device.&#xA;It also runs a thread that is devoted to receiving SNMP inform response on the socket.&#xA;&lt;BR>&#xA;A socket imposes an upper limit on size of inform response packet. Any&#xA;packet which exceeds this limit is truncated. By default, this&#xA;limit is {@link SnmpAdaptorServer#bufferSize}.&#xA;" annotatedElement="92542242-201c-43da-bdf3-5835f64b9fd3"/>
                  <interfaceRealization xmi:id="830f51c0-392f-43d3-83cf-a873ad34e546" name="" supplier="bb0a33a2-7330-4036-9f32-81cdd2197901" client="92542242-201c-43da-bdf3-5835f64b9fd3" contract="bb0a33a2-7330-4036-9f32-81cdd2197901"/>
                </packagedElement>
