                <interfaceRealization xmi:id="2b9f4f57-24da-4323-af87-03983a87eb64" name="" supplier="41f4a654-a713-47bf-a391-e112be100ec5" client="979c77f1-4999-4d88-8654-4056c6b6b3d9" contract="41f4a654-a713-47bf-a391-e112be100ec5"/>
