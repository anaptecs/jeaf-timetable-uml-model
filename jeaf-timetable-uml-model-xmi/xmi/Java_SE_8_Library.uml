              </nestedClassifier>
              <nestedClassifier xmi:type="uml:Class" xmi:id="dce194d8-8ed5-480c-80ec-0a6a54ae4ec4" name="Double" clientDependency="550720ac-6f3b-4f62-84c3-2b734d43eb46">
                <ownedComment xmi:id="dfac69e7-fa1c-4f2c-9454-1d3706358aca" body="The &lt;code>Double&lt;/code> class defines a point specified in&#xA;&lt;code>double&lt;/code> precision.&#xA;@since 1.2&#xA;" annotatedElement="dce194d8-8ed5-480c-80ec-0a6a54ae4ec4"/>
                <generalization xmi:id="5d19afe3-4561-4620-aed6-75b4492257e1" isSubstitutable="true" general="21dccb72-ac6c-4711-9017-705b48d2e19f"/>
