              <nestedClassifier xmi:type="uml:Class" xmi:id="e0b63602-ba8f-494d-944c-0a114fa085e1" name="AsyncSupply" visibility="package" clientDependency="a4dded98-ad19-41dd-99a3-fbeb56b8270c 1f5dc3cf-5702-4372-9621-4420ad41396c">
                <ownedTemplateSignature xmi:type="uml:RedefinableTemplateSignature" xmi:id="2afcbb74-24fa-408b-8934-3f4311179133" name="" visibility="public" parameter="6ebb2499-aa3e-486c-8504-41208d45b35c">
