            <nestedClassifier xmi:type="uml:Class" xmi:id="1c9c5412-b703-47e2-b845-8dd56f00e957" name="FocusPropertyChangeListener" visibility="private" clientDependency="f4b6c5f2-5769-4697-a430-e766bd10148f">
              <interfaceRealization xmi:id="f4b6c5f2-5769-4697-a430-e766bd10148f" name="" supplier="351d738c-b38b-49d3-b4b5-e99e202d16ba" client="1c9c5412-b703-47e2-b845-8dd56f00e957" contract="351d738c-b38b-49d3-b4b5-e99e202d16ba"/>
