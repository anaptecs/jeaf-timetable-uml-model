              </templateBinding>
            </packagedElement>
            <packagedElement xmi:type="uml:Class" xmi:id="5e7d6fe8-f262-47b3-96f3-75fcf74fa4ca" name="ReferenceQueue&lt;S>">
              <templateBinding xmi:id="4d5a2ea4-f51d-487d-9f98-54c352048992" signature="b9e3243c-d584-473f-9d2e-72e124cfe67d">
                <parameterSubstitution xmi:id="9046c159-2a7c-4b95-b6a9-91a1fd3ac06e" formal="86036130-b3a8-48d1-ba71-8a63a4d65d2d" actual="34d406f0-7833-44d7-a521-52df6443d185"/>
              </templateBinding>
            </packagedElement>
            <packagedElement xmi:type="uml:Class" xmi:id="873f3f7a-f4d7-43ed-a30c-aef6b071bc6f" name="ReferenceQueue&lt;T>">
              <templateBinding xmi:id="22bda1d9-a971-4e9e-bc80-70402112419b" signature="b9e3243c-d584-473f-9d2e-72e124cfe67d">
                <parameterSubstitution xmi:id="9d7570cd-2600-40f5-a1b1-b63a5a39fc1a" formal="86036130-b3a8-48d1-ba71-8a63a4d65d2d" actual="6eafcfa5-e10c-44e0-b437-ab20284a8d89"/>
              </templateBinding>
            </packagedElement>
            <packagedElement xmi:type="uml:Class" xmi:id="b8a1cf33-5c24-4983-a2fe-f43790184f71" name="Reference&lt;Object>">
              <templateBinding xmi:id="a4eab887-c0d8-4462-8b09-c261cf23890d" signature="4db6b828-9cb4-4284-965a-067f160f3dd6">
                <parameterSubstitution xmi:id="b257b088-5e72-40dd-8d3d-48b1e96926df" formal="877e2e71-6bad-40b7-8a08-5d21f8975ed9" actual="42483ff6-53a9-4bf6-a5fa-caa9c31afef7"/>
