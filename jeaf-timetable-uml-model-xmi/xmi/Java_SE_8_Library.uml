                    </packagedElement>
                    <packagedElement xmi:type="uml:Class" xmi:id="4ff21249-b54f-4df5-a76e-24e47865e642" name="Method">
                      <ownedComment xmi:id="2f79d7f5-4877-4daa-ad2e-5f8d9edfba5e" body="This class represents the method info structure, i.e., the representation&#xA;for a method in the class. See JVM specification for details.&#xA;A method has access flags, a name, a signature and a number of attributes.&#xA;&#xA;@author  &lt;A HREF=&quot;mailto:markus.dahm@berlin.de&quot;>M. Dahm&lt;/A>&#xA;" annotatedElement="4ff21249-b54f-4df5-a76e-24e47865e642"/>
