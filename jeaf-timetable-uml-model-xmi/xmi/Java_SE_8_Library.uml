                    <packagedElement xmi:type="uml:Class" xmi:id="3e4eb760-676d-408e-920d-717f26a48005" name="Deprecated">
                      <ownedComment xmi:id="1f103537-b148-4853-a1bf-2c8f2429e4f0" body="This class is derived from &lt;em>Attribute&lt;/em> and denotes that this is a&#xA;deprecated method.&#xA;It is instantiated from the &lt;em>Attribute.readAttribute()&lt;/em> method.&#xA;&#xA;@author  &lt;A HREF=&quot;mailto:markus.dahm@berlin.de&quot;>M. Dahm&lt;/A>&#xA;@see     Attribute&#xA;" annotatedElement="3e4eb760-676d-408e-920d-717f26a48005"/>
                      <generalization xmi:id="8f744b69-ec61-4f23-a44f-f6930e0979da" isSubstitutable="true" general="3036d890-e66d-41b1-8ecb-9977d68690f1"/>
                    </packagedElement>
                    <packagedElement xmi:type="uml:Class" xmi:id="500b6afb-3d94-4be7-95ec-f43bb9ea1a7e" name="DescendingVisitor" clientDependency="5d5bcf85-8236-4379-94cd-2f6b444157f5">
                      <ownedComment xmi:id="83411c3c-7a1b-4400-b79f-b9718586d342" body="Traverses a JavaClass with another Visitor object 'piggy-backed'&#xA;that is applied to all components of a JavaClass object. I.e. this&#xA;class supplies the traversal strategy, other classes can make use&#xA;of it.&#xA;&#xA;@author &lt;A HREF=&quot;mailto:markus.dahm@berlin.de&quot;>M. Dahm&lt;/A>&#xA;" annotatedElement="500b6afb-3d94-4be7-95ec-f43bb9ea1a7e"/>
