                      <ownedComment xmi:id="3dac85f0-0de6-4df0-855c-621deb2b11b6" body="Classes who implement this information provide information needed for&#xA;static analysis of a path component.&#xA;" annotatedElement="bcb1a7bb-05e4-4ff3-86a7-b5b88414a8d6"/>
                    </packagedElement>
                    <packagedElement xmi:type="uml:Class" xmi:id="6bf2c393-0fc6-4a04-aac7-c67203b97b92" name="PredicatedNodeTest" clientDependency="6e7ded07-8117-46d0-8e86-ab472f26accb" isAbstract="true">
                      <generalization xmi:id="d99e4ed5-a97f-4be6-8b98-0fdbfa928227" isSubstitutable="true" general="d5f8dce3-d082-4e11-b44b-f19679a2ad86"/>
                      <interfaceRealization xmi:id="6e7ded07-8117-46d0-8e86-ab472f26accb" name="" supplier="e03483be-51c7-47b4-a687-40ece38d116e" client="6bf2c393-0fc6-4a04-aac7-c67203b97b92" contract="e03483be-51c7-47b4-a687-40ece38d116e"/>
                      <nestedClassifier xmi:type="uml:Class" xmi:id="a442fb3e-0e2b-456c-a8ee-392c77889890" name="PredOwner" visibility="package" clientDependency="7b84a189-1aa0-4209-a808-53cd40e991c5">
                        <interfaceRealization xmi:id="7b84a189-1aa0-4209-a808-53cd40e991c5" name="" supplier="2d9ebc04-c330-4d97-895d-6a79c1d1f9f9" client="a442fb3e-0e2b-456c-a8ee-392c77889890" contract="2d9ebc04-c330-4d97-895d-6a79c1d1f9f9"/>
                      </nestedClassifier>
                    </packagedElement>
                    <packagedElement xmi:type="uml:Class" xmi:id="b2e5b48d-1974-4a64-aa25-79cff0a6b856" name="ReverseAxesWalker">
                      <ownedComment xmi:id="77c23bbd-ce91-4a38-83c1-34b3da7e906f" body="Walker for a reverse axes.&#xA;@see &lt;a href=&quot;http://www.w3.org/TR/xpath#predicates&quot;>XPath 2.4 Predicates&lt;/a>&#xA;" annotatedElement="b2e5b48d-1974-4a64-aa25-79cff0a6b856"/>
                      <generalization xmi:id="ce70e71b-0d78-43d1-8684-bd32eed4fac3" isSubstitutable="true" general="e5de86ac-d2f0-4577-9248-297fbd94382c"/>
                    </packagedElement>
                    <packagedElement xmi:type="uml:Class" xmi:id="64fc6a52-c3c4-4ff1-8f9a-4009e634e56f" name="RTFIterator">
                      <generalization xmi:id="b745e519-8949-4e80-ae6a-c317d31a8451" isSubstitutable="true" general="1cce105c-0614-4787-8fbf-49d4c88883e8"/>
                    </packagedElement>
                    <packagedElement xmi:type="uml:Class" xmi:id="e233b749-f889-4e13-9b6c-564216315ca3" name="SelfIteratorNoPredicate">
                      <ownedComment xmi:id="1f3ab356-4615-4302-812c-8cf8ad836b2e" body="This class implements an optimized iterator for&#xA;&quot;.&quot; patterns, that is, the self axes without any predicates.&#xA;@see com.sun.org.apache.xpath.internal.axes.LocPathIterator&#xA;@xsl.usage advanced&#xA;" annotatedElement="e233b749-f889-4e13-9b6c-564216315ca3"/>
                      <generalization xmi:id="a489374f-d31c-442f-a182-c31826c0e184" isSubstitutable="true" general="7a445670-7c2d-4f52-ba92-386ee90e2092"/>
                    </packagedElement>
                    <packagedElement xmi:type="uml:Interface" xmi:id="e03483be-51c7-47b4-a687-40ece38d116e" name="SubContextList" isAbstract="true">
                      <ownedComment xmi:id="dd50e39b-ae58-4629-9ff6-f1867668c625" body="A class that implements this interface is a sub context node list, meaning it&#xA;is a node list for a location path step for a predicate.&#xA;@xsl.usage advanced&#xA;" annotatedElement="e03483be-51c7-47b4-a687-40ece38d116e"/>
                    </packagedElement>
                    <packagedElement xmi:type="uml:Class" xmi:id="bc83ac14-c830-427b-812d-51e36168d4c3" name="UnionChildIterator">
                      <ownedComment xmi:id="6a1c1249-d288-4ee2-840f-5f599ee14572" body="This class defines a simplified type of union iterator that only&#xA;tests along the child axes.  If the conditions are right, it is&#xA;much faster than using a UnionPathIterator.&#xA;" annotatedElement="bc83ac14-c830-427b-812d-51e36168d4c3"/>
                      <generalization xmi:id="72a81c37-ed3b-431f-a886-8c642dc39378" isSubstitutable="true" general="84c76da6-05a3-4ecf-afe4-0073535f9f7f"/>
                    </packagedElement>
                    <packagedElement xmi:type="uml:Class" xmi:id="54ac0993-3c56-46a1-b250-d9a49249b0b0" name="UnionPathIterator" clientDependency="a88817e2-9700-40eb-9401-2141287021b6 1bd90965-f71f-4e4d-9129-3f7e83b591dd 288b08c7-7d6a-42da-aa20-5c145405142b 7eedfd6d-0f32-43e6-9cdd-749f61760d6d">
                      <ownedComment xmi:id="97cea7d6-fc50-4e2c-aaea-d55d144ef97a" body="This class extends NodeSetDTM, which implements DTMIterator,&#xA;and fetches nodes one at a time in document order based on a XPath&#xA;&lt;a href=&quot;http://www.w3.org/TR/xpath#NT-UnionExpr&quot;>UnionExpr&lt;/a>.&#xA;As each node is iterated via nextNode(), the node is also stored&#xA;in the NodeVector, so that previousNode() can easily be done.&#xA;@xsl.usage advanced&#xA;" annotatedElement="54ac0993-3c56-46a1-b250-d9a49249b0b0"/>
                      <generalization xmi:id="41a3e693-9d87-4bcd-bc6d-0da2a85326dc" isSubstitutable="true" general="7a445670-7c2d-4f52-ba92-386ee90e2092"/>
                      <interfaceRealization xmi:id="288b08c7-7d6a-42da-aa20-5c145405142b" name="" supplier="af41d975-30f5-4ca2-9f69-6cae8e15d59a" client="54ac0993-3c56-46a1-b250-d9a49249b0b0" contract="af41d975-30f5-4ca2-9f69-6cae8e15d59a"/>
                      <interfaceRealization xmi:id="1bd90965-f71f-4e4d-9129-3f7e83b591dd" name="" supplier="c44bf7ff-d4ba-4ce4-80f4-b5570477e2d3" client="54ac0993-3c56-46a1-b250-d9a49249b0b0" contract="c44bf7ff-d4ba-4ce4-80f4-b5570477e2d3"/>
                      <interfaceRealization xmi:id="a88817e2-9700-40eb-9401-2141287021b6" name="" supplier="41f4a654-a713-47bf-a391-e112be100ec5" client="54ac0993-3c56-46a1-b250-d9a49249b0b0" contract="41f4a654-a713-47bf-a391-e112be100ec5"/>
                      <interfaceRealization xmi:id="7eedfd6d-0f32-43e6-9cdd-749f61760d6d" name="" supplier="bcb1a7bb-05e4-4ff3-86a7-b5b88414a8d6" client="54ac0993-3c56-46a1-b250-d9a49249b0b0" contract="bcb1a7bb-05e4-4ff3-86a7-b5b88414a8d6"/>
                      <nestedClassifier xmi:type="uml:Class" xmi:id="5a4aa667-f002-4969-ab75-6d14d4ced98c" name="iterOwner" visibility="package" clientDependency="1db83f54-4453-45c9-b1d9-620f2762a256">
                        <interfaceRealization xmi:id="1db83f54-4453-45c9-b1d9-620f2762a256" name="" supplier="2d9ebc04-c330-4d97-895d-6a79c1d1f9f9" client="5a4aa667-f002-4969-ab75-6d14d4ced98c" contract="2d9ebc04-c330-4d97-895d-6a79c1d1f9f9"/>
                      </nestedClassifier>
                    </packagedElement>
                    <packagedElement xmi:type="uml:Class" xmi:id="db6ef0fe-02d0-4f3a-adce-32f4a6a27edd" name="WalkerFactory">
                      <ownedComment xmi:id="f675c941-d968-4663-8572-8c5ec3e4da8b" body="This class is both a factory for XPath location path expressions,&#xA;which are built from the opcode map output, and an analysis engine&#xA;for the location path expressions in order to provide optimization hints.&#xA;" annotatedElement="db6ef0fe-02d0-4f3a-adce-32f4a6a27edd"/>
                    </packagedElement>
                    <packagedElement xmi:type="uml:Class" xmi:id="eaf77b76-8024-4e7d-b3c0-4e074482d8aa" name="WalkingIterator" clientDependency="dea3a97b-8de0-4eb1-85c2-6a4b47954935">
                      <ownedComment xmi:id="32facdd2-2567-4c23-99a9-25d1cc5a360e" body="Location path iterator that uses Walkers.&#xA;" annotatedElement="eaf77b76-8024-4e7d-b3c0-4e074482d8aa"/>
                      <generalization xmi:id="62759f07-a428-46a4-88ff-01dec19ffc66" isSubstitutable="true" general="7a445670-7c2d-4f52-ba92-386ee90e2092"/>
                      <interfaceRealization xmi:id="dea3a97b-8de0-4eb1-85c2-6a4b47954935" name="" supplier="2d9ebc04-c330-4d97-895d-6a79c1d1f9f9" client="eaf77b76-8024-4e7d-b3c0-4e074482d8aa" contract="2d9ebc04-c330-4d97-895d-6a79c1d1f9f9"/>
                    </packagedElement>
                    <packagedElement xmi:type="uml:Class" xmi:id="a2ae36f2-9c27-4f31-bff7-34f5bff403bb" name="WalkingIteratorSorted">
                      <ownedComment xmi:id="e1f90e76-7866-4602-b3ce-a77296c2ed0e" body="This class iterates over set of nodes that needs to be sorted.&#xA;@xsl.usage internal&#xA;" annotatedElement="a2ae36f2-9c27-4f31-bff7-34f5bff403bb"/>
                      <generalization xmi:id="059cf9cc-c3f5-49c0-9017-4e490167f6d2" isSubstitutable="true" general="eaf77b76-8024-4e7d-b3c0-4e074482d8aa"/>
                    </packagedElement>
                  </packagedElement>
                  <packagedElement xmi:type="uml:Package" xmi:id="548a146c-ab4b-407f-862f-8e0cc689f8cf" name="compiler">
                    <packagedElement xmi:type="uml:Class" xmi:id="fba4e0a4-adc7-46d7-9bb7-52dbbe54a694" name="Compiler">
                      <ownedComment xmi:id="1df6a6b4-ebf3-44a4-b414-6bef8cd3513e" body="An instance of this class compiles an XPath string expression into&#xA;a Expression object.  This class compiles the string into a sequence&#xA;of operation codes (op map) and then builds from that into an Expression&#xA;tree.&#xA;@xsl.usage advanced&#xA;" annotatedElement="fba4e0a4-adc7-46d7-9bb7-52dbbe54a694"/>
                      <generalization xmi:id="4268a7dd-cebc-4b2c-a2d5-f4bad5e41b0d" isSubstitutable="true" general="0599f206-d4f7-4f44-a29c-1ea31c3ad379"/>
                    </packagedElement>
                    <packagedElement xmi:type="uml:Class" xmi:id="2ed2aa99-f06f-4580-9df9-970f74eb8b39" name="FuncLoader">
                      <ownedComment xmi:id="f95a99ba-4278-4ecb-b0db-a7af2a21fdd7" body="Lazy load of functions into the function table as needed, so we don't&#xA;have to load all the functions allowed in XPath and XSLT on startup.&#xA;@xsl.usage advanced&#xA;" annotatedElement="2ed2aa99-f06f-4580-9df9-970f74eb8b39"/>
                    </packagedElement>
                    <packagedElement xmi:type="uml:Class" xmi:id="c4be707a-b334-49ad-9cd9-a82472a60763" name="FunctionTable">
                      <ownedComment xmi:id="9bdf105a-e75a-413d-a932-8b946eee9840" body="The function table for XPath.&#xA;" annotatedElement="c4be707a-b334-49ad-9cd9-a82472a60763"/>
                    </packagedElement>
                    <packagedElement xmi:type="uml:Class" xmi:id="719c57a0-9ab3-4b47-8d17-b079e0d8141a" name="Keywords">
                      <ownedComment xmi:id="ad3b01b0-aeca-4816-8ba6-1a0814086c85" body="Table of strings to operation code lookups.&#xA;@xsl.usage internal&#xA;" annotatedElement="719c57a0-9ab3-4b47-8d17-b079e0d8141a"/>
                    </packagedElement>
                    <packagedElement xmi:type="uml:Class" xmi:id="9d0b0a64-7ff1-4209-8e23-f0e8669dd896" name="Lexer" visibility="package">
                      <ownedComment xmi:id="cfe6a0e8-8156-4b2c-add9-d4eadc682b27" body="This class is in charge of lexical processing of the XPath&#xA;expression into tokens.&#xA;" annotatedElement="9d0b0a64-7ff1-4209-8e23-f0e8669dd896"/>
                    </packagedElement>
                    <packagedElement xmi:type="uml:Class" xmi:id="00cc9401-3533-4298-bde6-9cc5c837dd97" name="OpCodes">
                      <ownedComment xmi:id="4ed3cf17-62af-46e0-b8e7-007f986464e5" body="Operations codes for XPath.&#xA;&#xA;Code for the descriptions of the operations codes:&#xA;[UPPER CASE] indicates a literal value,&#xA;[lower case] is a description of a value,&#xA;([length] always indicates the length of the operation,&#xA;including the operations code and the length integer.)&#xA;{UPPER CASE} indicates the given production,&#xA;{description} is the description of a new production,&#xA;(For instance, {boolean expression} means some expression&#xA;that should be resolved to a boolean.)&#xA;means that it occurs zero or more times,&#xA;+ means that it occurs one or more times,&#xA;? means that it is optional.&#xA;&#xA;returns: indicates what the production should return.&#xA;" annotatedElement="00cc9401-3533-4298-bde6-9cc5c837dd97"/>
                    </packagedElement>
                    <packagedElement xmi:type="uml:Class" xmi:id="0599f206-d4f7-4f44-a29c-1ea31c3ad379" name="OpMap">
                      <ownedComment xmi:id="ed3416cf-3c8f-4082-8db8-0a171f6f020d" body="This class represents the data structure basics of the XPath&#xA;object.&#xA;" annotatedElement="0599f206-d4f7-4f44-a29c-1ea31c3ad379"/>
                    </packagedElement>
                    <packagedElement xmi:type="uml:Class" xmi:id="eba1fbb4-930b-4b25-a199-ad413b21c36f" name="OpMapVector">
                      <ownedComment xmi:id="63bda610-aa72-4be3-9866-312324758383" body="Like IntVector, but used only for the OpMap array.  Length of array&#xA;is kept in the m_lengthPos position of the array.  Only the required methods&#xA;are in included here.&#xA;@xsl.usage internal&#xA;" annotatedElement="eba1fbb4-930b-4b25-a199-ad413b21c36f"/>
                    </packagedElement>
                    <packagedElement xmi:type="uml:Class" xmi:id="e52ab144-799c-4c22-9475-35d7f612c0ad" name="PsuedoNames">
                      <ownedComment xmi:id="3ef3d002-46a0-4ade-be0c-8e0be77da9f0" body="This is used to represent names of nodes that may not be named, like a&#xA;comment node.&#xA;" annotatedElement="e52ab144-799c-4c22-9475-35d7f612c0ad"/>
                    </packagedElement>
                    <packagedElement xmi:type="uml:Class" xmi:id="5b143270-37ad-496f-864f-cf3ab79027ef" name="XPathDumper">
                      <ownedComment xmi:id="27825b5c-72ad-4a81-b863-074aed9e60e7" body="Class for XPath diagnostic functions.&#xA;" annotatedElement="5b143270-37ad-496f-864f-cf3ab79027ef"/>
                    </packagedElement>
                    <packagedElement xmi:type="uml:Class" xmi:id="69564110-8618-4462-b90b-061dac4ef476" name="XPathParser">
                      <ownedComment xmi:id="47e7405f-ec1a-4ca6-85d0-72b058044031" body="Tokenizes and parses XPath expressions. This should really be named&#xA;XPathParserImpl, and may be renamed in the future.&#xA;@xsl.usage general&#xA;" annotatedElement="69564110-8618-4462-b90b-061dac4ef476"/>
                    </packagedElement>
                  </packagedElement>
                  <packagedElement xmi:type="uml:Package" xmi:id="44f80c5e-9942-4238-80bb-d4e99ccb4c1e" name="domapi">
                    <packagedElement xmi:type="uml:Class" xmi:id="d655c90b-cd97-4f56-9dd0-c46a48c624a2" name="XPathEvaluatorImpl" clientDependency="c9ff8636-6e85-44b9-b10b-27ed6d9e904d">
                      <ownedComment xmi:id="6cc83e5c-40dd-45f1-ae78-ddeb42e5da20" body="The class provides an implementation of XPathEvaluator according&#xA;to the DOM L3 XPath Specification, Working Group Note 26 February 2004.&#xA;&#xA;&lt;p>See also the &lt;a href='http://www.w3.org/TR/2004/NOTE-DOM-Level-3-XPath-20040226'>Document Object Model (DOM) Level 3 XPath Specification&lt;/a>.&lt;/p>&#xA;&#xA;&lt;/p>The evaluation of XPath expressions is provided by&#xA;&lt;code>XPathEvaluator&lt;/code>, which will provide evaluation of XPath 1.0&#xA;expressions with no specialized extension functions or variables. It is&#xA;expected that the &lt;code>XPathEvaluator&lt;/code> interface will be&#xA;implemented on the same object which implements the &lt;code>Document&lt;/code>&#xA;interface in an implementation which supports the XPath DOM module.&#xA;&lt;code>XPathEvaluator&lt;/code> implementations may be available from other&#xA;sources that may provide support for special extension functions or&#xA;variables which are not defined in this specification.&lt;/p>&#xA;&#xA;@see org.w3c.dom.xpath.XPathEvaluator&#xA;&#xA;@xsl.usage internal&#xA;" annotatedElement="d655c90b-cd97-4f56-9dd0-c46a48c624a2"/>
                      <interfaceRealization xmi:id="c9ff8636-6e85-44b9-b10b-27ed6d9e904d" name="" supplier="bd389709-ab63-4f2c-9fe7-68060d562072" client="d655c90b-cd97-4f56-9dd0-c46a48c624a2" contract="bd389709-ab63-4f2c-9fe7-68060d562072"/>
                      <nestedClassifier xmi:type="uml:Class" xmi:id="651a7ab4-b18f-45fb-a677-794d9ea760e9" name="DummyPrefixResolver" visibility="private" clientDependency="706260fc-9729-4bd8-a86a-2bffd7f4ca1d">
                        <ownedComment xmi:id="eedb3721-79a4-49d2-aceb-9c8557115bbd" body="This prefix resolver is created whenever null is passed to the&#xA;evaluate method.  Its purpose is to satisfy the DOM L3 XPath API&#xA;requirement that if a null prefix resolver is used, an exception&#xA;should only be thrown when an attempt is made to resolve a prefix.&#xA;" annotatedElement="651a7ab4-b18f-45fb-a677-794d9ea760e9"/>
                        <interfaceRealization xmi:id="706260fc-9729-4bd8-a86a-2bffd7f4ca1d" name="" supplier="ddd63082-a1d2-49c8-a073-4528847facf5" client="651a7ab4-b18f-45fb-a677-794d9ea760e9" contract="ddd63082-a1d2-49c8-a073-4528847facf5"/>
                      </nestedClassifier>
                    </packagedElement>
                    <packagedElement xmi:type="uml:Class" xmi:id="34f2952c-9161-4ba5-9643-39e4fa92b726" name="XPathExpressionImpl" visibility="package" clientDependency="ffe6cb1c-a44f-443d-b550-f2a32f656372">
                      <ownedComment xmi:id="3705f6d2-e74d-4e54-9b79-d2a0d27c44a2" body="The class provides an implementation of XPathExpression according&#xA;to the DOM L3 XPath Specification, Working Group Note 26 February 2004.&#xA;&#xA;&lt;p>See also the &lt;a href='http://www.w3.org/TR/2004/NOTE-DOM-Level-3-XPath-20040226'>Document Object Model (DOM) Level 3 XPath Specification&lt;/a>.&lt;/p>&#xA;&#xA;&lt;p>The &lt;code>XPathExpression&lt;/code> interface represents a parsed and resolved&#xA;XPath expression.&lt;/p>&#xA;&#xA;@see org.w3c.dom.xpath.XPathExpression&#xA;&#xA;@xsl.usage internal&#xA;" annotatedElement="34f2952c-9161-4ba5-9643-39e4fa92b726"/>
                      <interfaceRealization xmi:id="ffe6cb1c-a44f-443d-b550-f2a32f656372" name="" supplier="6f29d316-7ccf-4d15-bebf-7b69b285940f" client="34f2952c-9161-4ba5-9643-39e4fa92b726" contract="6f29d316-7ccf-4d15-bebf-7b69b285940f"/>
                    </packagedElement>
                    <packagedElement xmi:type="uml:Class" xmi:id="2affd2a4-8372-4da4-a0a1-213a6ceab655" name="XPathNamespaceImpl" visibility="package" clientDependency="4c47c008-cf85-4c41-be61-32848c5eb97b">
                      <ownedComment xmi:id="7e2852ad-85aa-4721-864d-5388a84a2daf" body="The &lt;code>XPathNamespace&lt;/code> interface is returned by&#xA;&lt;code>XPathResult&lt;/code> interfaces to represent the XPath namespace node&#xA;type that DOM lacks. There is no public constructor for this node type.&#xA;Attempts to place it into a hierarchy or a NamedNodeMap result in a&#xA;&lt;code>DOMException&lt;/code> with the code &lt;code>HIERARCHY_REQUEST_ERR&lt;/code>&#xA;. This node is read only, so methods or setting of attributes that would&#xA;mutate the node result in a DOMException with the code&#xA;&lt;code>NO_MODIFICATION_ALLOWED_ERR&lt;/code>.&#xA;&lt;p>The core specification describes attributes of the &lt;code>Node&lt;/code>&#xA;interface that are different for different node node types but does not&#xA;describe &lt;code>XPATH_NAMESPACE_NODE&lt;/code>, so here is a description of&#xA;those attributes for this node type. All attributes of &lt;code>Node&lt;/code>&#xA;not described in this section have a &lt;code>null&lt;/code> or&#xA;&lt;code>false&lt;/code> value.&#xA;&lt;p>&lt;code>ownerDocument&lt;/code> matches the &lt;code>ownerDocument&lt;/code> of the&#xA;&lt;code>ownerElement&lt;/code> even if the element is later adopted.&#xA;&lt;p>&lt;code>prefix&lt;/code> is the prefix of the namespace represented by the&#xA;node.&#xA;&lt;p>&lt;code>nodeName&lt;/code> is the same as &lt;code>prefix&lt;/code>.&#xA;&lt;p>&lt;code>nodeType&lt;/code> is equal to &lt;code>XPATH_NAMESPACE_NODE&lt;/code>.&#xA;&lt;p>&lt;code>namespaceURI&lt;/code> is the namespace URI of the namespace&#xA;represented by the node.&#xA;&lt;p>&lt;code>adoptNode&lt;/code>, &lt;code>cloneNode&lt;/code>, and&#xA;&lt;code>importNode&lt;/code> fail on this node type by raising a&#xA;&lt;code>DOMException&lt;/code> with the code &lt;code>NOT_SUPPORTED_ERR&lt;/code>.In&#xA;future versions of the XPath specification, the definition of a namespace&#xA;node may be changed incomatibly, in which case incompatible changes to&#xA;field values may be required to implement versions beyond XPath 1.0.&#xA;&lt;p>See also the &lt;a href='http://www.w3.org/TR/2004/NOTE-DOM-Level-3-XPath-20040226'>Document Object Model (DOM) Level 3 XPath Specification&lt;/a>.&#xA;&#xA;This implementation wraps the DOM attribute node that contained the&#xA;namespace declaration.&#xA;@xsl.usage internal&#xA;" annotatedElement="2affd2a4-8372-4da4-a0a1-213a6ceab655"/>
                      <interfaceRealization xmi:id="4c47c008-cf85-4c41-be61-32848c5eb97b" name="" supplier="aa9b6769-1f1a-4440-854b-379e24d76054" client="2affd2a4-8372-4da4-a0a1-213a6ceab655" contract="aa9b6769-1f1a-4440-854b-379e24d76054"/>
                    </packagedElement>
                    <packagedElement xmi:type="uml:Class" xmi:id="113fdda5-9524-4670-b9ea-c62dfd321487" name="XPathNSResolverImpl" visibility="package" clientDependency="249f60a2-968f-4924-b6e7-b9af064d8418">
                      <ownedComment xmi:id="3420dc19-a609-413f-b3d2-273faf48755c" body="The class provides an implementation XPathNSResolver according&#xA;to the DOM L3 XPath Specification, Working Group Note 26 February 2004.&#xA;&#xA;&lt;p>See also the &lt;a href='http://www.w3.org/TR/2004/NOTE-DOM-Level-3-XPath-20040226'>Document Object Model (DOM) Level 3 XPath Specification&lt;/a>.&lt;/p>&#xA;&#xA;&lt;p>The &lt;code>XPathNSResolver&lt;/code> interface permit &lt;code>prefix&lt;/code>&#xA;strings in the expression to be properly bound to&#xA;&lt;code>namespaceURI&lt;/code> strings. &lt;code>XPathEvaluator&lt;/code> can&#xA;construct an implementation of &lt;code>XPathNSResolver&lt;/code> from a node,&#xA;or the interface may be implemented by any application.&lt;/p>&#xA;&#xA;@see org.w3c.dom.xpath.XPathNSResolver&#xA;@xsl.usage internal&#xA;" annotatedElement="113fdda5-9524-4670-b9ea-c62dfd321487"/>
                      <generalization xmi:id="318d9b79-8267-48e7-9952-5eea0ed2d045" isSubstitutable="true" general="eab807b5-06bc-4df4-9502-448a6a16e8b6"/>
                      <interfaceRealization xmi:id="249f60a2-968f-4924-b6e7-b9af064d8418" name="" supplier="99ed9f46-3598-4ef6-b016-dfc15f85232a" client="113fdda5-9524-4670-b9ea-c62dfd321487" contract="99ed9f46-3598-4ef6-b016-dfc15f85232a"/>
                    </packagedElement>
                    <packagedElement xmi:type="uml:Class" xmi:id="f1507c88-37c0-46f0-badf-49064a52955d" name="XPathResultImpl" visibility="package" clientDependency="7a72998e-cff7-4bf6-8347-290485d1b754 2db748d4-9de4-4bc0-be03-36194520185b">
                      <ownedComment xmi:id="6890a0e5-d2df-465b-9b09-2451afff8ae9" body="The class provides an implementation XPathResult according&#xA;to the DOM L3 XPath Specification, Working Group Note 26 February 2004.&#xA;&#xA;&lt;p>See also the &lt;a href='http://www.w3.org/TR/2004/NOTE-DOM-Level-3-XPath-20040226'>Document Object Model (DOM) Level 3 XPath Specification&lt;/a>.&lt;/p>&#xA;&#xA;&lt;p>The &lt;code>XPathResult&lt;/code> interface represents the result of the&#xA;evaluation of an XPath expression within the context of a particular&#xA;node. Since evaluation of an XPath expression can result in various&#xA;result types, this object makes it possible to discover and manipulate&#xA;the type and value of the result.&lt;/p>&#xA;&#xA;&lt;p>This implementation wraps an &lt;code>XObject&lt;/code>.&#xA;&#xA;@see com.sun.org.apache.xpath.internal.objects.XObject&#xA;@see org.w3c.dom.xpath.XPathResult&#xA;&#xA;@xsl.usage internal&#xA;" annotatedElement="f1507c88-37c0-46f0-badf-49064a52955d"/>
                      <interfaceRealization xmi:id="2db748d4-9de4-4bc0-be03-36194520185b" name="" supplier="893e0e76-b5f1-4e35-9cd9-45b711601894" client="f1507c88-37c0-46f0-badf-49064a52955d" contract="893e0e76-b5f1-4e35-9cd9-45b711601894"/>
                      <interfaceRealization xmi:id="7a72998e-cff7-4bf6-8347-290485d1b754" name="" supplier="7b31aca1-f6df-49eb-9dcb-a06b8e654309" client="f1507c88-37c0-46f0-badf-49064a52955d" contract="7b31aca1-f6df-49eb-9dcb-a06b8e654309"/>
                    </packagedElement>
                    <packagedElement xmi:type="uml:Class" xmi:id="8df06b3a-6148-4628-b7a5-3fd1d9150a03" name="XPathStylesheetDOM3Exception">
                      <ownedComment xmi:id="f220f5ca-e9e6-480e-8051-24cf63931771" body="A new exception to add support for DOM Level 3 XPath API.&#xA;This class is needed to throw a org.w3c.dom.DOMException with proper error code in&#xA;createExpression method of XPathEvaluatorImpl (a DOM Level 3 class).&#xA;&#xA;This class extends TransformerException because the error message includes information&#xA;about where the XPath problem is in the stylesheet as well as the XPath expression itself.&#xA;&#xA;@xsl.usage internal&#xA;" annotatedElement="8df06b3a-6148-4628-b7a5-3fd1d9150a03"/>
                      <generalization xmi:id="0923106e-6bbd-4dd7-943b-756bd6fe073b" isSubstitutable="true" general="fc47c0cc-5598-44f9-acb1-997da8b5b607"/>
