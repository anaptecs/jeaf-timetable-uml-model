          <packagedElement xmi:type="uml:Interface" xmi:id="3d7a8d19-717d-4c7d-b91a-d538c7c47989" name="ConcurrentMap&lt;WeakClassKey, Reference&lt;>>">
            <templateBinding xmi:id="7e3817f8-84a5-4357-9dd3-0c59a328fa58" signature="8099fccd-185e-465f-8b18-7f1d12d879a6">
