              <ownedComment xmi:id="1cd5bf62-4341-4fe0-a03e-9edcc8469d1c" body="The protected &lt;code>EditorDelegate&lt;/code> class.&#xA;" annotatedElement="181207cb-9f1b-4881-9a55-f8b2dcaf631e"/>
