              <nestedClassifier xmi:type="uml:Class" xmi:id="14b810a9-5740-42c9-9590-8e7de41eb717" name="Iterator" visibility="package" clientDependency="e88b0295-6ba2-4cd9-aed3-b9d9d57525ec" isAbstract="true">
                <interfaceRealization xmi:id="e88b0295-6ba2-4cd9-aed3-b9d9d57525ec" name="" supplier="7d949cdb-8ee7-42be-93d7-7819061ff5ba" client="14b810a9-5740-42c9-9590-8e7de41eb717" contract="7d949cdb-8ee7-42be-93d7-7819061ff5ba"/>
