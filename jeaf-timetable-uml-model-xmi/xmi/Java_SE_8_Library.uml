            <packagedElement xmi:type="uml:Class" xmi:id="3648968c-96ff-4143-924e-f3ba9029aebc" name="EllipseIterator" visibility="package" clientDependency="7c7b29d7-b5fb-4535-b946-b636c1ab40e5">
