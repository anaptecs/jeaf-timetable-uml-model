              <packagedElement xmi:type="uml:Class" xmi:id="dddc759e-721c-449d-9e47-1357faedc46e" name="ImageView">
                <ownedComment xmi:id="440d58e8-565f-4614-8182-f3e1d8894de3" body="View of an Image, intended to support the HTML &amp;lt;IMG&amp;gt; tag.&#xA;Supports scaling via the HEIGHT and WIDTH attributes of the tag.&#xA;If the image is unable to be loaded any text specified via the&#xA;&lt;code>ALT&lt;/code> attribute will be rendered.&#xA;&lt;p>&#xA;While this class has been part of swing for a while now, it is public&#xA;as of 1.4.&#xA;&#xA;@author  Scott Violet&#xA;@see IconView&#xA;@since 1.4&#xA;" annotatedElement="dddc759e-721c-449d-9e47-1357faedc46e"/>
                <generalization xmi:id="9bc0cb59-2a42-4050-aa08-9180c46a4d21" isSubstitutable="true" general="ab032086-ff26-45b9-97ab-5ef382d9c93a"/>
                <nestedClassifier xmi:type="uml:Class" xmi:id="1c744a12-2732-4b33-bac3-6549648c5c47" name="ImageHandler" visibility="private" clientDependency="542b310c-12d8-4232-b902-12260ba0e6a6">
                  <ownedComment xmi:id="38eb155d-18f7-4612-b52c-e3c414896921" body="ImageHandler implements the ImageObserver to correctly update the&#xA;display as new parts of the image become available.&#xA;" annotatedElement="1c744a12-2732-4b33-bac3-6549648c5c47"/>
                  <interfaceRealization xmi:id="542b310c-12d8-4232-b902-12260ba0e6a6" name="" supplier="8e7d9abf-6973-4518-8b88-d7d05a8a0a9a" client="1c744a12-2732-4b33-bac3-6549648c5c47" contract="8e7d9abf-6973-4518-8b88-d7d05a8a0a9a"/>
                </nestedClassifier>
                <nestedClassifier xmi:type="uml:Class" xmi:id="89b243f8-1039-48c7-b74c-ec19ca1476a0" name="ImageLabelView" visibility="private">
                  <ownedComment xmi:id="3a242c42-4231-40c6-90f4-e9e4df4efd71" body="ImageLabelView is used if the image can't be loaded, and&#xA;the attribute specified an alt attribute. It overriden a handle of&#xA;methods as the text is hardcoded and does not come from the document.&#xA;" annotatedElement="89b243f8-1039-48c7-b74c-ec19ca1476a0"/>
                  <generalization xmi:id="4cbd4088-b0ff-4e24-9662-140da9ac85fa" isSubstitutable="true" general="29b2c635-bdcd-4da2-8ee8-8c019d6b4154"/>
                </nestedClassifier>
              </packagedElement>
              <packagedElement xmi:type="uml:Class" xmi:id="29b2c635-bdcd-4da2-8ee8-8c019d6b4154" name="InlineView">
                <ownedComment xmi:id="7c283102-c7ce-4951-9048-91271d00d421" body="Displays the &lt;dfn>inline element&lt;/dfn> styles&#xA;based upon css attributes.&#xA;&#xA;@author  Timothy Prinzing&#xA;" annotatedElement="29b2c635-bdcd-4da2-8ee8-8c019d6b4154"/>
                <generalization xmi:id="c1c16f63-8b93-47f8-8217-395185f79dec" isSubstitutable="true" general="8a97cb8c-33a2-4f63-94e6-ce47b4739ea1"/>
              </packagedElement>
              <packagedElement xmi:type="uml:Class" xmi:id="f2909bbd-2341-4965-89f2-d3e835166a1a" name="IsindexView" visibility="package" clientDependency="944c8e91-6796-44bf-ad2e-08231b009f94">
                <ownedComment xmi:id="4c3dcdd7-a9ec-4284-aeaa-62551fc6e4c9" body="A view that supports the &amp;lt;ISINDEX&amp;lt; tag.  This is implemented&#xA;as a JPanel that contains&#xA;&#xA;@author Sunita Mani&#xA;" annotatedElement="f2909bbd-2341-4965-89f2-d3e835166a1a"/>
                <generalization xmi:id="6d296f8e-6e36-4b46-b54d-1091e8ee896b" isSubstitutable="true" general="34b9b95e-01ab-49ae-86fd-3710658dd371"/>
