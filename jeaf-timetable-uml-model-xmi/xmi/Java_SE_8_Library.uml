                      <ownedComment xmi:id="0c967dee-9b6e-451c-9c1f-d01898175102" body="POAManagerImpl is the implementation of the POAManager interface.&#xA;Its public methods are activate(), hold_requests(), discard_requests()&#xA;and deactivate().&#xA;" annotatedElement="2364f874-5e27-4071-8e08-b25b07749837"/>
