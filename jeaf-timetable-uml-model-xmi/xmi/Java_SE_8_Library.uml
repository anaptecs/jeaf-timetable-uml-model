              <ownedComment xmi:id="f44bce50-3999-489d-b39a-85648e4e8618" body="Provide programmatic access to the persistent fields to be written&#xA;to ObjectOutput.&#xA;&#xA;@since 1.2&#xA;" annotatedElement="bdd4418d-06d2-44f7-8b33-614cd3374142"/>
