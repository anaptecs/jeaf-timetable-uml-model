            <packagedElement xmi:type="uml:Interface" xmi:id="3a1e2678-fd28-4af6-887b-0a4e866bd75a" name="RunnableFuture" isAbstract="true">
              <ownedComment xmi:id="976b5cd4-1505-4d55-82db-cb979c97b40f" body="A {@link Future} that is {@link Runnable}. Successful execution of&#xA;the {@code run} method causes completion of the {@code Future}&#xA;and allows access to its results.&#xA;@see FutureTask&#xA;@see Executor&#xA;@since 1.6&#xA;@author Doug Lea&#xA;@param &lt;V> The result type returned by this Future's {@code get} method&#xA;" annotatedElement="3a1e2678-fd28-4af6-887b-0a4e866bd75a"/>
              <ownedTemplateSignature xmi:type="uml:RedefinableTemplateSignature" xmi:id="5db80544-40c7-4586-80b3-6697d4cec553" name="" visibility="public" parameter="d36c3e5e-9155-4b50-8738-ec569653237e">
