            <packagedElement xmi:type="uml:Interface" xmi:id="3dc6c96c-13db-413d-b6e8-4d44cd2978e4" name="DynUnion" isAbstract="true">
              <ownedComment xmi:id="9b293e91-175e-4143-9dec-3451e0912bf0" body="The &lt;code>DynUnion&lt;/code> interface represents a &lt;code>DynAny&lt;/code> object&#xA;that is associated with an IDL union.&#xA;Union values can be traversed using the operations defined in &lt;code>DynAny&lt;/code>.&#xA;The first component in the union corresponds to the discriminator;&#xA;the second corresponds to the actual value of the union.&#xA;Calling the method &lt;code>next()&lt;/code> twice allows you to access both components.&#xA;@deprecated Use the new &lt;a href=&quot;../DynamicAny/DynUnion.html&quot;>DynUnion&lt;/a> instead&#xA;" annotatedElement="3dc6c96c-13db-413d-b6e8-4d44cd2978e4"/>
              <generalization xmi:id="898b048f-b3da-43ad-bc83-baf0e3a54dc8" isSubstitutable="true" general="b9b8a38d-9489-45b5-8efa-c474c2cb87d3"/>
              <generalization xmi:id="7d232b76-3534-4c82-8e00-7ff2bc15cd24" isSubstitutable="true" general="f94cadb7-5cc1-4586-98e9-436c6fedd2bd"/>
            </packagedElement>
            <packagedElement xmi:type="uml:Interface" xmi:id="81019d20-238a-4a9d-b955-810f29a6319b" name="DynValue" isAbstract="true">
              <ownedComment xmi:id="dc665a4a-c820-4ea5-88ee-42f60aa15be5" body="The representation of a &lt;code>DynAny&lt;/code> object that is associated&#xA;with an IDL value type.&#xA;@deprecated Use the new &lt;a href=&quot;../DynamicAny/DynValue.html&quot;>DynValue&lt;/a> instead&#xA;" annotatedElement="81019d20-238a-4a9d-b955-810f29a6319b"/>
