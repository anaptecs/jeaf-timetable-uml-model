              </ownedParameter>
              <ownedParameter xmi:type="uml:ClassifierTemplateParameter" xmi:id="21463b68-6b63-4619-af96-640bc31cbb0a" parameteredElement="1266403a-6147-4a26-9875-30671b323645">
                <ownedParameteredElement xmi:type="uml:Class" xmi:id="1266403a-6147-4a26-9875-30671b323645" name="V" templateParameter="21463b68-6b63-4619-af96-640bc31cbb0a"/>
              </ownedParameter>
            </ownedTemplateSignature>
            <generalization xmi:id="43ea7608-a647-45e5-9b5c-32f36c9436ef" isSubstitutable="true" general="73687539-2de6-4c5b-baa8-a67d07799195"/>
