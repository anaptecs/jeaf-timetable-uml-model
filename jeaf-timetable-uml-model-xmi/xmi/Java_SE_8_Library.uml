              <nestedClassifier xmi:type="uml:Class" xmi:id="4b736278-24d0-4d93-abc5-98d89189a5e5" name="BCSSServiceProvider" visibility="protected" clientDependency="c06a19e8-7a49-4094-86a8-71376f78597d">
                <ownedComment xmi:id="b801ffd6-4929-4d0f-a596-015399d40a93" body="subclasses may subclass this nested class to add behaviors for&#xA;each BeanContextServicesProvider.&#xA;" annotatedElement="4b736278-24d0-4d93-abc5-98d89189a5e5"/>
                <interfaceRealization xmi:id="c06a19e8-7a49-4094-86a8-71376f78597d" name="" supplier="41f4a654-a713-47bf-a391-e112be100ec5" client="4b736278-24d0-4d93-abc5-98d89189a5e5" contract="41f4a654-a713-47bf-a391-e112be100ec5"/>
              </nestedClassifier>
              <nestedClassifier xmi:type="uml:Class" xmi:id="5e849931-063c-4d80-b20c-58f13abe17e8" name="BCSSProxyServiceProvider" visibility="protected" clientDependency="cdca9f0c-764b-4d98-9419-b2fa185696fe f96175c3-9407-4eb8-8b9a-3221bced40cc">
                <interfaceRealization xmi:id="cdca9f0c-764b-4d98-9419-b2fa185696fe" name="" supplier="61ed0194-8482-483d-8224-9b7bfc430069" client="5e849931-063c-4d80-b20c-58f13abe17e8" contract="61ed0194-8482-483d-8224-9b7bfc430069"/>
