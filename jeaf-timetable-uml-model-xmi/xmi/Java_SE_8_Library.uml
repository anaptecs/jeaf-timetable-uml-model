            <packagedElement xmi:type="uml:Interface" xmi:id="635e7dca-3e23-4ae5-ad37-2595d14d244f" name="DynFixed" isAbstract="true">
              <ownedComment xmi:id="a7315129-514d-4e4d-a157-f27aa710c3e7" body="DynFixed objects support the manipulation of IDL fixed values.&#xA;Because IDL does not have a generic type that can represent fixed types with arbitrary&#xA;number of digits and arbitrary scale, the operations use the IDL string type.&#xA;" annotatedElement="635e7dca-3e23-4ae5-ad37-2595d14d244f"/>
