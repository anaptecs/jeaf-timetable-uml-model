                      <packagedElement xmi:type="uml:Class" xmi:id="9d6bb62a-1fea-4d32-817c-dac8fca9c31a" name="Base64">
                        <ownedComment xmi:id="e2ebf229-183c-473b-aa7b-f6ac09c92fbf" body="Implementation of MIME's Base64 encoding and decoding conversions.&#xA;Optimized code. (raw version taken from oreilly.jonathan.util,&#xA;and currently org.apache.xerces.ds.util.Base64)&#xA;&#xA;@author Raul Benito(Of the xerces copy, and little adaptations).&#xA;@author Anli Shundi&#xA;@author Christian Geuer-Pollmann&#xA;@see &lt;A HREF=&quot;ftp://ftp.isi.edu/in-notes/rfc2045.txt&quot;>RFC 2045&lt;/A>&#xA;@see com.sun.org.apache.xml.internal.security.transforms.implementations.TransformBase64Decode&#xA;" annotatedElement="9d6bb62a-1fea-4d32-817c-dac8fca9c31a"/>
                      </packagedElement>
