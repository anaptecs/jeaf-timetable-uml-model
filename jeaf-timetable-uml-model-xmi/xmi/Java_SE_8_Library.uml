              <packagedElement xmi:type="uml:Class" xmi:id="93945850-8602-4ecb-8044-36a0b501ea4b" name="ToolBarSeparatorPainter" visibility="package">
                <ownedComment xmi:id="a1c16799-6333-4f44-8f87-3e4bc2948bee" body="A special painter implementation for tool bar separators in Nimbus.&#xA;The designer tool doesn't have support for painters which render&#xA;repeated patterns, but that's exactly what the toolbar separator design&#xA;is for Nimbus. This custom painter is designed to handle this situation.&#xA;When support is added to the design tool / code generator to deal with&#xA;repeated patterns, then we can remove this class.&#xA;&lt;p>&#xA;" annotatedElement="93945850-8602-4ecb-8044-36a0b501ea4b"/>
                <generalization xmi:id="a8ed596f-904a-4c74-9833-ccd4fe306404" isSubstitutable="true" general="5806144a-f1e7-4e0c-b590-03a1c8d2f61f"/>
