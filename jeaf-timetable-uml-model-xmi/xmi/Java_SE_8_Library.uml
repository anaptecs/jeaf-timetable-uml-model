              </ownedParameter>
            </ownedTemplateSignature>
          </packagedElement>
          <packagedElement xmi:type="uml:Interface" xmi:id="c13a9bcb-e2bd-4e26-bfe8-2fe7735b6542" name="DocumentationTool" isAbstract="true">
            <ownedComment xmi:id="6ecfb923-f17d-46f8-964f-406a00d61a9b" body="Interface to invoke Java&amp;trade; programming language documentation tools from&#xA;programs.&#xA;" annotatedElement="c13a9bcb-e2bd-4e26-bfe8-2fe7735b6542"/>
            <generalization xmi:id="7a7f6d65-2bdc-4f14-9d44-dbcf8d631112" isSubstitutable="true" general="382ba024-f766-4084-aca6-ec444cb62aae"/>
            <generalization xmi:id="089adaf6-8037-407b-8268-075f32e542f4" isSubstitutable="true" general="113a441a-25ec-479d-8f1e-4dc3804345df"/>
            <nestedClassifier xmi:type="uml:Interface" xmi:id="e2c7b1c0-b65e-4639-b254-a454f2e564c0" name="DocumentationTask" isAbstract="true">
              <ownedComment xmi:id="7294a563-753e-4d85-b027-c2ba4c16c2b4" body="Interface representing a future for a documentation task.  The&#xA;task has not yet started.  To start the task, call&#xA;the {@linkplain #call call} method.&#xA;&#xA;&lt;p>Before calling the call method, additional aspects of the&#xA;task can be configured, for example, by calling the&#xA;{@linkplain #setLocale setLocale} method.&#xA;" annotatedElement="e2c7b1c0-b65e-4639-b254-a454f2e564c0"/>
              <generalization xmi:id="bd6b76c4-5086-45db-a88d-dddaa52a60a2" isSubstitutable="true" general="9b77065e-031d-4d31-adbe-ab9efc0b276a"/>
            </nestedClassifier>
            <nestedClassifier xmi:type="uml:Class" xmi:id="cd3cdf6f-6c40-4718-ab15-a72fbdbadd78" name="Location" clientDependency="3c3e59a3-e400-4cc9-9276-404d9148c86c">
              <ownedComment xmi:id="a3bbd062-78a8-4e68-969a-0904c4fd734e" body="Locations specific to {@link DocumentationTool}.&#xA;&#xA;@see StandardLocation&#xA;" annotatedElement="cd3cdf6f-6c40-4718-ab15-a72fbdbadd78"/>
              <interfaceRealization xmi:id="3c3e59a3-e400-4cc9-9276-404d9148c86c" name="" supplier="28fc941c-a924-4472-83bb-010e9ace32f1" client="cd3cdf6f-6c40-4718-ab15-a72fbdbadd78" contract="28fc941c-a924-4472-83bb-010e9ace32f1"/>
            </nestedClassifier>
          </packagedElement>
          <packagedElement xmi:type="uml:Interface" xmi:id="70d401d7-c875-4cc9-90a1-11f31fa196e9" name="FileObject" isAbstract="true">
            <ownedComment xmi:id="97be85fb-ab74-404c-9172-bd154421736b" body="File abstraction for tools.  In this context, &lt;em>file&lt;/em> means&#xA;an abstraction of regular files and other sources of data.  For&#xA;example, a file object can be used to represent regular files,&#xA;memory cache, or data in databases.&#xA;&#xA;&lt;p>All methods in this interface might throw a SecurityException if&#xA;a security exception occurs.&#xA;&#xA;&lt;p>Unless explicitly allowed, all methods in this interface might&#xA;throw a NullPointerException if given a {@code null} argument.&#xA;&#xA;@author Peter von der Ah&amp;eacute;&#xA;@author Jonathan Gibbons&#xA;@since 1.6&#xA;" annotatedElement="70d401d7-c875-4cc9-90a1-11f31fa196e9"/>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="13b9e1f0-b222-42a2-858c-6635c382a3d1" name="ForwardingFileObject" clientDependency="719c9fcf-ab8b-44a5-aacf-f10983e54962">
            <ownedComment xmi:id="0c4dc3da-308b-4f2d-8522-349c2e22ea9a" body="Forwards calls to a given file object.  Subclasses of this class&#xA;might override some of these methods and might also provide&#xA;additional fields and methods.&#xA;&#xA;@param &lt;F> the kind of file object forwarded to by this object&#xA;@author Peter von der Ah&amp;eacute;&#xA;@since 1.6&#xA;" annotatedElement="13b9e1f0-b222-42a2-858c-6635c382a3d1"/>
            <ownedTemplateSignature xmi:type="uml:RedefinableTemplateSignature" xmi:id="0c374edd-0e65-488a-b268-561c76d49ba3" name="" visibility="public" parameter="46935018-11e7-4187-bf09-b5b0ad74782a">
