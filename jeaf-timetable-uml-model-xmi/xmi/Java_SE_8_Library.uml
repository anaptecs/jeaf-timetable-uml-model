                <ownedParameter xmi:type="uml:ClassifierTemplateParameter" xmi:id="f1c99842-b781-4cc8-b85e-7cadd67289d3" parameteredElement="a42f41ce-d8a6-42b9-b2a4-38f25d69c6d8">
