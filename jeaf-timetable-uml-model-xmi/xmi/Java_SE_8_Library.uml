          <packagedElement xmi:type="uml:Package" xmi:id="104bb32a-938d-42db-b1a5-69e9e099ebb7" name="zone">
            <packagedElement xmi:type="uml:Class" xmi:id="dbb1a9ce-0cf0-4676-948e-7b3719aa6e1c" name="Ser" visibility="package" clientDependency="74738989-ae67-4b13-a66e-6900aaeae3a2">
              <ownedComment xmi:id="1ce73056-e088-4611-a9ee-89dfd07d3dbd" body="The shared serialization delegate for this package.&#xA;&#xA;@implNote&#xA;This class is mutable and should be created once per serialization.&#xA;&#xA;@serial include&#xA;@since 1.8&#xA;" annotatedElement="dbb1a9ce-0cf0-4676-948e-7b3719aa6e1c"/>
