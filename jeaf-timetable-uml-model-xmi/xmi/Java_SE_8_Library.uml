                <interfaceRealization xmi:id="2b447eda-b4ad-4129-befd-c14dbb44e22b" name="" supplier="f0504232-eacc-495e-8700-42ee9956bbaa" client="ef4a1805-c179-423b-be27-02e6d72f2013" contract="f0504232-eacc-495e-8700-42ee9956bbaa"/>
              </nestedClassifier>
              <nestedClassifier xmi:type="uml:Class" xmi:id="760a9c3a-c7d8-4e4b-9ce5-59112a4ce6c3" name="COWSubList" visibility="private" clientDependency="1e699b4c-9c5e-4800-af6e-988d914e3cd2">
                <ownedComment xmi:id="5f455bf4-3734-4841-b0ac-0b509976989f" body="Sublist for CopyOnWriteArrayList.&#xA;This class extends AbstractList merely for convenience, to&#xA;avoid having to define addAll, etc. This doesn't hurt, but&#xA;is wasteful.  This class does not need or use modCount&#xA;mechanics in AbstractList, but does need to check for&#xA;concurrent modification using similar mechanics.  On each&#xA;operation, the array that we expect the backing list to use&#xA;is checked and updated.  Since we do this for all of the&#xA;base operations invoked by those defined in AbstractList,&#xA;all is well.  While inefficient, this is not worth&#xA;improving.  The kinds of list operations inherited from&#xA;AbstractList are already so slow on COW sublists that&#xA;adding a bit more space/time doesn't seem even noticeable.&#xA;" annotatedElement="760a9c3a-c7d8-4e4b-9ce5-59112a4ce6c3"/>
                <ownedTemplateSignature xmi:type="uml:RedefinableTemplateSignature" xmi:id="f53d5611-f2b3-4495-b018-8ee892fcb89d" name="" visibility="public" parameter="3dce3ee1-46cf-4397-a566-61a09971456a">
                  <ownedParameter xmi:type="uml:ClassifierTemplateParameter" xmi:id="3dce3ee1-46cf-4397-a566-61a09971456a" parameteredElement="3a48b6d6-fe79-462b-b1e7-c04b79ae9236">
                    <ownedParameteredElement xmi:type="uml:Class" xmi:id="3a48b6d6-fe79-462b-b1e7-c04b79ae9236" name="E" templateParameter="3dce3ee1-46cf-4397-a566-61a09971456a"/>
                  </ownedParameter>
                </ownedTemplateSignature>
                <generalization xmi:id="9d0aa0d2-7fe4-4328-9090-ffb178cd4ebd" isSubstitutable="true" general="f1616513-83ee-4adf-b64d-df28f428d282"/>
                <interfaceRealization xmi:id="1e699b4c-9c5e-4800-af6e-988d914e3cd2" name="" supplier="6be53522-274b-4bdb-9d8b-e36cd2f9faa3" client="760a9c3a-c7d8-4e4b-9ce5-59112a4ce6c3" contract="6be53522-274b-4bdb-9d8b-e36cd2f9faa3"/>
              </nestedClassifier>
              <nestedClassifier xmi:type="uml:Class" xmi:id="f2340121-beba-49ea-8323-b075f74a220f" name="COWSubListIterator" visibility="private" clientDependency="32798375-4124-4871-a317-25e70db62836">
                <ownedTemplateSignature xmi:type="uml:RedefinableTemplateSignature" xmi:id="4ee41259-06a9-4fd4-9056-42c3cf12589a" name="" visibility="public" parameter="4ad77483-bd6d-4e3b-96cf-d27d270a8a46">
                  <ownedParameter xmi:type="uml:ClassifierTemplateParameter" xmi:id="4ad77483-bd6d-4e3b-96cf-d27d270a8a46" parameteredElement="ee5c73b3-5867-4923-a25f-1dddae57e84d">
