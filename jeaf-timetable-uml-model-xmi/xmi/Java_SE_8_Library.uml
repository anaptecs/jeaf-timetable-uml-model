                    <packagedElement xmi:type="uml:Interface" xmi:id="3f391e71-dc4a-4c88-a4c9-b4f2dd8e4dd7" name="IDLNameTranslator" isAbstract="true">
                      <ownedComment xmi:id="fe2e3454-1146-409d-85fe-a456ba505c2d" body="Translates between methods on an interface and RMI-IIOP encodings&#xA;of those methods as names.&#xA;" annotatedElement="3f391e71-dc4a-4c88-a4c9-b4f2dd8e4dd7"/>
                    </packagedElement>
                    <packagedElement xmi:type="uml:Class" xmi:id="ad7da22b-e332-4222-87bf-b8010c42ed07" name="PresentationDefaults" isAbstract="true"/>
