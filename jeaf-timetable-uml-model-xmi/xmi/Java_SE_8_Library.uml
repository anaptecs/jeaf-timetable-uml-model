                    <packagedElement xmi:type="uml:Class" xmi:id="607549ac-adf9-41a4-bcfd-758b459298af" name="ClassGen" clientDependency="a4e3398c-2764-49d4-8447-1c1ebb2c129e">
                      <ownedComment xmi:id="11e612bc-9409-4630-9d57-4dd650a30a19" body="Template class for building up a java class. May be initialized with an&#xA;existing java class (file).&#xA;&#xA;@see JavaClass&#xA;@author  &lt;A HREF=&quot;mailto:markus.dahm@berlin.de&quot;>M. Dahm&lt;/A>&#xA;" annotatedElement="607549ac-adf9-41a4-bcfd-758b459298af"/>
                      <generalization xmi:id="fa901b2c-0acf-4569-a4aa-e0afafa40e14" isSubstitutable="true" general="37637924-0484-480c-a0d7-242a0174063e"/>
