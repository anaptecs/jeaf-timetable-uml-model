          <packagedElement xmi:type="uml:Class" xmi:id="f83c9444-cc7a-45d5-895e-8e87aacad798" name="InvalidApplicationException">
            <ownedComment xmi:id="d352edb0-85f2-4638-affb-167a04649123" body="Thrown when an attempt is made to apply either of the following: A&#xA;subquery expression to an MBean or a qualified attribute expression&#xA;to an MBean of the wrong class.  This exception is used internally&#xA;by JMX during the evaluation of a query.  User code does not&#xA;usually see it.&#xA;&#xA;@since 1.5&#xA;" annotatedElement="f83c9444-cc7a-45d5-895e-8e87aacad798"/>
