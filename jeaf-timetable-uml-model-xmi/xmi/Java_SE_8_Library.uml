            <packagedElement xmi:type="uml:Class" xmi:id="6ddd566c-629f-4fe0-bde4-0b37bac9b3fd" name="DynamicImplementation">
              <ownedComment xmi:id="8310a6ac-e35f-4c41-996b-72de03281de0" body="@deprecated org.omg.CORBA.DynamicImplementation&#xA;" annotatedElement="6ddd566c-629f-4fe0-bde4-0b37bac9b3fd"/>
              <generalization xmi:id="1611becb-07b5-4e94-bedf-daa101fb2170" isSubstitutable="true" general="1f22f99e-8789-483b-8626-1e5e54fec134"/>
