                    <packagedElement xmi:type="uml:Class" xmi:id="7918c7ea-542d-40d9-b0cc-99a9e853a08e" name="SWAP" clientDependency="6d2d498a-6995-4302-adb9-8857928449b1 fc74f838-19c7-4036-88d6-4ce6cd7ebadd">
                      <ownedComment xmi:id="2133f33a-24e8-4890-8fe7-d449703e2a56" body="SWAP - Swa top operand stack word&#xA;&lt;PRE>Stack: ..., word2, word1 -&amp;gt; ..., word1, word2&lt;/PRE>&#xA;&#xA;@author  &lt;A HREF=&quot;mailto:markus.dahm@berlin.de&quot;>M. Dahm&lt;/A>&#xA;" annotatedElement="7918c7ea-542d-40d9-b0cc-99a9e853a08e"/>
