                    </packagedElement>
                    <packagedElement xmi:type="uml:Class" xmi:id="4ab6cbc0-8a09-4dbf-82cc-d7c8fbdf7893" name="DatatypeMessageFormatter">
                      <ownedComment xmi:id="e5ee4478-2647-421b-83b2-2a3496149447" body="&lt;p>Used to format JAXP 1.3 Datatype API error messages using a specified locale.&lt;/p>&#xA;&#xA;@author  Neeraj Bajaj, Sun Microsystems&#xA;@version $Id: DatatypeMessageFormatter.java,v 1.6 2010-11-01 04:40:14 joehw Exp $&#xA;" annotatedElement="4ab6cbc0-8a09-4dbf-82cc-d7c8fbdf7893"/>
