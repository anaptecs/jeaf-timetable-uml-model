                        <packagedElement xmi:type="uml:Class" xmi:id="b68f45ce-2228-4e00-ace9-2c64741166d7" name="ReferenceSubTreeData" clientDependency="543c905a-7e46-481a-932f-29f06b880dec">
                          <ownedComment xmi:id="bc430da6-792f-4e7f-8bf3-27ed4d2e03fd" body="A representation of a &lt;code>ReferenceNodeSetData&lt;/code> type containing a node-set.&#xA;This is a subtype of NodeSetData that represents a dereferenced&#xA;same-document URI as the root of a subdocument. The main reason is&#xA;for efficiency and performance, as some transforms can operate&#xA;directly on the subdocument and there is no need to convert it&#xA;first to an XPath node-set.&#xA;" annotatedElement="b68f45ce-2228-4e00-ace9-2c64741166d7"/>
                          <interfaceRealization xmi:id="543c905a-7e46-481a-932f-29f06b880dec" name="" supplier="9b51f713-e3d1-47c5-8d78-3149616b0eb5" client="b68f45ce-2228-4e00-ace9-2c64741166d7" contract="9b51f713-e3d1-47c5-8d78-3149616b0eb5"/>
                          <nestedClassifier xmi:type="uml:Class" xmi:id="0b1cb3a1-938e-4564-9642-21ee2a493c2d" name="DelayedNodeIterator" visibility="package" clientDependency="69511ac4-87b3-42e9-b651-35b01570641b">
                            <ownedComment xmi:id="4fa71c74-11c9-4118-b678-a700e108d23d" body="This is an Iterator that contains a backing node-set that is&#xA;not populated until the caller first attempts to advance the iterator.&#xA;" annotatedElement="0b1cb3a1-938e-4564-9642-21ee2a493c2d"/>
                            <interfaceRealization xmi:id="69511ac4-87b3-42e9-b651-35b01570641b" name="" supplier="561395f3-9bca-4d94-a0c5-80999e777b21" client="0b1cb3a1-938e-4564-9642-21ee2a493c2d" contract="561395f3-9bca-4d94-a0c5-80999e777b21"/>
                          </nestedClassifier>
                        </packagedElement>
                        <packagedElement xmi:type="uml:Interface" xmi:id="561395f3-9bca-4d94-a0c5-80999e777b21" name="Iterator&lt;Node>">
