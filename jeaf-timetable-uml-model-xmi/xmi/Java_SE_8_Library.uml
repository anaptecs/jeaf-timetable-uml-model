                  <generalization xmi:id="3fc16200-300d-495b-bbfb-2bfb0a84a405" isSubstitutable="true" general="5258e060-7293-4026-ada0-4e0991972607"/>
                </nestedClassifier>
                <nestedClassifier xmi:type="uml:Class" xmi:id="4f90d81f-df5f-4057-a340-e42b4465de5b" name="EnumMapping" visibility="private">
                  <ownedTemplateSignature xmi:type="uml:RedefinableTemplateSignature" xmi:id="7dad171f-9977-4c99-a136-d605b21fde07" name="" visibility="public" parameter="8e3b2c72-5aac-4208-a509-ec7107d32b9c">
