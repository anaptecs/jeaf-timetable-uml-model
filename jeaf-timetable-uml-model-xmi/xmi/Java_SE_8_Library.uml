            <nestedClassifier xmi:type="uml:Class" xmi:id="49464aa5-cb85-47aa-ba89-5032659216d5" name="SortManager" visibility="private">
              <ownedComment xmi:id="5039ba3d-8bc5-49ad-bb87-25bd0817c5c7" body="SortManager provides support for managing the selection and variable&#xA;row heights when sorting is enabled. This information is encapsulated&#xA;into a class to avoid bulking up JTable.&#xA;" annotatedElement="49464aa5-cb85-47aa-ba89-5032659216d5"/>
            </nestedClassifier>
