            <nestedClassifier xmi:type="uml:Class" xmi:id="e1ad5690-6922-44ce-92dc-73652091cb0e" name="LinkedEntryIterator" visibility="package" clientDependency="5036d07e-2385-4607-ad6a-644ccee532fb">
              <generalization xmi:id="bd8a0a49-7499-46d7-9eb1-fddb9e5a4bde" isSubstitutable="true" general="d071b704-acac-4e12-9cbc-50ce66883054"/>
