                <ownedParameter xmi:type="uml:ClassifierTemplateParameter" xmi:id="2660b20e-9946-45b5-813c-c686c3ee002e" parameteredElement="1154c853-3688-4854-b0e4-451be6e0b133" constrainingClassifier="859a55a9-36b5-480c-8ddf-533225e81592">
