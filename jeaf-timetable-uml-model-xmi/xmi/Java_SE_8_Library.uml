                </packagedElement>
                <packagedElement xmi:type="uml:Class" xmi:id="333beb28-7d0c-4e31-8c65-17ef83962ba5" name="JDMAclBlock" visibility="package">
                  <generalization xmi:id="72621471-3c2a-49d0-a402-3e17153bf421" isSubstitutable="true" general="9441a0f3-2a00-4d93-9cbb-506619f42419"/>
                </packagedElement>
                <packagedElement xmi:type="uml:Class" xmi:id="743fd4ac-3c22-4cb8-ac40-d4d2daf93a4f" name="JDMAclItem" visibility="package">
