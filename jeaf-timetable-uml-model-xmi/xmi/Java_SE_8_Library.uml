          <packagedElement xmi:type="uml:Class" xmi:id="f8e42b9a-54f6-4414-b743-c8cf8c79f861" name="ProcessImpl" visibility="package">
            <generalization xmi:id="f01c1ce3-6929-440a-bd1d-fe9fd72edfe5" isSubstitutable="true" general="f55865d4-45fb-41a5-9c16-44134e7104eb"/>
