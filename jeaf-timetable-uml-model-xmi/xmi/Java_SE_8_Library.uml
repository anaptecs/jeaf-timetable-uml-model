              <nestedClassifier xmi:type="uml:Class" xmi:id="1a69b153-aed5-4483-965e-0de71fdb48c1" name="DefaultTransferHandler" visibility="package" clientDependency="ceec9108-f7f8-4af0-9861-37a07ed03bd0">
                <ownedComment xmi:id="bb2c5982-b39b-489b-b292-855c9a7c4452" body="A Simple TransferHandler that exports the data as a String, and&#xA;imports the data from the String clipboard.  This is only used&#xA;if the UI hasn't supplied one, which would only happen if someone&#xA;hasn't subclassed Basic.&#xA;" annotatedElement="1a69b153-aed5-4483-965e-0de71fdb48c1"/>
                <generalization xmi:id="17f11c38-417e-4ec9-814e-fce2eb015c3c" isSubstitutable="true" general="5dbaf2c1-d1a9-4591-94aa-bb69a86b251e"/>
