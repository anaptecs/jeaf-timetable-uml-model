              <nestedClassifier xmi:type="uml:Class" xmi:id="3f071603-9dbd-4d56-8df5-78652b93fe50" name="WrappedMember" visibility="private">
                <ownedComment xmi:id="fc8ed653-6f61-477b-92e4-ee95a6f90095" body="This subclass allows a wrapped method handle to be re-associated with an arbitrary member name." annotatedElement="3f071603-9dbd-4d56-8df5-78652b93fe50"/>
