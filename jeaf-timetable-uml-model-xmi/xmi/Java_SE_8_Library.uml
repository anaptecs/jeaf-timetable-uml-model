            <packagedElement xmi:type="uml:Class" xmi:id="d2895360-79b1-4d61-b4e7-1f08c1fc7112" name="DynEnumHelper" isAbstract="true">
              <ownedComment xmi:id="d6aaf108-6afa-4163-8fc3-733aa107c6b7" body="DynEnum objects support the manipulation of IDL enumerated values.&#xA;The current position of a DynEnum is always -1.&#xA;" annotatedElement="d2895360-79b1-4d61-b4e7-1f08c1fc7112"/>
            </packagedElement>
            <packagedElement xmi:type="uml:Interface" xmi:id="fdff36c0-8eba-40bd-92b2-eb7026bef82c" name="DynEnumOperations" isAbstract="true">
              <ownedComment xmi:id="678298e2-0e18-4b0b-8b59-79d60d363be2" body="DynEnum objects support the manipulation of IDL enumerated values.&#xA;The current position of a DynEnum is always -1.&#xA;" annotatedElement="fdff36c0-8eba-40bd-92b2-eb7026bef82c"/>
              <generalization xmi:id="828f1195-c4eb-4a47-8d23-50f701a32efc" isSubstitutable="true" general="6c876d96-a169-4e56-8d2f-6f0fc47f3a62"/>
