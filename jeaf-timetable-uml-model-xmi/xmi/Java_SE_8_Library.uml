            <packagedElement xmi:type="uml:Class" xmi:id="0a691024-f78a-41c5-87cd-2b22f37d49df" name="ImplicitActivationPolicyValue" clientDependency="d2a6d773-1977-4c3a-8b50-405bbee8ebfd">
              <ownedComment xmi:id="e9636541-6d28-4f9b-9a9a-539ccf7b782c" body="ImplicitActivationPolicyValue has the following&#xA;semantics.&#xA;IMPLICIT_ACTIVATION to indicate implicit activation&#xA;of servants.  This requires SYSTEM_ID and RETAIN&#xA;policies to be set.&#xA;NO_IMPLICIT_ACTIVATION to indicate no implicit&#xA;servant activation.&#xA;" annotatedElement="0a691024-f78a-41c5-87cd-2b22f37d49df"/>
              <interfaceRealization xmi:id="d2a6d773-1977-4c3a-8b50-405bbee8ebfd" name="" supplier="b38468cc-c261-4f52-86ea-658766759ede" client="0a691024-f78a-41c5-87cd-2b22f37d49df" contract="b38468cc-c261-4f52-86ea-658766759ede"/>
            </packagedElement>
            <packagedElement xmi:type="uml:Interface" xmi:id="fc4c6c59-cccc-4efc-8e57-5c654639f774" name="LIFESPAN_POLICY_ID" isAbstract="true">
