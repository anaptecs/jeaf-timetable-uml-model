              <nestedClassifier xmi:type="uml:Class" xmi:id="b9d2cf68-5780-4503-aea0-8cd94bb842b6" name="LongStreamBuilderImpl" visibility="package" clientDependency="140efd95-4008-438e-9fcc-ee20b24f405c">
                <generalization xmi:id="2caa47ef-c19c-4ed0-b168-86e1c3cdcc4a" isSubstitutable="true" general="4f965088-0e7a-46c0-91b6-b7090b00c7e9"/>
                <interfaceRealization xmi:id="140efd95-4008-438e-9fcc-ee20b24f405c" name="" supplier="ba6731ea-2ec8-4f33-8bec-d75c63f9a31f" client="b9d2cf68-5780-4503-aea0-8cd94bb842b6" contract="ba6731ea-2ec8-4f33-8bec-d75c63f9a31f"/>
