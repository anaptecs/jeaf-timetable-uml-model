                </nestedClassifier>
                <nestedClassifier xmi:type="uml:Class" xmi:id="a512cc2e-bc49-4d0d-9cd6-2cd868c2e8b1" name="AssertiveAttribute" visibility="package" clientDependency="d1e4580f-efdd-42a7-ab96-b822f33020ae">
                  <generalization xmi:id="fedf7f9a-8ba8-4585-b736-5e94f8cb7124" isSubstitutable="true" general="fb15e7d4-8146-4cba-ae66-2878d4c7f3e7"/>
                  <interfaceRealization xmi:id="d1e4580f-efdd-42a7-ab96-b822f33020ae" name="" supplier="cba57868-07ad-410f-879c-24bc9c6383d5" client="a512cc2e-bc49-4d0d-9cd6-2cd868c2e8b1" contract="cba57868-07ad-410f-879c-24bc9c6383d5"/>
                </nestedClassifier>
                <nestedClassifier xmi:type="uml:Class" xmi:id="aa674348-5209-4fea-b654-e387ac852be4" name="NumericAttribute" visibility="package" clientDependency="1695718e-964e-4ed2-a2f0-66a1bae95344">
                  <generalization xmi:id="fcf04581-cfca-43d6-96ce-148212047d81" isSubstitutable="true" general="fb15e7d4-8146-4cba-ae66-2878d4c7f3e7"/>
                  <interfaceRealization xmi:id="1695718e-964e-4ed2-a2f0-66a1bae95344" name="" supplier="cba57868-07ad-410f-879c-24bc9c6383d5" client="aa674348-5209-4fea-b654-e387ac852be4" contract="cba57868-07ad-410f-879c-24bc9c6383d5"/>
                </nestedClassifier>
              </packagedElement>
              <packagedElement xmi:type="uml:Class" xmi:id="f6a8449c-5737-4f65-a076-6b2068c7a35a" name="RTFEditorKit">
                <ownedComment xmi:id="a199ebe7-7e2f-4b8f-95bf-4e482a13a877" body="This is the default implementation of RTF editing&#xA;functionality.  The RTF support was not written by the&#xA;Swing team.  In the future we hope to improve the support&#xA;provided.&#xA;&#xA;@author  Timothy Prinzing (of this class, not the package!)&#xA;" annotatedElement="f6a8449c-5737-4f65-a076-6b2068c7a35a"/>
                <generalization xmi:id="09988063-5085-4737-b67c-f230352c7ca4" isSubstitutable="true" general="0def593a-d057-4f62-b0db-cac959d2a0f8"/>
              </packagedElement>
              <packagedElement xmi:type="uml:Class" xmi:id="0fa4f558-6297-4753-bea0-8133365c5218" name="RTFGenerator" visibility="package">
                <ownedComment xmi:id="f8f5f8ca-aeca-4f24-9659-9211f231eabb" body="Generates an RTF output stream (java.io.OutputStream) from rich text&#xA;(handed off through a series of LTTextAcceptor calls).  Can be used to&#xA;generate RTF from any object which knows how to write to a text acceptor&#xA;(e.g., LTAttributedText and LTRTFFilter).&#xA;&#xA;&lt;p>Note that this is a lossy conversion since RTF's model of&#xA;text does not exactly correspond with LightText's.&#xA;&#xA;@see LTAttributedText&#xA;@see LTRTFFilter&#xA;@see LTTextAcceptor&#xA;@see java.io.OutputStream&#xA;" annotatedElement="0fa4f558-6297-4753-bea0-8133365c5218"/>
                <generalization xmi:id="ed49a84c-7394-4a03-9678-ed742359d4b5" isSubstitutable="true" general="42483ff6-53a9-4bf6-a5fa-caa9c31afef7"/>
                <nestedClassifier xmi:type="uml:Class" xmi:id="9621394a-6a81-45ee-a108-8b3f9c82f148" name="CharacterKeywordPair" visibility="package"/>
              </packagedElement>
              <packagedElement xmi:type="uml:Class" xmi:id="3e901d72-103d-491e-a53a-30524f0f3909" name="RTFParser" visibility="package" isAbstract="true">
                <ownedComment xmi:id="efeeafc7-77a4-4a55-bb2d-eef67e4261e7" body="&lt;b>RTFParser&lt;/b> is a subclass of &lt;b>AbstractFilter&lt;/b> which understands basic RTF syntax&#xA;and passes a stream of control words, text, and begin/end group&#xA;indications to its subclass.&#xA;&#xA;Normally programmers will only use &lt;b>RTFFilter&lt;/b>, a subclass of this class that knows what to&#xA;do with the tokens this class parses.&#xA;&#xA;@see AbstractFilter&#xA;@see RTFFilter&#xA;" annotatedElement="3e901d72-103d-491e-a53a-30524f0f3909"/>
                <generalization xmi:id="32832c6c-9726-4390-99d0-141ba749c44d" isSubstitutable="true" general="4cbbb299-7215-4f77-aa5a-5e737aab9f69"/>
              </packagedElement>
              <packagedElement xmi:type="uml:Class" xmi:id="ca804556-ab0e-4b61-9f17-579241307cbd" name="RTFReader" visibility="package">
                <ownedComment xmi:id="526098f7-281b-48fd-9f5d-9fd7f958ff92" body="Takes a sequence of RTF tokens and text and appends the text&#xA;described by the RTF to a &lt;code>StyledDocument&lt;/code> (the &lt;em>target&lt;/em>).&#xA;The RTF is lexed&#xA;from the character stream by the &lt;code>RTFParser&lt;/code> which is this class's&#xA;superclass.&#xA;&#xA;This class is an indirect subclass of OutputStream. It must be closed&#xA;in order to guarantee that all of the text has been sent to&#xA;the text acceptor.&#xA;&#xA;@see RTFParser&#xA;@see java.io.OutputStream&#xA;" annotatedElement="ca804556-ab0e-4b61-9f17-579241307cbd"/>
                <generalization xmi:id="cc4012bc-9a2e-4e27-b338-2cfdacecc6c3" isSubstitutable="true" general="3e901d72-103d-491e-a53a-30524f0f3909"/>
                <nestedClassifier xmi:type="uml:Interface" xmi:id="dacb9deb-2228-4e5d-b033-f02645fa9bea" name="Destination" visibility="package" isAbstract="true">
                  <ownedComment xmi:id="7a0fd39a-c70d-4682-8213-eec5d00fcc03" body="An interface (could be an entirely abstract class) describing&#xA;a destination. The RTF reader always has a current destination&#xA;which is where text is sent.&#xA;&#xA;@see RTFReader&#xA;" annotatedElement="dacb9deb-2228-4e5d-b033-f02645fa9bea"/>
                </nestedClassifier>
                <nestedClassifier xmi:type="uml:Class" xmi:id="c19cb2b6-32b5-40a4-9a5f-a016852484b5" name="DiscardingDestination" visibility="package" clientDependency="1e9d2b9f-c4db-4de9-829a-d2a9aa2f6249">
                  <ownedComment xmi:id="2e2fb315-dfb6-49bc-9354-6a3e0b13270c" body="This data-sink class is used to implement ignored destinations&#xA;(e.g. {\*\blegga blah blah blah} )&#xA;It accepts all keywords and text but does nothing with them." annotatedElement="c19cb2b6-32b5-40a4-9a5f-a016852484b5"/>
                  <interfaceRealization xmi:id="1e9d2b9f-c4db-4de9-829a-d2a9aa2f6249" name="" supplier="dacb9deb-2228-4e5d-b033-f02645fa9bea" client="c19cb2b6-32b5-40a4-9a5f-a016852484b5" contract="dacb9deb-2228-4e5d-b033-f02645fa9bea"/>
                </nestedClassifier>
                <nestedClassifier xmi:type="uml:Class" xmi:id="fea2a5b6-4cd8-49e8-83fe-d8922c8bb30c" name="FonttblDestination" visibility="package" clientDependency="f0a7d79e-5f7f-48a5-b0d9-fc9423101619">
                  <ownedComment xmi:id="bd199bc9-3c6c-40b0-8f7f-d4f35e42ea91" body="Reads the fonttbl group, inserting fonts into the RTFReader's&#xA;fontTable dictionary." annotatedElement="fea2a5b6-4cd8-49e8-83fe-d8922c8bb30c"/>
                  <interfaceRealization xmi:id="f0a7d79e-5f7f-48a5-b0d9-fc9423101619" name="" supplier="dacb9deb-2228-4e5d-b033-f02645fa9bea" client="fea2a5b6-4cd8-49e8-83fe-d8922c8bb30c" contract="dacb9deb-2228-4e5d-b033-f02645fa9bea"/>
                </nestedClassifier>
                <nestedClassifier xmi:type="uml:Class" xmi:id="3c98c7bc-9fba-4598-9d72-5bed81313a22" name="ColortblDestination" visibility="package" clientDependency="8cf32160-ccc6-44e9-9bd0-18670add31b2">
                  <ownedComment xmi:id="fa50a3e7-d579-4040-8b8a-11bf53ff020d" body="Reads the colortbl group. Upon end-of-group, the RTFReader's&#xA;color table is set to an array containing the read colors." annotatedElement="3c98c7bc-9fba-4598-9d72-5bed81313a22"/>
                  <interfaceRealization xmi:id="8cf32160-ccc6-44e9-9bd0-18670add31b2" name="" supplier="dacb9deb-2228-4e5d-b033-f02645fa9bea" client="3c98c7bc-9fba-4598-9d72-5bed81313a22" contract="dacb9deb-2228-4e5d-b033-f02645fa9bea"/>
                </nestedClassifier>
                <nestedClassifier xmi:type="uml:Class" xmi:id="afa2f7ac-b49c-4df7-be0f-bc2b160bc816" name="StylesheetDestination" visibility="package" clientDependency="d4fb0153-4369-4180-a9c4-49f072b7faa8">
                  <ownedComment xmi:id="b48a54e7-c4d5-45fd-824e-ae16aae9b9ed" body="Handles the stylesheet keyword. Styles are read and sorted&#xA;into the three style arrays in the RTFReader." annotatedElement="afa2f7ac-b49c-4df7-be0f-bc2b160bc816"/>
                  <generalization xmi:id="e193079d-2a87-40d5-b3a8-2b82b797331b" isSubstitutable="true" general="c19cb2b6-32b5-40a4-9a5f-a016852484b5"/>
                  <interfaceRealization xmi:id="d4fb0153-4369-4180-a9c4-49f072b7faa8" name="" supplier="dacb9deb-2228-4e5d-b033-f02645fa9bea" client="afa2f7ac-b49c-4df7-be0f-bc2b160bc816" contract="dacb9deb-2228-4e5d-b033-f02645fa9bea"/>
                  <nestedClassifier xmi:type="uml:Class" xmi:id="7c9b57cb-43f9-4f32-8d13-9e777940abd3" name="StyleDefiningDestination" visibility="package" clientDependency="aee1d15a-501a-420b-a177-20e2ecbb5541">
                    <ownedComment xmi:id="92a18d00-0b76-46f4-b64c-faa083d402fb" body="This subclass handles an individual style" annotatedElement="7c9b57cb-43f9-4f32-8d13-9e777940abd3"/>
                    <generalization xmi:id="b8b270b5-3f48-49af-b937-6ae726e56213" isSubstitutable="true" general="d92b770d-9bae-49f2-a892-654ea829dd1e"/>
