                    <packagedElement xmi:type="uml:Class" xmi:id="5fc92301-8639-4f3c-8578-170d61c53092" name="ParserConfigurationSettings" clientDependency="628fbab1-2cd1-489d-bf5b-9876dd49adb8">
                      <ownedComment xmi:id="14b75d9d-fe3e-4f64-abdd-b834466b3d39" body="This class implements the basic operations for managing parser&#xA;configuration features and properties. This utility class can&#xA;be used as a base class for parser configurations or separately&#xA;to encapsulate a number of parser settings as a component&#xA;manager.&#xA;&lt;p>&#xA;This class can be constructed with a &quot;parent&quot; settings object&#xA;(in the form of an &lt;code>XMLComponentManager&lt;/code>) that allows&#xA;parser configuration settings to be &quot;chained&quot; together.&#xA;&#xA;@author Andy Clark, IBM&#xA;&#xA;@version $Id: ParserConfigurationSettings.java,v 1.6 2010-11-01 04:40:14 joehw Exp $&#xA;" annotatedElement="5fc92301-8639-4f3c-8578-170d61c53092"/>
                      <interfaceRealization xmi:id="628fbab1-2cd1-489d-bf5b-9876dd49adb8" name="" supplier="16d84f0d-7e17-4249-8410-4c29502f0afd" client="5fc92301-8639-4f3c-8578-170d61c53092" contract="16d84f0d-7e17-4249-8410-4c29502f0afd"/>
                    </packagedElement>
                    <packagedElement xmi:type="uml:Class" xmi:id="021fdeeb-549b-416a-9f48-f307c9b5cd83" name="PropertyState"/>
                    <packagedElement xmi:type="uml:Class" xmi:id="6b5fe7c9-1700-4876-83a1-5f4272e61d7d" name="SAX2XNI" clientDependency="1e2a8bd4-ccce-44b3-998e-fd64db608bc3 55a46110-88d2-417d-8bf1-0ae6bb9eb982">
                      <ownedComment xmi:id="5e04090b-d4c0-43f5-aba1-9e818a02b42d" body="Receves SAX {@link ContentHandler} events&#xA;and produces the equivalent {@link XMLDocumentHandler} events.&#xA;&#xA;@author&#xA;Kohsuke Kawaguchi (kohsuke.kawaguchi@sun.com)&#xA;" annotatedElement="6b5fe7c9-1700-4876-83a1-5f4272e61d7d"/>
                      <interfaceRealization xmi:id="1e2a8bd4-ccce-44b3-998e-fd64db608bc3" name="" supplier="c1ba9edb-3b3b-4e75-a057-ba7df9208c25" client="6b5fe7c9-1700-4876-83a1-5f4272e61d7d" contract="c1ba9edb-3b3b-4e75-a057-ba7df9208c25"/>
