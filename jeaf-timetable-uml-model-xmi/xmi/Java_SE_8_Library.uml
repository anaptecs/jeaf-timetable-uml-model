                <ownedComment xmi:id="dd7ab839-031a-4d9b-ab7f-13287311c0bb" body="Provides the Synth L&amp;amp;F UI delegate for&#xA;{@link javax.swing.JSplitPane}.&#xA;&#xA;@author Scott Violet&#xA;@since 1.7&#xA;" annotatedElement="c60d4e3b-3d8b-48ad-b08e-72f4621a4eda"/>
