              <ownedComment xmi:id="29c19181-1963-4267-9a3d-160744a1f8e3" body="This policy specifies whether implicit activation&#xA;of servants is supported in the created POA.&#xA;" annotatedElement="267e587c-ddb5-4b8f-b43d-4f949534ca89"/>
