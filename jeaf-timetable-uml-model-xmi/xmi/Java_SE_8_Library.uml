            <nestedClassifier xmi:type="uml:Class" xmi:id="5f69282a-5aee-469a-b406-9bc9dd69cc22" name="PlainEditorKit" visibility="package" clientDependency="638a59f8-d236-4ec3-8b82-a2d8ae617a6d">
              <generalization xmi:id="4af3e302-9f28-405a-aa2f-0e27276f42ad" isSubstitutable="true" general="583b7eef-e7be-41c7-86d7-30d4f41b945e"/>
