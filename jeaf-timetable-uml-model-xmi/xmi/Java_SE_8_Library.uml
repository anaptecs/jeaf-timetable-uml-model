                    <packagedElement xmi:type="uml:Class" xmi:id="257d755f-3725-45fb-8402-ecf23795ce05" name="DOMInputSource">
                      <ownedComment xmi:id="9539692e-aa80-4db9-9bae-f3bdfa1f8439" body="&lt;p>An &lt;code>XMLInputSource&lt;/code> analogue to &lt;code>javax.xml.transform.dom.DOMSource&lt;/code>.&lt;/p>&#xA;&#xA;" annotatedElement="257d755f-3725-45fb-8402-ecf23795ce05"/>
