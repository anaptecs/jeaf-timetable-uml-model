                    <nestedClassifier xmi:type="uml:Class" xmi:id="412f4070-ea5a-4095-8060-380089039265" name="Grid" visibility="private">
                      <ownedComment xmi:id="7a04acef-0336-4bba-9a09-8d19dbbf48df" body="This should be pulled out into its own class if more classes need to&#xA;use it.&#xA;&lt;p>&#xA;Grid is used to draw the track for windows scrollbars. Grids&#xA;are cached in a HashMap, with the key being the rgb components&#xA;of the foreground/background colors. Further the Grid is held through&#xA;a WeakRef so that it can be freed when no longer needed. As the&#xA;Grid is rather expensive to draw, it is drawn in a BufferedImage.&#xA;" annotatedElement="412f4070-ea5a-4095-8060-380089039265"/>
                    </nestedClassifier>
                  </packagedElement>
