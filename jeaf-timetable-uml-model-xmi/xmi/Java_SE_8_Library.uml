                    <ownedComment xmi:id="0febb6ab-ad1a-433b-b516-e879e667ce90" body="&lt;p> &lt;code>ContactInfoList&lt;/code> contains one or more&#xA;{@link com.sun.corba.se.pept.transport.ContactInfo ContactInfo}.&#xA;&#xA;@author Harold Carr&#xA;" annotatedElement="1b29852e-9db3-4ba0-a380-a7442fab45b2"/>
                  </packagedElement>
