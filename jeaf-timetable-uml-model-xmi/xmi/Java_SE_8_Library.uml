                    <nestedClassifier xmi:type="uml:Class" xmi:id="4992df07-c45c-4101-9ac1-3ddc0dabd906" name="WindowsFontProperty" visibility="private">
                      <ownedComment xmi:id="c0e21372-cd92-4798-863c-1a37919766c6" body="DesktopProperty for fonts. If a font with the name 'MS Sans Serif'&#xA;is returned, it is mapped to 'Microsoft Sans Serif'.&#xA;" annotatedElement="4992df07-c45c-4101-9ac1-3ddc0dabd906"/>
