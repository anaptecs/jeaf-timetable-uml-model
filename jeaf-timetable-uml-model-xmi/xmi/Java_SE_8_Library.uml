              <nestedClassifier xmi:type="uml:Class" xmi:id="ac850ca4-77f7-41e8-9426-befaac4cec04" name="InputMethodRequestsHandler" visibility="package" clientDependency="736c55be-f919-45c2-b58c-f662b32d1a25 e5413b46-7441-4cb3-b660-660d716c5fab">
                <interfaceRealization xmi:id="e5413b46-7441-4cb3-b660-660d716c5fab" name="" supplier="2090c0be-85b5-4783-8679-63d855af9d97" client="ac850ca4-77f7-41e8-9426-befaac4cec04" contract="2090c0be-85b5-4783-8679-63d855af9d97"/>
                <interfaceRealization xmi:id="736c55be-f919-45c2-b58c-f662b32d1a25" name="" supplier="f5ab78f5-1f0c-4786-be68-4729fe772240" client="ac850ca4-77f7-41e8-9426-befaac4cec04" contract="f5ab78f5-1f0c-4786-be68-4729fe772240"/>
