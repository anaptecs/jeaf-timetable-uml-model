                        <interfaceRealization xmi:id="12bf543e-c61f-4efb-9956-b59bb85c2bde" name="" supplier="56a11d4e-e354-493c-933c-9822f6515ef8" client="38ecad75-dac0-4ecb-bcfd-0ed401babddf" contract="56a11d4e-e354-493c-933c-9822f6515ef8"/>
