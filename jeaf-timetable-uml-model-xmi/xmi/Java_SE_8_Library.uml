              <nestedClassifier xmi:type="uml:Class" xmi:id="979c77f1-4999-4d88-8654-4056c6b6b3d9" name="ComposedTextCaret" visibility="package" clientDependency="2b9f4f57-24da-4323-af87-03983a87eb64">
