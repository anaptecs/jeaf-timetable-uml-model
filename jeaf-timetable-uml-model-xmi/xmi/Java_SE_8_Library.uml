                  <ownedParameteredElement xmi:type="uml:Class" xmi:id="04d0c323-eba2-4309-90bc-96c329f76f80" name="P_OUT" templateParameter="2c5bc7d4-1aa1-4808-9d99-bab3dbda0e20"/>
                </ownedParameter>
                <ownedParameter xmi:type="uml:ClassifierTemplateParameter" xmi:id="b600886b-0883-476d-bc10-c63d78d581e9" parameteredElement="fe7c8e13-92ad-4e95-9ec7-4701a15a0eff">
                  <ownedParameteredElement xmi:type="uml:Class" xmi:id="fe7c8e13-92ad-4e95-9ec7-4701a15a0eff" name="R" templateParameter="b600886b-0883-476d-bc10-c63d78d581e9"/>
