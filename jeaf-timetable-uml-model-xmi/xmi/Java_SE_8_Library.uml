                  <ownedParameteredElement xmi:type="uml:Class" xmi:id="c5a8da6b-bb6c-4f70-af65-f88159d519c7" name="E_OUT" templateParameter="00ec9c8a-306a-49a1-8bbf-eaec4d8ef6a8"/>
