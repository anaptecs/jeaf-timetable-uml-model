            <packagedElement xmi:type="uml:Class" xmi:id="2691f2bd-538f-4875-bffa-ed20a37c71cf" name="Dimension2D" clientDependency="f8cc85ed-1a8c-4d2d-95bc-f8ba2431dcc8" isAbstract="true">
              <ownedComment xmi:id="cb10503d-1e66-4507-8ac1-86f6ad1b2947" body="The &lt;code>Dimension2D&lt;/code> class is to encapsulate a width&#xA;and a height dimension.&#xA;&lt;p>&#xA;This class is only the abstract superclass for all objects that&#xA;store a 2D dimension.&#xA;The actual storage representation of the sizes is left to&#xA;the subclass.&#xA;&#xA;@author      Jim Graham&#xA;@since 1.2&#xA;" annotatedElement="2691f2bd-538f-4875-bffa-ed20a37c71cf"/>
