                      <packagedElement xmi:type="uml:Class" xmi:id="1ce51c20-f436-4741-a7ba-ec556ea38ea9" name="WeakReferenceXMLSchema" visibility="package">
                        <ownedComment xmi:id="93bf6fd3-dd13-43df-a1fc-5b8ffd81b656" body="&lt;p>An implementation of Schema for W3C XML Schemas&#xA;that keeps a weak reference to its grammar pool. If&#xA;no validators currently have a reference to the&#xA;grammar pool, the garbage collector is free to reclaim&#xA;its memory.&lt;/p>&#xA;&#xA;@author Michael Glavassevich, IBM&#xA;" annotatedElement="1ce51c20-f436-4741-a7ba-ec556ea38ea9"/>
