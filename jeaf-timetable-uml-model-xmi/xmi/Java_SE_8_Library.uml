            <packagedElement xmi:type="uml:Interface" xmi:id="50ab46a8-da9b-4dc7-b6dc-1462196155ba" name="SortedMap&lt;String, String>">
              <templateBinding xmi:id="29d23ec4-64b9-40ca-a962-68df6110fb3e" signature="caf839c5-a415-4409-a671-74260b7e2d1f">
