                      </packagedElement>
                      <packagedElement xmi:type="uml:Class" xmi:id="7878c176-bd20-47d1-9161-233ea7f37020" name="BitArray" clientDependency="e959d6ac-1470-4d8a-8c4f-313602f15173">
                        <ownedComment xmi:id="b530bab7-91bd-4dd5-b279-813ff5db02ba" body="@author Morten Jorgensen&#xA;" annotatedElement="7878c176-bd20-47d1-9161-233ea7f37020"/>
                        <interfaceRealization xmi:id="e959d6ac-1470-4d8a-8c4f-313602f15173" name="" supplier="9017f17b-8b62-4a3e-be1e-7461adb464eb" client="7878c176-bd20-47d1-9161-233ea7f37020" contract="9017f17b-8b62-4a3e-be1e-7461adb464eb"/>
                      </packagedElement>
                      <packagedElement xmi:type="uml:Class" xmi:id="5403d848-2eb9-4870-89f8-a9c7c02d00c1" name="CachedNodeListIterator">
                        <ownedComment xmi:id="55a7373c-66b1-41f4-91e4-cd4f00929a5b" body="CachedNodeListIterator is used for select expressions in a&#xA;variable or parameter. This iterator caches all nodes in an&#xA;IntegerArray. Its cloneIterator() method is overridden to&#xA;return an object of ClonedNodeListIterator.&#xA;" annotatedElement="5403d848-2eb9-4870-89f8-a9c7c02d00c1"/>
                        <generalization xmi:id="d8ab26a7-e7ad-4da4-bf9f-1752f189aedd" isSubstitutable="true" general="59ccc38a-d7f7-42b4-ab67-fed330dbe0f9"/>
                      </packagedElement>
                      <packagedElement xmi:type="uml:Class" xmi:id="13415b13-a6b8-4a27-939c-396db9d9e4e6" name="ClonedNodeListIterator">
                        <ownedComment xmi:id="56d20366-0fc7-41b0-8024-ddd3c10269d5" body="A ClonedNodeListIterator is returned by the cloneIterator() method&#xA;of a CachedNodeListIterator. Its next() method retrieves the nodes from&#xA;the cache of the CachedNodeListIterator.&#xA;" annotatedElement="13415b13-a6b8-4a27-939c-396db9d9e4e6"/>
                        <generalization xmi:id="397aab46-9dd0-4e95-8e73-914d8104b51a" isSubstitutable="true" general="59ccc38a-d7f7-42b4-ab67-fed330dbe0f9"/>
                      </packagedElement>
                      <packagedElement xmi:type="uml:Class" xmi:id="b27ce968-c859-42ba-88ce-0603cab66a80" name="CollatorFactoryBase" clientDependency="69e5a1dd-fae7-4e85-9f8f-522138a43e5a">
                        <ownedComment xmi:id="754e4b9e-0b31-41aa-a0a7-2bc38062853c" body="@author W. Eliot Kimber (eliot@isogen.com)&#xA;" annotatedElement="b27ce968-c859-42ba-88ce-0603cab66a80"/>
                        <interfaceRealization xmi:id="69e5a1dd-fae7-4e85-9f8f-522138a43e5a" name="" supplier="3b24fcbe-f922-43fb-aca9-0a4f185716d5" client="b27ce968-c859-42ba-88ce-0603cab66a80" contract="3b24fcbe-f922-43fb-aca9-0a4f185716d5"/>
                      </packagedElement>
                      <packagedElement xmi:type="uml:Interface" xmi:id="e02b9c39-84fd-4207-9b49-ebb0901a1574" name="CurrentNodeListFilter" isAbstract="true">
                        <ownedComment xmi:id="ba4d1c06-3f4d-45df-b8ef-4c2057b6f519" body="@author Jacek Ambroziak&#xA;@author Santiago Pericas-Geertsen&#xA;@author Morten Jorgensen&#xA;" annotatedElement="e02b9c39-84fd-4207-9b49-ebb0901a1574"/>
                      </packagedElement>
                      <packagedElement xmi:type="uml:Class" xmi:id="ee71f511-7191-45f0-9d0a-db18f37656d0" name="CurrentNodeListIterator">
                        <ownedComment xmi:id="519f03aa-3889-4501-a9b8-b31a6d6a2cb8" body="Iterators of this kind use a CurrentNodeListFilter to filter a subset of&#xA;nodes from a source iterator. For each node from the source, the boolean&#xA;method CurrentNodeListFilter.test() is called.&#xA;&#xA;All nodes from the source are read into an array upon calling setStartNode()&#xA;(this is needed to determine the value of last, a parameter to&#xA;CurrentNodeListFilter.test()). The method getLast() returns the last element&#xA;after applying the filter.&#xA;@author Jacek Ambroziak&#xA;@author Santiago Pericas-Geertsen&#xA;@author Morten Jorgensen&#xA;" annotatedElement="ee71f511-7191-45f0-9d0a-db18f37656d0"/>
                        <generalization xmi:id="15c9150a-7c04-4897-bd25-c986272caeb5" isSubstitutable="true" general="59ccc38a-d7f7-42b4-ab67-fed330dbe0f9"/>
                      </packagedElement>
                      <packagedElement xmi:type="uml:Class" xmi:id="c204f8d6-cd7c-46b8-992d-c30315793ecf" name="DocumentCache" clientDependency="8ccd64ca-5561-4214-85f6-a7af7365f200">
                        <ownedComment xmi:id="7e7e6f8e-4ea4-4ddd-a359-72af8b9cbc1c" body="@author Morten Jorgensen&#xA;" annotatedElement="c204f8d6-cd7c-46b8-992d-c30315793ecf"/>
