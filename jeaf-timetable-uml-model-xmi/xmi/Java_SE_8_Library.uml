                    <packagedElement xmi:type="uml:Class" xmi:id="c156273d-92b9-4e58-b39c-e11dcc2722c7" name="InnerClass" clientDependency="3263415f-9c11-4e18-aa69-96ff4284a3ad b176f7bd-4a6b-4191-99c3-81af84bce901">
                      <ownedComment xmi:id="2be8ef0a-0ae4-429e-9d37-3937a357cec9" body="This class represents a inner class attribute, i.e., the class&#xA;indices of the inner and outer classes, the name and the attributes&#xA;of the inner class.&#xA;&#xA;@author  &lt;A HREF=&quot;mailto:markus.dahm@berlin.de&quot;>M. Dahm&lt;/A>&#xA;@see InnerClasses&#xA;" annotatedElement="c156273d-92b9-4e58-b39c-e11dcc2722c7"/>
                      <interfaceRealization xmi:id="3263415f-9c11-4e18-aa69-96ff4284a3ad" name="" supplier="af41d975-30f5-4ca2-9f69-6cae8e15d59a" client="c156273d-92b9-4e58-b39c-e11dcc2722c7" contract="af41d975-30f5-4ca2-9f69-6cae8e15d59a"/>
