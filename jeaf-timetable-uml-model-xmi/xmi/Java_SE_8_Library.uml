                  <nestedClassifier xmi:type="uml:Class" xmi:id="28c726ac-37b3-4dfb-a77b-42f04ecaa7f0" name="JFIFThumbRGB" visibility="package">
                    <ownedComment xmi:id="9905a3ad-a879-4d5f-a9cc-4b7793a00552" body="A JFIF thumbnail stored as RGB, one byte per channel,&#xA;interleaved.&#xA;" annotatedElement="28c726ac-37b3-4dfb-a77b-42f04ecaa7f0"/>
                    <generalization xmi:id="cf7a37ff-bdfe-4a17-b1f0-33c58bf71287" isSubstitutable="true" general="f7093d7f-4b2d-46e2-b552-1e5c06d5921a"/>
