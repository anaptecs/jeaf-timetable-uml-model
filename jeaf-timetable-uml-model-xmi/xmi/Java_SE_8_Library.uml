                    <packagedElement xmi:type="uml:Class" xmi:id="7b856e14-8566-4f62-9aae-599fbd1efd79" name="DocumentBuilderImpl" clientDependency="c9630eee-ca90-479f-8a3b-53dc50c7ccc3">
