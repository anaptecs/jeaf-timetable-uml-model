                <packagedElement xmi:type="uml:Package" xmi:id="ac5a6054-91e4-4809-96ef-6ba144bec8aa" name="orbutil">
                  <packagedElement xmi:type="uml:Package" xmi:id="8f711929-bb81-4e37-a943-27fac18a5466" name="closure">
                    <packagedElement xmi:type="uml:Class" xmi:id="03cb3391-85f9-4bc1-8412-4f5a4ca106a0" name="Constant" clientDependency="88c91192-7d17-4183-a698-c71b0d019084">
                      <interfaceRealization xmi:id="88c91192-7d17-4183-a698-c71b0d019084" name="" supplier="aa622955-38f4-4fdc-af10-7dccb6e35a8d" client="03cb3391-85f9-4bc1-8412-4f5a4ca106a0" contract="aa622955-38f4-4fdc-af10-7dccb6e35a8d"/>
