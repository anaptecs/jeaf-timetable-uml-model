            </packagedElement>
            <packagedElement xmi:type="uml:Interface" xmi:id="b8660e54-1222-4461-8678-6dabb14e4d98" name="LabelPeer" isAbstract="true">
              <ownedComment xmi:id="41b6eedc-63ee-441c-9a15-a4d80b01ca9c" body="The peer interface for {@link Label}.&#xA;&#xA;The peer interfaces are intended only for use in porting&#xA;the AWT. They are not intended for use by application&#xA;developers, and developers should not implement peers&#xA;nor invoke any of the peer methods directly on the peer&#xA;instances.&#xA;" annotatedElement="b8660e54-1222-4461-8678-6dabb14e4d98"/>
              <generalization xmi:id="a8615ff7-c7e1-44f3-a58c-a72228097af0" isSubstitutable="true" general="b8be7819-af0f-4b86-a4c3-5879cf85f05b"/>
            </packagedElement>
            <packagedElement xmi:type="uml:Interface" xmi:id="24cc11fe-0c05-467f-9a1f-e11e7eb365cb" name="LightweightPeer" isAbstract="true">
              <ownedComment xmi:id="31b1ea03-9a45-4091-9b17-dd785150b6be" body="The LightweightPeer interface marks a component as depending upon&#xA;a native container so window related events can be routed to the&#xA;component.  Since this only applies to components and their&#xA;extensions, this interface extends ComponentPeer.&#xA;&lt;p>&#xA;The peer interfaces are intended only for use in porting&#xA;the AWT. They are not intended for use by application&#xA;developers, and developers should not implement peers&#xA;nor invoke any of the peer methods directly on the peer&#xA;instances.&#xA;&#xA;@author Timothy Prinzing&#xA;" annotatedElement="24cc11fe-0c05-467f-9a1f-e11e7eb365cb"/>
              <generalization xmi:id="02fe763b-be22-45df-9ce9-da9ab9026acb" isSubstitutable="true" general="b8be7819-af0f-4b86-a4c3-5879cf85f05b"/>
            </packagedElement>
            <packagedElement xmi:type="uml:Interface" xmi:id="0ed1c177-92de-4fd6-bcb1-c5d057d36d0c" name="ListPeer" isAbstract="true">
              <ownedComment xmi:id="2d23da3c-b0fe-409d-8840-4b721247853c" body="The peer interface for {@link List}.&#xA;&#xA;The peer interfaces are intended only for use in porting&#xA;the AWT. They are not intended for use by application&#xA;developers, and developers should not implement peers&#xA;nor invoke any of the peer methods directly on the peer&#xA;instances.&#xA;" annotatedElement="0ed1c177-92de-4fd6-bcb1-c5d057d36d0c"/>
              <generalization xmi:id="44b9aaa3-f2a6-45c0-a3ba-34debffb3a6f" isSubstitutable="true" general="b8be7819-af0f-4b86-a4c3-5879cf85f05b"/>
            </packagedElement>
            <packagedElement xmi:type="uml:Interface" xmi:id="a0d08d3f-bd20-48fe-a790-65e492dc1492" name="MenuBarPeer" isAbstract="true">
