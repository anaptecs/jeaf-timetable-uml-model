            <nestedClassifier xmi:type="uml:Class" xmi:id="87eb4a81-0a0f-4d36-9ece-41cad9ae1322" name="SwingWorkerPropertyChangeSupport" visibility="private">
              <generalization xmi:id="6fcfab60-1e04-4a70-a47a-d5344d301c7a" isSubstitutable="true" general="92c69056-c15f-4f27-be27-05e614758b73"/>
