              <packagedElement xmi:type="uml:Class" xmi:id="680c3fb0-1e46-44db-8218-d022fa323988" name="RMIConnector" clientDependency="e85c19b4-4a91-433c-88fd-4876f7e5b210 94506263-89f2-4a7b-bf9c-3b6965c881e2 0a1d7ddd-890c-461e-9229-bc7dd3cce4ce">
                <ownedComment xmi:id="b602b43b-2566-4c0b-b725-bc34b358f650" body="&lt;p>A connection to a remote RMI connector.  Usually, such&#xA;connections are made using {@link&#xA;javax.management.remote.JMXConnectorFactory JMXConnectorFactory}.&#xA;However, specialized applications can use this class directly, for&#xA;example with an {@link RMIServer} stub obtained without going&#xA;through JNDI.&lt;/p>&#xA;&#xA;@since 1.5&#xA;" annotatedElement="680c3fb0-1e46-44db-8218-d022fa323988"/>
                <interfaceRealization xmi:id="94506263-89f2-4a7b-bf9c-3b6965c881e2" name="" supplier="993c519c-68c3-4036-9f77-d920a012c6af" client="680c3fb0-1e46-44db-8218-d022fa323988" contract="993c519c-68c3-4036-9f77-d920a012c6af"/>
