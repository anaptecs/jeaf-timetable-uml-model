                        <nestedClassifier xmi:type="uml:Class" xmi:id="67ede96e-5867-46a3-82cf-fad89c794618" name="DefaultAnyNodeCounter" visibility="package">
                          <generalization xmi:id="dfa3af36-476b-4dba-82c6-6e4aee8bbafa" isSubstitutable="true" general="6afeb56b-497d-4505-bd5e-898678c81ef6"/>
                        </nestedClassifier>
                      </packagedElement>
                      <packagedElement xmi:type="uml:Class" xmi:id="b6d7f5e4-2afd-45a9-84ab-c534b83207df" name="ArrayNodeListIterator" clientDependency="c86e0010-f3f7-4ab7-a5c4-9bf76f5fe381">
