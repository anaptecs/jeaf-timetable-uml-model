            </packagedElement>
            <packagedElement xmi:type="uml:Interface" xmi:id="8500de2a-b7d2-4710-a246-360f01bd1249" name="CurrentOperations" isAbstract="true">
              <ownedComment xmi:id="c6117c33-b44b-4186-bc42-064b9805d0cd" body="The interface for &lt;tt>Current&lt;/tt>.  For more information on&#xA;Operations interfaces, see &lt;a href=&quot;doc-files/generatedfiles.html&quot;>&#xA;&quot;Generated Files&quot;&lt;/a>.&#xA;&#xA;org/omg/CORBA/CurrentOperations.java&#xA;Generated by the IDL-to-Java compiler (portable), version &quot;3.0&quot;&#xA;from ../../../../../src/share/classes/org/omg/PortableServer/corba.idl&#xA;Saturday, July 17, 1999 12:26:21 AM PDT.&#xA;" annotatedElement="8500de2a-b7d2-4710-a246-360f01bd1249"/>
