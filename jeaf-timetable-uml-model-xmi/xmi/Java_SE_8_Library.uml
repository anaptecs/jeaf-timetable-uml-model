                    </packagedElement>
                    <packagedElement xmi:type="uml:Class" xmi:id="e696d1c5-4e95-45ed-910f-d7c5ab620789" name="ClassGenException">
                      <ownedComment xmi:id="d6061e83-949f-44f3-a774-f0b473928d9e" body="Thrown on internal errors. Extends RuntimeException so it hasn't to be declared&#xA;in the throws clause every time.&#xA;&#xA;@author  &lt;A HREF=&quot;mailto:markus.dahm@berlin.de&quot;>M. Dahm&lt;/A>&#xA;" annotatedElement="e696d1c5-4e95-45ed-910f-d7c5ab620789"/>
