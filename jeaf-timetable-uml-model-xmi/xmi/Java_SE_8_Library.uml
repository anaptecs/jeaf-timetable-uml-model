                    <packagedElement xmi:type="uml:Class" xmi:id="a6e17f2b-68ac-405f-b31b-1cbd399ccedc" name="SWITCH" clientDependency="465725e3-3391-4c36-95f4-b16ce4e97798">
                      <ownedComment xmi:id="68d1ce47-810e-4783-b7fa-da1d7fddb338" body="SWITCH - Branch depending on int value, generates either LOOKUPSWITCH or&#xA;TABLESWITCH instruction, depending on whether the match values (int[]) can be&#xA;sorted with no gaps between the numbers.&#xA;&#xA;@author  &lt;A HREF=&quot;mailto:markus.dahm@berlin.de&quot;>M. Dahm&lt;/A>&#xA;" annotatedElement="a6e17f2b-68ac-405f-b31b-1cbd399ccedc"/>
                      <interfaceRealization xmi:id="465725e3-3391-4c36-95f4-b16ce4e97798" name="" supplier="c7ede6e0-fdaf-40b6-944c-d88b081a986d" client="a6e17f2b-68ac-405f-b31b-1cbd399ccedc" contract="c7ede6e0-fdaf-40b6-944c-d88b081a986d"/>
                    </packagedElement>
                    <packagedElement xmi:type="uml:Class" xmi:id="1dcaea40-04d9-4867-b69d-15aa5ab688ad" name="TABLESWITCH">
                      <ownedComment xmi:id="55ce6ff9-80c7-473b-8c83-b75c3771c624" body="TABLESWITCH - Switch within given range of values, i.e., low..high&#xA;&#xA;@author  &lt;A HREF=&quot;mailto:markus.dahm@berlin.de&quot;>M. Dahm&lt;/A>&#xA;@see SWITCH&#xA;" annotatedElement="1dcaea40-04d9-4867-b69d-15aa5ab688ad"/>
