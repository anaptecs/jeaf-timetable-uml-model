              <packagedElement xmi:type="uml:Class" xmi:id="39a1f8af-2223-4b02-a5f7-d3e89a68115d" name="RMIConnectionImpl_Stub" clientDependency="f649a069-6d41-4c11-a4a9-9dcdc8f58858">
