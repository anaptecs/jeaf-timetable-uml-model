                <packagedElement xmi:type="uml:Class" xmi:id="53f40183-3dfe-4380-b271-0bffc5919293" name="NonSyncVector&lt;SnmpMibNode>">
                  <templateBinding xmi:id="28a9e096-6e8d-4d30-b629-86fb47d5575e" signature="2ba365b8-5d0b-420d-8a45-26be6e94130e">
                    <parameterSubstitution xmi:id="77176d5d-5cf4-4144-8cb5-a54bade78877" formal="55221e44-ba15-41c4-ac45-29e589d27708" actual="6732bc83-fa55-4b50-ab49-efe4d00c6faf"/>
