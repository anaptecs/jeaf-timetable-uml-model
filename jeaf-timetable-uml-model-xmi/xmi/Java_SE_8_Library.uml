            <packagedElement xmi:type="uml:Interface" xmi:id="76ab195e-e141-48f2-8441-b8b736d3ff27" name="Map&lt;String, RoleInfo>"/>
            <packagedElement xmi:type="uml:Interface" xmi:id="fecd4253-b5c6-4307-9043-77853347728e" name="List&lt;Role>">
