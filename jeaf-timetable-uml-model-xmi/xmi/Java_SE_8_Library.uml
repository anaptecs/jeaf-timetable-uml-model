            <nestedClassifier xmi:type="uml:Class" xmi:id="9d46e60b-0d8b-42a1-afb4-ff566cc7a302" name="TreeModelHandler" visibility="protected" clientDependency="e085b204-0227-42f9-9a89-15533640cb6e">
              <ownedComment xmi:id="1159081e-e984-49dc-8e13-42e23e3623ee" body="Listens to the model and updates the &lt;code>expandedState&lt;/code>&#xA;accordingly when nodes are removed, or changed.&#xA;" annotatedElement="9d46e60b-0d8b-42a1-afb4-ff566cc7a302"/>
