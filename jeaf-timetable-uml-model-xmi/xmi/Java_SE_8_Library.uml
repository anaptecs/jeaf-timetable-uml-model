              </packagedElement>
              <packagedElement xmi:type="uml:Class" xmi:id="1e5d5b68-2755-4406-b9dc-1abd1de355b2" name="ParseConversionEventImpl" clientDependency="f8ed85eb-53c7-41ea-af39-ac29c6d602a9">
                <ownedComment xmi:id="218ac0f1-c42d-4444-91ee-21de2a8f7814" body="Default implementation of the ParseConversionEvent interface.&#xA;&#xA;&lt;p>&#xA;JAXB providers are allowed to use whatever class that implements&#xA;the ValidationEvent interface. This class is just provided for a&#xA;convenience.&#xA;&#xA;@author &lt;ul>&lt;li>Ryan Shoemaker, Sun Microsystems, Inc.&lt;/li>&lt;/ul>&#xA;@see javax.xml.bind.ParseConversionEvent&#xA;@see javax.xml.bind.Validator&#xA;@see javax.xml.bind.ValidationEventHandler&#xA;@see javax.xml.bind.ValidationEvent&#xA;@see javax.xml.bind.ValidationEventLocator&#xA;@since JAXB1.0&#xA;" annotatedElement="1e5d5b68-2755-4406-b9dc-1abd1de355b2"/>
                <generalization xmi:id="aabe624b-ad06-4166-8cd1-4b9c621c0cbe" isSubstitutable="true" general="8d93d7e5-a0a2-41c9-8c1c-539b25f35fe9"/>
