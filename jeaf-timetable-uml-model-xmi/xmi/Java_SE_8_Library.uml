                    <packagedElement xmi:type="uml:Class" xmi:id="ef1bd4eb-58da-4d80-91b7-67d27659d962" name="ConstantPool" clientDependency="f5fdb658-2357-4d8a-af49-52b0fa0ce17c b3def384-b426-4986-8743-9d4095c31e5f c2bd66c8-99c1-4961-9765-739900b030ab">
                      <ownedComment xmi:id="f8032fa1-8548-4a22-b5b2-a64cb2c390f5" body="This class represents the constant pool, i.e., a table of constants, of&#xA;a parsed classfile. It may contain null references, due to the JVM&#xA;specification that skips an entry after an 8-byte constant (double,&#xA;long) entry.  Those interested in generating constant pools&#xA;programatically should see &lt;a href=&quot;../generic/ConstantPoolGen.html&quot;>&#xA;ConstantPoolGen&lt;/a>.&#xA;@see     Constant&#xA;@see     com.sun.org.apache.bcel.internal.generic.ConstantPoolGen&#xA;@author &lt;A HREF=&quot;mailto:markus.dahm@berlin.de&quot;>M. Dahm&lt;/A>&#xA;" annotatedElement="ef1bd4eb-58da-4d80-91b7-67d27659d962"/>
                      <interfaceRealization xmi:id="f5fdb658-2357-4d8a-af49-52b0fa0ce17c" name="" supplier="af41d975-30f5-4ca2-9f69-6cae8e15d59a" client="ef1bd4eb-58da-4d80-91b7-67d27659d962" contract="af41d975-30f5-4ca2-9f69-6cae8e15d59a"/>
                      <interfaceRealization xmi:id="b3def384-b426-4986-8743-9d4095c31e5f" name="" supplier="681391a6-92f7-45b2-b4b7-f0f64563f504" client="ef1bd4eb-58da-4d80-91b7-67d27659d962" contract="681391a6-92f7-45b2-b4b7-f0f64563f504"/>
