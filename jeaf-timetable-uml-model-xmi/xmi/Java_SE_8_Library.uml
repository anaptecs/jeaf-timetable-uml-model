            </nestedClassifier>
            <nestedClassifier xmi:type="uml:Class" xmi:id="9f731b85-b23f-4247-851e-24bf4491cb5d" name="javax_swing_JMenu_PersistenceDelegate" visibility="package">
              <generalization xmi:id="cc42d802-051b-4da0-ab35-bfa167930be8" isSubstitutable="true" general="d5e3827b-1651-454b-ba48-7628a84b1cfb"/>
