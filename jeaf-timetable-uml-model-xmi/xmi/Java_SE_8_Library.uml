              <packagedElement xmi:type="uml:Class" xmi:id="de149a52-29e3-4df1-9660-f2a7eb85b86c" name="MetalLabelUI">
                <ownedComment xmi:id="db68e92e-9939-4baf-a755-8dcce978fa7e" body="A Windows L&amp;amp;F implementation of LabelUI.  This implementation&#xA;is completely static, i.e. there's only one UIView implementation&#xA;that's shared by all JLabel objects.&#xA;&#xA;@author Hans Muller&#xA;" annotatedElement="de149a52-29e3-4df1-9660-f2a7eb85b86c"/>
