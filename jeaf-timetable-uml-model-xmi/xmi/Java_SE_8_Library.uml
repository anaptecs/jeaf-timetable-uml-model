                <ownedComment xmi:id="465d2d06-3945-45e3-bfb3-e4e33b648253" body="Linked list node class&#xA;" annotatedElement="b430a130-3763-4a47-a790-b752c169ae4d"/>
                <ownedTemplateSignature xmi:type="uml:RedefinableTemplateSignature" xmi:id="8a1f31e0-85b0-40d5-8cf0-3912cf7fef2c" name="" visibility="public" parameter="d579b584-8722-402f-91ac-7b7c3db3b728">
                  <ownedParameter xmi:type="uml:ClassifierTemplateParameter" xmi:id="d579b584-8722-402f-91ac-7b7c3db3b728" parameteredElement="4ff6dc33-d462-4b3c-8b8d-0e288c361d63">
