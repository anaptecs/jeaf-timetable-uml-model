                <nestedClassifier xmi:type="uml:Class" xmi:id="f9f2234d-a082-4628-a67b-f92f5cbc84dd" name="SelectionModelPropertyChangeHandler" clientDependency="f526f2fe-ba1b-48b8-8459-e547ffd55cb6">
                  <ownedComment xmi:id="52c18cd4-fd66-4971-8e97-04468381f895" body="Listener on the TreeSelectionModel, resets the row selection if&#xA;any of the properties of the model change.&#xA;" annotatedElement="f9f2234d-a082-4628-a67b-f92f5cbc84dd"/>
                  <interfaceRealization xmi:id="f526f2fe-ba1b-48b8-8459-e547ffd55cb6" name="" supplier="351d738c-b38b-49d3-b4b5-e99e202d16ba" client="f9f2234d-a082-4628-a67b-f92f5cbc84dd" contract="351d738c-b38b-49d3-b4b5-e99e202d16ba"/>
