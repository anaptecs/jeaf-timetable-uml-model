              </ownedTemplateSignature>
              <generalization xmi:id="f3d60a96-4c49-4761-b641-c9e430575597" isSubstitutable="true" general="f1616513-83ee-4adf-b64d-df28f428d282"/>
              <interfaceRealization xmi:id="15544885-319b-4913-8480-5e8f3aa44870" name="" supplier="6be53522-274b-4bdb-9d8b-e36cd2f9faa3" client="789ac549-2a3d-473e-8db0-e7116b2026c4" contract="6be53522-274b-4bdb-9d8b-e36cd2f9faa3"/>
              <interfaceRealization xmi:id="3a3d581d-6133-44b0-a9f5-6fb8ffb541e4" name="" supplier="41f4a654-a713-47bf-a391-e112be100ec5" client="789ac549-2a3d-473e-8db0-e7116b2026c4" contract="41f4a654-a713-47bf-a391-e112be100ec5"/>
