                  <generalization xmi:id="869979d5-4b24-49ea-9a81-165f09024012" isSubstitutable="true" general="5258e060-7293-4026-ada0-4e0991972607"/>
                </nestedClassifier>
                <nestedClassifier xmi:type="uml:Class" xmi:id="85a65950-1773-4cd5-8381-9eefa5f96b6b" name="ArrayMapping" visibility="private">
