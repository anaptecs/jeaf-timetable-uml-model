                <ownedComment xmi:id="5fe9bbea-b34e-422a-b8fe-7a59037e8a98" body="A Windows L&amp;amp;F implementation of PopupMenuUI.  This implementation&#xA;is a &quot;combined&quot; view/controller.&#xA;&#xA;@author Georges Saab&#xA;@author David Karlton&#xA;@author Arnaud Weber&#xA;" annotatedElement="961eb78a-1411-4686-89cf-442c371280d0"/>
                <generalization xmi:id="2518b9dd-2751-4f6c-9551-71d3f7dd142b" isSubstitutable="true" general="7190e770-a6be-4b4a-9c1c-3b78e8bef7a7"/>
                <nestedClassifier xmi:type="uml:Class" xmi:id="2984465d-92fa-46ca-8ebf-07cce2d3d1bd" name="BasicPopupMenuListener" visibility="private" clientDependency="5674700d-cc64-403a-a1c3-67f650991398">
                  <ownedComment xmi:id="3a2bf605-b468-416e-8ad5-c67280c5ff0f" body="This Listener fires the Action that provides the correct auditory&#xA;feedback.&#xA;&#xA;@since 1.4&#xA;" annotatedElement="2984465d-92fa-46ca-8ebf-07cce2d3d1bd"/>
                  <interfaceRealization xmi:id="5674700d-cc64-403a-a1c3-67f650991398" name="" supplier="1b5dac1b-c570-4e47-be8c-2f7175851d20" client="2984465d-92fa-46ca-8ebf-07cce2d3d1bd" contract="1b5dac1b-c570-4e47-be8c-2f7175851d20"/>
                </nestedClassifier>
                <nestedClassifier xmi:type="uml:Class" xmi:id="9970ff61-ac11-4613-9508-32d8899455f3" name="BasicMenuKeyListener" visibility="private" clientDependency="6d456694-cbea-43ab-8a71-dd080733f043">
                  <ownedComment xmi:id="a4d64d7d-317d-4b8a-9acf-0dc3d3e41ab8" body="Handles mnemonic for children JMenuItems.&#xA;@since 1.5&#xA;" annotatedElement="9970ff61-ac11-4613-9508-32d8899455f3"/>
