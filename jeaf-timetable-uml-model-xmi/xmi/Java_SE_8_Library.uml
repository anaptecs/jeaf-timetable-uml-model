            <packagedElement xmi:type="uml:Class" xmi:id="0167baf7-bbcb-4f85-9944-c637d311fed9" name="_NamingContextExtStub" clientDependency="00644178-9cf0-4fcb-a536-e873a63178da">
              <ownedComment xmi:id="0f36850c-c719-4091-8e1e-6f1df6792298" body="&lt;code>NamingContextExt&lt;/code> is the extension of &lt;code>NamingContext&lt;/code>&#xA;which&#xA;contains a set of name bindings in which each name is unique and is&#xA;part of Interoperable Naming Service.&#xA;Different names can be bound to an object in the same or different&#xA;contexts at the same time. Using &lt;tt>NamingContextExt&lt;/tt>, you can use&#xA;URL-based names to bind and resolve. &lt;p>&#xA;&#xA;See &lt;a href=&quot;http://www.omg.org/technology/documents/formal/naming_service.htm&quot;>&#xA;CORBA COS&#xA;Naming Specification.&lt;/a>&#xA;" annotatedElement="0167baf7-bbcb-4f85-9944-c637d311fed9"/>
              <generalization xmi:id="05fd83fb-fd34-4096-914c-33e94933c56d" isSubstitutable="true" general="1f22f99e-8789-483b-8626-1e5e54fec134"/>
