                    <nestedClassifier xmi:type="uml:Class" xmi:id="8c3af1d8-860a-409d-856c-647f6f8bb192" name="ScalableIconUIResource" clientDependency="1c879b27-7192-46c1-87b1-b21b733290cb eb860567-cba3-4f59-b800-4f942c1d6fe5">
                      <ownedComment xmi:id="077950f3-f834-4da0-836a-7bf4f33de90d" body="A versatile Icon implementation which can take an array of Icon&#xA;instances (typically &lt;code>ImageIcon&lt;/code>s) and choose one that gives the best&#xA;quality for a given Graphics2D scale factor when painting.&#xA;&lt;p>&#xA;The class is public so it can be instantiated by UIDefaults.ProxyLazyValue.&#xA;&lt;p>&#xA;Note: We assume here that icons are square.&#xA;" annotatedElement="8c3af1d8-860a-409d-856c-647f6f8bb192"/>
                      <interfaceRealization xmi:id="1c879b27-7192-46c1-87b1-b21b733290cb" name="" supplier="adcd0b04-f02a-48b0-a1c4-75dfd17c11e6" client="8c3af1d8-860a-409d-856c-647f6f8bb192" contract="adcd0b04-f02a-48b0-a1c4-75dfd17c11e6"/>
