          </packagedElement>
          <packagedElement xmi:type="uml:Interface" xmi:id="c2827b74-efde-4544-839a-5f1aa478a27e" name="List&lt;Image>">
            <templateBinding xmi:id="e3695e64-82d8-432c-97cf-1e0a6a1cc38c" signature="3e71fc6e-9a72-4a79-82dc-c9a0ddc40a6d">
