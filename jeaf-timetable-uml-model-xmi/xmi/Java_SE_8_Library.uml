                <interfaceRealization xmi:id="69469382-db77-4793-a6fd-53199c1fe998" name="" supplier="72d02ddd-92c5-4757-a367-313d65e02a77" client="14f2ec6f-4e89-4b15-b76c-068ccec06dc8" contract="72d02ddd-92c5-4757-a367-313d65e02a77"/>
