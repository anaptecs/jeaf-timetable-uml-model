                <ownedTemplateSignature xmi:type="uml:RedefinableTemplateSignature" xmi:id="3bb0e2c9-4b1e-4f41-ba15-bbb922cffd98" name="" visibility="public" parameter="533fb54c-836d-483a-8d47-4ad2c27185ea">
                  <ownedParameter xmi:type="uml:ClassifierTemplateParameter" xmi:id="533fb54c-836d-483a-8d47-4ad2c27185ea" parameteredElement="bf451995-39fd-45f4-84ad-2cde5543e29b">
                    <ownedParameteredElement xmi:type="uml:Class" xmi:id="bf451995-39fd-45f4-84ad-2cde5543e29b" name="E" templateParameter="533fb54c-836d-483a-8d47-4ad2c27185ea"/>
