              <ownedComment xmi:id="50e87643-53ff-4dc5-9e10-ae91ef54b8db" body="A subclass of &lt;code>TransferHandler.DropLocation&lt;/code> representing&#xA;a drop location for a &lt;code>JList&lt;/code>.&#xA;&#xA;@see #getDropLocation&#xA;@since 1.6&#xA;" annotatedElement="28e0fe9a-6324-4651-afa6-61ffd35bf56d"/>
