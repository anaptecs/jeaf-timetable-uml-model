              <packagedElement xmi:type="uml:Class" xmi:id="f6711e7c-517e-477f-b4dd-cdf6f76d9010" name="TypeMismatchHelper" isAbstract="true">
                <ownedComment xmi:id="1814d630-b20e-4a56-a3bc-2982795d9714" body="org/omg/DynamicAny/DynAnyPackage/TypeMismatchHelper.java .&#xA;Generated by the IDL-to-Java compiler (portable), version &quot;3.2&quot;&#xA;from d:/re/workspace/8-2-build-windows-amd64-cygwin/jdk8u40/3098/corba/src/share/classes/org/omg/DynamicAny/DynamicAny.idl&#xA;Saturday, March 7, 2015 1:53:26 PM PST&#xA;" annotatedElement="f6711e7c-517e-477f-b4dd-cdf6f76d9010"/>
