            </packagedElement>
            <packagedElement xmi:type="uml:Class" xmi:id="31ab0855-d22c-43a1-9fce-c6ec86916b6f" name="StandardWatchEventKinds">
              <ownedComment xmi:id="f00fed7f-78a8-4be4-b243-1e87f260cbf8" body="Defines the &lt;em>standard&lt;/em> event kinds.&#xA;&#xA;@since 1.7&#xA;" annotatedElement="31ab0855-d22c-43a1-9fce-c6ec86916b6f"/>
              <nestedClassifier xmi:type="uml:Class" xmi:id="be5dc164-8dd7-4704-a4f1-56c39e94bd8f" name="StdWatchEventKind" visibility="private" clientDependency="e6d13641-2643-43f9-8d8a-d1540a9755b8">
                <ownedTemplateSignature xmi:type="uml:RedefinableTemplateSignature" xmi:id="0fecbc9d-fced-4cf7-8daa-1344e4bf1a98" name="" visibility="public" parameter="0ea9f212-5f05-421a-bbf2-c0a02b1549db">
                  <ownedParameter xmi:type="uml:ClassifierTemplateParameter" xmi:id="0ea9f212-5f05-421a-bbf2-c0a02b1549db" parameteredElement="14206145-e962-44d5-961d-8ad1d5d0091c">
