          <packagedElement xmi:type="uml:Class" xmi:id="6a46e9d9-8445-4556-b386-d56a8b55b375" name="WeakReference&lt;>">
            <templateBinding xmi:id="9a159b0b-fb49-478d-968e-65d014eda6d6" signature="9252aca1-1101-47b8-ba29-36de36616b9a">
              <parameterSubstitution xmi:id="da5c7c7b-10ae-4e36-825a-b38291c3169e" formal="89715b01-615a-40f1-937e-932b5ec2604a"/>
