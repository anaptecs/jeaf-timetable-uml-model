                    <packagedElement xmi:type="uml:Class" xmi:id="cc2f681c-9cb5-4984-b88f-3fe939fbb4f6" name="ConstantValue">
                      <ownedComment xmi:id="a07eb606-6cd6-4fab-ba0c-2f144ce2a05f" body="This class is derived from &lt;em>Attribute&lt;/em> and represents a constant&#xA;value, i.e., a default value for initializing a class field.&#xA;This class is instantiated by the &lt;em>Attribute.readAttribute()&lt;/em> method.&#xA;&#xA;@author  &lt;A HREF=&quot;mailto:markus.dahm@berlin.de&quot;>M. Dahm&lt;/A>&#xA;@see     Attribute&#xA;" annotatedElement="cc2f681c-9cb5-4984-b88f-3fe939fbb4f6"/>
