              <ownedComment xmi:id="c4a463af-413a-4e78-9b41-0490f79cf82c" body="This immutable class specifies the set of parameters used for&#xA;generating DSA parameters as specified in&#xA;&lt;a href=&quot;http://csrc.nist.gov/publications/fips/fips186-3/fips_186-3.pdf&quot;>FIPS 186-3 Digital Signature Standard (DSS)&lt;/a>.&#xA;&#xA;@see AlgorithmParameterSpec&#xA;&#xA;@since 8&#xA;" annotatedElement="70617a23-4866-4511-ab36-62275ff3211b"/>
              <interfaceRealization xmi:id="09f14ca3-46f8-4d0a-adfd-f0436c3780c8" name="" supplier="6c712c04-2ab3-409c-8ed5-2fd192a3f3a3" client="70617a23-4866-4511-ab36-62275ff3211b" contract="6c712c04-2ab3-409c-8ed5-2fd192a3f3a3"/>
            </packagedElement>
