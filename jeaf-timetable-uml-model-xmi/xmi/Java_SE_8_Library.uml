              <interfaceRealization xmi:id="64e476b6-c5b5-4e53-bb4e-57a5066714ff" name="" supplier="1e72bb21-e6c3-4a01-b9f9-0d2920aea021" client="42d04e9a-b886-41f7-9a5e-889a1c91d4db" contract="1e72bb21-e6c3-4a01-b9f9-0d2920aea021"/>
