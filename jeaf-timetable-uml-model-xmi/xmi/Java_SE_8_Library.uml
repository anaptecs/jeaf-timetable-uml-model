                        <packagedElement xmi:type="uml:Class" xmi:id="e2f80665-822c-4951-a342-77b2c8be0eea" name="XSDocumentInfo" visibility="package">
                          <ownedComment xmi:id="a1dd959b-9644-4cfe-94cc-af7ca8cab826" body="Objects of this class hold all information pecular to a&#xA;particular XML Schema document.  This is needed because&#xA;namespace bindings and other settings on the &lt;schema/> element&#xA;affect the contents of that schema document alone.&#xA;&#xA;@xerces.internal&#xA;&#xA;@author Neil Graham, IBM&#xA;@version $Id: XSDocumentInfo.java,v 1.5 2007/10/15 22:27:48 spericas Exp $&#xA;" annotatedElement="e2f80665-822c-4951-a342-77b2c8be0eea"/>
