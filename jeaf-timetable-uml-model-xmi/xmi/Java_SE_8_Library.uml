                  </templateBinding>
                </packagedElement>
                <packagedElement xmi:type="uml:Class" xmi:id="7f5af5c6-fb1c-4de0-80bf-e30c9c4887a2" name="Hashtable&lt;String, Object>">
                  <templateBinding xmi:id="4c5358c2-4848-4446-9314-1be45a2cdb12" signature="3d6acbd1-c1c1-411d-83b8-c21681e49619">
                    <parameterSubstitution xmi:id="8c622e67-605d-469d-a1a1-bdf3f21e175f" formal="76170334-e783-48fb-bc7b-a9e9876f2d59" actual="50286478-8b56-42c9-9375-a6f40dbd4c8c"/>
