                <nestedClassifier xmi:type="uml:Class" xmi:id="ba5ee906-708a-4592-baa1-920c49f41983" name="SplitPaneDividerBorder" visibility="package" clientDependency="ff056a3d-9300-4142-8bc3-b3494c0982e2 58004b4b-d423-474a-a351-4d2517480fd1">
                  <ownedComment xmi:id="9be0d826-5345-4f99-b301-d93e94138a0a" body="Draws the border around the divider in a splitpane&#xA;(when BasicSplitPaneUI is used). To get the appropriate effect, this&#xA;needs to be used with a SplitPaneBorder.&#xA;" annotatedElement="ba5ee906-708a-4592-baa1-920c49f41983"/>
                  <interfaceRealization xmi:id="ff056a3d-9300-4142-8bc3-b3494c0982e2" name="" supplier="19d02488-7c9e-446d-b848-95b617b351b4" client="ba5ee906-708a-4592-baa1-920c49f41983" contract="19d02488-7c9e-446d-b848-95b617b351b4"/>
