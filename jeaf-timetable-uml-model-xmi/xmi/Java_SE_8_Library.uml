              </templateBinding>
            </packagedElement>
            <packagedElement xmi:type="uml:Interface" xmi:id="7881c438-0b91-4e20-b5fb-d2689a9de0b5" name="List&lt;GarbageCollectorMXBean>">
              <templateBinding xmi:id="dca168e7-292a-4998-9998-c60ca2d6b595" signature="3e71fc6e-9a72-4a79-82dc-c9a0ddc40a6d">
                <parameterSubstitution xmi:id="1160ed5d-2426-4c3f-b51c-a0f91eea530c" formal="5d8b8a6a-c59b-4de0-9ece-820c205828df" actual="74a04be6-29e8-49de-9c58-d8dea6e04ecd"/>
              </templateBinding>
            </packagedElement>
            <packagedElement xmi:type="uml:Interface" xmi:id="fa922bd8-b4df-4b19-bcb2-5c1eba2c39c8" name="List&lt;>">
              <templateBinding xmi:id="31f3da4c-8816-4bfe-b29f-352f8f91716e" signature="3e71fc6e-9a72-4a79-82dc-c9a0ddc40a6d">
                <parameterSubstitution xmi:id="0896e60a-9d01-4454-851e-1284f673fc48" formal="5d8b8a6a-c59b-4de0-9ece-820c205828df"/>
              </templateBinding>
            </packagedElement>
            <packagedElement xmi:type="uml:Interface" xmi:id="fa833b08-4b28-4e5a-8f3f-2e88acdd6793" name="Set&lt;Class&lt;PlatformManagedObject>>">
              <templateBinding xmi:id="bdb953a1-c37a-4f1c-bf4f-fffaa1e0d02f" signature="e404761f-aaaa-437f-91d9-939fcff0d8fe">
                <parameterSubstitution xmi:id="ab746188-a6bb-4925-b724-c43360c9a8b8" formal="cab8b42e-6617-48ac-bb01-a30fdf8de7ba" actual="448c6af0-1540-4514-9ebe-13c9fcd78a30"/>
              </templateBinding>
            </packagedElement>
            <packagedElement xmi:type="uml:Class" xmi:id="448c6af0-1540-4514-9ebe-13c9fcd78a30" name="Class&lt;PlatformManagedObject>">
              <templateBinding xmi:id="9ea198d2-c3ed-4add-818f-9b8c181822b5" signature="f35fe106-3dd8-428b-bbfc-49338ab32049">
                <parameterSubstitution xmi:id="751d9ba8-10d9-4536-a054-e2e14a43a598" formal="1a5cc16e-ef60-4e50-8a7c-6e829207530b" actual="06d310a7-22c6-4528-97eb-d3606c3e77bc"/>
              </templateBinding>
            </packagedElement>
            <packagedElement xmi:type="uml:Interface" xmi:id="a6ff4e39-b706-4602-a0d7-5cacb1f79ff4" name="MXBeanFetcher&lt;>">
