            <nestedClassifier xmi:type="uml:Class" xmi:id="53c44a88-6833-4e59-87b3-d3d5cd5726dd" name="DoSubmitAccumulativeRunnable" visibility="private" clientDependency="fa70a4ca-f729-4bf3-87cf-d2ee1b342eef">
              <generalization xmi:id="5ed19f2a-1544-4fe6-b473-0f2b530e5f3b" isSubstitutable="true" general="236a2fe9-514a-48f9-80fc-66dfa4a9c29b"/>
              <interfaceRealization xmi:id="fa70a4ca-f729-4bf3-87cf-d2ee1b342eef" name="" supplier="9f3f1179-ef94-4d2c-8b64-1857870b0a46" client="53c44a88-6833-4e59-87b3-d3d5cd5726dd" contract="9f3f1179-ef94-4d2c-8b64-1857870b0a46"/>
