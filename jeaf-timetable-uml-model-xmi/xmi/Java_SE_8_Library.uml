            <packagedElement xmi:type="uml:Class" xmi:id="c95cec52-cc57-4236-9dbe-2f3cc6cc8501" name="AbstractShortCircuitTask" visibility="package" isAbstract="true">
              <ownedComment xmi:id="33c591dd-c1a9-4927-b073-bc1212caae5e" body="Abstract class for fork-join tasks used to implement short-circuiting&#xA;stream ops, which can produce a result without processing all elements of the&#xA;stream.&#xA;&#xA;@param &lt;P_IN> type of input elements to the pipeline&#xA;@param &lt;P_OUT> type of output elements from the pipeline&#xA;@param &lt;R> type of intermediate result, may be different from operation&#xA;result type&#xA;@param &lt;K> type of child and sibling tasks&#xA;@since 1.8&#xA;" annotatedElement="c95cec52-cc57-4236-9dbe-2f3cc6cc8501"/>
              <ownedTemplateSignature xmi:type="uml:RedefinableTemplateSignature" xmi:id="f3de941a-879e-4e73-bff5-b8ced6616206" name="" visibility="public" parameter="94af7f5b-b255-4247-99b3-082b370908a5 2c5bc7d4-1aa1-4808-9d99-bab3dbda0e20 b600886b-0883-476d-bc10-c63d78d581e9 c2d7778c-6c2f-46a4-b627-53fa3278bfb2">
                <ownedParameter xmi:type="uml:ClassifierTemplateParameter" xmi:id="94af7f5b-b255-4247-99b3-082b370908a5" parameteredElement="7ac19cdc-3ce1-4634-82b2-f4c44cc2c379">
                  <ownedParameteredElement xmi:type="uml:Class" xmi:id="7ac19cdc-3ce1-4634-82b2-f4c44cc2c379" name="P_IN" templateParameter="94af7f5b-b255-4247-99b3-082b370908a5"/>
