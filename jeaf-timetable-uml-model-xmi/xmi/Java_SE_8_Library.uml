                <interfaceRealization xmi:id="2ed7b32e-2775-47fc-822f-6ee96658cb9f" name="" supplier="32233862-3e2f-4895-a472-f5b9f207545c" client="fe23cdb7-9b90-4c51-af70-76fe8df66626" contract="32233862-3e2f-4895-a472-f5b9f207545c"/>
              </nestedClassifier>
              <nestedClassifier xmi:type="uml:Class" xmi:id="76ef2e61-43aa-4e9c-9c7d-4e2f3f6625e2" name="KeymapWrapper" visibility="package">
                <ownedComment xmi:id="b85bd252-6abe-425a-a2d5-90881ef18901" body="KeymapWrapper wraps a Keymap inside an InputMap. For KeymapWrapper&#xA;to be useful it must be used with a KeymapActionMap.&#xA;KeymapWrapper for the most part, is an InputMap with two parents.&#xA;The first parent visited is ALWAYS the Keymap, with the second&#xA;parent being the parent inherited from InputMap. If&#xA;&lt;code>keymap.getAction&lt;/code> returns null, implying the Keymap&#xA;does not have a binding for the KeyStroke,&#xA;the parent is then visited. If the Keymap has a binding, the&#xA;Action is returned, if not and the KeyStroke represents a&#xA;KeyTyped event and the Keymap has a defaultAction,&#xA;&lt;code>DefaultActionKey&lt;/code> is returned.&#xA;&lt;p>KeymapActionMap is then able to transate the object passed in&#xA;to either message the Keymap, or message its default implementation.&#xA;" annotatedElement="76ef2e61-43aa-4e9c-9c7d-4e2f3f6625e2"/>
                <generalization xmi:id="9d193228-5c6e-4ee9-bee8-a4f511d9560f" isSubstitutable="true" general="3ca6c206-e265-49be-9cb2-f7ef569759a9"/>
              </nestedClassifier>
              <nestedClassifier xmi:type="uml:Class" xmi:id="378162c3-fcc5-4494-9989-15de246ab8d4" name="KeymapActionMap" visibility="package">
                <ownedComment xmi:id="d6bcbd97-c09b-457d-85c9-f2318fec847f" body="Wraps a Keymap inside an ActionMap. This is used with&#xA;a KeymapWrapper. If &lt;code>get&lt;/code> is passed in&#xA;&lt;code>KeymapWrapper.DefaultActionKey&lt;/code>, the default action is&#xA;returned, otherwise if the key is an Action, it is returned.&#xA;" annotatedElement="378162c3-fcc5-4494-9989-15de246ab8d4"/>
                <generalization xmi:id="e639a4bb-1c84-40f0-aa0b-e781a0a5d341" isSubstitutable="true" general="e2054eaa-a3e7-43af-b3ee-bd78f73d8c33"/>
              </nestedClassifier>
              <nestedClassifier xmi:type="uml:Class" xmi:id="5f43e7fd-afde-4405-84c4-27594767720b" name="MutableCaretEvent" visibility="package" clientDependency="24fe768e-52e2-4cfd-b3d6-d028e99d28af 8cedfe61-9ad1-4dbf-99e7-29e7acedf034 8cbb03e6-63b5-46f5-9b9a-5e29d7a81bb6">
                <ownedComment xmi:id="9727dc90-0cab-478b-80b6-64adee91619f" body="Event to use when firing a notification of change to caret&#xA;position.  This is mutable so that the event can be reused&#xA;since caret events can be fairly high in bandwidth.&#xA;" annotatedElement="5f43e7fd-afde-4405-84c4-27594767720b"/>
                <generalization xmi:id="e37690d5-e4fc-4b07-9feb-a7909d1f842e" isSubstitutable="true" general="1b99927e-5c82-4a60-a136-d291e5654a9f"/>
                <interfaceRealization xmi:id="8cedfe61-9ad1-4dbf-99e7-29e7acedf034" name="" supplier="93a66f3d-d261-4a7c-89c3-b032b4651759" client="5f43e7fd-afde-4405-84c4-27594767720b" contract="93a66f3d-d261-4a7c-89c3-b032b4651759"/>
