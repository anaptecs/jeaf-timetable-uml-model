              </templateBinding>
            </packagedElement>
            <packagedElement xmi:type="uml:Class" xmi:id="14c67c9d-d191-4f4e-88fe-b5d7c595b978" name="ModelWrapper&lt;M, Integer>">
              <templateBinding xmi:id="428c4e99-ec42-469f-9df3-2ebaa24b1515" signature="0c6eeecb-9773-4b1c-926b-c71d30f58cd7">
