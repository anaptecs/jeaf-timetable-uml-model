                    </packagedElement>
                    <packagedElement xmi:type="uml:Class" xmi:id="b9304a71-08f9-4251-87ec-25fbf668f9cc" name="TargetLostException">
                      <ownedComment xmi:id="9494dc44-2296-4bd0-9d5a-03e6b362b8a8" body="Thrown by InstructionList.remove() when one or multiple disposed instruction&#xA;are still being referenced by a InstructionTargeter object. I.e. the&#xA;InstructionTargeter has to be notified that (one of) the InstructionHandle it&#xA;is referencing is being removed from the InstructionList and thus not valid anymore.&#xA;&#xA;Making this an exception instead of a return value forces the user to handle&#xA;these case explicitely in a try { ... } catch. The following code illustrates&#xA;how this may be done:&#xA;&#xA;&lt;PRE>&#xA;...&#xA;try {&#xA;il.delete(start_ih, end_ih);&#xA;} catch(TargetLostException e) {&#xA;InstructionHandle[] targets = e.getTargets();&#xA;for(int i=0; i &lt; targets.length; i++) {&#xA;InstructionTargeter[] targeters = targets[i].getTargeters();&#xA;&#xA;for(int j=0; j &lt; targeters.length; j++)&#xA;targeters[j].updateTarget(targets[i], new_target);&#xA;}&#xA;}&#xA;&lt;/PRE>&#xA;&#xA;@see InstructionHandle&#xA;@see InstructionList&#xA;@see InstructionTargeter&#xA;@author  &lt;A HREF=&quot;mailto:markus.dahm@berlin.de&quot;>M. Dahm&lt;/A>&#xA;" annotatedElement="b9304a71-08f9-4251-87ec-25fbf668f9cc"/>
                      <generalization xmi:id="654b96bf-2e73-43ad-8fd9-da87c53fee8b" isSubstitutable="true" general="fbf790b8-e2bc-40b1-8105-00e11a20c000"/>
                    </packagedElement>
                    <packagedElement xmi:type="uml:Class" xmi:id="12090415-f544-439b-91c5-22933fd3117f" name="Type" clientDependency="89778541-7e65-4fd9-b922-e9dfd00777ae" isAbstract="true">
                      <ownedComment xmi:id="aadd0dad-f14b-48e0-9fbb-c8b183985036" body="Abstract super class for all possible java types, namely basic types&#xA;such as int, object types like String and array types, e.g. int[]&#xA;&#xA;@author  &lt;A HREF=&quot;mailto:markus.dahm@berlin.de&quot;>M. Dahm&lt;/A>&#xA;" annotatedElement="12090415-f544-439b-91c5-22933fd3117f"/>
                      <interfaceRealization xmi:id="89778541-7e65-4fd9-b922-e9dfd00777ae" name="" supplier="41f4a654-a713-47bf-a391-e112be100ec5" client="12090415-f544-439b-91c5-22933fd3117f" contract="41f4a654-a713-47bf-a391-e112be100ec5"/>
                    </packagedElement>
                    <packagedElement xmi:type="uml:Interface" xmi:id="9d83777d-fab4-4b47-b59f-83607a47ef4d" name="TypedInstruction" isAbstract="true">
                      <ownedComment xmi:id="17ed0b6d-1439-494f-96e0-87a5e83dfd08" body="Get the type associated with an instruction, int for ILOAD, or the type&#xA;of the field of a PUTFIELD instruction, e.g..&#xA;&#xA;@author  &lt;A HREF=&quot;mailto:markus.dahm@berlin.de&quot;>M. Dahm&lt;/A>&#xA;" annotatedElement="9d83777d-fab4-4b47-b59f-83607a47ef4d"/>
                    </packagedElement>
                    <packagedElement xmi:type="uml:Interface" xmi:id="da7ff21e-37ec-49f8-8e92-136ce7df3306" name="UnconditionalBranch" isAbstract="true">
                      <ownedComment xmi:id="b6aef053-bead-4f76-96e9-b2182be16f03" body="Denotes an instruction to perform an unconditional branch, i.e., GOTO, JSR.&#xA;&#xA;@author  &lt;A HREF=&quot;mailto:markus.dahm@berlin.de&quot;>M. Dahm&lt;/A>&#xA;@see GOTO&#xA;@see JSR&#xA;" annotatedElement="da7ff21e-37ec-49f8-8e92-136ce7df3306"/>
                    </packagedElement>
                    <packagedElement xmi:type="uml:Interface" xmi:id="efa5e39c-95f8-49e6-a991-e629fa62e446" name="VariableLengthInstruction" isAbstract="true">
                      <ownedComment xmi:id="22cab3a4-41f4-4506-bba7-0610234b358a" body="Denotes an instruction to be a variable length instruction, such as&#xA;GOTO, JSR, LOOKUPSWITCH and TABLESWITCH.&#xA;&#xA;@author  &lt;A HREF=&quot;mailto:markus.dahm@berlin.de&quot;>M. Dahm&lt;/A>&#xA;@see GOTO&#xA;@see JSR&#xA;@see LOOKUPSWITCH&#xA;@see TABLESWITCH&#xA;" annotatedElement="efa5e39c-95f8-49e6-a991-e629fa62e446"/>
                    </packagedElement>
                    <packagedElement xmi:type="uml:Interface" xmi:id="1f94afc9-254c-454b-a053-58f5b24ebf68" name="Visitor" isAbstract="true">
                      <ownedComment xmi:id="3c4c55ef-a3f1-43bf-8b99-597aa5ff55ac" body="Interface implementing the Visitor pattern programming style.&#xA;I.e., a class that implements this interface can handle all types of&#xA;instructions with the properly typed methods just by calling the accept()&#xA;method.&#xA;&#xA;@author  &lt;A HREF=&quot;mailto:markus.dahm@berlin.de&quot;>M. Dahm&lt;/A>&#xA;" annotatedElement="1f94afc9-254c-454b-a053-58f5b24ebf68"/>
                    </packagedElement>
                  </packagedElement>
