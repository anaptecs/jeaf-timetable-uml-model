              </packagedElement>
              <packagedElement xmi:type="uml:Class" xmi:id="58d24564-6133-4465-9cf4-74578d85163d" name="LineView" visibility="package">
                <ownedComment xmi:id="81d63ad4-c93e-42fe-b2b9-917bdacbd626" body="A view implementation to display an unwrapped&#xA;preformatted line.&lt;p>&#xA;This subclasses ParagraphView, but this really only contains one&#xA;Row of text.&#xA;&#xA;@author  Timothy Prinzing&#xA;" annotatedElement="58d24564-6133-4465-9cf4-74578d85163d"/>
                <generalization xmi:id="c628b306-f016-41fc-8a6e-386b7b0bd79d" isSubstitutable="true" general="a3723f8d-e429-4f67-8390-2c5a69834f29"/>
