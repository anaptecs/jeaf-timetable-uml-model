                  </nestedClassifier>
                  <nestedClassifier xmi:type="uml:Class" xmi:id="1493eef4-db0b-4efb-afd8-34b24d2593bd" name="MetaAction" visibility="package">
                    <ownedComment xmi:id="6c52aae1-b44e-4eae-9781-72a22b9826b4" body="Subclass of HiddenAction to set the content type for style sheets,&#xA;and to set the name of the default style sheet.&#xA;" annotatedElement="1493eef4-db0b-4efb-afd8-34b24d2593bd"/>
                    <generalization xmi:id="41d8e176-15a8-4260-a91c-7f3c440d8f7c" isSubstitutable="true" general="59cd7211-4d59-447a-bc9d-3303caa40fb9"/>
                  </nestedClassifier>
                  <nestedClassifier xmi:type="uml:Class" xmi:id="8f96ebca-ae32-49d9-b2e8-0292a52ade15" name="HeadAction" visibility="package">
                    <ownedComment xmi:id="08d5b485-fc44-4600-abef-1c5f65de6f71" body="End if overridden to create the necessary stylesheets that&#xA;are referenced via the link tag. It is done in this manner&#xA;as the meta tag can be used to specify an alternate style sheet,&#xA;and is not guaranteed to come before the link tags.&#xA;" annotatedElement="8f96ebca-ae32-49d9-b2e8-0292a52ade15"/>
                    <generalization xmi:id="b9e8503c-594b-4eb6-9987-268c923edd99" isSubstitutable="true" general="2bf9d0a9-d94a-4fcd-afea-ab28040972eb"/>
                  </nestedClassifier>
                  <nestedClassifier xmi:type="uml:Class" xmi:id="5e4c1702-85f8-4def-8de7-736fd07a915b" name="LinkAction" visibility="package">
                    <ownedComment xmi:id="9229a2aa-33a4-4b93-9e83-a4225d15a487" body="A subclass to add the AttributeSet to styles if the&#xA;attributes contains an attribute for 'rel' with value&#xA;'stylesheet' or 'alternate stylesheet'.&#xA;" annotatedElement="5e4c1702-85f8-4def-8de7-736fd07a915b"/>
                    <generalization xmi:id="bd03dffc-0a1a-4d15-8a80-bfaa7407dc6e" isSubstitutable="true" general="59cd7211-4d59-447a-bc9d-3303caa40fb9"/>
                  </nestedClassifier>
