            <nestedClassifier xmi:type="uml:Class" xmi:id="80788c04-e05f-4269-8278-a5c713797666" name="VectorSpliterator" visibility="package" clientDependency="2b81242f-f76e-4b6a-b943-a1969e4e141d">
              <ownedComment xmi:id="f9d36c12-faea-4d11-bbae-c0f692fa4c7d" body="Similar to ArrayList Spliterator" annotatedElement="80788c04-e05f-4269-8278-a5c713797666"/>
              <ownedTemplateSignature xmi:type="uml:RedefinableTemplateSignature" xmi:id="80c3c819-107c-4be4-bfb2-a027c14c42cd" name="" visibility="public" parameter="157c5309-dae4-47b4-8aa8-dba37590ddaa">
