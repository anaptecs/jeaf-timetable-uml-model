            <packagedElement xmi:type="uml:Class" xmi:id="d0e61534-7306-45cb-8421-dfe3aac8595b" name="StructMember" clientDependency="fa504374-1167-4c6c-8cae-f730480cb338">
              <ownedComment xmi:id="b3e7228e-c463-46f2-af5c-ca84b0929a7e" body="Describes a member of an IDL &lt;code>struct&lt;/code> in the&#xA;Interface Repository, including&#xA;the  name of the &lt;code>struct&lt;/code> member, the type of&#xA;the &lt;code>struct&lt;/code> member, and&#xA;the typedef that represents the IDL type of the&#xA;&lt;code>struct&lt;/code> member&#xA;described the &lt;code>struct&lt;/code> member object.&#xA;" annotatedElement="d0e61534-7306-45cb-8421-dfe3aac8595b"/>
