              <generalization xmi:id="72c5d090-6bb9-42df-bab5-db76234aa149" isSubstitutable="true" general="531cd211-14e2-4428-a612-7702e427a865"/>
            </nestedClassifier>
            <nestedClassifier xmi:type="uml:Class" xmi:id="81f746f4-e2ea-4ea9-a988-96df718cb1e0" name="EntryIterator" visibility="private">
              <generalization xmi:id="56aa7540-9f56-41cd-ae0c-b857e43fee3e" isSubstitutable="true" general="a0f7f676-9a3c-45a4-a852-0036015d41b3"/>
              <nestedClassifier xmi:type="uml:Class" xmi:id="146661ed-63a2-4782-9de4-8b88e99de1ec" name="Entry" visibility="private" clientDependency="2c6ee9c3-f454-4558-8085-90487d3356fd">
                <interfaceRealization xmi:id="2c6ee9c3-f454-4558-8085-90487d3356fd" name="" supplier="418e0122-3937-43dd-9c1c-efb79a019e4f" client="146661ed-63a2-4782-9de4-8b88e99de1ec" contract="418e0122-3937-43dd-9c1c-efb79a019e4f"/>
