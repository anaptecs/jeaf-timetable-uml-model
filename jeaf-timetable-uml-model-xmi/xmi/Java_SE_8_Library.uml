          <packagedElement xmi:type="uml:Class" xmi:id="23f37570-cab1-4b6c-a0cc-0ac4bad379e1" name="TwoStacksPlainDatagramSocketImpl" visibility="package">
            <ownedComment xmi:id="1f3fb778-3bd7-400a-a172-62b27f54c0ed" body="This class defines the plain DatagramSocketImpl that is used for all&#xA;Windows versions lower than Vista. It adds support for IPv6 on&#xA;these platforms where available.&#xA;&#xA;For backward compatibility windows platforms that do not have IPv6&#xA;support also use this implementation, and fd1 gets set to null&#xA;during socket creation.&#xA;&#xA;@author Chris Hegarty&#xA;" annotatedElement="23f37570-cab1-4b6c-a0cc-0ac4bad379e1"/>
            <generalization xmi:id="994b03e9-eabe-49c0-bd3d-0f1b8b64124a" isSubstitutable="true" general="43a301ad-e7c2-4a62-96ef-0df2aafee4c9"/>
          </packagedElement>
