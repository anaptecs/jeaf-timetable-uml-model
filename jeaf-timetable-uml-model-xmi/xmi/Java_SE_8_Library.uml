              </packagedElement>
              <packagedElement xmi:type="uml:Class" xmi:id="75f4cd6d-5a86-43da-b9f0-16f5840ad624" name="TextInputCallback" clientDependency="a74e805f-5f52-4d07-a942-0e4a372fc73e 3ee19dfd-f19e-4a43-a285-afc249be3ff9">
                <ownedComment xmi:id="f25e29ad-e83b-42ff-a2f5-bbbd6019cbeb" body="&lt;p> Underlying security services instantiate and pass a&#xA;{@code TextInputCallback} to the {@code handle}&#xA;method of a {@code CallbackHandler} to retrieve generic text&#xA;information.&#xA;&#xA;@see javax.security.auth.callback.CallbackHandler&#xA;" annotatedElement="75f4cd6d-5a86-43da-b9f0-16f5840ad624"/>
                <interfaceRealization xmi:id="3ee19dfd-f19e-4a43-a285-afc249be3ff9" name="" supplier="82f4385f-427a-4cb2-b1dd-75deafd1cb31" client="75f4cd6d-5a86-43da-b9f0-16f5840ad624" contract="82f4385f-427a-4cb2-b1dd-75deafd1cb31"/>
