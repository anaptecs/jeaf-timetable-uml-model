            <packagedElement xmi:type="uml:Class" xmi:id="1cf2751a-d49c-4368-adf2-62b367fd45c3" name="Rectangle2D" isAbstract="true">
              <ownedComment xmi:id="98ef1a2b-0fd4-41b5-bab2-402ef813a8cc" body="The &lt;code>Rectangle2D&lt;/code> class describes a rectangle&#xA;defined by a location {@code (x,y)} and dimension&#xA;{@code (w x h)}.&#xA;&lt;p>&#xA;This class is only the abstract superclass for all objects that&#xA;store a 2D rectangle.&#xA;The actual storage representation of the coordinates is left to&#xA;the subclass.&#xA;&#xA;@author      Jim Graham&#xA;@since 1.2&#xA;" annotatedElement="1cf2751a-d49c-4368-adf2-62b367fd45c3"/>
              <generalization xmi:id="e7eabfe2-f801-4b06-8813-2275bd1a888a" isSubstitutable="true" general="81a4d57e-fa34-4035-b2df-d4e2706fcab3"/>
