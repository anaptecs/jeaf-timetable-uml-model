                <packagedElement xmi:type="uml:Interface" xmi:id="8b0507ee-770e-42df-8980-a1153147e271" name="Enumeration&lt;SnmpVarBind>">
                  <templateBinding xmi:id="57c78fa1-bc01-47b3-abcb-7f90ed6d5309" signature="7b1ed18b-c6ee-4bbd-863e-3ff21240ec19">
