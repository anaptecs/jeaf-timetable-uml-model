                <nestedClassifier xmi:type="uml:Class" xmi:id="c1fa0130-5558-4e33-8162-60db19a059f8" name="WriteLock" clientDependency="975e6510-2a6b-4a0f-837f-10925e08b399 5249f238-44f4-4523-8f68-4b2336fb97a9">
                  <ownedComment xmi:id="8b4fbd38-0cdf-42a9-b5b2-26f6c2cdb7b5" body="The lock returned by method {@link ReentrantReadWriteLock#writeLock}.&#xA;" annotatedElement="c1fa0130-5558-4e33-8162-60db19a059f8"/>
