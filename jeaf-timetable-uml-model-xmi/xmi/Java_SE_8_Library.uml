                  <interfaceRealization xmi:id="d633da0a-69b6-469b-b9b3-74c69e7590e5" name="" supplier="351d738c-b38b-49d3-b4b5-e99e202d16ba" client="7c7bc337-c8ed-4917-87e9-7b62ebdf40b1" contract="351d738c-b38b-49d3-b4b5-e99e202d16ba"/>
                  <interfaceRealization xmi:id="73342fdd-7952-4798-a207-6f7cdc3344d9" name="" supplier="93a66f3d-d261-4a7c-89c3-b032b4651759" client="7c7bc337-c8ed-4917-87e9-7b62ebdf40b1" contract="93a66f3d-d261-4a7c-89c3-b032b4651759"/>
                </nestedClassifier>
              </packagedElement>
              <packagedElement xmi:type="uml:Class" xmi:id="9633a215-8725-4c59-a1f2-38346dfd9084" name="BasicSplitPaneDivider" clientDependency="ad229188-7536-43ec-badb-605f7c188c06">
                <ownedComment xmi:id="a88623f9-0fab-43ee-a703-7469a6d3bc4b" body="Divider used by BasicSplitPaneUI. Subclassers may wish to override&#xA;paint to do something more interesting.&#xA;The border effect is drawn in BasicSplitPaneUI, so if you don't like&#xA;that border, reset it there.&#xA;To conditionally drag from certain areas subclass mousePressed and&#xA;call super when you wish the dragging to begin.&#xA;&lt;p>&#xA;&lt;strong>Warning:&lt;/strong>&#xA;Serialized objects of this class will not be compatible with&#xA;future Swing releases. The current serialization support is&#xA;appropriate for short term storage or RMI between applications running&#xA;the same version of Swing.  As of 1.4, support for long term storage&#xA;of all JavaBeans&amp;trade;&#xA;has been added to the &lt;code>java.beans&lt;/code> package.&#xA;Please see {@link java.beans.XMLEncoder}.&#xA;&#xA;@author Scott Violet&#xA;" annotatedElement="9633a215-8725-4c59-a1f2-38346dfd9084"/>
                <generalization xmi:id="b8e9685a-6ca0-4e06-a7b7-5d3a6c59bdf8" isSubstitutable="true" general="5615c00b-9c1c-4a7d-8a21-640ea10f375a"/>
                <interfaceRealization xmi:id="ad229188-7536-43ec-badb-605f7c188c06" name="" supplier="351d738c-b38b-49d3-b4b5-e99e202d16ba" client="9633a215-8725-4c59-a1f2-38346dfd9084" contract="351d738c-b38b-49d3-b4b5-e99e202d16ba"/>
                <nestedClassifier xmi:type="uml:Class" xmi:id="2fff57e7-d97a-49a9-ad75-f77aa1ef456c" name="MouseHandler" visibility="protected" clientDependency="763e681c-e3e8-4e89-9117-c83a66c1202a">
                  <ownedComment xmi:id="cb18e630-4026-4c07-88dd-081bc134a8f9" body="MouseHandler is responsible for converting mouse events&#xA;(released, dragged...) into the appropriate DragController&#xA;methods.&#xA;&#xA;" annotatedElement="2fff57e7-d97a-49a9-ad75-f77aa1ef456c"/>
                  <generalization xmi:id="90753928-d287-49ec-b8e3-51d39e048774" isSubstitutable="true" general="0184255e-aab0-4235-95cf-9ccb6b839c6e"/>
                  <interfaceRealization xmi:id="763e681c-e3e8-4e89-9117-c83a66c1202a" name="" supplier="98d86871-97d0-4429-88d0-62e1b9b71e43" client="2fff57e7-d97a-49a9-ad75-f77aa1ef456c" contract="98d86871-97d0-4429-88d0-62e1b9b71e43"/>
                </nestedClassifier>
                <nestedClassifier xmi:type="uml:Class" xmi:id="f6ae3748-abed-4d6b-840d-fed63aaa681b" name="DragController" visibility="protected">
                  <ownedComment xmi:id="6cbc2cc9-78ea-4dca-8431-a8b531dbcc7c" body="Handles the events during a dragging session for a&#xA;HORIZONTAL_SPLIT oriented split pane. This continually&#xA;messages &lt;code>dragDividerTo&lt;/code> and then when done messages&#xA;&lt;code>finishDraggingTo&lt;/code>. When an instance is created it should be&#xA;messaged with &lt;code>isValid&lt;/code> to insure that dragging can happen&#xA;(dragging won't be allowed if the two views can not be resized).&#xA;&lt;p>&#xA;&lt;strong>Warning:&lt;/strong>&#xA;Serialized objects of this class will not be compatible with&#xA;future Swing releases. The current serialization support is&#xA;appropriate for short term storage or RMI between applications running&#xA;the same version of Swing.  As of 1.4, support for long term storage&#xA;of all JavaBeans&amp;trade;&#xA;has been added to the &lt;code>java.beans&lt;/code> package.&#xA;Please see {@link java.beans.XMLEncoder}.&#xA;" annotatedElement="f6ae3748-abed-4d6b-840d-fed63aaa681b"/>
                </nestedClassifier>
                <nestedClassifier xmi:type="uml:Class" xmi:id="485d36f4-c72e-49bc-8c07-f295dc0a980e" name="VerticalDragController" visibility="protected">
                  <ownedComment xmi:id="fc48ba66-8a77-4aae-9aed-6d08e0518d94" body="Handles the events during a dragging session for a&#xA;VERTICAL_SPLIT oriented split pane. This continually&#xA;messages &lt;code>dragDividerTo&lt;/code> and then when done messages&#xA;&lt;code>finishDraggingTo&lt;/code>. When an instance is created it should be&#xA;messaged with &lt;code>isValid&lt;/code> to insure that dragging can happen&#xA;(dragging won't be allowed if the two views can not be resized).&#xA;" annotatedElement="485d36f4-c72e-49bc-8c07-f295dc0a980e"/>
                  <generalization xmi:id="14ec6cee-476c-46a2-b74d-4b9d016a1598" isSubstitutable="true" general="f6ae3748-abed-4d6b-840d-fed63aaa681b"/>
                </nestedClassifier>
                <nestedClassifier xmi:type="uml:Class" xmi:id="b87edc7b-1e9f-4868-9013-9ed0490010a9" name="DividerLayout" visibility="protected" clientDependency="8c848edc-9d5a-4cb0-bf86-db5f765ffe44">
                  <ownedComment xmi:id="5eb9a38d-d659-43e8-b3af-360de3f9c5be" body="Used to layout a &lt;code>BasicSplitPaneDivider&lt;/code>.&#xA;Layout for the divider&#xA;involves appropriately moving the left/right buttons around.&#xA;&#xA;" annotatedElement="b87edc7b-1e9f-4868-9013-9ed0490010a9"/>
                  <interfaceRealization xmi:id="8c848edc-9d5a-4cb0-bf86-db5f765ffe44" name="" supplier="73d8039b-0e2f-4183-8c47-60afb884da86" client="b87edc7b-1e9f-4868-9013-9ed0490010a9" contract="73d8039b-0e2f-4183-8c47-60afb884da86"/>
                </nestedClassifier>
                <nestedClassifier xmi:type="uml:Class" xmi:id="07851d7e-ebb7-4a82-a69f-c821ccf7f298" name="OneTouchActionHandler" visibility="private" clientDependency="42d5fdf3-6e67-41b5-ba7c-398009915420">
                  <ownedComment xmi:id="abcf32d3-471f-48aa-b3f4-3831af06d900" body="Listeners installed on the one touch expandable buttons.&#xA;" annotatedElement="07851d7e-ebb7-4a82-a69f-c821ccf7f298"/>
                  <interfaceRealization xmi:id="42d5fdf3-6e67-41b5-ba7c-398009915420" name="" supplier="9f3f1179-ef94-4d2c-8b64-1857870b0a46" client="07851d7e-ebb7-4a82-a69f-c821ccf7f298" contract="9f3f1179-ef94-4d2c-8b64-1857870b0a46"/>
                </nestedClassifier>
              </packagedElement>
              <packagedElement xmi:type="uml:Class" xmi:id="63c0556a-a2ea-467b-8e1e-987dabc52c68" name="BasicSplitPaneUI">
                <ownedComment xmi:id="40006a00-1ae6-438e-81ac-9e7a8e00c2e7" body="A Basic L&amp;amp;F implementation of the SplitPaneUI.&#xA;&#xA;@author Scott Violet&#xA;@author Steve Wilson&#xA;@author Ralph Kar&#xA;" annotatedElement="63c0556a-a2ea-467b-8e1e-987dabc52c68"/>
                <generalization xmi:id="4dfc81a0-83df-46ef-b479-9fa245ad7350" isSubstitutable="true" general="61b08828-e35b-4a94-bb7e-34393dbfaafb"/>
                <nestedClassifier xmi:type="uml:Class" xmi:id="ee6f4bcf-9161-4511-9371-570165df2528" name="PropertyHandler" clientDependency="9c621d3f-f5f7-4662-8e96-8741a95de7d0">
                  <ownedComment xmi:id="886d2028-4bd7-4e44-a844-925d7bfeb8ac" body="Implementation of the PropertyChangeListener&#xA;that the JSplitPane UI uses.&#xA;&lt;p>&#xA;This class should be treated as a &amp;quot;protected&amp;quot; inner class.&#xA;Instantiate it only within subclasses of BasicSplitPaneUI.&#xA;" annotatedElement="ee6f4bcf-9161-4511-9371-570165df2528"/>
