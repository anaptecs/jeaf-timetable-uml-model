                <ownedComment xmi:id="de40320c-ddb6-40f0-818f-8b880fe1183f" body="Implements the Unicode category ALL and the dot metacharacter when&#xA;in dotall mode.&#xA;" annotatedElement="46732cf6-1196-4f9e-9913-4ec5bb3c810f"/>
                <generalization xmi:id="d274bc8f-4ceb-45de-8c36-863ffbee7600" isSubstitutable="true" general="29cdb228-2cf1-48ee-a98e-e0c8d4f6346e"/>
              </nestedClassifier>
