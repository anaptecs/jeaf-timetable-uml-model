                  <generalization xmi:id="deacd823-3ff9-41be-8054-ccba3c100547" isSubstitutable="true" general="fcea9912-0f03-4260-96c2-b5d714ecc050"/>
                </nestedClassifier>
                <nestedClassifier xmi:type="uml:Class" xmi:id="da0ad2ef-a4b5-4501-9151-03e258db7676" name="RolloverMarginBorder" visibility="package">
                  <ownedComment xmi:id="f98195cf-8ebe-43a4-9539-aca51bd5bf3d" body="A border which is like a Margin border but it will only honor the margin&#xA;if the margin has been explicitly set by the developer.&#xA;&#xA;Note: This is identical to the package private class&#xA;MetalBorders.RolloverMarginBorder and should probably be consolidated.&#xA;" annotatedElement="da0ad2ef-a4b5-4501-9151-03e258db7676"/>
