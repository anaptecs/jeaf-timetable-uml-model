                      <ownedComment xmi:id="40dcbc46-b93f-4456-8538-e80de643eea1" body="Abstract super class for fields and methods.&#xA;&#xA;@author  &lt;A HREF=&quot;mailto:markus.dahm@berlin.de&quot;>M. Dahm&lt;/A>&#xA;" annotatedElement="9f644052-d57e-4228-adbc-3cff72fe7a65"/>
