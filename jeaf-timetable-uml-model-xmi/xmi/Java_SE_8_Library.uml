              </templateBinding>
            </packagedElement>
            <packagedElement xmi:type="uml:Class" xmi:id="e593b78f-48ad-4078-a465-b78f9facab52" name="Vector&lt;TableColumn>">
              <templateBinding xmi:id="1edbfd77-e99f-4024-b073-a04e3e60525b" signature="f1a14f96-df41-4636-b28a-9d52a0c301fe">
