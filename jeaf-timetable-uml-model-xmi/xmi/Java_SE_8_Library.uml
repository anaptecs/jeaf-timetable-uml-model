              <nestedClassifier xmi:type="uml:Class" xmi:id="f8308fc5-25e7-4c6e-a237-297611f94736" name="ChangeUpdateRunnable" visibility="package" clientDependency="cf9d3f93-03cb-433e-b8c5-6379cfc549e5">
