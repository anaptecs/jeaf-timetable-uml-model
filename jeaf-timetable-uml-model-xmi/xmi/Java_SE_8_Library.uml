                    </packagedElement>
                    <packagedElement xmi:type="uml:Class" xmi:id="8964c991-9690-400a-b28b-a2884e8218b5" name="DOMUtil">
                      <ownedComment xmi:id="bae1851f-0448-45c7-aac9-f2cd38ba305b" body="Some useful utility methods.&#xA;This class was modified in Xerces2 with a view to abstracting as&#xA;much as possible away from the representation of the underlying&#xA;parsed structure (i.e., the DOM).  This was done so that, if Xerces&#xA;ever adopts an in-memory representation more efficient than the DOM&#xA;(such as a DTM), we should easily be able to convert our schema&#xA;parsing to utilize it.&#xA;&#xA;@version $Id: DOMUtil.java,v 1.7 2010-11-01 04:40:14 joehw Exp $&#xA;" annotatedElement="8964c991-9690-400a-b28b-a2884e8218b5"/>
                      <nestedClassifier xmi:type="uml:Class" xmi:id="4396c9a6-8f93-4dac-a9ff-8e0fbe3dd1ee" name="ThrowableMethods" visibility="package">
                        <ownedComment xmi:id="f1120365-0c70-4a21-8d8f-c3cfb7fcc36a" body="Holder of methods from java.lang.Throwable.&#xA;" annotatedElement="4396c9a6-8f93-4dac-a9ff-8e0fbe3dd1ee"/>
                      </nestedClassifier>
                    </packagedElement>
                    <packagedElement xmi:type="uml:Class" xmi:id="e8b404ee-94d1-4c09-a2a4-b8539b767e43" name="DraconianErrorHandler" clientDependency="bc20f7f3-4b68-4686-b1ba-464927aa27e1">
