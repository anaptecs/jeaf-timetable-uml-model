                  <generalization xmi:id="ecef0349-1b54-404a-8ba4-fe2bb11f5f31" isSubstitutable="true" general="89984750-7d8e-40f2-9ad7-66e3961a6580"/>
                </nestedClassifier>
              </nestedClassifier>
            </nestedClassifier>
            <nestedClassifier xmi:type="uml:Class" xmi:id="44349f1d-b5b3-4725-8dae-c9594ead849e" name="DisabledAction" visibility="private" clientDependency="b58fad56-9db4-4992-906f-28f9493e140b">
              <ownedComment xmi:id="f3696f0b-1a18-48cd-9bcc-b1795dd878fe" body="An Action implementation that is always disabled.&#xA;" annotatedElement="44349f1d-b5b3-4725-8dae-c9594ead849e"/>
