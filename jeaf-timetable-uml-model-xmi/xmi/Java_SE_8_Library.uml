              <packagedElement xmi:type="uml:Class" xmi:id="f1a5e2d0-fabf-4214-a326-24cb72f746b5" name="BasicHTML">
                <ownedComment xmi:id="cabaaa0b-4260-4edb-8bb0-6907b7aee5b5" body="Support for providing html views for the swing components.&#xA;This translates a simple html string to a javax.swing.text.View&#xA;implementation that can render the html and provide the necessary&#xA;layout semantics.&#xA;&#xA;@author  Timothy Prinzing&#xA;@since 1.3&#xA;" annotatedElement="f1a5e2d0-fabf-4214-a326-24cb72f746b5"/>
                <nestedClassifier xmi:type="uml:Class" xmi:id="b7e93ec6-1ec5-446a-98a8-300deabfd798" name="BasicEditorKit" visibility="package">
                  <ownedComment xmi:id="bcdaed83-cf57-41c2-80d3-e3fea621fa49" body="The views produced for the ComponentUI implementations aren't&#xA;going to be edited and don't need full html support.  This kit&#xA;alters the HTMLEditorKit to try and trim things down a bit.&#xA;It does the following:&#xA;&lt;ul>&#xA;&lt;li>It doesn't produce Views for things like comments,&#xA;head, title, unknown tags, etc.&#xA;&lt;li>It installs a different set of css settings from the default&#xA;provided by HTMLEditorKit.&#xA;&lt;/ul>&#xA;" annotatedElement="b7e93ec6-1ec5-446a-98a8-300deabfd798"/>
                  <generalization xmi:id="b4a285b8-ed71-4185-96ac-747a208a5bb4" isSubstitutable="true" general="5175dc08-1c58-418b-bbf0-848016ade4a3"/>
                </nestedClassifier>
                <nestedClassifier xmi:type="uml:Class" xmi:id="6e56be17-fa9e-46a4-b96e-e53b826af9ec" name="BasicHTMLViewFactory" visibility="package">
                  <ownedComment xmi:id="915da247-f0b7-4424-babf-442d97497e44" body="BasicHTMLViewFactory extends HTMLFactory to force images to be loaded&#xA;synchronously.&#xA;" annotatedElement="6e56be17-fa9e-46a4-b96e-e53b826af9ec"/>
                  <generalization xmi:id="9d6aa16d-093a-4e34-82c5-ba726e6fe2ed" isSubstitutable="true" general="6f60f48e-4bbd-4ccd-9370-75e053212ab5"/>
                </nestedClassifier>
                <nestedClassifier xmi:type="uml:Class" xmi:id="c917e9b8-0dd9-4c2f-b1a3-3398eab93d59" name="BasicDocument" visibility="package">
                  <ownedComment xmi:id="ca925f58-4f71-4ded-aa1f-f90457472a3d" body="The subclass of HTMLDocument that is used as the model. getForeground&#xA;is overridden to return the foreground property from the Component this&#xA;was created for.&#xA;" annotatedElement="c917e9b8-0dd9-4c2f-b1a3-3398eab93d59"/>
                  <generalization xmi:id="4a699791-b7ad-4b8f-b8a9-a5252f6659c0" isSubstitutable="true" general="182c14d7-d91c-4efb-8856-0580ea30f9ea"/>
                </nestedClassifier>
                <nestedClassifier xmi:type="uml:Class" xmi:id="c507c874-2bfe-4433-a622-96cfeabf4018" name="Renderer" visibility="package">
                  <ownedComment xmi:id="6d8c6668-202c-4f9b-b545-55a5ee4b0337" body="Root text view that acts as an HTML renderer.&#xA;" annotatedElement="c507c874-2bfe-4433-a622-96cfeabf4018"/>
