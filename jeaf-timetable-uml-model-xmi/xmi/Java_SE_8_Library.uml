            <interfaceRealization xmi:id="09bf9b4e-3cda-403c-960f-475f0840a0b3" name="" supplier="6c1ec895-4f1f-4a90-b94f-fa5667da5ed2" client="8b643c00-8803-4824-a40b-36dcdbd65758" contract="6c1ec895-4f1f-4a90-b94f-fa5667da5ed2"/>
