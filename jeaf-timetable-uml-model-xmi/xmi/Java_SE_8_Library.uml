            <packagedElement xmi:type="uml:Interface" xmi:id="339018e9-195b-464b-a8d4-936268e340bf" name="TableCellEditor" isAbstract="true">
              <ownedComment xmi:id="64e910ee-eb75-4f0c-bc14-70e9e21ca7f2" body="This interface defines the method any object that would like to be&#xA;an editor of values for components such as &lt;code>JListBox&lt;/code>,&#xA;&lt;code>JComboBox&lt;/code>, &lt;code>JTree&lt;/code>, or &lt;code>JTable&lt;/code>&#xA;needs to implement.&#xA;&#xA;@author Alan Chung&#xA;" annotatedElement="339018e9-195b-464b-a8d4-936268e340bf"/>
