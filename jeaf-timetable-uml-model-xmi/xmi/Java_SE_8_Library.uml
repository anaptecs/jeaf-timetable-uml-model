                      <ownedComment xmi:id="40947f67-2b0f-4af0-8dd1-21e98001d843" body="IMUL - Multiply ints&#xA;&lt;PRE>Stack: ..., value1, value2 -&amp;gt; result&lt;/PRE>&#xA;&#xA;@author  &lt;A HREF=&quot;mailto:markus.dahm@berlin.de&quot;>M. Dahm&lt;/A>&#xA;" annotatedElement="c7484072-f211-4ecd-9882-8966438510e0"/>
                      <generalization xmi:id="3fccf3bf-9cbc-49eb-881c-2aae9c41a203" isSubstitutable="true" general="75d6eb59-6113-4515-a948-ee7bf7e12bac"/>
                    </packagedElement>
                    <packagedElement xmi:type="uml:Interface" xmi:id="a0155184-1ed4-4ed9-ac75-e0f73e4fa111" name="IndexedInstruction" isAbstract="true">
                      <ownedComment xmi:id="aa93c67c-b4d5-480c-8615-39ba6548953f" body="Denote entity that refers to an index, e.g. local variable instructions,&#xA;RET, CPInstruction, etc.&#xA;&#xA;@author  &lt;A HREF=&quot;mailto:markus.dahm@berlin.de&quot;>M. Dahm&lt;/A>&#xA;" annotatedElement="a0155184-1ed4-4ed9-ac75-e0f73e4fa111"/>
                    </packagedElement>
                    <packagedElement xmi:type="uml:Class" xmi:id="ee61135a-498e-418a-88fc-6098d7731007" name="INEG">
                      <ownedComment xmi:id="a141d6e5-d2b5-4a68-a1da-f9d50e2b4440" body="INEG - Negate int&#xA;&lt;PRE>Stack: ..., value -&amp;gt; ..., result&lt;/PRE>&#xA;&#xA;@author  &lt;A HREF=&quot;mailto:markus.dahm@berlin.de&quot;>M. Dahm&lt;/A>&#xA;" annotatedElement="ee61135a-498e-418a-88fc-6098d7731007"/>
                      <generalization xmi:id="9d8dec60-533b-441e-a20d-0989e54007a7" isSubstitutable="true" general="75d6eb59-6113-4515-a948-ee7bf7e12bac"/>
                    </packagedElement>
                    <packagedElement xmi:type="uml:Class" xmi:id="da05a10c-5cb5-4c33-8ef7-01c46c0d666e" name="INSTANCEOF" clientDependency="88161473-8b13-4a8a-9f62-dd7d5685723d 3c87939c-ca25-4513-a83b-05849807878d b051229d-3435-4c08-9c72-813cdfc4e66d ef9c2ce7-ef67-455a-9f73-4755cb74c613">
                      <ownedComment xmi:id="932b9161-7667-41e2-8fe9-ff6382cc64e1" body="INSTANCEOF - Determine if object is of given type&#xA;&lt;PRE>Stack: ..., objectref -&amp;gt; ..., result&lt;/PRE>&#xA;&#xA;@author  &lt;A HREF=&quot;mailto:markus.dahm@berlin.de&quot;>M. Dahm&lt;/A>&#xA;" annotatedElement="da05a10c-5cb5-4c33-8ef7-01c46c0d666e"/>
                      <generalization xmi:id="c1d168ac-7bed-49cd-84ea-1e05b7000f15" isSubstitutable="true" general="83d0d000-d9ee-4501-90e7-bdea1dae3866"/>
                      <interfaceRealization xmi:id="3c87939c-ca25-4513-a83b-05849807878d" name="" supplier="65e8b54b-e585-4521-8f8a-0606f764fef0" client="da05a10c-5cb5-4c33-8ef7-01c46c0d666e" contract="65e8b54b-e585-4521-8f8a-0606f764fef0"/>
                      <interfaceRealization xmi:id="b051229d-3435-4c08-9c72-813cdfc4e66d" name="" supplier="8a19e778-d09e-4ed2-8f79-2fc524f41257" client="da05a10c-5cb5-4c33-8ef7-01c46c0d666e" contract="8a19e778-d09e-4ed2-8f79-2fc524f41257"/>
                      <interfaceRealization xmi:id="88161473-8b13-4a8a-9f62-dd7d5685723d" name="" supplier="72b2deb9-6b9b-48ed-abb9-756a9483a7c2" client="da05a10c-5cb5-4c33-8ef7-01c46c0d666e" contract="72b2deb9-6b9b-48ed-abb9-756a9483a7c2"/>
                      <interfaceRealization xmi:id="ef9c2ce7-ef67-455a-9f73-4755cb74c613" name="" supplier="7cc8508b-2fac-4498-9d2f-2c6ba1583e13" client="da05a10c-5cb5-4c33-8ef7-01c46c0d666e" contract="7cc8508b-2fac-4498-9d2f-2c6ba1583e13"/>
                    </packagedElement>
                    <packagedElement xmi:type="uml:Class" xmi:id="9a1fe03b-b9ed-44f8-910c-ea46eca4dcc2" name="Instruction" clientDependency="b3bedfd9-d8e9-4ccb-a112-49e9c5c1992e a53e051b-cc77-4d89-b8d3-8b1649c2727a" isAbstract="true">
                      <ownedComment xmi:id="7a049e79-0172-42e6-96cb-59a2a556c6a6" body="Abstract super class for all Java byte codes.&#xA;&#xA;@author  &lt;A HREF=&quot;mailto:markus.dahm@berlin.de&quot;>M. Dahm&lt;/A>&#xA;" annotatedElement="9a1fe03b-b9ed-44f8-910c-ea46eca4dcc2"/>
                      <interfaceRealization xmi:id="b3bedfd9-d8e9-4ccb-a112-49e9c5c1992e" name="" supplier="af41d975-30f5-4ca2-9f69-6cae8e15d59a" client="9a1fe03b-b9ed-44f8-910c-ea46eca4dcc2" contract="af41d975-30f5-4ca2-9f69-6cae8e15d59a"/>
                      <interfaceRealization xmi:id="a53e051b-cc77-4d89-b8d3-8b1649c2727a" name="" supplier="41f4a654-a713-47bf-a391-e112be100ec5" client="9a1fe03b-b9ed-44f8-910c-ea46eca4dcc2" contract="41f4a654-a713-47bf-a391-e112be100ec5"/>
                    </packagedElement>
                    <packagedElement xmi:type="uml:Interface" xmi:id="9a73355c-3a35-4104-9e86-bb224d687e89" name="InstructionComparator" isAbstract="true">
                      <ownedComment xmi:id="2cda23e2-f860-42df-804f-690f2dfd618e" body="Equality of instructions isn't clearly to be defined. You might&#xA;wish, for example, to compare whether instructions have the same&#xA;meaning. E.g., whether two INVOKEVIRTUALs describe the same&#xA;call.&lt;br>The DEFAULT comparator however, considers two instructions&#xA;to be equal if they have same opcode and point to the same indexes&#xA;(if any) in the constant pool or the same local variable index. Branch&#xA;instructions must have the same target.&#xA;&#xA;@see Instruction&#xA;@author &lt;A HREF=&quot;mailto:markus.dahm@berlin.de&quot;>M. Dahm&lt;/A>&#xA;" annotatedElement="9a73355c-3a35-4104-9e86-bb224d687e89"/>
                    </packagedElement>
                    <packagedElement xmi:type="uml:Interface" xmi:id="a9314c22-132d-42bd-952d-b4355d47f349" name="InstructionConstants" isAbstract="true">
                      <ownedComment xmi:id="23d079e0-85bc-4426-aec4-98cbec7dd7c0" body="This interface contains shareable instruction objects.&#xA;&#xA;In order to save memory you can use some instructions multiply,&#xA;since they have an immutable state and are directly derived from&#xA;Instruction.  I.e. they have no instance fields that could be&#xA;changed. Since some of these instructions like ICONST_0 occur&#xA;very frequently this can save a lot of time and space. This&#xA;feature is an adaptation of the FlyWeight design pattern, we&#xA;just use an array instead of a factory.&#xA;&#xA;The Instructions can also accessed directly under their names, so&#xA;it's possible to write il.append(Instruction.ICONST_0);&#xA;&#xA;@author  &lt;A HREF=&quot;mailto:markus.dahm@berlin.de&quot;>M. Dahm&lt;/A>&#xA;" annotatedElement="a9314c22-132d-42bd-952d-b4355d47f349"/>
                      <nestedClassifier xmi:type="uml:Class" xmi:id="6394d30e-590b-4495-a5c0-ee98b1340f73" name="Clinit"/>
                    </packagedElement>
                    <packagedElement xmi:type="uml:Class" xmi:id="ac409928-173e-45de-b4ee-0299d3e7b411" name="InstructionFactory" clientDependency="d03aebe1-4255-45e4-9bc3-18f830ff5898 8478a58b-6a01-4161-8f59-6fcee536e044">
                      <ownedComment xmi:id="e442bdee-c440-4e4b-9a1e-055662c172b0" body="Instances of this class may be used, e.g., to generate typed&#xA;versions of instructions. Its main purpose is to be used as the&#xA;byte code generating backend of a compiler. You can subclass it to&#xA;add your own create methods.&#xA;&#xA;@author &lt;A HREF=&quot;mailto:markus.dahm@berlin.de&quot;>M. Dahm&lt;/A>&#xA;@see Constants&#xA;" annotatedElement="ac409928-173e-45de-b4ee-0299d3e7b411"/>
                      <interfaceRealization xmi:id="d03aebe1-4255-45e4-9bc3-18f830ff5898" name="" supplier="a9314c22-132d-42bd-952d-b4355d47f349" client="ac409928-173e-45de-b4ee-0299d3e7b411" contract="a9314c22-132d-42bd-952d-b4355d47f349"/>
                      <interfaceRealization xmi:id="8478a58b-6a01-4161-8f59-6fcee536e044" name="" supplier="41f4a654-a713-47bf-a391-e112be100ec5" client="ac409928-173e-45de-b4ee-0299d3e7b411" contract="41f4a654-a713-47bf-a391-e112be100ec5"/>
                      <nestedClassifier xmi:type="uml:Class" xmi:id="f1808267-878c-4511-873e-cd9bb2f38cd5" name="MethodObject" visibility="private"/>
                    </packagedElement>
                    <packagedElement xmi:type="uml:Class" xmi:id="170ef63b-196c-4de3-8c40-080a5de1e8d0" name="InstructionHandle" clientDependency="2ad80703-bdf6-48af-b2e5-96e80f507284">
                      <ownedComment xmi:id="25f27e63-e0c1-4598-ae78-cdc5cc2f69c2" body="Instances of this class give users a handle to the instructions contained in&#xA;an InstructionList. Instruction objects may be used more than once within a&#xA;list, this is useful because it saves memory and may be much faster.&#xA;&#xA;Within an InstructionList an InstructionHandle object is wrapped&#xA;around all instructions, i.e., it implements a cell in a&#xA;doubly-linked list. From the outside only the next and the&#xA;previous instruction (handle) are accessible. One&#xA;can traverse the list via an Enumeration returned by&#xA;InstructionList.elements().&#xA;&#xA;@author  &lt;A HREF=&quot;mailto:markus.dahm@berlin.de&quot;>M. Dahm&lt;/A>&#xA;@see Instruction&#xA;@see BranchHandle&#xA;@see InstructionList&#xA;" annotatedElement="170ef63b-196c-4de3-8c40-080a5de1e8d0"/>
                      <interfaceRealization xmi:id="2ad80703-bdf6-48af-b2e5-96e80f507284" name="" supplier="41f4a654-a713-47bf-a391-e112be100ec5" client="170ef63b-196c-4de3-8c40-080a5de1e8d0" contract="41f4a654-a713-47bf-a391-e112be100ec5"/>
                    </packagedElement>
                    <packagedElement xmi:type="uml:Class" xmi:id="4ddcfb2d-d97c-4d9f-966a-a29b52b9b8fa" name="InstructionList" clientDependency="e43e74a3-5eb3-4af4-aa3e-abcc7f752779">
                      <ownedComment xmi:id="71cecfd6-f762-4230-994b-808618154536" body="This class is a container for a list of &lt;a&#xA;href=&quot;Instruction.html&quot;>Instruction&lt;/a> objects. Instructions can&#xA;be appended, inserted, moved, deleted, etc.. Instructions are being&#xA;wrapped into &lt;a&#xA;href=&quot;InstructionHandle.html&quot;>InstructionHandles&lt;/a> objects that&#xA;are returned upon append/insert operations. They give the user&#xA;(read only) access to the list structure, such that it can be traversed and&#xA;manipulated in a controlled way.&#xA;&#xA;A list is finally dumped to a byte code array with &lt;a&#xA;href=&quot;#getByteCode()&quot;>getByteCode&lt;/a>.&#xA;&#xA;@author  &lt;A HREF=&quot;mailto:markus.dahm@berlin.de&quot;>M. Dahm&lt;/A>&#xA;@see     Instruction&#xA;@see     InstructionHandle&#xA;@see BranchHandle&#xA;" annotatedElement="4ddcfb2d-d97c-4d9f-966a-a29b52b9b8fa"/>
                      <interfaceRealization xmi:id="e43e74a3-5eb3-4af4-aa3e-abcc7f752779" name="" supplier="41f4a654-a713-47bf-a391-e112be100ec5" client="4ddcfb2d-d97c-4d9f-966a-a29b52b9b8fa" contract="41f4a654-a713-47bf-a391-e112be100ec5"/>
                    </packagedElement>
                    <packagedElement xmi:type="uml:Interface" xmi:id="a19f7b83-3956-4ee5-8e32-6af40de91dd7" name="InstructionListObserver" isAbstract="true">
                      <ownedComment xmi:id="6bd95f32-59a8-4c43-9c77-a695b6ee49a6" body="Implement this interface if you're interested in changes to an InstructionList object&#xA;and register yourself with addObserver().&#xA;&#xA;@author  &lt;A HREF=&quot;mailto:markus.dahm@berlin.de&quot;>M. Dahm&lt;/A>&#xA;" annotatedElement="a19f7b83-3956-4ee5-8e32-6af40de91dd7"/>
                    </packagedElement>
                    <packagedElement xmi:type="uml:Interface" xmi:id="670dd02b-d102-4aa8-b686-6c6d79badb91" name="InstructionTargeter" isAbstract="true">
                      <ownedComment xmi:id="c43d2034-524d-4418-b727-f6ab877397c2" body="Denote that a class targets InstructionHandles within an InstructionList. Namely&#xA;the following implementers:&#xA;&#xA;@see BranchHandle&#xA;@see LocalVariableGen&#xA;@see CodeExceptionGen&#xA;@author  &lt;A HREF=&quot;mailto:markus.dahm@berlin.de&quot;>M. Dahm&lt;/A>&#xA;" annotatedElement="670dd02b-d102-4aa8-b686-6c6d79badb91"/>
                    </packagedElement>
                    <packagedElement xmi:type="uml:Class" xmi:id="d2748738-8842-4b94-894d-5fdcdbe585ec" name="InvokeInstruction" clientDependency="5131c337-744c-41a2-8e32-ab997e7c1922 67a617a9-0d1d-432b-9fb1-c9b03985e9e0 a5622ccf-955f-46ac-99f2-4ae5b8cada37 5eee47bf-c3dd-4013-8eae-ae261bbe6fce" isAbstract="true">
                      <ownedComment xmi:id="f9f9c525-a8db-48f8-92f0-9b96cfa6ff03" body="Super class for the INVOKExxx family of instructions.&#xA;&#xA;@author  &lt;A HREF=&quot;mailto:markus.dahm@berlin.de&quot;>M. Dahm&lt;/A>&#xA;" annotatedElement="d2748738-8842-4b94-894d-5fdcdbe585ec"/>
                      <generalization xmi:id="c38fa23d-fab8-472e-8bf9-b76c05e4eb59" isSubstitutable="true" general="9f644052-d57e-4228-adbc-3cff72fe7a65"/>
