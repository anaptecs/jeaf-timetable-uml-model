              </ownedParameter>
            </ownedTemplateSignature>
            <generalization xmi:id="1bf4dcb5-3dbd-4085-af88-f1c619e01242" isSubstitutable="true" general="ca445ddd-624d-4eba-ac51-bf7f993b8e10"/>
            <interfaceRealization xmi:id="76e36937-8f5f-457b-baf3-47a9dd9359c1" name="" supplier="7b997626-b0c9-4c62-8d14-be8658f6f2c8" client="99875bf5-dd7e-4eeb-94ae-8252588a2bad" contract="7b997626-b0c9-4c62-8d14-be8658f6f2c8"/>
