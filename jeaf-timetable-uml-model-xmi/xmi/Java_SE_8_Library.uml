            <packagedElement xmi:type="uml:Interface" xmi:id="10c0ba93-5d27-4ac5-aa60-6a194f199c74" name="Iterator&lt;E>">
              <templateBinding xmi:id="3cab79a0-4eff-4e85-b593-67099a388810" signature="89418999-ce9f-42d9-ba0a-9b08a10665d0">
                <parameterSubstitution xmi:id="94fbd80b-e4c5-4af1-b2ac-b8d1e1a4261f" formal="23a74449-2e94-4038-9c98-d67f366cbe2f" actual="f76d8d11-d258-440a-82e5-73c5b2e4b6f7"/>
