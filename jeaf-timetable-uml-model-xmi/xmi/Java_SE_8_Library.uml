            <interfaceRealization xmi:id="e7e78d9c-3288-45b2-bfdf-9745f167e7ab" name="" supplier="0c97a559-0b1f-461e-bd3e-9b3f829d66be" client="8a119f02-9257-492d-a8af-556b489bb72c" contract="0c97a559-0b1f-461e-bd3e-9b3f829d66be"/>
