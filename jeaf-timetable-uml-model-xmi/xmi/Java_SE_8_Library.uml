                </nestedClassifier>
              </packagedElement>
              <packagedElement xmi:type="uml:Class" xmi:id="b0c5ccda-4bef-4de1-b8d8-f3b9844ba87d" name="MBeanServerDelegateImpl" visibility="package" clientDependency="8fd74f33-c73a-4776-bf0b-d401f0c84baf 288af251-cbb1-4711-86af-6979eeceaafc">
                <ownedComment xmi:id="9cc9327a-67f9-44f4-940d-522e3fea4ee1" body="This class is the MBean implementation of the MBeanServerDelegate.&#xA;&#xA;@since 1.5&#xA;" annotatedElement="b0c5ccda-4bef-4de1-b8d8-f3b9844ba87d"/>
                <generalization xmi:id="a27c183c-6332-49ff-9d05-ae99dfd45b66" isSubstitutable="true" general="66869068-0b52-4bc3-9152-59801852ee3d"/>
