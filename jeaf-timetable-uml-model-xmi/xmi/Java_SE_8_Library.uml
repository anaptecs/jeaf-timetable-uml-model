            <packagedElement xmi:type="uml:Interface" xmi:id="c9afc2f9-474a-4cdb-a9c4-900d18279b5d" name="ChronoZonedDateTime&lt;ThaiBuddhistDate>">
              <templateBinding xmi:id="df78ba3e-790f-44ba-a26a-c9c39b7d6d2c" signature="eed3cd9b-5a14-4015-8f85-ef79a7f2784b">
                <parameterSubstitution xmi:id="fe8ab2e8-690b-4c4e-a24f-88c895d39936" formal="2a531e9f-a349-4dc4-809f-9a8e9b0b0b21" actual="e199f7ca-7c75-479d-95ba-13e12a89c855"/>
