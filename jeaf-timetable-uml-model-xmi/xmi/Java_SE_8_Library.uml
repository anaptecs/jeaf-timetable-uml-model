            </nestedClassifier>
            <nestedClassifier xmi:type="uml:Class" xmi:id="d6ebc85c-6a30-4b14-b31e-2d62becc53d9" name="SpringMap" visibility="package" isAbstract="true">
              <generalization xmi:id="25c7700d-376a-44eb-861a-5e702ff3300e" isSubstitutable="true" general="50521c38-974d-4617-8c91-13b0308f6e59"/>
            </nestedClassifier>
            <nestedClassifier xmi:type="uml:Class" xmi:id="8bd06abe-d96e-43c7-aca3-234cc6da9962" name="CompoundSpring" visibility="package" isAbstract="true">
              <generalization xmi:id="19579a73-2762-4626-a399-cb294d79949e" isSubstitutable="true" general="6403806e-ba24-42d0-8eb1-7cfc2741dc36"/>
            </nestedClassifier>
            <nestedClassifier xmi:type="uml:Class" xmi:id="a2b8ac9a-100c-4351-8e6a-d9bffade0db7" name="SumSpring" visibility="private">
