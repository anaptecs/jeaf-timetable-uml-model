              </templateBinding>
            </packagedElement>
            <packagedElement xmi:type="uml:Interface" xmi:id="d6b32e30-ed5b-4545-9050-4669ebbbf6fe" name="TemporalQuery&lt;Boolean>">
              <templateBinding xmi:id="7686e191-94ac-4a6a-ac7c-2b9c37a8ba49" signature="50fc7230-037e-43fb-b0cc-772e79e77ad4">
                <parameterSubstitution xmi:id="216dbf7f-63a4-4f9f-8736-479288392b19" formal="dbfb7312-edb9-42f2-8734-f9ca7b1d7daa" actual="ac2ef6bc-a4c1-4d04-a7de-9a9e97a3e0a1"/>
              </templateBinding>
            </packagedElement>
            <packagedElement xmi:type="uml:Interface" xmi:id="449542c5-25bb-4e06-955d-343e392fcc77" name="TemporalQuery&lt;>">
              <templateBinding xmi:id="913280e8-82f3-40c9-886a-8663c5e679f7" signature="50fc7230-037e-43fb-b0cc-772e79e77ad4">
                <parameterSubstitution xmi:id="2490fac6-7b8e-4ea0-899c-5ef5d688a10e" formal="dbfb7312-edb9-42f2-8734-f9ca7b1d7daa"/>
              </templateBinding>
