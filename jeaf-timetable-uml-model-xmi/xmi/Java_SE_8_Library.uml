                  </packagedElement>
                  <packagedElement xmi:type="uml:Interface" xmi:id="8e3d1a2d-df0c-4c62-aa61-21b4a2068cf9" name="ContactInfo" isAbstract="true">
                    <ownedComment xmi:id="f49a5bde-6861-4eaa-83e3-830aeca52a71" body="&lt;p>The &lt;b>&lt;em>primary&lt;/em>&lt;/b> PEPt client-side plug-in point and enabler&#xA;for &lt;b>&lt;em>altenate encodings, protocols and transports&lt;/em>&lt;/b>.&lt;/p>&#xA;&#xA;&lt;p>&lt;code>ContactInfo&lt;/code> is a &lt;em>factory&lt;/em> for client-side&#xA;artifacts used&#xA;to construct and send a message (and possibly receive and process a&#xA;response).&lt;/p>&#xA;&#xA;@author Harold Carr&#xA;" annotatedElement="8e3d1a2d-df0c-4c62-aa61-21b4a2068cf9"/>
                  </packagedElement>
