            <nestedClassifier xmi:type="uml:Class" xmi:id="e374a13b-c0d0-475e-874a-f43c38bb0805" name="Page" visibility="private" clientDependency="b99600d7-223e-47bb-8a05-b6b07548b94a f2a83f02-e966-4600-bed5-933de7bf76b8 26d7ef9f-7ffe-4b10-ab7f-5033ada892ac">
