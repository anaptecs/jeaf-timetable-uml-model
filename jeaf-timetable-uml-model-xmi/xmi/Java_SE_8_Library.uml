          <packagedElement xmi:type="uml:Class" xmi:id="faddcbe1-4e3f-491b-87d5-66f4883fbb56" name="ReferenceQueue&lt;Class&lt;>>">
            <templateBinding xmi:id="f49128d2-b1b1-463d-8a8c-df47d5e73d1a" signature="b9e3243c-d584-473f-9d2e-72e124cfe67d">
