              <generalization xmi:id="17ff0936-f453-4099-9273-9df4fcf1845f" isSubstitutable="true" general="7f3c60c7-b6d0-4f10-afe7-808a76561b1d"/>
            </packagedElement>
            <packagedElement xmi:type="uml:Interface" xmi:id="9fcfbf2e-f133-462d-a5ad-86e6ba9fa61f" name="SystemTrayPeer" isAbstract="true">
