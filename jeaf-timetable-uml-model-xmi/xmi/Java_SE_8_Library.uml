              <packagedElement xmi:type="uml:Class" xmi:id="00771609-2b27-4819-ba86-9b2666f88d45" name="LoweredBorder" visibility="package" clientDependency="1f55a290-a089-4add-a28b-37a2ca7b969b">
                <ownedComment xmi:id="e775b424-de19-4b1d-be06-8ee55c07df98" body="LoweredBorder - A recessed rounded inner shadowed border. Used as the&#xA;standard Nimbus TitledBorder. This class is both a painter and a swing&#xA;border.&#xA;&#xA;@author Jasper Potts&#xA;" annotatedElement="00771609-2b27-4819-ba86-9b2666f88d45"/>
                <generalization xmi:id="0ea40400-8ff9-40f5-a504-62dd1d7ffbbc" isSubstitutable="true" general="5806144a-f1e7-4e0c-b590-03a1c8d2f61f"/>
