                  </packagedElement>
                </packagedElement>
                <packagedElement xmi:type="uml:Package" xmi:id="73dc6b22-a03e-49a8-8651-a26bb4add3c5" name="rmi">
                  <packagedElement xmi:type="uml:Class" xmi:id="cdebffce-6bb5-419c-a64e-6f4b27836a33" name="ClientProvider" clientDependency="dc4d2ed0-1632-4a4e-b2af-9db8db6a1ea4">
                    <interfaceRealization xmi:id="dc4d2ed0-1632-4a4e-b2af-9db8db6a1ea4" name="" supplier="6032142f-eb39-4c14-93a5-892427b225eb" client="cdebffce-6bb5-419c-a64e-6f4b27836a33" contract="6032142f-eb39-4c14-93a5-892427b225eb"/>
