              </nestedClassifier>
              <nestedClassifier xmi:type="uml:Class" xmi:id="8462091a-4ac1-4957-87fb-d60fabcee7af" name="LoggerWeakRef" visibility="package">
                <generalization xmi:id="b16e626a-0ae8-4cea-bc88-452d89bded40" isSubstitutable="true" general="75737024-f7ca-4aa8-9fc4-f4cbfda43e3a"/>
              </nestedClassifier>
              <nestedClassifier xmi:type="uml:Class" xmi:id="cef5a6f9-6b06-4eba-b1be-5cfe98ab68cf" name="LogNode" visibility="private"/>
