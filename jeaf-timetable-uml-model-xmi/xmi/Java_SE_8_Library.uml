                      <ownedParameteredElement xmi:type="uml:Class" xmi:id="d89681f6-63be-4b7c-8ac3-65c7de0c7978" name="T" templateParameter="97c164ee-deb2-4a90-9fcb-7cab2d7467e2"/>
                    </ownedParameter>
                  </ownedTemplateSignature>
                  <generalization xmi:id="abe377ec-921e-40b9-972d-1f445506b432" isSubstitutable="true" general="55d2985e-2f5c-492e-a405-516a447369bb"/>
                </nestedClassifier>
              </packagedElement>
