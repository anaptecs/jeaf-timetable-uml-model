                <interfaceRealization xmi:id="c384a7b3-f25f-4751-9941-23c80372e782" name="" supplier="41f4a654-a713-47bf-a391-e112be100ec5" client="cf2def36-8939-40e0-9e4f-837829c3e87e" contract="41f4a654-a713-47bf-a391-e112be100ec5"/>
              </nestedClassifier>
              <nestedClassifier xmi:type="uml:Class" xmi:id="cfe92b5d-6e1f-4e54-864c-17ffab07e966" name="DefaultDocumentFilter" visibility="private" clientDependency="8440c68d-7940-4bbb-8822-a4d29ad1a396">
                <ownedComment xmi:id="1f262fe4-3d4c-4ffc-b3ab-6957965014aa" body="DocumentFilter implementation that calls back to the replace&#xA;method of DefaultFormatter.&#xA;" annotatedElement="cfe92b5d-6e1f-4e54-864c-17ffab07e966"/>
                <generalization xmi:id="a168ba9c-e875-437b-a7a6-5ea109d3fe23" isSubstitutable="true" general="89984750-7d8e-40f2-9ad7-66e3961a6580"/>
