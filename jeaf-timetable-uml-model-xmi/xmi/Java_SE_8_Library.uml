                  </nestedClassifier>
                  <nestedClassifier xmi:type="uml:Class" xmi:id="45c25080-b7ee-4eba-8d2a-345e68f15c82" name="JFIFExtensionMarkerSegment" visibility="package">
                    <ownedComment xmi:id="85f597b3-8540-4e8c-ba17-a63e88e8daf7" body="A JFIF extension APP0 marker segment.&#xA;" annotatedElement="45c25080-b7ee-4eba-8d2a-345e68f15c82"/>
                    <generalization xmi:id="4b027965-2129-403a-aa43-042b32c23530" isSubstitutable="true" general="c15504bb-c7e6-4bfb-aeab-fad059cb0243"/>
                  </nestedClassifier>
                  <nestedClassifier xmi:type="uml:Class" xmi:id="8bd91a04-bfad-436d-a292-e0e48b40d815" name="JFIFThumb" visibility="package" clientDependency="41d2aa3d-83e9-41e9-8ca2-144e0e136543" isAbstract="true">
                    <ownedComment xmi:id="76380584-5a6a-4832-a0ba-4a2e5d3cdc07" body="A superclass for the varieties of thumbnails that can&#xA;be stored in a JFIF extension marker segment.&#xA;" annotatedElement="8bd91a04-bfad-436d-a292-e0e48b40d815"/>
                    <interfaceRealization xmi:id="41d2aa3d-83e9-41e9-8ca2-144e0e136543" name="" supplier="af41d975-30f5-4ca2-9f69-6cae8e15d59a" client="8bd91a04-bfad-436d-a292-e0e48b40d815" contract="af41d975-30f5-4ca2-9f69-6cae8e15d59a"/>
