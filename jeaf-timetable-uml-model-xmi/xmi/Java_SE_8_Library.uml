                </nestedClassifier>
                <nestedClassifier xmi:type="uml:Class" xmi:id="01325aaf-1956-47be-b19b-3248b8462c00" name="BasicHighlighter" clientDependency="d78868a2-5bb7-4f69-9c5c-4f3f0099d925">
