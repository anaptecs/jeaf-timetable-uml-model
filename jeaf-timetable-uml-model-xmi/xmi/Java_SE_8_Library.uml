            <packagedElement xmi:type="uml:Interface" xmi:id="028fbf8c-b451-4086-8ef7-24c524ee559a" name="UNSUPPORTED_POLICY" isAbstract="true">
              <ownedComment xmi:id="da1a39cc-5d6e-4def-bc50-e50367c1ddf1" body="One of the &lt;tt>PolicyErrorCode&lt;/tt>s which would be filled if&#xA;the requested &lt;tt>Policy&lt;/tt> is understood to be valid by the&#xA;ORB, but is not currently supported.&#xA;&#xA;@author rip-dev&#xA;" annotatedElement="028fbf8c-b451-4086-8ef7-24c524ee559a"/>
