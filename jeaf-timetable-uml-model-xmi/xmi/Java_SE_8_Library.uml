          </packagedElement>
          <packagedElement xmi:type="uml:Package" xmi:id="499a4e5f-7019-4bce-bbf0-999ab72a98fd" name="relation">
            <packagedElement xmi:type="uml:Class" xmi:id="afa07626-208b-421d-9c7b-9e85879be969" name="InvalidRelationIdException">
              <ownedComment xmi:id="9db7e1df-1c57-4d90-9184-ecf1e176380c" body="This exception is raised when relation id provided for a relation is already&#xA;used.&#xA;&#xA;@since 1.5&#xA;" annotatedElement="afa07626-208b-421d-9c7b-9e85879be969"/>
              <generalization xmi:id="30857548-09d6-4467-8ca6-0fff43c09e10" isSubstitutable="true" general="d0e8e21d-2e91-44eb-aaec-9472068fe7f2"/>
            </packagedElement>
            <packagedElement xmi:type="uml:Class" xmi:id="0e18d906-e819-450b-9cc4-f63fb9036822" name="InvalidRelationServiceException">
              <ownedComment xmi:id="3640c5c9-f64a-49d6-8512-c2803670ed28" body="This exception is raised when an invalid Relation Service is provided.&#xA;&#xA;@since 1.5&#xA;" annotatedElement="0e18d906-e819-450b-9cc4-f63fb9036822"/>
              <generalization xmi:id="135bb666-57de-4f30-82a7-5a9a0b037516" isSubstitutable="true" general="d0e8e21d-2e91-44eb-aaec-9472068fe7f2"/>
            </packagedElement>
            <packagedElement xmi:type="uml:Class" xmi:id="5b5d7459-d568-4c8a-b1eb-8290ea279536" name="InvalidRelationTypeException">
              <ownedComment xmi:id="2f70208a-75d3-4d1c-befb-7e0d6d41fa9e" body="Invalid relation type.&#xA;This exception is raised when, in a relation type, there is already a&#xA;relation type with that name, or the same name has been used for two&#xA;different role infos, or no role info provided, or one null role info&#xA;provided.&#xA;&#xA;@since 1.5&#xA;" annotatedElement="5b5d7459-d568-4c8a-b1eb-8290ea279536"/>
              <generalization xmi:id="b458f0fa-6931-46ce-a6a6-80f5e5f1a86c" isSubstitutable="true" general="d0e8e21d-2e91-44eb-aaec-9472068fe7f2"/>
            </packagedElement>
            <packagedElement xmi:type="uml:Class" xmi:id="f1b37dae-ce24-4919-9a18-3f546d0ba29b" name="InvalidRoleInfoException">
              <ownedComment xmi:id="8ccbba58-e83f-4382-9ebb-68ed2d573c2f" body="This exception is raised when, in a role info, its minimum degree is greater&#xA;than its maximum degree.&#xA;&#xA;@since 1.5&#xA;" annotatedElement="f1b37dae-ce24-4919-9a18-3f546d0ba29b"/>
              <generalization xmi:id="8abe7c1a-082b-4152-9c69-c23a486d553c" isSubstitutable="true" general="d0e8e21d-2e91-44eb-aaec-9472068fe7f2"/>
            </packagedElement>
            <packagedElement xmi:type="uml:Class" xmi:id="7f9f5696-5983-450f-bacc-23e4666840ef" name="InvalidRoleValueException">
              <ownedComment xmi:id="0ca10bf6-4a40-472b-8115-2d79324bc0a4" body="Role value is invalid.&#xA;This exception is raised when, in a role, the number of referenced MBeans&#xA;in given value is less than expected minimum degree, or the number of&#xA;referenced MBeans in provided value exceeds expected maximum degree, or&#xA;one referenced MBean in the value is not an Object of the MBean&#xA;class expected for that role, or an MBean provided for that role does not&#xA;exist.&#xA;&#xA;@since 1.5&#xA;" annotatedElement="7f9f5696-5983-450f-bacc-23e4666840ef"/>
              <generalization xmi:id="ab53cca3-980b-45c2-bb9e-c06a9890665f" isSubstitutable="true" general="d0e8e21d-2e91-44eb-aaec-9472068fe7f2"/>
            </packagedElement>
            <packagedElement xmi:type="uml:Class" xmi:id="e1165e01-0351-41c2-8148-abc7ab4d9ce4" name="MBeanServerNotificationFilter">
              <ownedComment xmi:id="0a07cc1b-fdb0-47ae-b76a-45d87398b0ef" body="Filter for {@link MBeanServerNotification}.&#xA;This filter filters MBeanServerNotification notifications by&#xA;selecting the ObjectNames of interest and the operations (registration,&#xA;unregistration, both) of interest (corresponding to notification&#xA;types).&#xA;&#xA;&lt;p>The &lt;b>serialVersionUID&lt;/b> of this class is &lt;code>2605900539589789736L&lt;/code>.&#xA;&#xA;@since 1.5&#xA;" annotatedElement="e1165e01-0351-41c2-8148-abc7ab4d9ce4"/>
              <generalization xmi:id="ab3d2939-223a-4f37-b91b-aa2323cfa689" isSubstitutable="true" general="a7420662-2c74-49db-8684-3fb157c83e0f"/>
            </packagedElement>
            <packagedElement xmi:type="uml:Interface" xmi:id="92b4fa12-650f-4e80-930d-ae9174dd5559" name="Relation" isAbstract="true">
              <ownedComment xmi:id="5287ddbe-e020-4d6f-875a-034ab27ed067" body="This interface has to be implemented by any MBean class expected to&#xA;represent a relation managed using the Relation Service.&#xA;&lt;P>Simple relations, i.e. having only roles, no properties or methods, can&#xA;be created directly by the Relation Service (represented as RelationSupport&#xA;objects, internally handled by the Relation Service).&#xA;&lt;P>If the user wants to represent more complex relations, involving&#xA;properties and/or methods, he has to provide his own class implementing the&#xA;Relation interface. This can be achieved either by inheriting from&#xA;RelationSupport class, or by implementing the interface (fully or delegation to&#xA;a RelationSupport object member).&#xA;&lt;P>Specifying such user relation class is to introduce properties and/or&#xA;methods. Those have to be exposed for remote management. So this means that&#xA;any user relation class must be a MBean class.&#xA;&#xA;@since 1.5&#xA;" annotatedElement="92b4fa12-650f-4e80-930d-ae9174dd5559"/>
            </packagedElement>
            <packagedElement xmi:type="uml:Class" xmi:id="d0e8e21d-2e91-44eb-aaec-9472068fe7f2" name="RelationException">
              <ownedComment xmi:id="227640f3-4aee-4630-9609-642a739360bd" body="This class is the superclass of any exception which can be raised during&#xA;relation management.&#xA;&#xA;@since 1.5&#xA;" annotatedElement="d0e8e21d-2e91-44eb-aaec-9472068fe7f2"/>
              <generalization xmi:id="d35d200e-72a1-4970-b0fe-9057cae5e160" isSubstitutable="true" general="3737f65c-ecb3-428c-9c59-a5c26c88712a"/>
            </packagedElement>
            <packagedElement xmi:type="uml:Class" xmi:id="6b33564f-44ac-4690-84a0-5aee82aa0e30" name="RelationNotFoundException">
              <ownedComment xmi:id="718e20b5-a7e4-4b95-9a42-654f68f58337" body="This exception is raised when there is no relation for a given relation id&#xA;in a Relation Service.&#xA;&#xA;@since 1.5&#xA;" annotatedElement="6b33564f-44ac-4690-84a0-5aee82aa0e30"/>
              <generalization xmi:id="c7ab24a7-174d-4d20-b50c-24d2ca107957" isSubstitutable="true" general="d0e8e21d-2e91-44eb-aaec-9472068fe7f2"/>
            </packagedElement>
            <packagedElement xmi:type="uml:Class" xmi:id="bdc31b57-0513-4e6c-86f8-14204952076e" name="RelationNotification">
              <ownedComment xmi:id="a7d86db6-ee54-4c25-bd42-d3d049762514" body="A notification of a change in the Relation Service.&#xA;A RelationNotification notification is sent when a relation is created via&#xA;the Relation Service, or an MBean is added as a relation in the Relation&#xA;Service, or a role is updated in a relation, or a relation is removed from&#xA;the Relation Service.&#xA;&#xA;&lt;p>The &lt;b>serialVersionUID&lt;/b> of this class is &lt;code>-6871117877523310399L&lt;/code>.&#xA;&#xA;@since 1.5&#xA;" annotatedElement="bdc31b57-0513-4e6c-86f8-14204952076e"/>
              <generalization xmi:id="9265be7e-6450-4242-8ff0-e608e9d32828" isSubstitutable="true" general="e0fa0f21-52ff-45ac-bf23-3868045f71a2"/>
            </packagedElement>
            <packagedElement xmi:type="uml:Class" xmi:id="e9216d0f-dd24-4636-a07e-c68e2cbc8859" name="RelationService" clientDependency="64103c18-deec-452b-83fb-bc8867e8d015 467eb84e-b7b4-4191-9c81-888625a150bf 00a22157-b3c5-4e9b-803c-eb3b01ac698d">
              <ownedComment xmi:id="6cb582b9-ddf1-426b-aa78-ba5481242ede" body="The Relation Service is in charge of creating and deleting relation types&#xA;and relations, of handling the consistency and of providing query&#xA;mechanisms.&#xA;&lt;P>It implements the NotificationBroadcaster by extending&#xA;NotificationBroadcasterSupport to send notifications when a relation is&#xA;removed from it.&#xA;&lt;P>It implements the NotificationListener interface to be able to receive&#xA;notifications concerning unregistration of MBeans referenced in relation&#xA;roles and of relation MBeans.&#xA;&lt;P>It implements the MBeanRegistration interface to be able to retrieve&#xA;its ObjectName and MBean Server.&#xA;&#xA;@since 1.5&#xA;" annotatedElement="e9216d0f-dd24-4636-a07e-c68e2cbc8859"/>
              <generalization xmi:id="eaaa94d2-f3b4-42e2-9374-a0bfff042b68" isSubstitutable="true" general="4fdd863e-2ebe-4446-b114-09a1fa0b364f"/>
              <interfaceRealization xmi:id="64103c18-deec-452b-83fb-bc8867e8d015" name="" supplier="cd8825a6-3051-4c25-baaf-8a124fcd54bd" client="e9216d0f-dd24-4636-a07e-c68e2cbc8859" contract="cd8825a6-3051-4c25-baaf-8a124fcd54bd"/>
              <interfaceRealization xmi:id="467eb84e-b7b4-4191-9c81-888625a150bf" name="" supplier="1ae962cb-8d6d-4cbd-abad-6946bf1c3caf" client="e9216d0f-dd24-4636-a07e-c68e2cbc8859" contract="1ae962cb-8d6d-4cbd-abad-6946bf1c3caf"/>
              <interfaceRealization xmi:id="00a22157-b3c5-4e9b-803c-eb3b01ac698d" name="" supplier="f8190d45-95a6-440b-8c79-61b51b1ff13c" client="e9216d0f-dd24-4636-a07e-c68e2cbc8859" contract="f8190d45-95a6-440b-8c79-61b51b1ff13c"/>
            </packagedElement>
            <packagedElement xmi:type="uml:Interface" xmi:id="cd8825a6-3051-4c25-baaf-8a124fcd54bd" name="RelationServiceMBean" isAbstract="true">
              <ownedComment xmi:id="64e7ae15-e44f-4243-addb-f3d6b293ce5e" body="The Relation Service is in charge of creating and deleting relation types&#xA;and relations, of handling the consistency and of providing query&#xA;mechanisms.&#xA;&#xA;@since 1.5&#xA;" annotatedElement="cd8825a6-3051-4c25-baaf-8a124fcd54bd"/>
            </packagedElement>
            <packagedElement xmi:type="uml:Class" xmi:id="4fc73742-250c-46fb-a42e-84e1cde957ea" name="RelationServiceNotRegisteredException">
              <ownedComment xmi:id="b58a30e7-b93a-4f64-a233-caa0dcd560b9" body="This exception is raised when an access is done to the Relation Service and&#xA;that one is not registered.&#xA;&#xA;@since 1.5&#xA;" annotatedElement="4fc73742-250c-46fb-a42e-84e1cde957ea"/>
              <generalization xmi:id="5a5c1e11-f11b-451b-80df-a71a20ec1be0" isSubstitutable="true" general="d0e8e21d-2e91-44eb-aaec-9472068fe7f2"/>
            </packagedElement>
            <packagedElement xmi:type="uml:Class" xmi:id="5138ad6e-755c-44dc-a298-eacc80de3c24" name="RelationSupport" clientDependency="88d05b70-4fe6-45f7-9d5b-e1078bdcdb6f 8bc9d099-c30d-49d6-9b63-7b8dee7bd06d">
              <ownedComment xmi:id="e7c8d8c3-b5aa-44c1-a3f5-672269458170" body="A RelationSupport object is used internally by the Relation Service to&#xA;represent simple relations (only roles, no properties or methods), with an&#xA;unlimited number of roles, of any relation type. As internal representation,&#xA;it is not exposed to the user.&#xA;&lt;P>RelationSupport class conforms to the design patterns of standard MBean. So&#xA;the user can decide to instantiate a RelationSupport object himself as&#xA;a MBean (as it follows the MBean design patterns), to register it in the&#xA;MBean Server, and then to add it in the Relation Service.&#xA;&lt;P>The user can also, when creating his own MBean relation class, have it&#xA;extending RelationSupport, to retrieve the implementations of required&#xA;interfaces (see below).&#xA;&lt;P>It is also possible to have in a user relation MBean class a member&#xA;being a RelationSupport object, and to implement the required interfaces by&#xA;delegating all to this member.&#xA;&lt;P> RelationSupport implements the Relation interface (to be handled by the&#xA;Relation Service).&#xA;&lt;P>It implements also the MBeanRegistration interface to be able to retrieve&#xA;the MBean Server where it is registered (if registered as a MBean) to access&#xA;to its Relation Service.&#xA;&#xA;@since 1.5&#xA;" annotatedElement="5138ad6e-755c-44dc-a298-eacc80de3c24"/>
              <interfaceRealization xmi:id="8bc9d099-c30d-49d6-9b63-7b8dee7bd06d" name="" supplier="585a1723-a0de-4f4d-9bca-ee3eca1fdeb4" client="5138ad6e-755c-44dc-a298-eacc80de3c24" contract="585a1723-a0de-4f4d-9bca-ee3eca1fdeb4"/>
              <interfaceRealization xmi:id="88d05b70-4fe6-45f7-9d5b-e1078bdcdb6f" name="" supplier="1ae962cb-8d6d-4cbd-abad-6946bf1c3caf" client="5138ad6e-755c-44dc-a298-eacc80de3c24" contract="1ae962cb-8d6d-4cbd-abad-6946bf1c3caf"/>
            </packagedElement>
            <packagedElement xmi:type="uml:Interface" xmi:id="585a1723-a0de-4f4d-9bca-ee3eca1fdeb4" name="RelationSupportMBean" isAbstract="true">
              <ownedComment xmi:id="6d83c2ab-6db4-4a52-af0e-46178891a23b" body="A RelationSupport object is used internally by the Relation Service to&#xA;represent simple relations (only roles, no properties or methods), with an&#xA;unlimited number of roles, of any relation type. As internal representation,&#xA;it is not exposed to the user.&#xA;&lt;P>RelationSupport class conforms to the design patterns of standard MBean. So&#xA;the user can decide to instantiate a RelationSupport object himself as&#xA;a MBean (as it follows the MBean design patterns), to register it in the&#xA;MBean Server, and then to add it in the Relation Service.&#xA;&lt;P>The user can also, when creating his own MBean relation class, have it&#xA;extending RelationSupport, to retrieve the implementations of required&#xA;interfaces (see below).&#xA;&lt;P>It is also possible to have in a user relation MBean class a member&#xA;being a RelationSupport object, and to implement the required interfaces by&#xA;delegating all to this member.&#xA;&lt;P> RelationSupport implements the Relation interface (to be handled by the&#xA;Relation Service).&#xA;&#xA;@since 1.5&#xA;" annotatedElement="585a1723-a0de-4f4d-9bca-ee3eca1fdeb4"/>
              <generalization xmi:id="a167949e-39ab-4d0b-a252-ce3a8cb4d436" isSubstitutable="true" general="92b4fa12-650f-4e80-930d-ae9174dd5559"/>
            </packagedElement>
            <packagedElement xmi:type="uml:Interface" xmi:id="70820746-a1ca-47fe-bd83-819a95e7829f" name="RelationType" isAbstract="true">
              <ownedComment xmi:id="a33fcf9b-1e05-49ab-acbd-4030cf3cfafe" body="The RelationType interface has to be implemented by any class expected to&#xA;represent a relation type.&#xA;&#xA;@since 1.5&#xA;" annotatedElement="70820746-a1ca-47fe-bd83-819a95e7829f"/>
              <generalization xmi:id="58572eec-b62c-496e-954a-61a923c6d22d" isSubstitutable="true" general="41f4a654-a713-47bf-a391-e112be100ec5"/>
            </packagedElement>
            <packagedElement xmi:type="uml:Class" xmi:id="87ef3fb7-5649-40eb-98a5-7da00d26d912" name="RelationTypeNotFoundException">
              <ownedComment xmi:id="760dcfa0-7410-4912-8d3e-2b1095ea7543" body="This exception is raised when there is no relation type with given name in&#xA;Relation Service.&#xA;&#xA;@since 1.5&#xA;" annotatedElement="87ef3fb7-5649-40eb-98a5-7da00d26d912"/>
              <generalization xmi:id="bc17b660-f692-4dd5-8647-7178f9cc6432" isSubstitutable="true" general="d0e8e21d-2e91-44eb-aaec-9472068fe7f2"/>
            </packagedElement>
            <packagedElement xmi:type="uml:Class" xmi:id="f9808564-d032-4392-a378-78834d3b329d" name="RelationTypeSupport" clientDependency="a15d7873-82bd-4ec0-88ab-478a76e0c85f">
              <ownedComment xmi:id="93b74dbd-48a2-4885-a018-98e878001af3" body="A RelationTypeSupport object implements the RelationType interface.&#xA;&lt;P>It represents a relation type, providing role information for each role&#xA;expected to be supported in every relation of that type.&#xA;&#xA;&lt;P>A relation type includes a relation type name and a list of&#xA;role infos (represented by RoleInfo objects).&#xA;&#xA;&lt;P>A relation type has to be declared in the Relation Service:&#xA;&lt;P>- either using the createRelationType() method, where a RelationTypeSupport&#xA;object will be created and kept in the Relation Service&#xA;&lt;P>- either using the addRelationType() method where the user has to create&#xA;an object implementing the RelationType interface, and this object will be&#xA;used as representing a relation type in the Relation Service.&#xA;&#xA;&lt;p>The &lt;b>serialVersionUID&lt;/b> of this class is &lt;code>4611072955724144607L&lt;/code>.&#xA;&#xA;@since 1.5&#xA;" annotatedElement="f9808564-d032-4392-a378-78834d3b329d"/>
              <interfaceRealization xmi:id="a15d7873-82bd-4ec0-88ab-478a76e0c85f" name="" supplier="70820746-a1ca-47fe-bd83-819a95e7829f" client="f9808564-d032-4392-a378-78834d3b329d" contract="70820746-a1ca-47fe-bd83-819a95e7829f"/>
            </packagedElement>
            <packagedElement xmi:type="uml:Class" xmi:id="812fe1e5-5e7c-4b1f-b938-3fc545a1ebd0" name="Role" clientDependency="d46c03ab-24d5-4f68-a22b-d6e13715c17c">
              <ownedComment xmi:id="948df569-45fa-40e4-af9f-ee6667b85f14" body="Represents a role: includes a role name and referenced MBeans (via their&#xA;ObjectNames). The role value is always represented as an ArrayList&#xA;collection (of ObjectNames) to homogenize the access.&#xA;&#xA;&lt;p>The &lt;b>serialVersionUID&lt;/b> of this class is &lt;code>-279985518429862552L&lt;/code>.&#xA;&#xA;@since 1.5&#xA;" annotatedElement="812fe1e5-5e7c-4b1f-b938-3fc545a1ebd0"/>
              <interfaceRealization xmi:id="d46c03ab-24d5-4f68-a22b-d6e13715c17c" name="" supplier="41f4a654-a713-47bf-a391-e112be100ec5" client="812fe1e5-5e7c-4b1f-b938-3fc545a1ebd0" contract="41f4a654-a713-47bf-a391-e112be100ec5"/>
            </packagedElement>
            <packagedElement xmi:type="uml:Class" xmi:id="3b9631e6-c8da-443c-9ae7-60adfeb5f776" name="RoleInfo" clientDependency="f783b7b4-05d9-4bea-a6ef-c6c2fb79f3b0">
              <ownedComment xmi:id="34ef6e70-abe9-4fc6-adaa-3f1b682c9220" body="A RoleInfo object summarises a role in a relation type.&#xA;&#xA;&lt;p>The &lt;b>serialVersionUID&lt;/b> of this class is &lt;code>2504952983494636987L&lt;/code>.&#xA;&#xA;@since 1.5&#xA;" annotatedElement="3b9631e6-c8da-443c-9ae7-60adfeb5f776"/>
              <interfaceRealization xmi:id="f783b7b4-05d9-4bea-a6ef-c6c2fb79f3b0" name="" supplier="41f4a654-a713-47bf-a391-e112be100ec5" client="3b9631e6-c8da-443c-9ae7-60adfeb5f776" contract="41f4a654-a713-47bf-a391-e112be100ec5"/>
            </packagedElement>
            <packagedElement xmi:type="uml:Class" xmi:id="129e8fa7-2b9f-48ae-b38b-cd9b8aac1cb4" name="RoleInfoNotFoundException">
              <ownedComment xmi:id="17c6b927-a491-439a-af26-e45a9ddffe92" body="This exception is raised when there is no role info with given name in a&#xA;given relation type.&#xA;&#xA;@since 1.5&#xA;" annotatedElement="129e8fa7-2b9f-48ae-b38b-cd9b8aac1cb4"/>
              <generalization xmi:id="6fd07c2c-7ea9-4a42-9635-c0638faaefb8" isSubstitutable="true" general="d0e8e21d-2e91-44eb-aaec-9472068fe7f2"/>
            </packagedElement>
            <packagedElement xmi:type="uml:Class" xmi:id="60bf823f-092d-4e22-beca-07b659678ef9" name="RoleList">
              <ownedComment xmi:id="7b68db2a-4d0c-4bb5-a76a-6f068d31b9d4" body="A RoleList represents a list of roles (Role objects). It is used as&#xA;parameter when creating a relation, and when trying to set several roles in&#xA;a relation (via 'setRoles()' method). It is returned as part of a&#xA;RoleResult, to provide roles successfully retrieved.&#xA;&#xA;@since 1.5&#xA;" annotatedElement="60bf823f-092d-4e22-beca-07b659678ef9"/>
              <generalization xmi:id="d48abd43-8497-4485-a61c-87b740c8d62a" isSubstitutable="true" general="ae50ab0b-774d-4fdb-9160-a2116e9eb2b9"/>
            </packagedElement>
            <packagedElement xmi:type="uml:Class" xmi:id="68d0b577-2b31-4f25-b21e-a11b6b83b511" name="RoleNotFoundException">
              <ownedComment xmi:id="1d3215a2-70ba-4e4f-9cec-41442ea92cb1" body="This exception is raised when a role in a relation does not exist, or is not&#xA;readable, or is not settable.&#xA;&#xA;@since 1.5&#xA;" annotatedElement="68d0b577-2b31-4f25-b21e-a11b6b83b511"/>
              <generalization xmi:id="30eb4aa8-9ba1-43dd-bfe2-fab05d444b94" isSubstitutable="true" general="d0e8e21d-2e91-44eb-aaec-9472068fe7f2"/>
            </packagedElement>
            <packagedElement xmi:type="uml:Class" xmi:id="d9a1a5be-a173-4d09-b307-0dd273601379" name="RoleResult" clientDependency="c049adf3-5b56-401b-bf92-5fe612edae4a">
              <ownedComment xmi:id="3b92ae13-5d31-4ab2-bd7d-73c27359243f" body="Represents the result of a multiple access to several roles of a relation&#xA;(either for reading or writing).&#xA;&#xA;&lt;p>The &lt;b>serialVersionUID&lt;/b> of this class is &lt;code>-6304063118040985512L&lt;/code>.&#xA;&#xA;@since 1.5&#xA;" annotatedElement="d9a1a5be-a173-4d09-b307-0dd273601379"/>
              <interfaceRealization xmi:id="c049adf3-5b56-401b-bf92-5fe612edae4a" name="" supplier="41f4a654-a713-47bf-a391-e112be100ec5" client="d9a1a5be-a173-4d09-b307-0dd273601379" contract="41f4a654-a713-47bf-a391-e112be100ec5"/>
            </packagedElement>
            <packagedElement xmi:type="uml:Class" xmi:id="2c91fd68-658e-4a99-b565-8ab2d5e896fd" name="RoleStatus">
              <ownedComment xmi:id="c5e106bb-92a9-432c-b236-5370ca4cef14" body="This class describes the various problems which can be encountered when&#xA;accessing a role.&#xA;&#xA;@since 1.5&#xA;" annotatedElement="2c91fd68-658e-4a99-b565-8ab2d5e896fd"/>
            </packagedElement>
            <packagedElement xmi:type="uml:Class" xmi:id="d570d1e2-2722-43bf-90ed-3dfca2d98842" name="RoleUnresolved" clientDependency="e8773203-8e22-41b4-b7a7-a86fc46a45a7">
              <ownedComment xmi:id="12bd91aa-5b88-4263-8db5-1d43d768dd41" body="Represents an unresolved role: a role not retrieved from a relation due&#xA;to a problem. It provides the role name, value (if problem when trying to&#xA;set the role) and an integer defining the problem (constants defined in&#xA;RoleStatus).&#xA;&#xA;&lt;p>The &lt;b>serialVersionUID&lt;/b> of this class is &lt;code>-48350262537070138L&lt;/code>.&#xA;&#xA;@since 1.5&#xA;" annotatedElement="d570d1e2-2722-43bf-90ed-3dfca2d98842"/>
              <interfaceRealization xmi:id="e8773203-8e22-41b4-b7a7-a86fc46a45a7" name="" supplier="41f4a654-a713-47bf-a391-e112be100ec5" client="d570d1e2-2722-43bf-90ed-3dfca2d98842" contract="41f4a654-a713-47bf-a391-e112be100ec5"/>
            </packagedElement>
            <packagedElement xmi:type="uml:Class" xmi:id="0ab4a700-a5c1-48d6-afe7-6875caed338b" name="RoleUnresolvedList">
              <ownedComment xmi:id="c8398c10-58e5-459d-a8d8-9d970d7a137e" body="A RoleUnresolvedList represents a list of RoleUnresolved objects,&#xA;representing roles not retrieved from a relation due to a problem&#xA;encountered when trying to access (read or write) the roles.&#xA;&#xA;@since 1.5&#xA;" annotatedElement="0ab4a700-a5c1-48d6-afe7-6875caed338b"/>
              <generalization xmi:id="ba6ab164-5fe7-4d26-93ab-c181cef08b94" isSubstitutable="true" general="ae50ab0b-774d-4fdb-9160-a2116e9eb2b9"/>
            </packagedElement>
