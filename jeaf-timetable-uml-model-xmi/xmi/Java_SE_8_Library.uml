              <interfaceRealization xmi:id="26d7ef9f-7ffe-4b10-ab7f-5033ada892ac" name="" supplier="41f4a654-a713-47bf-a391-e112be100ec5" client="e374a13b-c0d0-475e-874a-f43c38bb0805" contract="41f4a654-a713-47bf-a391-e112be100ec5"/>
              <interfaceRealization xmi:id="f2a83f02-e966-4600-bed5-933de7bf76b8" name="" supplier="48cc3f20-62b3-4f28-9b0f-1a6b930a4f86" client="e374a13b-c0d0-475e-874a-f43c38bb0805" contract="48cc3f20-62b3-4f28-9b0f-1a6b930a4f86"/>
