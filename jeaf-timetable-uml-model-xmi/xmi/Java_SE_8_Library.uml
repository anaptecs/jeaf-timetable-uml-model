          <packagedElement xmi:type="uml:Class" xmi:id="5c3d8c88-39c9-49fe-9366-5a1f4a87ed46" name="SocksSocketImpl" visibility="package" clientDependency="d0a37a73-6905-4a4f-ad35-a7eff3a6baf7">
            <ownedComment xmi:id="2be89189-9ba1-4f18-9672-35cc96d71313" body="SOCKS (V4 &amp; V5) TCP socket implementation (RFC 1928).&#xA;This is a subclass of PlainSocketImpl.&#xA;Note this class should &lt;b>NOT&lt;/b> be public.&#xA;" annotatedElement="5c3d8c88-39c9-49fe-9366-5a1f4a87ed46"/>
            <generalization xmi:id="02dccc91-2ba8-49ae-9a08-989a8904ce81" isSubstitutable="true" general="8e422d4f-4f54-4d40-a15d-2f7abd847bcc"/>
