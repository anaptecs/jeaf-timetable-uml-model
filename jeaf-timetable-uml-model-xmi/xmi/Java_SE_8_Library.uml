                    </packagedElement>
                    <packagedElement xmi:type="uml:Class" xmi:id="45daa44e-b9da-431a-a724-10273af62da9" name="LocalVariable" clientDependency="5e2f995c-b72b-47af-ae2d-847c5ae74715 51190c4a-673e-476f-a71a-3de7c8d43819 16c8cf7d-287b-4bcf-be8a-6be7605a17a8 b67b30f7-d35d-4ee1-a202-34e491fcfec3">
                      <ownedComment xmi:id="e268a89d-d666-4b18-a60b-a03a2abc30b8" body="This class represents a local variable within a method. It contains its&#xA;scope, name, signature and index on the method's frame.&#xA;&#xA;@author  &lt;A HREF=&quot;mailto:markus.dahm@berlin.de&quot;>M. Dahm&lt;/A>&#xA;@see     LocalVariableTable&#xA;" annotatedElement="45daa44e-b9da-431a-a724-10273af62da9"/>
