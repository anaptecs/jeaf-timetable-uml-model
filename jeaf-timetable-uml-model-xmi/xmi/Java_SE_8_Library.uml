              <packagedElement xmi:type="uml:Class" xmi:id="79af3d2e-2074-44fa-98c2-82cb2a592810" name="VersionHelper" isAbstract="true">
                <ownedComment xmi:id="701c6a4a-1fed-43a8-bcc8-4c816deea1e4" body="VersionHelper was used by JNDI to accommodate differences between&#xA;JDK 1.1.x and the Java 2 platform. As this is no longer necessary&#xA;since JNDI's inclusion in the platform, this class currently&#xA;serves as a set of utilities for performing system-level things,&#xA;such as class-loading and reading system properties.&#xA;&#xA;@author Rosanna Lee&#xA;@author Scott Seligman&#xA;" annotatedElement="79af3d2e-2074-44fa-98c2-82cb2a592810"/>
              </packagedElement>
