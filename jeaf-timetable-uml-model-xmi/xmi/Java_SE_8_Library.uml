            <packagedElement xmi:type="uml:Interface" xmi:id="073a8ae8-452b-4ff0-89af-ea4cc5936d58" name="List&lt;CodeSigner&quot;[]&quot;>">
              <templateBinding xmi:id="cb581d27-0f72-4a11-ba9b-4fd2227e5258" signature="3e71fc6e-9a72-4a79-82dc-c9a0ddc40a6d">
