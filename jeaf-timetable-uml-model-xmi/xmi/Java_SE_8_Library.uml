                      <ownedComment xmi:id="d706c2ea-162a-45e3-97ac-7182095db041" body="LSUB - Substract longs&#xA;&lt;PRE>Stack: ..., value1.word1, value1.word2, value2.word1, value2.word2 -&amp;gt;&lt;/PRE>&#xA;..., result.word1, result.word2&#xA;&#xA;@author  &lt;A HREF=&quot;mailto:markus.dahm@berlin.de&quot;>M. Dahm&lt;/A>&#xA;" annotatedElement="136012f2-46ba-4a6c-acbe-b0653886a70a"/>
