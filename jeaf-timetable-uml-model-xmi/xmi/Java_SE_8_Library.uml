          <packagedElement xmi:type="uml:Class" xmi:id="76c21698-7b7c-4c29-aa56-e1ce3bb3d5c5" name="AtomicReferenceFieldUpdater&lt;SQLException, SQLException>">
            <templateBinding xmi:id="d78eea7a-b587-4d73-b224-7bb01bf31b57" signature="4a95dcc4-8b44-4c51-b131-6757871e193d">
