            <packagedElement xmi:type="uml:Interface" xmi:id="5698c32a-5263-4304-a068-036f7d3fbe55" name="IntBinaryOperator" isAbstract="true">
              <ownedComment xmi:id="c557241f-ae69-4728-82cd-947eff44747b" body="Represents an operation upon two {@code int}-valued operands and producing an&#xA;{@code int}-valued result.   This is the primitive type specialization of&#xA;{@link BinaryOperator} for {@code int}.&#xA;&#xA;&lt;p>This is a &lt;a href=&quot;package-summary.html&quot;>functional interface&lt;/a>&#xA;whose functional method is {@link #applyAsInt(int, int)}.&#xA;&#xA;@see BinaryOperator&#xA;@see IntUnaryOperator&#xA;@since 1.8&#xA;" annotatedElement="5698c32a-5263-4304-a068-036f7d3fbe55"/>
            </packagedElement>
            <packagedElement xmi:type="uml:Interface" xmi:id="77a0962c-825d-452a-9d7b-7e311d44ca51" name="IntConsumer" isAbstract="true">
              <ownedComment xmi:id="6543638d-4985-4104-9ad5-4578ac12c86f" body="Represents an operation that accepts a single {@code int}-valued argument and&#xA;returns no result.  This is the primitive type specialization of&#xA;{@link Consumer} for {@code int}.  Unlike most other functional interfaces,&#xA;{@code IntConsumer} is expected to operate via side-effects.&#xA;&#xA;&lt;p>This is a &lt;a href=&quot;package-summary.html&quot;>functional interface&lt;/a>&#xA;whose functional method is {@link #accept(int)}.&#xA;&#xA;@see Consumer&#xA;@since 1.8&#xA;" annotatedElement="77a0962c-825d-452a-9d7b-7e311d44ca51"/>
            </packagedElement>
            <packagedElement xmi:type="uml:Interface" xmi:id="80a533b1-9615-4416-9dcb-4c7d8b2b52f1" name="IntFunction" isAbstract="true">
              <ownedComment xmi:id="eb4cbae7-7b52-4c2d-a64c-a0a44a851e60" body="Represents a function that accepts an int-valued argument and produces a&#xA;result.  This is the {@code int}-consuming primitive specialization for&#xA;{@link Function}.&#xA;&#xA;&lt;p>This is a &lt;a href=&quot;package-summary.html&quot;>functional interface&lt;/a>&#xA;whose functional method is {@link #apply(int)}.&#xA;&#xA;@param &lt;R> the type of the result of the function&#xA;&#xA;@see Function&#xA;@since 1.8&#xA;" annotatedElement="80a533b1-9615-4416-9dcb-4c7d8b2b52f1"/>
              <ownedTemplateSignature xmi:type="uml:RedefinableTemplateSignature" xmi:id="bf2ea0f4-a441-484e-86c0-8e0efb9b6c15" name="" visibility="public" parameter="a2a187f1-31b0-4998-b160-bcf72d42a96f">
