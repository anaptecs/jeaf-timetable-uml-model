                  <packagedElement xmi:type="uml:Class" xmi:id="1c1bcffb-9c81-490e-bcc5-6bacf172db1a" name="CDRInputStream_1_2">
                    <generalization xmi:id="c0e90b8e-8eae-4896-b021-ea568a0bbdd4" isSubstitutable="true" general="24ece174-f531-4991-9c0e-9d950b454841"/>
                  </packagedElement>
                  <packagedElement xmi:type="uml:Class" xmi:id="3a24a6b2-ce28-4540-a2e6-690d14b936cf" name="CDRInputStreamBase" visibility="package" isAbstract="true">
                    <ownedComment xmi:id="52686e71-f3a3-46ca-876a-ed4a3db9e423" body="Describes CDRInputStream delegates and provides some&#xA;implementation.  Non-default constructors are avoided in&#xA;the delegation to separate instantiation from initialization,&#xA;so we use init methods.&#xA;" annotatedElement="3a24a6b2-ce28-4540-a2e6-690d14b936cf"/>
                    <generalization xmi:id="6dacded4-ea02-4d6b-9dc6-2e66122ec388" isSubstitutable="true" general="dbebea9a-4340-4cdc-bf6c-860ce989a804"/>
                  </packagedElement>
                  <packagedElement xmi:type="uml:Class" xmi:id="ee1f2cc8-6ad0-4fe7-856e-dc241b03b1aa" name="CDROutputObject">
