              <nestedClassifier xmi:type="uml:Class" xmi:id="7efe45b7-ae89-454e-9180-0199ee8bc3cc" name="CheckedEntrySet" visibility="package" clientDependency="6a3a1a93-8c3f-44c9-9cc6-13286fdb97ed">
                <ownedComment xmi:id="e62d78f5-3a9a-4ee2-a713-e846da467fed" body="We need this class in addition to CheckedSet as Map.Entry permits&#xA;modification of the backing Map via the setValue operation.  This&#xA;class is subtle: there are many possible attacks that must be&#xA;thwarted.&#xA;&#xA;@serial exclude&#xA;" annotatedElement="7efe45b7-ae89-454e-9180-0199ee8bc3cc"/>
