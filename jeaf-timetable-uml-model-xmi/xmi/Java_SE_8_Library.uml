          <packagedElement xmi:type="uml:Interface" xmi:id="fd24caf0-d5e0-4239-95f6-d3c515280917" name="ConcurrentMap&lt;Locale, NumberFormat>">
            <templateBinding xmi:id="7967acb2-739e-457d-8a40-d478c2a732f7" signature="8099fccd-185e-465f-8b18-7f1d12d879a6">
