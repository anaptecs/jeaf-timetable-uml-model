                      <ownedComment xmi:id="e4908d5e-2be1-4d76-b0b4-c99d47dc9999" body="LSTORE - Store long into local variable&#xA;&lt;PRE>Stack: ..., value.word1, value.word2 -&amp;gt; ... &lt;/PRE>&#xA;&#xA;@author  &lt;A HREF=&quot;mailto:markus.dahm@berlin.de&quot;>M. Dahm&lt;/A>&#xA;" annotatedElement="6bfc7294-85f6-4c1f-b2ed-fab8f22640a6"/>
