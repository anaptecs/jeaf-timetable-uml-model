              <generalization xmi:id="d2421edf-c645-40dd-97da-afda39cd0485" isSubstitutable="true" general="9e5250e4-1579-4676-bc2e-9f3de7b78be1"/>
              <generalization xmi:id="3fa667b2-a3d4-4af4-b44a-ca4e6d975157" isSubstitutable="true" general="d9970614-0de7-4861-867d-3970ee5ba9a4"/>
