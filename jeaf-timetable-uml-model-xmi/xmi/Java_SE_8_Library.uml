                <nestedClassifier xmi:type="uml:Class" xmi:id="65132d0c-369f-4e93-8082-328920b01870" name="TableElementInfo" visibility="private" clientDependency="e6840f48-3777-4cf6-a0c5-e13bf38069ac">
                  <ownedComment xmi:id="38667149-ce5b-49b3-bd16-9a591f310f79" body="TableElementInfo encapsulates information about a HTML.Tag.TABLE.&#xA;To make access fast it crates a grid containing the children to&#xA;allow for access by row, column. TableElementInfo will contain&#xA;TableRowElementInfos, which will contain TableCellElementInfos.&#xA;Any time one of the rows or columns becomes invalid the table is&#xA;invalidated.  This is because any time one of the child attributes&#xA;changes the size of the grid may have changed.&#xA;" annotatedElement="65132d0c-369f-4e93-8082-328920b01870"/>
                  <generalization xmi:id="0a8493ae-34ec-4a3f-b3b8-440968014537" isSubstitutable="true" general="93943f49-14e6-4d63-99cb-946233c74bcb"/>
