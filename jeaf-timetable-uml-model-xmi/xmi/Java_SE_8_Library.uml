                      <ownedComment xmi:id="fff94a77-cf46-43e7-9b04-ac24553715aa" body="LRETURN -  Return long from method&#xA;&lt;PRE>Stack: ..., value.word1, value.word2 -&amp;gt; &amp;lt;empty&amp;gt;&lt;/PRE>&#xA;&#xA;@author  &lt;A HREF=&quot;mailto:markus.dahm@berlin.de&quot;>M. Dahm&lt;/A>&#xA;" annotatedElement="5806de52-8600-45bf-b69e-5e74c2f585f3"/>
