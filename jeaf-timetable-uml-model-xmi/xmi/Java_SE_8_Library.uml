              <interfaceRealization xmi:id="254d75c6-9699-4485-ae51-6541f6b5432a" name="" supplier="e5423739-5db3-4666-8b9a-2cc2b52f0c4a" client="a824ce1e-e263-4061-aed4-0d44bbf25fe4" contract="e5423739-5db3-4666-8b9a-2cc2b52f0c4a"/>
              <nestedClassifier xmi:type="uml:Class" xmi:id="4a51c4a6-7e0d-4b25-91b4-ba924002a1f7" name="AccessibleJTreeNode" visibility="protected" clientDependency="0ddb08b4-5c44-41a3-927d-4460b471da1f 8f484111-18e1-413f-97e9-e08ef54c53e1 fb517423-bfc6-4351-9d8b-450d008a6def 90dd1b32-61f1-4c3b-9614-12b3aac083d5">
                <ownedComment xmi:id="25ee32eb-8648-4a08-b323-97481542b7eb" body="This class implements accessibility support for the&#xA;&lt;code>JTree&lt;/code> child.  It provides an implementation of the&#xA;Java Accessibility API appropriate to tree nodes.&#xA;" annotatedElement="4a51c4a6-7e0d-4b25-91b4-ba924002a1f7"/>
