                    <interfaceRealization xmi:id="5664ca37-4218-43d8-b75e-460e98a15feb" name="" supplier="508bd5f7-ceac-4265-a583-05db703743ee" client="ee36df24-9063-4087-8310-3bcbc27ac917" contract="508bd5f7-ceac-4265-a583-05db703743ee"/>
                    <nestedClassifier xmi:type="uml:Class" xmi:id="172078e3-7b2d-4a99-bfae-6f8e654c2735" name="OutputStreamFactory" visibility="private"/>
                  </packagedElement>
                  <packagedElement xmi:type="uml:Class" xmi:id="922a0290-94eb-4845-a51c-00c46bdeab00" name="CDROutputStream_1_0">
                    <generalization xmi:id="e8c0f366-0ebb-4ff7-aad1-65c96dd2dffc" isSubstitutable="true" general="d01d248f-6172-4f78-b95e-4445241787db"/>
                  </packagedElement>
                  <packagedElement xmi:type="uml:Class" xmi:id="f9e05abb-a654-4481-923a-14781d3b613c" name="CDROutputStream_1_1">
                    <generalization xmi:id="42594301-25d9-427c-8ddf-2f3226db761d" isSubstitutable="true" general="922a0290-94eb-4845-a51c-00c46bdeab00"/>
                  </packagedElement>
                  <packagedElement xmi:type="uml:Class" xmi:id="df2085bd-8f88-4999-ae8c-ccac7fb26ef3" name="CDROutputStream_1_2">
                    <generalization xmi:id="1540dca3-e3a0-4eea-b7ce-5b94abb7a1ed" isSubstitutable="true" general="f9e05abb-a654-4481-923a-14781d3b613c"/>
                  </packagedElement>
                  <packagedElement xmi:type="uml:Class" xmi:id="d01d248f-6172-4f78-b95e-4445241787db" name="CDROutputStreamBase" visibility="package" isAbstract="true">
                    <ownedComment xmi:id="3feb4ef5-ae00-4cfa-8de3-1c7709c78cfc" body="Describes CDROutputStream delegates and provides some&#xA;implementation.  Non-default constructors are avoided in&#xA;the delegation to separate instantiation from initialization,&#xA;so we use init methods.&#xA;" annotatedElement="d01d248f-6172-4f78-b95e-4445241787db"/>
                    <generalization xmi:id="3497b259-8b9d-4148-a8e8-eb485815b7eb" isSubstitutable="true" general="ebecfa03-1126-440a-9cde-0bcb479ec2df"/>
                  </packagedElement>
                  <packagedElement xmi:type="uml:Class" xmi:id="53301e17-a6c1-4a1a-9b7e-313a74b23423" name="CodeSetCache" visibility="package">
                    <ownedComment xmi:id="32e4d5e3-8939-4165-a21e-43b8f24f15ac" body="Thread local cache of sun.io code set converters for performance.&#xA;&#xA;The thread local class contains a single reference to a Map[]&#xA;containing two WeakHashMaps.  One for CharsetEncoders and&#xA;one for CharsetDecoders.  Constants are defined for indexing.&#xA;&#xA;This is used internally by CodeSetConversion.&#xA;" annotatedElement="53301e17-a6c1-4a1a-9b7e-313a74b23423"/>
                  </packagedElement>
                  <packagedElement xmi:type="uml:Class" xmi:id="e3e3708d-5562-458d-9c64-7e7290b5780f" name="CodeSetComponentInfo">
                    <nestedClassifier xmi:type="uml:Class" xmi:id="61e1b949-60c1-48bd-a3dd-ebea8ad11199" name="CodeSetComponent">
                      <ownedComment xmi:id="1e33fa87-9d0b-4a4c-90bd-a3c54346b81b" body="CodeSetComponent is part of an IOR multi-component profile.  Two&#xA;instances constitute a CodeSetComponentInfo (one for char and one&#xA;for wchar data)&#xA;" annotatedElement="61e1b949-60c1-48bd-a3dd-ebea8ad11199"/>
                    </nestedClassifier>
                    <nestedClassifier xmi:type="uml:Class" xmi:id="7d8dbdfa-21c0-44a5-a261-7aebe4ff0359" name="CodeSetContext">
                      <ownedComment xmi:id="df6f17d1-1e23-4eac-bee9-ca7f5b6b3be1" body="CodeSetContext goes in a GIOP service context&#xA;" annotatedElement="7d8dbdfa-21c0-44a5-a261-7aebe4ff0359"/>
                    </nestedClassifier>
                  </packagedElement>
                  <packagedElement xmi:type="uml:Class" xmi:id="4a078baa-8d89-49d1-958b-f67376a53910" name="CodeSetConversion">
                    <ownedComment xmi:id="033ff4ab-9905-4c81-920e-d0e7290547c0" body="Collection of classes, interfaces, and factory methods for&#xA;CORBA code set conversion.&#xA;&#xA;This is mainly used to shield other code from the sun.io&#xA;converters which might change, as well as provide some basic&#xA;translation from conversion to CORBA error exceptions.  Some&#xA;extra work is required here to facilitate the way CORBA&#xA;says it uses UTF-16 as of the 00-11-03 spec.&#xA;&#xA;REVISIT - Since the nio.Charset and nio.Charset.Encoder/Decoder&#xA;use NIO ByteBuffer and NIO CharBuffer, the interaction&#xA;and interface between this class and the CDR streams&#xA;should be looked at more closely for optimizations to&#xA;avoid unnecessary copying of data between char[] &amp;&#xA;CharBuffer and byte[] &amp; ByteBuffer, especially&#xA;DirectByteBuffers.&#xA;&#xA;" annotatedElement="4a078baa-8d89-49d1-958b-f67376a53910"/>
                    <nestedClassifier xmi:type="uml:Class" xmi:id="7245a4db-0fb7-4dfa-bf5f-193573b1b6c7" name="CTBConverter" isAbstract="true">
                      <ownedComment xmi:id="cc247815-81b0-4855-a12a-e146866038ff" body="Abstraction for char to byte conversion.&#xA;&#xA;Must be used in the proper sequence:&#xA;&#xA;1)  convert&#xA;2)  Optional getNumBytes and/or getAlignment (if necessary)&#xA;3)  getBytes (see warning)&#xA;" annotatedElement="7245a4db-0fb7-4dfa-bf5f-193573b1b6c7"/>
                    </nestedClassifier>
                    <nestedClassifier xmi:type="uml:Class" xmi:id="57813679-9fb9-4981-a051-9a778fb7a49f" name="BTCConverter" isAbstract="true">
                      <ownedComment xmi:id="f5ea2d62-f786-4cbe-b380-20d119e9594b" body="Abstraction for byte to char conversion.&#xA;" annotatedElement="57813679-9fb9-4981-a051-9a778fb7a49f"/>
                    </nestedClassifier>
                    <nestedClassifier xmi:type="uml:Class" xmi:id="4aadd04d-6cf6-4100-bc0e-aacfaeec4541" name="JavaCTBConverter" visibility="private">
                      <ownedComment xmi:id="e7bae1ed-8a04-47dc-b86e-6c44b2aac2f4" body="Implementation of CTBConverter which uses a nio.Charset.CharsetEncoder&#xA;to do the real work.  Handles translation of exceptions to the&#xA;appropriate CORBA versions.&#xA;" annotatedElement="4aadd04d-6cf6-4100-bc0e-aacfaeec4541"/>
                      <generalization xmi:id="853ee8af-d17d-42a0-be9c-3d3fcbbaa392" isSubstitutable="true" general="7245a4db-0fb7-4dfa-bf5f-193573b1b6c7"/>
                    </nestedClassifier>
                    <nestedClassifier xmi:type="uml:Class" xmi:id="42ff2cf1-4b26-4883-839f-de48c3948622" name="UTF16CTBConverter" visibility="private">
                      <ownedComment xmi:id="bf08022c-0808-432c-8237-ab003246d6ef" body="Special UTF16 converter which can either always write a BOM&#xA;or use a specified byte order without one.&#xA;" annotatedElement="42ff2cf1-4b26-4883-839f-de48c3948622"/>
                      <generalization xmi:id="807abd7f-15af-4346-bbac-36b4ec4914b2" isSubstitutable="true" general="4aadd04d-6cf6-4100-bc0e-aacfaeec4541"/>
                    </nestedClassifier>
                    <nestedClassifier xmi:type="uml:Class" xmi:id="6f2cb7de-a644-4ded-928f-68d37a1080de" name="JavaBTCConverter" visibility="private">
                      <ownedComment xmi:id="1d71c293-447e-4784-9559-4a8ffd461c2d" body="Implementation of BTCConverter which uses a sun.io.ByteToCharConverter&#xA;for the real work.  Handles translation of exceptions to the&#xA;appropriate CORBA versions.&#xA;" annotatedElement="6f2cb7de-a644-4ded-928f-68d37a1080de"/>
                      <generalization xmi:id="664e626f-89b1-4785-8eb0-c512fd025bbe" isSubstitutable="true" general="57813679-9fb9-4981-a051-9a778fb7a49f"/>
                    </nestedClassifier>
                    <nestedClassifier xmi:type="uml:Class" xmi:id="d1066dce-916e-4b98-85d2-099ee1d81dbd" name="UTF16BTCConverter" visibility="private">
                      <ownedComment xmi:id="5cabb568-5648-40d8-a9c3-0f9ed240fb23" body="Special converter for UTF16 since it's required to optionally&#xA;support a byte order marker while the internal Java converters&#xA;either require it or require that it isn't there.&#xA;&#xA;The solution is to check for the byte order marker, and if we&#xA;need to do something differently, switch internal converters.&#xA;" annotatedElement="d1066dce-916e-4b98-85d2-099ee1d81dbd"/>
                      <generalization xmi:id="c869f983-662c-42a8-b20e-194e9ce3cfc2" isSubstitutable="true" general="6f2cb7de-a644-4ded-928f-68d37a1080de"/>
                    </nestedClassifier>
                    <nestedClassifier xmi:type="uml:Class" xmi:id="2ad09e16-56c5-4b34-90ef-a3c416472cb4" name="CodeSetConversionHolder" visibility="private"/>
                  </packagedElement>
                  <packagedElement xmi:type="uml:Class" xmi:id="453ceaa7-397a-4667-97f2-53483dd9cefe" name="EncapsInputStream">
                    <ownedComment xmi:id="e153d603-5a29-492d-9af5-d78004e4bbe7" body="Encapsulations are supposed to explicitly define their&#xA;code sets and GIOP version.  The original resolution to issue 2784&#xA;said that the defaults were UTF-8 and UTF-16, but that was not&#xA;agreed upon.&#xA;&#xA;These streams currently use CDR 1.2 with ISO8859-1 for char/string and&#xA;UTF16 for wchar/wstring.  If no byte order marker is available,&#xA;the endianness of the encapsulation is used.&#xA;&#xA;When more encapsulations arise that have their own special code&#xA;sets defined, we can make all constructors take such parameters.&#xA;" annotatedElement="453ceaa7-397a-4667-97f2-53483dd9cefe"/>
                    <generalization xmi:id="58ee9fe5-457b-432c-8f43-e89ecf528f02" isSubstitutable="true" general="5fe201c1-43ec-41f5-ae49-bfa591f69dd9"/>
                  </packagedElement>
                  <packagedElement xmi:type="uml:Class" xmi:id="d61e2a1a-934a-4acc-a54f-e106ac1d8400" name="EncapsOutputStream">
                    <ownedComment xmi:id="295c66bd-199a-4afd-a8a1-50bc26dca88a" body="Encapsulations are supposed to explicitly define their&#xA;code sets and GIOP version.  The original resolution to issue 2784&#xA;said that the defaults were UTF-8 and UTF-16, but that was not&#xA;agreed upon.&#xA;&#xA;These streams currently use CDR 1.2 with ISO8859-1 for char/string and&#xA;UTF16 for wchar/wstring.  If no byte order marker is available,&#xA;the endianness of the encapsulation is used.&#xA;&#xA;When more encapsulations arise that have their own special code&#xA;sets defined, we can make all constructors take such parameters.&#xA;" annotatedElement="d61e2a1a-934a-4acc-a54f-e106ac1d8400"/>
                    <generalization xmi:id="bd0fb71e-fd8f-4166-a9e7-edb87e2f3757" isSubstitutable="true" general="ee36df24-9063-4087-8310-3bcbc27ac917"/>
                  </packagedElement>
                  <packagedElement xmi:type="uml:Class" xmi:id="55dcfabb-0705-4afd-9a4b-ee3c20869b2b" name="IDLJavaSerializationInputStream">
                    <ownedComment xmi:id="7e09a13b-89a9-40ae-81e6-bcb417ed50d4" body="Implementation class that uses Java serialization for input streams.&#xA;This assumes a GIOP version 1.2 message format.&#xA;&#xA;This class uses a ByteArrayInputStream as the underlying buffer. The&#xA;first 16 bytes are directly read out of the underlying buffer. This allows&#xA;[GIOPHeader (12 bytes) + requestID (4 bytes)] to be read as bytes.&#xA;Subsequent write operations on this output stream object uses&#xA;ObjectInputStream class to read into the buffer. This allows unmarshaling&#xA;complex types and graphs using the ObjectInputStream implementation.&#xA;&#xA;Note, this class assumes a GIOP 1.2 style header. Further, the first&#xA;12 bytes, that is, the GIOPHeader is read directly from the received&#xA;message, before this stream object is called. So, this class effectively&#xA;reads only the requestID (4 bytes) directly, and uses the&#xA;ObjectInputStream for further unmarshaling.&#xA;&#xA;@author Ram Jeyaraman&#xA;" annotatedElement="55dcfabb-0705-4afd-9a4b-ee3c20869b2b"/>
                    <generalization xmi:id="ccfa9d4c-2c62-4709-a5b0-c2f5bbd4f7f9" isSubstitutable="true" general="3a24a6b2-ce28-4540-a2e6-690d14b936cf"/>
                    <nestedClassifier xmi:type="uml:Class" xmi:id="530a05cd-f972-4982-8caf-0fa73b10c186" name="_ByteArrayInputStream" visibility="package">
                      <generalization xmi:id="e3d2abb9-b964-420d-a019-72510bf8394d" isSubstitutable="true" general="108998bc-715f-42c6-b1b6-bbd55c9a6b2c"/>
                    </nestedClassifier>
                    <nestedClassifier xmi:type="uml:Class" xmi:id="74e87220-c7b6-42e6-8706-bafa8a2004a6" name="MarshalObjectInputStream" visibility="package">
                      <generalization xmi:id="b8fa2fca-9bd7-4e45-a61f-af3bc9e3aee1" isSubstitutable="true" general="10fcccb3-4ad8-460c-be6b-d807e76605fe"/>
                    </nestedClassifier>
                  </packagedElement>
                  <packagedElement xmi:type="uml:Class" xmi:id="ef465365-7432-4f90-bc90-02630ac0d13f" name="IDLJavaSerializationOutputStream" visibility="package">
                    <ownedComment xmi:id="be5bf4d0-aa38-47d5-83ae-a0ebcb7a2db8" body="Implementation class that uses Java serialization for output streams.&#xA;This assumes a GIOP version 1.2 message format.&#xA;&#xA;This class uses a ByteArrayOutputStream as the underlying buffer. The&#xA;first 16 bytes are direct writes into the underlying buffer. This allows&#xA;[GIOPHeader (12 bytes) + requestID (4 bytes)] to be written as bytes.&#xA;Subsequent write operations on this output stream object uses&#xA;ObjectOutputStream class to write into the buffer. This allows marshaling&#xA;complex types and graphs using the ObjectOutputStream implementation.&#xA;&#xA;Note, this class assumes a GIOP 1.2 style header. Note, we expect that the&#xA;first 16 bytes are written only using the write_octet, write_long or&#xA;write_ulong method calls.&#xA;&#xA;@author Ram Jeyaraman&#xA;" annotatedElement="ef465365-7432-4f90-bc90-02630ac0d13f"/>
                    <generalization xmi:id="180361cb-1ec1-4e23-8b85-fc73029bee3c" isSubstitutable="true" general="d01d248f-6172-4f78-b95e-4445241787db"/>
                    <nestedClassifier xmi:type="uml:Class" xmi:id="47bbb8bf-66e3-4e2e-aee9-a1634b8a0d4b" name="_ByteArrayOutputStream" visibility="package">
                      <generalization xmi:id="09a7ec4f-24a8-4e66-897f-534b6e1c75a2" isSubstitutable="true" general="f9debaab-91a3-4dc7-8fc7-eedaa6b86d13"/>
                    </nestedClassifier>
                    <nestedClassifier xmi:type="uml:Class" xmi:id="de85cef8-cc91-4d48-be3a-a8e700bab891" name="MarshalObjectOutputStream" visibility="package">
                      <generalization xmi:id="997c4437-6af0-4487-9088-58a92048e989" isSubstitutable="true" general="e0607c43-f2ed-4599-95dc-fe68ccd01d0d"/>
                    </nestedClassifier>
                  </packagedElement>
                  <packagedElement xmi:type="uml:Interface" xmi:id="375e73a1-c8cd-4f56-96eb-d56f45e890cd" name="MarkAndResetHandler" visibility="package" isAbstract="true">
                    <ownedComment xmi:id="a144b6f3-e920-4571-899e-d5ab7e2638ee" body="Defines an abstraction for a RestorableInputStream to&#xA;implement mark/reset.&#xA;" annotatedElement="375e73a1-c8cd-4f56-96eb-d56f45e890cd"/>
                  </packagedElement>
                  <packagedElement xmi:type="uml:Interface" xmi:id="be0626c2-fa1d-4d61-9b1d-6910b41c8673" name="MarshalInputStream" isAbstract="true"/>
                  <packagedElement xmi:type="uml:Interface" xmi:id="92601c42-dc0a-4db4-84b0-5b1ac3d77d03" name="MarshalOutputStream" isAbstract="true"/>
                  <packagedElement xmi:type="uml:Class" xmi:id="30d697ff-cd7e-4b4e-88fa-78b29ab6f9d4" name="OSFCodeSetRegistry">
