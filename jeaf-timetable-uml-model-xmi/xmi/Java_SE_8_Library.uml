              <ownedComment xmi:id="5e13770b-37b6-4f11-a911-41b96e044adf" body="A better GridLayout class&#xA;&#xA;@author Steve Wilson&#xA;" annotatedElement="c24006be-6a8f-4fdf-8710-f661a11ca437"/>
