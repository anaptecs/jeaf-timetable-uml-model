              <nestedClassifier xmi:type="uml:Class" xmi:id="3d26c007-f4f8-4015-85c0-99c350ae416c" name="TreeBin" visibility="package">
                <ownedComment xmi:id="cee374d4-c888-4665-b00b-c4c9efcdccf0" body="TreeNodes used at the heads of bins. TreeBins do not hold user&#xA;keys or values, but instead point to list of TreeNodes and&#xA;their root. They also maintain a parasitic read-write lock&#xA;forcing writers (who hold bin lock) to wait for readers (who do&#xA;not) to complete before tree restructuring operations.&#xA;" annotatedElement="3d26c007-f4f8-4015-85c0-99c350ae416c"/>
                <ownedTemplateSignature xmi:type="uml:RedefinableTemplateSignature" xmi:id="337b4dd1-b326-488c-a4d0-bdd04a7cbadc" name="" visibility="public" parameter="8b5a2cd7-57b2-4c17-88ac-d172454ace79 8cefbd61-9d6e-492e-b085-707f7f6258ed">
                  <ownedParameter xmi:type="uml:ClassifierTemplateParameter" xmi:id="8b5a2cd7-57b2-4c17-88ac-d172454ace79" parameteredElement="569a739e-2abe-4368-a616-bbcdd72819c1">
