              </packagedElement>
              <packagedElement xmi:type="uml:Interface" xmi:id="8f137bfa-ef0e-47bb-9adc-ad2999f3cf4c" name="AssertTree" isAbstract="true">
                <ownedComment xmi:id="91daf5de-4115-4230-a1ec-5e12d03af578" body="A tree node for an 'assert' statement.&#xA;&#xA;For example:&#xA;&lt;pre>&#xA;assert &lt;em>condition&lt;/em> ;&#xA;&#xA;assert &lt;em>condition&lt;/em> : &lt;em>detail&lt;/em> ;&#xA;&lt;/pre>&#xA;&#xA;@jls section 14.10&#xA;&#xA;@author Peter von der Ah&amp;eacute;&#xA;@author Jonathan Gibbons&#xA;@since 1.6&#xA;" annotatedElement="8f137bfa-ef0e-47bb-9adc-ad2999f3cf4c"/>
                <generalization xmi:id="f2b0b813-997c-47e7-b233-a1590109f418" isSubstitutable="true" general="01dcdee9-f45c-4a81-aa85-6436a7479f34"/>
              </packagedElement>
              <packagedElement xmi:type="uml:Interface" xmi:id="efd27c38-3dbb-41fe-98af-fe95e7134f8c" name="AssignmentTree" isAbstract="true">
                <ownedComment xmi:id="5583b7f0-892b-4f92-a131-dc1d2c48a498" body="A tree node for an assignment expression.&#xA;&#xA;For example:&#xA;&lt;pre>&#xA;&lt;em>variable&lt;/em> = &lt;em>expression&lt;/em>&#xA;&lt;/pre>&#xA;&#xA;@jls section 15.26.1&#xA;&#xA;@author Peter von der Ah&amp;eacute;&#xA;@author Jonathan Gibbons&#xA;@since 1.6&#xA;" annotatedElement="efd27c38-3dbb-41fe-98af-fe95e7134f8c"/>
                <generalization xmi:id="1a915df0-1864-4246-bb05-e9a4c7f2e962" isSubstitutable="true" general="c8beae39-adea-4653-8097-bec110a62fc1"/>
              </packagedElement>
              <packagedElement xmi:type="uml:Interface" xmi:id="03df62be-9185-4236-a387-9e5713f738e2" name="BinaryTree" isAbstract="true">
                <ownedComment xmi:id="76100ce8-9f43-4714-bdd9-64bc673f8d5b" body="A tree node for a binary expression.&#xA;Use {@link #getKind getKind} to determine the kind of operator.&#xA;&#xA;For example:&#xA;&lt;pre>&#xA;&lt;em>leftOperand&lt;/em> &lt;em>operator&lt;/em> &lt;em>rightOperand&lt;/em>&#xA;&lt;/pre>&#xA;&#xA;@jls sections 15.17 to 15.24&#xA;&#xA;@author Peter von der Ah&amp;eacute;&#xA;@author Jonathan Gibbons&#xA;@since 1.6&#xA;" annotatedElement="03df62be-9185-4236-a387-9e5713f738e2"/>
                <generalization xmi:id="ca395fd5-4329-4af0-8432-bf4ff9cabe86" isSubstitutable="true" general="c8beae39-adea-4653-8097-bec110a62fc1"/>
              </packagedElement>
              <packagedElement xmi:type="uml:Interface" xmi:id="254c460f-826c-4077-b885-3c38e2b70530" name="BlockTree" isAbstract="true">
                <ownedComment xmi:id="82fb13f5-ea63-404d-b7e0-82507cd58ce2" body="A tree node for a statement block.&#xA;&#xA;For example:&#xA;&lt;pre>&#xA;{ }&#xA;&#xA;{ &lt;em>statements&lt;/em> }&#xA;&#xA;static { &lt;em>statements&lt;/em> }&#xA;&lt;/pre>&#xA;&#xA;@jls section 14.2&#xA;&#xA;@author Peter von der Ah&amp;eacute;&#xA;@author Jonathan Gibbons&#xA;@since 1.6&#xA;" annotatedElement="254c460f-826c-4077-b885-3c38e2b70530"/>
                <generalization xmi:id="f7e39e42-5656-47f0-b024-b01e134e2f2a" isSubstitutable="true" general="01dcdee9-f45c-4a81-aa85-6436a7479f34"/>
              </packagedElement>
              <packagedElement xmi:type="uml:Interface" xmi:id="50184793-193a-4e26-b58b-2bef3075d9bc" name="BreakTree" isAbstract="true">
                <ownedComment xmi:id="fbb1b841-8d34-43a0-95ca-36bc4f40090f" body="A tree node for a 'break' statement.&#xA;&#xA;For example:&#xA;&lt;pre>&#xA;break;&#xA;&#xA;break &lt;em>label&lt;/em> ;&#xA;&lt;/pre>&#xA;&#xA;@jls section 14.15&#xA;&#xA;@author Peter von der Ah&amp;eacute;&#xA;@author Jonathan Gibbons&#xA;@since 1.6&#xA;" annotatedElement="50184793-193a-4e26-b58b-2bef3075d9bc"/>
                <generalization xmi:id="bd1f9b87-53ca-48cf-9d98-04e9a172ff01" isSubstitutable="true" general="01dcdee9-f45c-4a81-aa85-6436a7479f34"/>
              </packagedElement>
              <packagedElement xmi:type="uml:Interface" xmi:id="a9a892da-bd3f-4829-bf40-0ce54c479e79" name="CaseTree" isAbstract="true">
                <ownedComment xmi:id="c747192a-c288-408a-bc4d-405d94bca5e3" body="A tree node for a 'case' in a 'switch' statement.&#xA;&#xA;For example:&#xA;&lt;pre>&#xA;case &lt;em>expression&lt;/em> :&#xA;&lt;em>statements&lt;/em>&#xA;&#xA;default :&#xA;&lt;em>statements&lt;/em>&#xA;&lt;/pre>&#xA;&#xA;@jls section 14.11&#xA;&#xA;@author Peter von der Ah&amp;eacute;&#xA;@author Jonathan Gibbons&#xA;@since 1.6&#xA;" annotatedElement="a9a892da-bd3f-4829-bf40-0ce54c479e79"/>
                <generalization xmi:id="a4ad582b-5534-4bc6-9db2-27d5af5aa2c4" isSubstitutable="true" general="605a3649-eb18-4189-b393-9e836930c2f4"/>
              </packagedElement>
              <packagedElement xmi:type="uml:Interface" xmi:id="57471014-d4b3-4e56-9c21-58f6ff601bac" name="CatchTree" isAbstract="true">
                <ownedComment xmi:id="72005291-6168-40c9-b27b-619dcaeccd33" body="A tree node for a 'catch' block in a 'try' statement.&#xA;&#xA;For example:&#xA;&lt;pre>&#xA;catch ( &lt;em>parameter&lt;/em> )&#xA;&lt;em>block&lt;/em>&#xA;&lt;/pre>&#xA;&#xA;@jls section 14.20&#xA;&#xA;@author Peter von der Ah&amp;eacute;&#xA;@author Jonathan Gibbons&#xA;@since 1.6&#xA;" annotatedElement="57471014-d4b3-4e56-9c21-58f6ff601bac"/>
                <generalization xmi:id="d96ee1b9-622d-4f35-bdcf-3435999142b5" isSubstitutable="true" general="605a3649-eb18-4189-b393-9e836930c2f4"/>
              </packagedElement>
              <packagedElement xmi:type="uml:Interface" xmi:id="0f1a0ec6-f1ff-4211-a3b8-38efddcb652a" name="ClassTree" isAbstract="true">
                <ownedComment xmi:id="0ff1e48f-3d9d-4d6b-9241-91645d6630d7" body="A tree node for a class, interface, enum, or annotation&#xA;type declaration.&#xA;&#xA;For example:&#xA;&lt;pre>&#xA;&lt;em>modifiers&lt;/em> class &lt;em>simpleName&lt;/em> &lt;em>typeParameters&lt;/em>&#xA;extends &lt;em>extendsClause&lt;/em>&#xA;implements &lt;em>implementsClause&lt;/em>&#xA;{&#xA;&lt;em>members&lt;/em>&#xA;}&#xA;&lt;/pre>&#xA;&#xA;@jls sections 8.1, 8.9, 9.1, and 9.6&#xA;&#xA;@author Peter von der Ah&amp;eacute;&#xA;@author Jonathan Gibbons&#xA;@since 1.6&#xA;" annotatedElement="0f1a0ec6-f1ff-4211-a3b8-38efddcb652a"/>
                <generalization xmi:id="324670f3-aab5-4249-ac7f-9f2a26f864c3" isSubstitutable="true" general="01dcdee9-f45c-4a81-aa85-6436a7479f34"/>
              </packagedElement>
              <packagedElement xmi:type="uml:Interface" xmi:id="48fea358-3ee7-46b2-b670-a29875972fe8" name="CompilationUnitTree" isAbstract="true">
                <ownedComment xmi:id="dedb3c7d-99ab-497f-9fa6-36812a977f38" body="Represents the abstract syntax tree for compilation units (source&#xA;files) and package declarations (package-info.java).&#xA;&#xA;@jls sections 7.3, and 7.4&#xA;&#xA;@author Peter von der Ah&amp;eacute;&#xA;@since 1.6&#xA;" annotatedElement="48fea358-3ee7-46b2-b670-a29875972fe8"/>
                <generalization xmi:id="51644d59-f54c-4f31-8a4c-b1d2a0c62296" isSubstitutable="true" general="605a3649-eb18-4189-b393-9e836930c2f4"/>
              </packagedElement>
              <packagedElement xmi:type="uml:Interface" xmi:id="8531a7bd-73e7-4a9d-a90a-b78053f89e0a" name="CompoundAssignmentTree" isAbstract="true">
                <ownedComment xmi:id="9aec955d-abb6-4eea-8cb8-012cb390d12e" body="A tree node for compound assignment operator.&#xA;Use {@link #getKind getKind} to determine the kind of operator.&#xA;&#xA;For example:&#xA;&lt;pre>&#xA;&lt;em>variable&lt;/em> &lt;em>operator&lt;/em> &lt;em>expression&lt;/em>&#xA;&lt;/pre>&#xA;&#xA;@jls section 15.26.2&#xA;&#xA;@author Peter von der Ah&amp;eacute;&#xA;@author Jonathan Gibbons&#xA;@since 1.6&#xA;" annotatedElement="8531a7bd-73e7-4a9d-a90a-b78053f89e0a"/>
                <generalization xmi:id="8293cf6d-d217-4c4f-b19a-f1aaebcb3c9e" isSubstitutable="true" general="c8beae39-adea-4653-8097-bec110a62fc1"/>
              </packagedElement>
              <packagedElement xmi:type="uml:Interface" xmi:id="cfd962cb-2698-473c-b99c-8a368d69ac7f" name="ConditionalExpressionTree" isAbstract="true">
                <ownedComment xmi:id="b527cb49-291e-4a0c-b5de-788a2065423a" body="A tree node for the conditional operator ? :.&#xA;&#xA;For example:&#xA;&lt;pre>&#xA;&lt;em>condition&lt;/em> ? &lt;em>trueExpression&lt;/em> : &lt;em>falseExpression&lt;/em>&#xA;&lt;/pre>&#xA;&#xA;@jls section 15.25&#xA;&#xA;@author Peter von der Ah&amp;eacute;&#xA;@author Jonathan Gibbons&#xA;@since 1.6&#xA;" annotatedElement="cfd962cb-2698-473c-b99c-8a368d69ac7f"/>
                <generalization xmi:id="7ea97b8c-a563-4d2e-aab5-275fcdf7bd5c" isSubstitutable="true" general="c8beae39-adea-4653-8097-bec110a62fc1"/>
              </packagedElement>
              <packagedElement xmi:type="uml:Interface" xmi:id="edaab279-e4db-4249-babe-a77bf43f78c6" name="ContinueTree" isAbstract="true">
                <ownedComment xmi:id="8155294b-9aa9-4b3e-9176-634e4805a149" body="A tree node for a 'continue' statement.&#xA;&#xA;For example:&#xA;&lt;pre>&#xA;continue;&#xA;continue &lt;em>label&lt;/em> ;&#xA;&lt;/pre>&#xA;&#xA;@jls section 14.16&#xA;&#xA;@author Peter von der Ah&amp;eacute;&#xA;@author Jonathan Gibbons&#xA;@since 1.6&#xA;" annotatedElement="edaab279-e4db-4249-babe-a77bf43f78c6"/>
                <generalization xmi:id="8cdc2aad-a74b-47c8-9c76-2d9ee7b8d8ae" isSubstitutable="true" general="01dcdee9-f45c-4a81-aa85-6436a7479f34"/>
              </packagedElement>
              <packagedElement xmi:type="uml:Interface" xmi:id="8b801862-b812-46b3-841b-381b4e704a1f" name="DoWhileLoopTree" isAbstract="true">
                <ownedComment xmi:id="64a5c298-44f0-4352-8516-4dfe7b0677f1" body="A tree node for a 'do' statement.&#xA;&#xA;For example:&#xA;&lt;pre>&#xA;do&#xA;&lt;em>statement&lt;/em>&#xA;while ( &lt;em>expression&lt;/em> );&#xA;&lt;/pre>&#xA;&#xA;@jls section 14.13&#xA;&#xA;@author Peter von der Ah&amp;eacute;&#xA;@author Jonathan Gibbons&#xA;@since 1.6&#xA;" annotatedElement="8b801862-b812-46b3-841b-381b4e704a1f"/>
                <generalization xmi:id="b1cb3b17-ee11-4382-bf4b-60f2ffa78263" isSubstitutable="true" general="01dcdee9-f45c-4a81-aa85-6436a7479f34"/>
              </packagedElement>
              <packagedElement xmi:type="uml:Interface" xmi:id="0d049bfc-a278-470e-9b51-04514cdd1d57" name="EmptyStatementTree" isAbstract="true">
                <ownedComment xmi:id="aacb35e5-4d13-448e-a6ea-4f7f7fe5dbd7" body="A tree node for an empty (skip) statement.&#xA;&#xA;For example:&#xA;&lt;pre>&#xA;;&#xA;&lt;/pre>&#xA;&#xA;@jls section 14.6&#xA;&#xA;@author Peter von der Ah&amp;eacute;&#xA;@author Jonathan Gibbons&#xA;@since 1.6&#xA;" annotatedElement="0d049bfc-a278-470e-9b51-04514cdd1d57"/>
                <generalization xmi:id="79cacabd-995f-43ed-affe-17325fa81b9e" isSubstitutable="true" general="01dcdee9-f45c-4a81-aa85-6436a7479f34"/>
              </packagedElement>
              <packagedElement xmi:type="uml:Interface" xmi:id="9d1beba3-9afd-4723-b9cf-3da76858bd38" name="EnhancedForLoopTree" isAbstract="true">
                <ownedComment xmi:id="70658695-2957-424a-8a6b-e5d087ed2405" body="A tree node for an &quot;enhanced&quot; 'for' loop statement.&#xA;&#xA;For example:&#xA;&lt;pre>&#xA;for ( &lt;em>variable&lt;/em> : &lt;em>expression&lt;/em> )&#xA;&lt;em>statement&lt;/em>&#xA;&lt;/pre>&#xA;&#xA;@jls section 14.14.2&#xA;&#xA;@author Peter von der Ah&amp;eacute;&#xA;@author Jonathan Gibbons&#xA;@since 1.6&#xA;" annotatedElement="9d1beba3-9afd-4723-b9cf-3da76858bd38"/>
                <generalization xmi:id="1899d6bd-7abe-4baa-a039-54a08deb0d35" isSubstitutable="true" general="01dcdee9-f45c-4a81-aa85-6436a7479f34"/>
              </packagedElement>
              <packagedElement xmi:type="uml:Interface" xmi:id="5e363c62-30af-4da8-b99f-084edeee9902" name="ErroneousTree" isAbstract="true">
                <ownedComment xmi:id="8ebeb971-04f5-40bc-91b8-e6ccf9cc9270" body="A tree node to stand in for a malformed expression.&#xA;&#xA;@author Peter von der Ah&amp;eacute;&#xA;@author Jonathan Gibbons&#xA;@since 1.6&#xA;" annotatedElement="5e363c62-30af-4da8-b99f-084edeee9902"/>
                <generalization xmi:id="49411d9f-b865-48e5-864b-a7a3f79e2468" isSubstitutable="true" general="c8beae39-adea-4653-8097-bec110a62fc1"/>
              </packagedElement>
              <packagedElement xmi:type="uml:Interface" xmi:id="dbc6b240-69e6-4e39-bbcd-9d0418ba2d61" name="ExpressionStatementTree" isAbstract="true">
                <ownedComment xmi:id="d81bdf34-c865-46d0-89a1-f1b914ee6db8" body="A tree node for an expression statement.&#xA;&#xA;For example:&#xA;&lt;pre>&#xA;&lt;em>expression&lt;/em> ;&#xA;&lt;/pre>&#xA;&#xA;@jls section 14.8&#xA;&#xA;@author Peter von der Ah&amp;eacute;&#xA;@author Jonathan Gibbons&#xA;@since 1.6&#xA;" annotatedElement="dbc6b240-69e6-4e39-bbcd-9d0418ba2d61"/>
                <generalization xmi:id="2d39cbec-1324-4d66-98b0-f3de94d6f1a3" isSubstitutable="true" general="01dcdee9-f45c-4a81-aa85-6436a7479f34"/>
              </packagedElement>
              <packagedElement xmi:type="uml:Interface" xmi:id="c8beae39-adea-4653-8097-bec110a62fc1" name="ExpressionTree" isAbstract="true">
                <ownedComment xmi:id="444a6434-2fef-472b-9b4f-3243f7cc5745" body="A tree node used as the base class for the different types of&#xA;expressions.&#xA;&#xA;@jls chapter 15&#xA;&#xA;@author Peter von der Ah&amp;eacute;&#xA;@author Jonathan Gibbons&#xA;@since 1.6&#xA;" annotatedElement="c8beae39-adea-4653-8097-bec110a62fc1"/>
                <generalization xmi:id="2bc61275-a41a-4ae2-8433-3296c1e9ef9f" isSubstitutable="true" general="605a3649-eb18-4189-b393-9e836930c2f4"/>
              </packagedElement>
              <packagedElement xmi:type="uml:Interface" xmi:id="9b6f833b-3ca0-42dd-b490-9da809dde97d" name="ForLoopTree" isAbstract="true">
                <ownedComment xmi:id="d4ec2f5f-b186-4920-8123-ab436d6e7d1e" body="A tree node for a basic 'for' loop statement.&#xA;&#xA;For example:&#xA;&lt;pre>&#xA;for ( &lt;em>initializer&lt;/em> ; &lt;em>condition&lt;/em> ; &lt;em>update&lt;/em> )&#xA;&lt;em>statement&lt;/em>&#xA;&lt;/pre>&#xA;&#xA;@jls section 14.14.1&#xA;&#xA;@author Peter von der Ah&amp;eacute;&#xA;@author Jonathan Gibbons&#xA;@since 1.6&#xA;" annotatedElement="9b6f833b-3ca0-42dd-b490-9da809dde97d"/>
                <generalization xmi:id="c233e62a-1d73-451a-8855-7bccaf8b8f96" isSubstitutable="true" general="01dcdee9-f45c-4a81-aa85-6436a7479f34"/>
              </packagedElement>
              <packagedElement xmi:type="uml:Interface" xmi:id="dbbd995b-461e-473f-8be2-f68f44a346b0" name="IdentifierTree" isAbstract="true">
                <ownedComment xmi:id="e6b8d2d6-25a2-4f30-803b-00c93b19c678" body="A tree node for an identifier expression.&#xA;&#xA;For example:&#xA;&lt;pre>&#xA;&lt;em>name&lt;/em>&#xA;&lt;/pre>&#xA;&#xA;@jls section 6.5.6.1&#xA;&#xA;@author Peter von der Ah&amp;eacute;&#xA;@author Jonathan Gibbons&#xA;@since 1.6&#xA;" annotatedElement="dbbd995b-461e-473f-8be2-f68f44a346b0"/>
                <generalization xmi:id="12ca898d-838b-4a73-93e7-c275b634c38d" isSubstitutable="true" general="c8beae39-adea-4653-8097-bec110a62fc1"/>
              </packagedElement>
              <packagedElement xmi:type="uml:Interface" xmi:id="41f9bae2-def8-4f74-8019-c2dcdcc86dd7" name="IfTree" isAbstract="true">
                <ownedComment xmi:id="dbc08ad7-7bf6-454c-9d50-86fde9ecc60a" body="A tree node for an 'if' statement.&#xA;&#xA;For example:&#xA;&lt;pre>&#xA;if ( &lt;em>condition&lt;/em> )&#xA;&lt;em>thenStatement&lt;/em>&#xA;&#xA;if ( &lt;em>condition&lt;/em> )&#xA;&lt;em>thenStatement&lt;/em>&#xA;else&#xA;&lt;em>elseStatement&lt;/em>&#xA;&lt;/pre>&#xA;&#xA;@jls section 14.9&#xA;&#xA;@author Peter von der Ah&amp;eacute;&#xA;@author Jonathan Gibbons&#xA;@since 1.6&#xA;" annotatedElement="41f9bae2-def8-4f74-8019-c2dcdcc86dd7"/>
                <generalization xmi:id="c800f1a4-fc82-4cbe-bcf5-cd2559c741c7" isSubstitutable="true" general="01dcdee9-f45c-4a81-aa85-6436a7479f34"/>
              </packagedElement>
              <packagedElement xmi:type="uml:Interface" xmi:id="a1944171-ee7a-4d2a-b748-24466fdd73ed" name="ImportTree" isAbstract="true">
                <ownedComment xmi:id="ee99d816-6f31-4141-8ceb-8a150d5edb39" body="A tree node for an import statement.&#xA;&#xA;For example:&#xA;&lt;pre>&#xA;import &lt;em>qualifiedIdentifier&lt;/em> ;&#xA;&#xA;static import &lt;em>qualifiedIdentifier&lt;/em> ;&#xA;&lt;/pre>&#xA;&#xA;@jls section 7.5&#xA;&#xA;@author Peter von der Ah&amp;eacute;&#xA;@author Jonathan Gibbons&#xA;@since 1.6&#xA;" annotatedElement="a1944171-ee7a-4d2a-b748-24466fdd73ed"/>
                <generalization xmi:id="d87ec03e-d562-4e8c-bdc8-23531beb088c" isSubstitutable="true" general="605a3649-eb18-4189-b393-9e836930c2f4"/>
              </packagedElement>
              <packagedElement xmi:type="uml:Interface" xmi:id="e5f7e79b-dc20-41cd-9999-ffd4d9432a74" name="InstanceOfTree" isAbstract="true">
                <ownedComment xmi:id="a3c59d81-5761-42b2-937b-c613b4961cce" body="A tree node for an 'instanceof' expression.&#xA;&#xA;For example:&#xA;&lt;pre>&#xA;&lt;em>expression&lt;/em> instanceof &lt;em>type&lt;/em>&#xA;&lt;/pre>&#xA;&#xA;@jls section 15.20.2&#xA;&#xA;@author Peter von der Ah&amp;eacute;&#xA;@author Jonathan Gibbons&#xA;@since 1.6&#xA;" annotatedElement="e5f7e79b-dc20-41cd-9999-ffd4d9432a74"/>
                <generalization xmi:id="b7a52a80-ab6b-4935-b2ef-e7249c126dba" isSubstitutable="true" general="c8beae39-adea-4653-8097-bec110a62fc1"/>
              </packagedElement>
              <packagedElement xmi:type="uml:Interface" xmi:id="06334588-97aa-489a-ad4b-c65dfa32c5ee" name="IntersectionTypeTree" isAbstract="true">
                <ownedComment xmi:id="6662e052-5e39-4f07-954c-ee1124f75936" body="A tree node for an intersection type in a cast expression.&#xA;&#xA;@author Maurizio Cimadamore&#xA;&#xA;@since 1.8&#xA;" annotatedElement="06334588-97aa-489a-ad4b-c65dfa32c5ee"/>
                <generalization xmi:id="a5ddbb05-2951-44a9-8a6d-6d33c9215dc9" isSubstitutable="true" general="605a3649-eb18-4189-b393-9e836930c2f4"/>
              </packagedElement>
              <packagedElement xmi:type="uml:Interface" xmi:id="3071ae0c-ceed-4c6e-948f-02feb0d48b1b" name="LabeledStatementTree" isAbstract="true">
                <ownedComment xmi:id="f1e066f1-1f8f-45ef-bedd-4c8d8c87a110" body="A tree node for a labeled statement.&#xA;&#xA;For example:&#xA;&lt;pre>&#xA;&lt;em>label&lt;/em> : &lt;em>statement&lt;/em>&#xA;&lt;/pre>&#xA;&#xA;@jls section 14.7&#xA;&#xA;@author Peter von der Ah&amp;eacute;&#xA;@author Jonathan Gibbons&#xA;@since 1.6&#xA;" annotatedElement="3071ae0c-ceed-4c6e-948f-02feb0d48b1b"/>
                <generalization xmi:id="6efe3f6f-8058-41f7-83c9-e11f445aa6e6" isSubstitutable="true" general="01dcdee9-f45c-4a81-aa85-6436a7479f34"/>
              </packagedElement>
              <packagedElement xmi:type="uml:Interface" xmi:id="e983513d-2948-4f32-b6e7-dae9f35dc880" name="LambdaExpressionTree" isAbstract="true">
                <ownedComment xmi:id="f414d8a4-ca76-44a1-85b5-5154a65d2417" body="A tree node for a lambda expression.&#xA;&#xA;For example:&#xA;&lt;pre>{@code&#xA;()->{}&#xA;(List&lt;String> ls)->ls.size()&#xA;(x,y)-> { return x + y; }&#xA;}&lt;/pre>&#xA;" annotatedElement="e983513d-2948-4f32-b6e7-dae9f35dc880"/>
                <generalization xmi:id="8737eff0-f13f-4ae4-95e9-adf9d47c2090" isSubstitutable="true" general="c8beae39-adea-4653-8097-bec110a62fc1"/>
                <nestedClassifier xmi:type="uml:Class" xmi:id="88053141-11bc-4d94-a115-a02b8e6c5830" name="BodyKind">
                  <ownedComment xmi:id="95bf9753-1fb2-47f1-8de3-a3a5762d5e7e" body="Lambda expressions come in two forms: (i) expression lambdas, whose body&#xA;is an expression, and (ii) statement lambdas, whose body is a block&#xA;" annotatedElement="88053141-11bc-4d94-a115-a02b8e6c5830"/>
                </nestedClassifier>
              </packagedElement>
              <packagedElement xmi:type="uml:Interface" xmi:id="35af2375-0323-404a-9ee8-581d9217d90c" name="LineMap" isAbstract="true">
                <ownedComment xmi:id="e01ba5df-c21d-4257-aedb-1180d58d33af" body="Provides methods to convert between character positions and line numbers&#xA;for a compilation unit.&#xA;&#xA;@since 1.6&#xA;" annotatedElement="35af2375-0323-404a-9ee8-581d9217d90c"/>
              </packagedElement>
              <packagedElement xmi:type="uml:Interface" xmi:id="4fe70c55-9732-4fda-9eef-ccd86dacb49a" name="LiteralTree" isAbstract="true">
                <ownedComment xmi:id="42118901-a0b9-44bf-866a-a42ab9952c10" body="A tree node for a literal expression.&#xA;Use {@link #getKind getKind} to determine the kind of literal.&#xA;&#xA;For example:&#xA;&lt;pre>&#xA;&lt;em>value&lt;/em>&#xA;&lt;/pre>&#xA;&#xA;@jls section 15.28&#xA;&#xA;@author Peter von der Ah&amp;eacute;&#xA;@author Jonathan Gibbons&#xA;@since 1.6&#xA;" annotatedElement="4fe70c55-9732-4fda-9eef-ccd86dacb49a"/>
                <generalization xmi:id="a18f12cc-531a-441d-906f-7cf2278b3637" isSubstitutable="true" general="c8beae39-adea-4653-8097-bec110a62fc1"/>
              </packagedElement>
              <packagedElement xmi:type="uml:Interface" xmi:id="8966c937-192d-475a-a5aa-9c439b229ddf" name="MemberReferenceTree" isAbstract="true">
                <ownedComment xmi:id="e1d0144d-5448-4167-a9f7-2fa92315b0f4" body="A tree node for a member reference expression.&#xA;&#xA;For example:&#xA;&lt;pre>&#xA;&lt;em>expression&lt;/em> # &lt;em>[ identifier | new ]&lt;/em>&#xA;&lt;/pre>&#xA;&#xA;@since 1.8&#xA;" annotatedElement="8966c937-192d-475a-a5aa-9c439b229ddf"/>
                <generalization xmi:id="236746f5-1f13-45b4-a041-d3327983f0c4" isSubstitutable="true" general="c8beae39-adea-4653-8097-bec110a62fc1"/>
                <nestedClassifier xmi:type="uml:Class" xmi:id="58ff1398-2f98-450c-9594-b284e3afd061" name="ReferenceMode">
                  <ownedComment xmi:id="9b467fef-eff3-4613-b39b-44061e98b81c" body="There are two kinds of member references: (i) method references and&#xA;(ii) constructor references&#xA;" annotatedElement="58ff1398-2f98-450c-9594-b284e3afd061"/>
                </nestedClassifier>
              </packagedElement>
              <packagedElement xmi:type="uml:Interface" xmi:id="07cfd42b-690c-453d-8082-634b45def2aa" name="MemberSelectTree" isAbstract="true">
                <ownedComment xmi:id="bce30915-ee75-4bfb-9df1-d5cba346d120" body="A tree node for a member access expression.&#xA;&#xA;For example:&#xA;&lt;pre>&#xA;&lt;em>expression&lt;/em> . &lt;em>identifier&lt;/em>&#xA;&lt;/pre>&#xA;&#xA;@jls sections 6.5, 15.11,and 15.12&#xA;&#xA;@author Peter von der Ah&amp;eacute;&#xA;@author Jonathan Gibbons&#xA;@since 1.6&#xA;" annotatedElement="07cfd42b-690c-453d-8082-634b45def2aa"/>
                <generalization xmi:id="394e1459-7967-4035-a37d-5a8bd06a3600" isSubstitutable="true" general="c8beae39-adea-4653-8097-bec110a62fc1"/>
              </packagedElement>
              <packagedElement xmi:type="uml:Interface" xmi:id="ae676b1e-729f-4dce-8ddc-2fc0a3cbb812" name="MethodInvocationTree" isAbstract="true">
                <ownedComment xmi:id="544e9cc6-df68-4e4d-86cf-6b09f5ece48f" body="A tree node for a method invocation expression.&#xA;&#xA;For example:&#xA;&lt;pre>&#xA;&lt;em>identifier&lt;/em> ( &lt;em>arguments&lt;/em> )&#xA;&#xA;this . &lt;em>typeArguments&lt;/em> &lt;em>identifier&lt;/em> ( &lt;em>arguments&lt;/em> )&#xA;&lt;/pre>&#xA;&#xA;@jls section 15.12&#xA;&#xA;@author Peter von der Ah&amp;eacute;&#xA;@author Jonathan Gibbons&#xA;@since 1.6&#xA;" annotatedElement="ae676b1e-729f-4dce-8ddc-2fc0a3cbb812"/>
                <generalization xmi:id="779474c9-c595-4920-bf4a-45db8e685f2b" isSubstitutable="true" general="c8beae39-adea-4653-8097-bec110a62fc1"/>
              </packagedElement>
              <packagedElement xmi:type="uml:Interface" xmi:id="b0411b39-03f9-471b-b8dc-50e65dd3b390" name="MethodTree" isAbstract="true">
                <ownedComment xmi:id="2b227c50-ac48-4085-9102-6810dcd0b8e7" body="A tree node for a method or annotation type element declaration.&#xA;&#xA;For example:&#xA;&lt;pre>&#xA;&lt;em>modifiers&lt;/em> &lt;em>typeParameters&lt;/em> &lt;em>type&lt;/em> &lt;em>name&lt;/em>&#xA;( &lt;em>parameters&lt;/em> )&#xA;&lt;em>body&lt;/em>&#xA;&#xA;&lt;em>modifiers&lt;/em> &lt;em>type&lt;/em> &lt;em>name&lt;/em> () default &lt;em>defaultValue&lt;/em>&#xA;&lt;/pre>&#xA;&#xA;@jls sections 8.4, 8.6, 8.7, 9.4, and 9.6&#xA;&#xA;@author Peter von der Ah&amp;eacute;&#xA;@author Jonathan Gibbons&#xA;@since 1.6&#xA;" annotatedElement="b0411b39-03f9-471b-b8dc-50e65dd3b390"/>
                <generalization xmi:id="c91ce02f-8743-4529-a38e-2127cd88b968" isSubstitutable="true" general="605a3649-eb18-4189-b393-9e836930c2f4"/>
              </packagedElement>
              <packagedElement xmi:type="uml:Interface" xmi:id="b8c00506-d842-4c84-b7f9-efd50c83c875" name="ModifiersTree" isAbstract="true">
                <ownedComment xmi:id="3c9dd56d-3b83-4574-b393-e9679687c304" body="A tree node for the modifiers, including annotations, for a declaration.&#xA;&#xA;For example:&#xA;&lt;pre>&#xA;&lt;em>flags&lt;/em>&#xA;&#xA;&lt;em>flags&lt;/em> &lt;em>annotations&lt;/em>&#xA;&lt;/pre>&#xA;&#xA;@jls sections 8.1.1, 8.3.1, 8.4.3, 8.5.1, 8.8.3, 9.1.1, and 9.7&#xA;&#xA;@author Peter von der Ah&amp;eacute;&#xA;@author Jonathan Gibbons&#xA;@since 1.6&#xA;" annotatedElement="b8c00506-d842-4c84-b7f9-efd50c83c875"/>
                <generalization xmi:id="40a4eeb4-d6b2-4b7a-9150-69d0b8fbd8ec" isSubstitutable="true" general="605a3649-eb18-4189-b393-9e836930c2f4"/>
              </packagedElement>
              <packagedElement xmi:type="uml:Interface" xmi:id="835050aa-a3ac-4b48-aae5-9ca9022dcc71" name="NewArrayTree" isAbstract="true">
                <ownedComment xmi:id="2429a9f9-e5a7-40fe-b474-3ebf2f58ef84" body="A tree node for an expression to create a new instance of an array.&#xA;&#xA;For example:&#xA;&lt;pre>&#xA;new &lt;em>type&lt;/em> &lt;em>dimensions&lt;/em> &lt;em>initializers&lt;/em>&#xA;&#xA;new &lt;em>type&lt;/em> &lt;em>dimensions&lt;/em> [ ] &lt;em>initializers&lt;/em>&#xA;&lt;/pre>&#xA;&#xA;@jls section 15.10&#xA;&#xA;@author Peter von der Ah&amp;eacute;&#xA;@author Jonathan Gibbons&#xA;@since 1.6&#xA;" annotatedElement="835050aa-a3ac-4b48-aae5-9ca9022dcc71"/>
                <generalization xmi:id="1803411c-acdb-49e4-9f73-f5c681a56da2" isSubstitutable="true" general="c8beae39-adea-4653-8097-bec110a62fc1"/>
              </packagedElement>
              <packagedElement xmi:type="uml:Interface" xmi:id="e9bd06ae-bf5b-4bcd-aa79-79bfb07b0fdb" name="NewClassTree" isAbstract="true">
                <ownedComment xmi:id="70eaab76-8d27-432d-8953-e4bc6769ba46" body="A tree node to declare a new instance of a class.&#xA;&#xA;For example:&#xA;&lt;pre>&#xA;new &lt;em>identifier&lt;/em> ( )&#xA;&#xA;new &lt;em>identifier&lt;/em> ( &lt;em>arguments&lt;/em> )&#xA;&#xA;new &lt;em>typeArguments&lt;/em> &lt;em>identifier&lt;/em> ( &lt;em>arguments&lt;/em> )&#xA;&lt;em>classBody&lt;/em>&#xA;&#xA;&lt;em>enclosingExpression&lt;/em>.new &lt;em>identifier&lt;/em> ( &lt;em>arguments&lt;/em> )&#xA;&lt;/pre>&#xA;&#xA;@jls section 15.9&#xA;&#xA;@author Peter von der Ah&amp;eacute;&#xA;@author Jonathan Gibbons&#xA;@since 1.6&#xA;" annotatedElement="e9bd06ae-bf5b-4bcd-aa79-79bfb07b0fdb"/>
                <generalization xmi:id="bc6a8097-a3b9-4833-9ecb-edac6e7d4292" isSubstitutable="true" general="c8beae39-adea-4653-8097-bec110a62fc1"/>
              </packagedElement>
              <packagedElement xmi:type="uml:Interface" xmi:id="5fd539c8-a1da-46e2-8d03-39f56c690d35" name="ParameterizedTypeTree" isAbstract="true">
                <ownedComment xmi:id="237269bf-58e2-42e0-8d02-1ad9a0f393a3" body="Provides interfaces to represent source code as abstract syntax&#xA;trees (AST).&#xA;&#xA;@author Peter von der Ah&amp;eacute;&#xA;@author Jonathan Gibbons&#xA;@since 1.6&#xA;" annotatedElement="5fd539c8-a1da-46e2-8d03-39f56c690d35"/>
                <generalization xmi:id="caa487c1-0fa6-433f-bdbb-035edc2c7d27" isSubstitutable="true" general="605a3649-eb18-4189-b393-9e836930c2f4"/>
              </packagedElement>
              <packagedElement xmi:type="uml:Interface" xmi:id="76089de6-ddbc-48b7-b4ad-4759e0e86e4e" name="ParenthesizedTree" isAbstract="true">
                <ownedComment xmi:id="d5f9422f-0acc-4fff-a4f3-b81dc89fec27" body="A tree node for a parenthesized expression.  Note: parentheses&#xA;not be preserved by the parser.&#xA;&#xA;For example:&#xA;&lt;pre>&#xA;( &lt;em>expression&lt;/em> )&#xA;&lt;/pre>&#xA;&#xA;@jls section 15.8.5&#xA;&#xA;@author Peter von der Ah&amp;eacute;&#xA;@author Jonathan Gibbons&#xA;@since 1.6&#xA;" annotatedElement="76089de6-ddbc-48b7-b4ad-4759e0e86e4e"/>
                <generalization xmi:id="5ecb125a-38ea-4219-a1d6-2589aadab0bb" isSubstitutable="true" general="c8beae39-adea-4653-8097-bec110a62fc1"/>
              </packagedElement>
              <packagedElement xmi:type="uml:Interface" xmi:id="0a0e809d-e40a-47a3-a035-ab60bb90965a" name="PrimitiveTypeTree" isAbstract="true">
                <ownedComment xmi:id="77764a0a-37e9-457a-96d5-9597e7a9d7b7" body="A tree node for a primitive type.&#xA;&#xA;For example:&#xA;&lt;pre>&#xA;&lt;em>primitiveTypeKind&lt;/em>&#xA;&lt;/pre>&#xA;&#xA;@jls section 4.2&#xA;&#xA;@author Peter von der Ah&amp;eacute;&#xA;@author Jonathan Gibbons&#xA;@since 1.6&#xA;" annotatedElement="0a0e809d-e40a-47a3-a035-ab60bb90965a"/>
                <generalization xmi:id="e8dbb677-5e37-4d9a-9ac7-8bc64fea2194" isSubstitutable="true" general="605a3649-eb18-4189-b393-9e836930c2f4"/>
              </packagedElement>
              <packagedElement xmi:type="uml:Interface" xmi:id="70cf0239-ceef-4624-a275-dbc25924b806" name="ReturnTree" isAbstract="true">
                <ownedComment xmi:id="d652d4ce-9f4f-49ad-aa47-78aaaf194df4" body="A tree node for a 'return' statement.&#xA;&#xA;For example:&#xA;&lt;pre>&#xA;return;&#xA;return &lt;em>expression&lt;/em>;&#xA;&lt;/pre>&#xA;&#xA;@jls section 14.17&#xA;&#xA;@author Peter von der Ah&amp;eacute;&#xA;@author Jonathan Gibbons&#xA;@since 1.6&#xA;" annotatedElement="70cf0239-ceef-4624-a275-dbc25924b806"/>
                <generalization xmi:id="e3d15b1c-9d8f-425e-9164-0c0ffbe7e832" isSubstitutable="true" general="01dcdee9-f45c-4a81-aa85-6436a7479f34"/>
              </packagedElement>
              <packagedElement xmi:type="uml:Interface" xmi:id="01c1b98a-532e-40b8-a9d7-5529708d9506" name="Scope" isAbstract="true">
                <ownedComment xmi:id="29d5c804-68fd-407e-a3d5-45dc45ec676b" body="Interface for determining locally available program elements, such as&#xA;local variables and imports.&#xA;Upon creation, a Scope is associated with a given program position;&#xA;for example, a {@linkplain Tree tree node}. This position may be used to&#xA;infer an enclosing method and/or class.&#xA;&#xA;&lt;p>A Scope does not itself contain the details of the elements corresponding&#xA;to the parameters, methods and fields of the methods and classes containing&#xA;its position. However, these elements can be determined from the enclosing&#xA;elements.&#xA;&#xA;&lt;p>Scopes may be contained in an enclosing scope. The outermost scope contains&#xA;those elements available via &quot;star import&quot; declarations; the scope within that&#xA;contains the top level elements of the compilation unit, including any named&#xA;imports.&#xA;&#xA;@since 1.6&#xA;" annotatedElement="01c1b98a-532e-40b8-a9d7-5529708d9506"/>
              </packagedElement>
              <packagedElement xmi:type="uml:Interface" xmi:id="01dcdee9-f45c-4a81-aa85-6436a7479f34" name="StatementTree" isAbstract="true">
                <ownedComment xmi:id="91ce194d-941f-454f-80b2-2ee2a8cb26fe" body="A tree node used as the base class for the different kinds of&#xA;statements.&#xA;&#xA;@jls chapter 14&#xA;&#xA;@author Peter von der Ah&amp;eacute;&#xA;@author Jonathan Gibbons&#xA;@since 1.6&#xA;" annotatedElement="01dcdee9-f45c-4a81-aa85-6436a7479f34"/>
                <generalization xmi:id="262c83ef-816b-4558-9b55-9cf04abdeeac" isSubstitutable="true" general="605a3649-eb18-4189-b393-9e836930c2f4"/>
              </packagedElement>
              <packagedElement xmi:type="uml:Interface" xmi:id="9f7b6b26-9b32-43c0-9261-b03e3ad1c8c1" name="SwitchTree" isAbstract="true">
                <ownedComment xmi:id="8968a6a1-b236-4085-9260-ddd662d37ce5" body="A tree node for a 'switch' statement.&#xA;&#xA;For example:&#xA;&lt;pre>&#xA;switch ( &lt;em>expression&lt;/em> ) {&#xA;&lt;em>cases&lt;/em>&#xA;}&#xA;&lt;/pre>&#xA;&#xA;@jls section 14.11&#xA;&#xA;@author Peter von der Ah&amp;eacute;&#xA;@author Jonathan Gibbons&#xA;@since 1.6&#xA;" annotatedElement="9f7b6b26-9b32-43c0-9261-b03e3ad1c8c1"/>
                <generalization xmi:id="8b1ec630-0664-46cf-afff-19c5e0331360" isSubstitutable="true" general="01dcdee9-f45c-4a81-aa85-6436a7479f34"/>
              </packagedElement>
              <packagedElement xmi:type="uml:Interface" xmi:id="d17af9a1-7c6c-482a-8cc4-1626e2c68ab7" name="SynchronizedTree" isAbstract="true">
                <ownedComment xmi:id="8a3ace57-5af7-4b70-833a-2f05d08deac7" body="A tree node for a 'synchronized' statement.&#xA;&#xA;For example:&#xA;&lt;pre>&#xA;synchronized ( &lt;em>expression&lt;/em> )&#xA;&lt;em>block&lt;/em>&#xA;&lt;/pre>&#xA;&#xA;@jls section 14.19&#xA;&#xA;@author Peter von der Ah&amp;eacute;&#xA;@author Jonathan Gibbons&#xA;@since 1.6&#xA;" annotatedElement="d17af9a1-7c6c-482a-8cc4-1626e2c68ab7"/>
                <generalization xmi:id="7647f72e-95fb-4110-8fdf-a12a8cd26dcc" isSubstitutable="true" general="01dcdee9-f45c-4a81-aa85-6436a7479f34"/>
              </packagedElement>
              <packagedElement xmi:type="uml:Interface" xmi:id="fcd544c5-7bfa-4ea1-b4fb-0e3d19ea2215" name="ThrowTree" isAbstract="true">
                <ownedComment xmi:id="87e91a0b-bea5-4d9f-97dd-4581d489c58a" body="A tree node for a 'throw' statement.&#xA;&#xA;For example:&#xA;&lt;pre>&#xA;throw &lt;em>expression&lt;/em>;&#xA;&lt;/pre>&#xA;&#xA;@jls section 14.18&#xA;&#xA;@author Peter von der Ah&amp;eacute;&#xA;@author Jonathan Gibbons&#xA;@since 1.6&#xA;" annotatedElement="fcd544c5-7bfa-4ea1-b4fb-0e3d19ea2215"/>
                <generalization xmi:id="af21980e-bbea-44bc-9c2f-8d4bb564e99e" isSubstitutable="true" general="01dcdee9-f45c-4a81-aa85-6436a7479f34"/>
              </packagedElement>
              <packagedElement xmi:type="uml:Interface" xmi:id="605a3649-eb18-4189-b393-9e836930c2f4" name="Tree" isAbstract="true">
                <ownedComment xmi:id="0e75b557-3464-4533-9c26-f896b8488b0d" body="Common interface for all nodes in an abstract syntax tree.&#xA;&#xA;&lt;p>&lt;b>WARNING:&lt;/b> This interface and its sub-interfaces are&#xA;subject to change as the Java&amp;trade; programming language evolves.&#xA;These interfaces are implemented by the JDK Java compiler (javac)&#xA;and should not be implemented either directly or indirectly by&#xA;other applications.&#xA;&#xA;@author Peter von der Ah&amp;eacute;&#xA;@author Jonathan Gibbons&#xA;&#xA;@since 1.6&#xA;" annotatedElement="605a3649-eb18-4189-b393-9e836930c2f4"/>
                <nestedClassifier xmi:type="uml:Class" xmi:id="3b157c7f-bf22-4f0d-a3ce-396262f325b5" name="Kind">
                  <ownedComment xmi:id="38401078-564c-4504-8bbf-ee6a382bbd3c" body="Enumerates all kinds of trees.&#xA;" annotatedElement="3b157c7f-bf22-4f0d-a3ce-396262f325b5"/>
                </nestedClassifier>
              </packagedElement>
              <packagedElement xmi:type="uml:Interface" xmi:id="5d7560e5-9fcd-4461-8c69-7c61604cd2c9" name="TreeVisitor" isAbstract="true">
                <ownedComment xmi:id="6882fdbe-4e81-41d0-be2b-5e9bc0b91b08" body="A visitor of trees, in the style of the visitor design pattern.&#xA;Classes implementing this interface are used to operate&#xA;on a tree when the kind of tree is unknown at compile time.&#xA;When a visitor is passed to an tree's {@link Tree#accept&#xA;accept} method, the &lt;tt>visit&lt;i>XYZ&lt;/i>&lt;/tt> method most applicable&#xA;to that tree is invoked.&#xA;&#xA;&lt;p> Classes implementing this interface may or may not throw a&#xA;{@code NullPointerException} if the additional parameter {@code p}&#xA;is {@code null}; see documentation of the implementing class for&#xA;details.&#xA;&#xA;&lt;p> &lt;b>WARNING:&lt;/b> It is possible that methods will be added to&#xA;this interface to accommodate new, currently unknown, language&#xA;structures added to future versions of the Java&amp;trade; programming&#xA;language.  Therefore, visitor classes directly implementing this&#xA;interface may be source incompatible with future versions of the&#xA;platform.&#xA;&#xA;@param &lt;R> the return type of this visitor's methods.  Use {@link&#xA;Void} for visitors that do not need to return results.&#xA;@param &lt;P> the type of the additional parameter to this visitor's&#xA;methods.  Use {@code Void} for visitors that do not need an&#xA;additional parameter.&#xA;&#xA;@author Peter von der Ah&amp;eacute;&#xA;@author Jonathan Gibbons&#xA;&#xA;@since 1.6&#xA;" annotatedElement="5d7560e5-9fcd-4461-8c69-7c61604cd2c9"/>
                <ownedTemplateSignature xmi:type="uml:RedefinableTemplateSignature" xmi:id="ed3a61f6-efd1-4946-8dcd-ef8808d79ebe" name="" visibility="public" parameter="739bcd3f-8ef6-46e2-860c-383c25431e79 f2741bef-fdea-4bac-aec9-e9e4de30e84b">
                  <ownedParameter xmi:type="uml:ClassifierTemplateParameter" xmi:id="739bcd3f-8ef6-46e2-860c-383c25431e79" parameteredElement="21b6728a-7c25-4e4a-bc13-6928939daf2d">
                    <ownedParameteredElement xmi:type="uml:Class" xmi:id="21b6728a-7c25-4e4a-bc13-6928939daf2d" name="R" templateParameter="739bcd3f-8ef6-46e2-860c-383c25431e79"/>
                  </ownedParameter>
                  <ownedParameter xmi:type="uml:ClassifierTemplateParameter" xmi:id="f2741bef-fdea-4bac-aec9-e9e4de30e84b" parameteredElement="493b2d31-6af8-4c3f-a2d2-061065e38ea5">
                    <ownedParameteredElement xmi:type="uml:Class" xmi:id="493b2d31-6af8-4c3f-a2d2-061065e38ea5" name="P" templateParameter="f2741bef-fdea-4bac-aec9-e9e4de30e84b"/>
                  </ownedParameter>
                </ownedTemplateSignature>
              </packagedElement>
              <packagedElement xmi:type="uml:Interface" xmi:id="4813d3ce-2dad-4647-b768-c4e5f9e8a0a1" name="TryTree" isAbstract="true">
                <ownedComment xmi:id="35615041-1597-4f41-b534-e30388deafc0" body="A tree node for a 'try' statement.&#xA;&#xA;For example:&#xA;&lt;pre>&#xA;try&#xA;&lt;em>block&lt;/em>&#xA;&lt;em>catches&lt;/em>&#xA;finally&#xA;&lt;em>finallyBlock&lt;/em>&#xA;&lt;/pre>&#xA;&#xA;@jls section 14.20&#xA;&#xA;@author Peter von der Ah&amp;eacute;&#xA;@author Jonathan Gibbons&#xA;@since 1.6&#xA;" annotatedElement="4813d3ce-2dad-4647-b768-c4e5f9e8a0a1"/>
                <generalization xmi:id="c1ba9e81-bc27-45e4-b9ca-0faa5b6db1cc" isSubstitutable="true" general="01dcdee9-f45c-4a81-aa85-6436a7479f34"/>
              </packagedElement>
              <packagedElement xmi:type="uml:Interface" xmi:id="b1664bab-b162-4f21-8e05-db020dbf1e23" name="TypeCastTree" isAbstract="true">
                <ownedComment xmi:id="bfc46116-fddc-4017-8ea4-e1f3b4ad1455" body="A tree node for a type cast expression.&#xA;&#xA;For example:&#xA;&lt;pre>&#xA;( &lt;em>type&lt;/em> ) &lt;em>expression&lt;/em>&#xA;&lt;/pre>&#xA;&#xA;@jls section 15.16&#xA;&#xA;@author Peter von der Ah&amp;eacute;&#xA;@author Jonathan Gibbons&#xA;@since 1.6&#xA;" annotatedElement="b1664bab-b162-4f21-8e05-db020dbf1e23"/>
                <generalization xmi:id="1486980f-7f31-4535-a488-0028099bb8cf" isSubstitutable="true" general="c8beae39-adea-4653-8097-bec110a62fc1"/>
              </packagedElement>
              <packagedElement xmi:type="uml:Interface" xmi:id="80b7490c-f710-4857-9ab0-000b8a270f23" name="TypeParameterTree" isAbstract="true">
                <ownedComment xmi:id="1013ffff-221c-4f45-a59a-2a16c034029d" body="A tree node for a type parameter.&#xA;&#xA;For example:&#xA;&lt;pre>&#xA;&lt;em>name&lt;/em>&#xA;&#xA;&lt;em>name&lt;/em> extends &lt;em>bounds&lt;/em>&#xA;&#xA;&lt;em>annotations&lt;/em> &lt;em>name&lt;/em>&#xA;&lt;/pre>&#xA;&#xA;@jls section 4.4&#xA;&#xA;@author Peter von der Ah&amp;eacute;&#xA;@author Jonathan Gibbons&#xA;@since 1.6&#xA;" annotatedElement="80b7490c-f710-4857-9ab0-000b8a270f23"/>
                <generalization xmi:id="f6e213b7-020f-4d9f-9689-98297d07892c" isSubstitutable="true" general="605a3649-eb18-4189-b393-9e836930c2f4"/>
              </packagedElement>
              <packagedElement xmi:type="uml:Interface" xmi:id="9de894e6-a062-4f89-92f5-a05e162e8fc8" name="UnaryTree" isAbstract="true">
                <ownedComment xmi:id="ef7425dd-7945-4d5f-ac3d-4ee27db4d934" body="A tree node for postfix and unary expressions.&#xA;Use {@link #getKind getKind} to determine the kind of operator.&#xA;&#xA;For example:&#xA;&lt;pre>&#xA;&lt;em>operator&lt;/em> &lt;em>expression&lt;/em>&#xA;&#xA;&lt;em>expression&lt;/em> &lt;em>operator&lt;/em>&#xA;&lt;/pre>&#xA;&#xA;@jls sections 15.14 and 15.15&#xA;&#xA;@author Peter von der Ah&amp;eacute;&#xA;@author Jonathan Gibbons&#xA;@since 1.6&#xA;" annotatedElement="9de894e6-a062-4f89-92f5-a05e162e8fc8"/>
                <generalization xmi:id="38fad1f6-b6cf-46f9-b603-0925880d8499" isSubstitutable="true" general="c8beae39-adea-4653-8097-bec110a62fc1"/>
              </packagedElement>
              <packagedElement xmi:type="uml:Interface" xmi:id="704ce56c-0431-4d4c-ae2c-ec26017af111" name="UnionTypeTree" isAbstract="true">
                <ownedComment xmi:id="955df2ec-5f31-4f6f-83e2-948c8780ea68" body="A tree node for a union type expression in a multicatch var declaration.&#xA;&#xA;@author Maurizio Cimadamore&#xA;&#xA;@since 1.7&#xA;" annotatedElement="704ce56c-0431-4d4c-ae2c-ec26017af111"/>
                <generalization xmi:id="fad3e314-d97e-44bb-a59d-cf8f9caafdf2" isSubstitutable="true" general="605a3649-eb18-4189-b393-9e836930c2f4"/>
              </packagedElement>
              <packagedElement xmi:type="uml:Interface" xmi:id="6218d30d-b735-4f91-b0dc-e592cf119776" name="VariableTree" isAbstract="true">
                <ownedComment xmi:id="d55b29a9-33a2-4484-acb4-c3fd30e3bbb0" body="A tree node for a variable declaration.&#xA;&#xA;For example:&#xA;&lt;pre>&#xA;&lt;em>modifiers&lt;/em> &lt;em>type&lt;/em> &lt;em>name&lt;/em> &lt;em>initializer&lt;/em> ;&#xA;&lt;em>modifiers&lt;/em> &lt;em>type&lt;/em> &lt;em>qualified-name&lt;/em>.this&#xA;&lt;/pre>&#xA;&#xA;@jls sections 8.3 and 14.4&#xA;&#xA;@author Peter von der Ah&amp;eacute;&#xA;@author Jonathan Gibbons&#xA;@since 1.6&#xA;" annotatedElement="6218d30d-b735-4f91-b0dc-e592cf119776"/>
                <generalization xmi:id="fc5e9aab-d01f-40c2-983a-4ea29bea0c28" isSubstitutable="true" general="01dcdee9-f45c-4a81-aa85-6436a7479f34"/>
              </packagedElement>
              <packagedElement xmi:type="uml:Interface" xmi:id="b7ed95be-0368-462f-96c1-a2724a36a848" name="WhileLoopTree" isAbstract="true">
                <ownedComment xmi:id="460edcf1-c516-4928-a97c-e479d3b9a6d2" body="A tree node for a 'while' loop statement.&#xA;&#xA;For example:&#xA;&lt;pre>&#xA;while ( &lt;em>condition&lt;/em> )&#xA;&lt;em>statement&lt;/em>&#xA;&lt;/pre>&#xA;&#xA;&#xA;@jls section 14.12&#xA;&#xA;@author Peter von der Ah&amp;eacute;&#xA;@author Jonathan Gibbons&#xA;@since 1.6&#xA;" annotatedElement="b7ed95be-0368-462f-96c1-a2724a36a848"/>
                <generalization xmi:id="f4890aac-20dc-4dc3-86d9-b65933ee8547" isSubstitutable="true" general="01dcdee9-f45c-4a81-aa85-6436a7479f34"/>
              </packagedElement>
              <packagedElement xmi:type="uml:Interface" xmi:id="e0f357a3-1766-47eb-ac33-223db5855feb" name="WildcardTree" isAbstract="true">
                <ownedComment xmi:id="e31f7c39-3625-47f4-a604-5540e1e77c6d" body="A tree node for a wildcard type argument.&#xA;Use {@link #getKind getKind} to determine the kind of bound.&#xA;&#xA;For example:&#xA;&lt;pre>&#xA;?&#xA;&#xA;? extends &lt;em>bound&lt;/em>&#xA;&#xA;? super &lt;em>bound&lt;/em>&#xA;&lt;/pre>&#xA;&#xA;@jls section 4.5.1&#xA;&#xA;@author Peter von der Ah&amp;eacute;&#xA;@author Jonathan Gibbons&#xA;@since 1.6&#xA;" annotatedElement="e0f357a3-1766-47eb-ac33-223db5855feb"/>
                <generalization xmi:id="b82da9ed-2391-4c1f-9eaf-64bca0d2ebb2" isSubstitutable="true" general="605a3649-eb18-4189-b393-9e836930c2f4"/>
