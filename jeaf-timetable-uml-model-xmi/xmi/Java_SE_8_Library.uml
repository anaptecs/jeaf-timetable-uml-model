              <generalization xmi:id="7760c5b3-f27e-472f-89dd-6b01185d41db" isSubstitutable="true" general="b38468cc-c261-4f52-86ea-658766759ede"/>
            </packagedElement>
            <packagedElement xmi:type="uml:Interface" xmi:id="52e26c97-2e5f-4a11-9479-894b7a0f11d3" name="IdAssignmentPolicyOperations" isAbstract="true">
              <ownedComment xmi:id="a5168c58-f3c6-421b-af81-e14ff51b5df8" body="IdAssignmentPolicy specifies whether Object Ids in&#xA;the created POA are generated by the application or&#xA;by the ORB. The default is SYSTEM_ID.&#xA;" annotatedElement="52e26c97-2e5f-4a11-9479-894b7a0f11d3"/>
              <generalization xmi:id="f2ba6d2a-73c7-4f44-9f1e-79394a91c896" isSubstitutable="true" general="a4b9f0a6-546e-4245-8d6d-26133984a5a5"/>
            </packagedElement>
            <packagedElement xmi:type="uml:Class" xmi:id="5d822db0-75de-498c-bb3d-3d48cc215f7c" name="IdAssignmentPolicyValue" clientDependency="7e8bba55-7220-44db-9254-f24bc5652a7d">
              <ownedComment xmi:id="48aef73e-b832-496f-adb7-da90191d6951" body="The IdAssignmentPolicyValue can have the following&#xA;values. USER_ID - Objects created with that POA are&#xA;assigned Object Ids only by the application.&#xA;SYSTEM_ID - Objects created with that POA are&#xA;assigned Object Ids only by the POA. If the POA also&#xA;has the PERSISTENT policy, assigned Object Ids must&#xA;be unique across all instantiations of the same POA.&#xA;" annotatedElement="5d822db0-75de-498c-bb3d-3d48cc215f7c"/>
              <interfaceRealization xmi:id="7e8bba55-7220-44db-9254-f24bc5652a7d" name="" supplier="b38468cc-c261-4f52-86ea-658766759ede" client="5d822db0-75de-498c-bb3d-3d48cc215f7c" contract="b38468cc-c261-4f52-86ea-658766759ede"/>
            </packagedElement>
            <packagedElement xmi:type="uml:Interface" xmi:id="7a75e849-e608-4fdc-bfe1-b70c250711d4" name="IdUniquenessPolicy" isAbstract="true">
              <ownedComment xmi:id="212de9ce-d31d-45a6-9db4-e4cd87f9825a" body="The IdUniquenessPolicy specifies whether the servants&#xA;activated in the created POA must have unique object i&#xA;identities. The default is UNIQUE_ID.&#xA;" annotatedElement="7a75e849-e608-4fdc-bfe1-b70c250711d4"/>
              <generalization xmi:id="42ca4dc8-0ad7-4a6c-adf3-037b6c018bd4" isSubstitutable="true" general="4f710d64-ff8e-48b3-b8bb-5b8828a15245"/>
              <generalization xmi:id="b883be5f-e104-467f-9843-c0ff08808937" isSubstitutable="true" general="ee833f56-d6e4-40a7-8139-27f06ad40de0"/>
              <generalization xmi:id="2dc43af3-a401-4a27-8611-0e2a92f9a459" isSubstitutable="true" general="b38468cc-c261-4f52-86ea-658766759ede"/>
            </packagedElement>
            <packagedElement xmi:type="uml:Interface" xmi:id="4f710d64-ff8e-48b3-b8bb-5b8828a15245" name="IdUniquenessPolicyOperations" isAbstract="true">
              <ownedComment xmi:id="4e12244d-7eed-4d71-acac-cb99a4cd984c" body="The IdUniquenessPolicy specifies whether the servants&#xA;activated in the created POA must have unique object i&#xA;identities. The default is UNIQUE_ID.&#xA;" annotatedElement="4f710d64-ff8e-48b3-b8bb-5b8828a15245"/>
              <generalization xmi:id="a4235c56-0133-4ef9-b157-723525b35623" isSubstitutable="true" general="a4b9f0a6-546e-4245-8d6d-26133984a5a5"/>
            </packagedElement>
            <packagedElement xmi:type="uml:Class" xmi:id="9f40eb88-32f6-4cb2-8955-06e9055fae74" name="IdUniquenessPolicyValue" clientDependency="b72aabaf-cfa3-4834-98ab-1d82c0264c55">
              <ownedComment xmi:id="23dbd857-62fd-42fd-8599-a6b7402147c4" body="IdUniquenessPolicyValue can have the following values.&#xA;UNIQUE_ID - Servants activated with that POA support&#xA;exactly one Object Id.  MULTIPLE_ID - a servant&#xA;activated with that POA may support one or more&#xA;Object Ids.&#xA;" annotatedElement="9f40eb88-32f6-4cb2-8955-06e9055fae74"/>
              <interfaceRealization xmi:id="b72aabaf-cfa3-4834-98ab-1d82c0264c55" name="" supplier="b38468cc-c261-4f52-86ea-658766759ede" client="9f40eb88-32f6-4cb2-8955-06e9055fae74" contract="b38468cc-c261-4f52-86ea-658766759ede"/>
