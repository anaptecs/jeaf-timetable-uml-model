                <interfaceRealization xmi:id="d834cb80-32c3-4f95-ab0f-4be855d54327" name="" supplier="351d738c-b38b-49d3-b4b5-e99e202d16ba" client="c60d4e3b-3d8b-48ad-b08e-72f4621a4eda" contract="351d738c-b38b-49d3-b4b5-e99e202d16ba"/>
