                      <ownedComment xmi:id="f5c78eb0-f8d5-486b-8a3c-296c3c16b138" body="IOR - Bitwise OR int&#xA;&lt;PRE>Stack: ..., value1, value2 -&amp;gt; ..., result&lt;/PRE>&#xA;&#xA;@author  &lt;A HREF=&quot;mailto:markus.dahm@berlin.de&quot;>M. Dahm&lt;/A>&#xA;" annotatedElement="d3a3782b-58e0-44a5-8707-98351f2bd0f5"/>
