                </ownedParameter>
              </ownedTemplateSignature>
            </packagedElement>
            <packagedElement xmi:type="uml:Interface" xmi:id="69720802-1f8e-4f94-8c07-c77720487c21" name="Supplier" isAbstract="true">
              <ownedComment xmi:id="e44d4222-b7da-4741-a213-045dc9b283c9" body="Represents a supplier of results.&#xA;&#xA;&lt;p>There is no requirement that a new or distinct result be returned each&#xA;time the supplier is invoked.&#xA;&#xA;&lt;p>This is a &lt;a href=&quot;package-summary.html&quot;>functional interface&lt;/a>&#xA;whose functional method is {@link #get()}.&#xA;&#xA;@param &lt;T> the type of results supplied by this supplier&#xA;&#xA;@since 1.8&#xA;" annotatedElement="69720802-1f8e-4f94-8c07-c77720487c21"/>
              <ownedTemplateSignature xmi:type="uml:RedefinableTemplateSignature" xmi:id="c231d33d-cf2f-45e3-be24-cd9e763bd189" name="" visibility="public" parameter="fa062c9a-bab4-4fba-9d35-2c32a7005897">
