              </packagedElement>
              <packagedElement xmi:type="uml:Class" xmi:id="54d14a35-d2b2-4cdc-b1a5-963ceac2cf2a" name="UnsupportedCallbackException">
                <ownedComment xmi:id="a8c30e7d-9d6e-491d-aa06-9a3e88733627" body="Signals that a {@code CallbackHandler} does not&#xA;recognize a particular {@code Callback}.&#xA;&#xA;" annotatedElement="54d14a35-d2b2-4cdc-b1a5-963ceac2cf2a"/>
                <generalization xmi:id="5d105d67-10a5-4c33-b9d1-bcd5f91fb151" isSubstitutable="true" general="fbf790b8-e2bc-40b1-8105-00e11a20c000"/>
              </packagedElement>
