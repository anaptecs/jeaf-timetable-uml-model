                  </ownedParameter>
                </ownedTemplateSignature>
                <generalization xmi:id="b3685342-2dea-49da-a2c1-c8026012aa4c" isSubstitutable="true" general="b94a5dcb-dc17-4b22-916d-6fd9fa77385d"/>
                <interfaceRealization xmi:id="331dcf5b-8a27-4434-8b13-7dece9cb322c" name="" supplier="41f4a654-a713-47bf-a391-e112be100ec5" client="fbd738a9-29f3-4916-867e-d18970b3ca35" contract="41f4a654-a713-47bf-a391-e112be100ec5"/>
              </nestedClassifier>
              <nestedClassifier xmi:type="uml:Class" xmi:id="67b51ed1-92b5-4b17-a66d-3a84c760af6d" name="ClassSet" visibility="private">
                <ownedComment xmi:id="87994532-5060-401b-a466-3ed0affe9531" body="This class implements a {@code Set} which returns only&#xA;members that are an instance of a specified Class.&#xA;" annotatedElement="67b51ed1-92b5-4b17-a66d-3a84c760af6d"/>
                <ownedTemplateSignature xmi:type="uml:RedefinableTemplateSignature" xmi:id="30e19d79-177d-423a-aaba-74190db992ef" name="" visibility="public" parameter="5a1f3fb2-af64-4a21-83d6-156a086f23bd">
                  <ownedParameter xmi:type="uml:ClassifierTemplateParameter" xmi:id="5a1f3fb2-af64-4a21-83d6-156a086f23bd" parameteredElement="3b5112f2-a3a9-4246-8cbe-791bedd12395">
