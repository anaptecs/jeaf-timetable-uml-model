                <ownedComment xmi:id="c4848683-bccb-4754-a8c8-5554d364da9a" body="The &lt;code>Float&lt;/code> class defines a point specified in float&#xA;precision.&#xA;@since 1.2&#xA;" annotatedElement="3dfce6f6-e7ce-406b-9cac-805b0ad37483"/>
                <generalization xmi:id="f13bb9c4-cd39-463b-a088-cdde0599bcdb" isSubstitutable="true" general="21dccb72-ac6c-4711-9017-705b48d2e19f"/>
