            <packagedElement xmi:type="uml:Interface" xmi:id="948e41f1-f1eb-4707-9087-5d779692209a" name="DynArray" isAbstract="true">
              <ownedComment xmi:id="3da3dae6-08ea-4b93-beaa-5898bcc3dfcf" body="DynArray objects support the manipulation of IDL arrays.&#xA;Note that the dimension of the array is contained in the TypeCode which is accessible&#xA;through the type attribute. It can also be obtained by calling the component_count operation.&#xA;" annotatedElement="948e41f1-f1eb-4707-9087-5d779692209a"/>
              <generalization xmi:id="e7c97652-7d12-41da-a254-419841246df0" isSubstitutable="true" general="bcd735b5-36ed-4009-a4ac-776c335859dc"/>
