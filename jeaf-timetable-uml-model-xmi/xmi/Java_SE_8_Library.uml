              <packagedElement xmi:type="uml:Class" xmi:id="43b451ed-d0fb-4edf-a13c-a5d57f90c6a0" name="Dictionary&lt;Integer, StyleDefiningDestination>">
                <templateBinding xmi:id="c615ef44-4b4e-4ad9-a515-c1aeb9ab3a56" signature="2a15466a-90ca-4dae-8df5-cece7d497428">
