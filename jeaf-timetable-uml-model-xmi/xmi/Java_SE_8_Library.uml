                  <packagedElement xmi:type="uml:Class" xmi:id="525941ff-ed2a-455a-8835-596ecb8ade3d" name="ObjectReferenceFactoryImpl" clientDependency="0d51ea14-f8a7-46c4-bb87-ebde2db85d26 b3a8ff7c-36a8-4713-86cf-b40699a065a4">
                    <ownedComment xmi:id="91beb30e-4904-4738-8c51-d66cdd297020" body="This is an implementation of the ObjectReferenceFactory abstract value&#xA;type defined by the portable interceptors IDL.&#xA;Note that this is a direct Java implementation&#xA;of the abstract value type: there is no stateful value type defined in IDL,&#xA;since defining the state in IDL is awkward and inefficient.  The best way&#xA;to define the state is to use internal data structures that can be written&#xA;to and read from CORBA streams.&#xA;" annotatedElement="525941ff-ed2a-455a-8835-596ecb8ade3d"/>
                    <generalization xmi:id="052ff038-41bf-4b5a-a481-0402f00fbea0" isSubstitutable="true" general="47cef2e7-f476-4c52-8777-adf340230ff5"/>
