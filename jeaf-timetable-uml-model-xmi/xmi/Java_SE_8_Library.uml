            </packagedElement>
            <packagedElement xmi:type="uml:Interface" xmi:id="d221a1d7-3e81-4c58-91ca-3f954c49bedd" name="ServantRetentionPolicyOperations" isAbstract="true">
              <ownedComment xmi:id="10cbdbbc-33f5-4bae-bc45-fa24516c9608" body="This policy specifies whether the created POA retains&#xA;active servants in an Active Object Map.&#xA;" annotatedElement="d221a1d7-3e81-4c58-91ca-3f954c49bedd"/>
              <generalization xmi:id="83493c8a-6736-45ad-aa99-63daf6778bcc" isSubstitutable="true" general="a4b9f0a6-546e-4245-8d6d-26133984a5a5"/>
            </packagedElement>
            <packagedElement xmi:type="uml:Class" xmi:id="cfb05bac-a5b2-45f2-925f-fe736cfac32b" name="ServantRetentionPolicyValue" clientDependency="ec4fa223-f4ed-428e-ba35-acfd4d243fd0">
              <ownedComment xmi:id="6445da51-bebe-4ac1-bc21-85af770f2281" body="ServantRetentionPolicyValue can have the following&#xA;values. RETAIN - to indicate that the POA will retain&#xA;active servants in its Active Object Map.&#xA;NON_RETAIN - to indicate Servants are not retained by&#xA;the POA. If no ServantRetentionPolicy is specified at&#xA;POA creation, the default is RETAIN.&#xA;" annotatedElement="cfb05bac-a5b2-45f2-925f-fe736cfac32b"/>
              <interfaceRealization xmi:id="ec4fa223-f4ed-428e-ba35-acfd4d243fd0" name="" supplier="b38468cc-c261-4f52-86ea-658766759ede" client="cfb05bac-a5b2-45f2-925f-fe736cfac32b" contract="b38468cc-c261-4f52-86ea-658766759ede"/>
            </packagedElement>
