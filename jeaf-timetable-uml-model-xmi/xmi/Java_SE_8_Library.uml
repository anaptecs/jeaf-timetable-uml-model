              <interfaceRealization xmi:id="58b1f7dd-09e4-4be6-854f-78c386dffc42" name="" supplier="c1a2002b-5dae-4e1d-936a-929503961129" client="069676c3-642d-4510-b23b-55a21f5f02d0" contract="c1a2002b-5dae-4e1d-936a-929503961129"/>
            </packagedElement>
            <packagedElement xmi:type="uml:Class" xmi:id="c5bfb3d4-b696-4776-be20-412b22e362a3" name="StandardOpenOption" clientDependency="44026b1f-a14d-4a47-89be-395f34d8c6d3">
              <ownedComment xmi:id="f2343894-b5bb-4788-9f2d-4591058b93c2" body="Defines the standard open options.&#xA;&#xA;@since 1.7&#xA;" annotatedElement="c5bfb3d4-b696-4776-be20-412b22e362a3"/>
