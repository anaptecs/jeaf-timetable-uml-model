            <packagedElement xmi:type="uml:Class" xmi:id="d289e0ee-8dfb-4924-86cc-133f42c150c4" name="AtomicReferenceFieldUpdater&lt;SelectionKey, Object>">
              <templateBinding xmi:id="de12fc7d-ff38-4e32-bbcd-43814dc4e522" signature="4a95dcc4-8b44-4c51-b131-6757871e193d">
                <parameterSubstitution xmi:id="7297b65a-89b8-4c5b-80f7-eb0086ea1b65" formal="a2dbacc7-fc31-49de-aae0-393c5c4111da" actual="efc47837-a79b-4f05-9880-cdd32954f307"/>
