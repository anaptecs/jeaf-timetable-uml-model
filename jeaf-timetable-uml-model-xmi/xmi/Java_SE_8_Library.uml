            <packagedElement xmi:type="uml:Interface" xmi:id="f24060ce-77de-4375-bb8c-6dda981ab44c" name="ServantManager" isAbstract="true">
              <ownedComment xmi:id="a12b44f4-f27c-4874-9f25-975f83d8d830" body="A servant manager supplies a POA with the ability&#xA;to activate objects on demand when the POA receives&#xA;a request targeted at an inactive object. A servant&#xA;manager is registered with a POA as a callback object,&#xA;to be invoked by the POA when necessary.&#xA;ServantManagers can either be ServantActivators or&#xA;ServantLocators. A ServantManager object must be&#xA;local to the process containing the POA objects&#xA;it is registered with.&#xA;" annotatedElement="f24060ce-77de-4375-bb8c-6dda981ab44c"/>
              <generalization xmi:id="a0e5c188-8c28-42ec-94f7-1937610c0782" isSubstitutable="true" general="9c093c11-8be6-4ac0-a688-54c4ab4546e8"/>
              <generalization xmi:id="dd2ebc58-7e1a-4cf9-a540-ae2759444987" isSubstitutable="true" general="b9b8a38d-9489-45b5-8efa-c474c2cb87d3"/>
              <generalization xmi:id="473c36ac-bbc7-4b7e-82af-aaf4b24b6d12" isSubstitutable="true" general="b38468cc-c261-4f52-86ea-658766759ede"/>
            </packagedElement>
            <packagedElement xmi:type="uml:Interface" xmi:id="9c093c11-8be6-4ac0-a688-54c4ab4546e8" name="ServantManagerOperations" isAbstract="true">
              <ownedComment xmi:id="d318a861-4430-47ca-86a6-172ce45ee925" body="A servant manager supplies a POA with the ability&#xA;to activate objects on demand when the POA receives&#xA;a request targeted at an inactive object. A servant&#xA;manager is registered with a POA as a callback object,&#xA;to be invoked by the POA when necessary.&#xA;ServantManagers can either be ServantActivators or&#xA;ServantLocators. A ServantManager object must be&#xA;local to the process containing the POA objects&#xA;it is registered with.&#xA;" annotatedElement="9c093c11-8be6-4ac0-a688-54c4ab4546e8"/>
            </packagedElement>
            <packagedElement xmi:type="uml:Interface" xmi:id="4cf2fe7c-df59-474c-9649-9846c95a86c9" name="ServantRetentionPolicy" isAbstract="true">
              <ownedComment xmi:id="53d58e77-a42d-49a5-8e92-73fc4b1aa29a" body="This policy specifies whether the created POA retains&#xA;active servants in an Active Object Map.&#xA;" annotatedElement="4cf2fe7c-df59-474c-9649-9846c95a86c9"/>
              <generalization xmi:id="8fc01c70-e6f5-44c9-b25b-0811dda51d8d" isSubstitutable="true" general="d221a1d7-3e81-4c58-91ca-3f954c49bedd"/>
