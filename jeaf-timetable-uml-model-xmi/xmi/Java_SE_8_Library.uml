                  <ownedParameter xmi:type="uml:ClassifierTemplateParameter" xmi:id="e5b7b3ed-6a7d-4d40-8a0e-fc3b75f5daf3" parameteredElement="8ee55979-56d2-4d5f-b303-7422dc67665a">
