              <packagedElement xmi:type="uml:Interface" xmi:id="9c875a3c-adee-4a03-9b98-6ddd5c19a000" name="FileAttribute&lt;Set&lt;PosixFilePermission>>">
                <templateBinding xmi:id="b02720e2-8c0f-48c5-92d6-46dcb9d55295" signature="da4ba38b-296e-4037-96a4-e8b7f12a7dc1">
                  <parameterSubstitution xmi:id="088a8a55-adc3-474d-bb38-465400d8023a" formal="29fc8c19-e236-4331-b2e7-4d1c1a46693b" actual="995a4cb8-cc39-426d-bab7-350a5f307833"/>
                </templateBinding>
