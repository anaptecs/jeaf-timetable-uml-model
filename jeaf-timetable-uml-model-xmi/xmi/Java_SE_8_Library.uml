                <nestedClassifier xmi:type="uml:Class" xmi:id="7dbb2fce-29e8-4780-a3e2-1fec0f6414be" name="TreeIncrementAction">
                  <ownedComment xmi:id="bbe29971-4a7d-4bb2-bd4d-890b484b4c0b" body="TreeIncrementAction is used to handle up/down actions.  Selection&#xA;is moved up or down based on direction.&#xA;" annotatedElement="7dbb2fce-29e8-4780-a3e2-1fec0f6414be"/>
                  <generalization xmi:id="631df561-5f9b-4eaf-9aa7-c9ba2fbb2f80" isSubstitutable="true" general="37db1b87-b22d-45bf-b084-60ec1e3df251"/>
