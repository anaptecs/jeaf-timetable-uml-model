            <nestedClassifier xmi:type="uml:Class" xmi:id="40fdebc5-0259-4b86-87ee-d990a58b0764" name="AccessibleAWTComponent" visibility="protected" clientDependency="dde88048-8efb-4e77-a468-ffe3058b330e 1cb12ca0-4bb6-4f92-8606-8ae9f63288ab" isAbstract="true">
              <ownedComment xmi:id="c58d263b-970a-4f53-abe7-878c41380adf" body="Inner class of Component used to provide default support for&#xA;accessibility.  This class is not meant to be used directly by&#xA;application developers, but is instead meant only to be&#xA;subclassed by component developers.&#xA;&lt;p>&#xA;The class used to obtain the accessible role for this object.&#xA;@since 1.3&#xA;" annotatedElement="40fdebc5-0259-4b86-87ee-d990a58b0764"/>
              <generalization xmi:id="309e8a2b-942a-491f-932c-22995d8b68ae" isSubstitutable="true" general="d5185061-7428-4f28-b8d2-a795389b470e"/>
