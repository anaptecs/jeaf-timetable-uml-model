            <packagedElement xmi:type="uml:Interface" xmi:id="d76261c2-032f-4ced-9f51-ca7baa177b53" name="RunnableScheduledFuture" isAbstract="true">
              <ownedComment xmi:id="402e80cf-4db3-424a-9cdf-817cef60fd21" body="A {@link ScheduledFuture} that is {@link Runnable}. Successful&#xA;execution of the {@code run} method causes completion of the&#xA;{@code Future} and allows access to its results.&#xA;@see FutureTask&#xA;@see Executor&#xA;@since 1.6&#xA;@author Doug Lea&#xA;@param &lt;V> The result type returned by this Future's {@code get} method&#xA;" annotatedElement="d76261c2-032f-4ced-9f51-ca7baa177b53"/>
              <ownedTemplateSignature xmi:type="uml:RedefinableTemplateSignature" xmi:id="f0c74f9d-5239-4c75-b407-42452743ba6a" name="" visibility="public" parameter="61e6c905-0fed-4090-8cdb-a719aaeeaf18">
                <ownedParameter xmi:type="uml:ClassifierTemplateParameter" xmi:id="61e6c905-0fed-4090-8cdb-a719aaeeaf18" parameteredElement="2d1a9d12-1a28-4b4e-9d38-76d96e95b950">
                  <ownedParameteredElement xmi:type="uml:Class" xmi:id="2d1a9d12-1a28-4b4e-9d38-76d96e95b950" name="V" templateParameter="61e6c905-0fed-4090-8cdb-a719aaeeaf18"/>
