              </ownedParameter>
            </ownedTemplateSignature>
            <generalization xmi:id="5d6aaab5-1458-4ee6-9285-7a4c4dcf62ed" isSubstitutable="true" general="b94a5dcb-dc17-4b22-916d-6fd9fa77385d"/>
            <interfaceRealization xmi:id="e3d27ad3-f5bd-4f0b-831b-28308e681055" name="" supplier="99a7362b-bfaf-4dfc-a102-9599d2c7d408" client="403c16fa-74df-4d88-bad8-f4e7cafe0cb0" contract="99a7362b-bfaf-4dfc-a102-9599d2c7d408"/>
