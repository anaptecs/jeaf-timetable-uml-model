              <nestedClassifier xmi:type="uml:Class" xmi:id="550fedfe-9a62-4e28-9858-6f72ec8a97ca" name="StyleContextChangeHandler" visibility="package">
                <ownedComment xmi:id="f89d98bf-8d40-44ef-b460-4dc932f1dfaa" body="Added to the StyleContext. When the StyleContext changes, this invokes&#xA;&lt;code>updateStylesListeningTo&lt;/code>.&#xA;" annotatedElement="550fedfe-9a62-4e28-9858-6f72ec8a97ca"/>
