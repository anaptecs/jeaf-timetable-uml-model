                      <ownedComment xmi:id="123a73f0-d09d-4435-923a-049d0f679312" body="This class represents the field info structure, i.e., the representation&#xA;for a variable in the class. See JVM specification for details.&#xA;&#xA;@author  &lt;A HREF=&quot;mailto:markus.dahm@berlin.de&quot;>M. Dahm&lt;/A>&#xA;" annotatedElement="b2d38a6b-a9a2-4b90-b7e6-fcacd0ed8ade"/>
