              <nestedClassifier xmi:type="uml:Class" xmi:id="7e90d078-1b4d-4f9b-a6ac-517904225bf6" name="LayerPainter" clientDependency="b19bd791-b53f-4caf-95c9-0ff7a62a8e0d" isAbstract="true">
