                    <packagedElement xmi:type="uml:Interface" xmi:id="e8f48000-2ba1-4a5e-9c2c-66dd1207180c" name="ItemPSVI" isAbstract="true">
                      <ownedComment xmi:id="a6a66b93-f505-4c03-a8c0-b0f988197826" body="Represents an abstract PSVI item for an element or an attribute&#xA;information item.&#xA;" annotatedElement="e8f48000-2ba1-4a5e-9c2c-66dd1207180c"/>
                    </packagedElement>
                    <packagedElement xmi:type="uml:Interface" xmi:id="994b7144-7bf3-4ab6-a473-5ee785d3036f" name="LSInputList" isAbstract="true">
                      <ownedComment xmi:id="bd9c3638-250c-4d7b-adbe-11b02618e292" body="The &lt;code>LSInputList&lt;/code> interface provides the abstraction of an&#xA;ordered collection of &lt;code>LSInput&lt;/code>s, without defining or&#xA;constraining how this collection is implemented.&#xA;" annotatedElement="994b7144-7bf3-4ab6-a473-5ee785d3036f"/>
                      <generalization xmi:id="a554691d-9469-4d5c-9b4c-dada6a4ac754" isSubstitutable="true" general="ff2480c1-357b-4498-9fd4-9f5ce08413c9"/>
                    </packagedElement>
                    <packagedElement xmi:type="uml:Interface" xmi:id="1eb7f2a0-4d55-4bc4-ac2e-f9a53fa8047a" name="PSVIProvider" isAbstract="true">
                      <ownedComment xmi:id="c4edaf41-6378-4a94-91c5-11d539819303" body="This interface provides access to the post schema validation infoset for an&#xA;API that provides a streaming document infoset, such as SAX, XNI, and&#xA;others.&#xA;&lt;p>For implementations that would like to provide access to the PSVI in a&#xA;streaming model, a parser object should also implement the&#xA;&lt;code>PSVIProvider&lt;/code> interface. Within the scope of the methods&#xA;handling the start and end of an element, applications may use the&#xA;&lt;code>PSVIProvider&lt;/code> to retrieve the PSVI related to the element and&#xA;its attributes.&#xA;" annotatedElement="1eb7f2a0-4d55-4bc4-ac2e-f9a53fa8047a"/>
                    </packagedElement>
                    <packagedElement xmi:type="uml:Interface" xmi:id="16d4313e-fa47-403f-be0b-34b43867f1b7" name="ShortList" isAbstract="true">
                      <ownedComment xmi:id="5db51394-c3ef-435d-9456-005e6034cb28" body="The &lt;code>ShortList&lt;/code> is an immutable ordered collection of&#xA;&lt;code>unsigned short&lt;/code>.&#xA;" annotatedElement="16d4313e-fa47-403f-be0b-34b43867f1b7"/>
                      <generalization xmi:id="b15601b5-c43c-4619-aded-5dcac482bc1e" isSubstitutable="true" general="ff2480c1-357b-4498-9fd4-9f5ce08413c9"/>
                    </packagedElement>
                    <packagedElement xmi:type="uml:Interface" xmi:id="e2005b5d-bc15-43ce-adb3-1fa3e14dd139" name="StringList" isAbstract="true">
                      <ownedComment xmi:id="bb6d473d-2d84-4bf0-b899-807024289280" body="The &lt;code>StringList&lt;/code> is an immutable ordered collection of&#xA;&lt;code>GenericString&lt;/code>.&#xA;" annotatedElement="e2005b5d-bc15-43ce-adb3-1fa3e14dd139"/>
                      <generalization xmi:id="20194a4f-156a-4f74-a06a-dde38b250175" isSubstitutable="true" general="ff2480c1-357b-4498-9fd4-9f5ce08413c9"/>
                    </packagedElement>
                    <packagedElement xmi:type="uml:Interface" xmi:id="0d4bf4da-d573-4c50-99d4-92d2344e6d73" name="XSAnnotation" isAbstract="true">
                      <ownedComment xmi:id="b51a5714-8511-47dc-aeab-60597548df5f" body="This interface represents the Annotation schema component.&#xA;" annotatedElement="0d4bf4da-d573-4c50-99d4-92d2344e6d73"/>
                      <generalization xmi:id="1ac2c871-73cf-40e3-9bf9-f3c118bebed0" isSubstitutable="true" general="79baa86a-eb91-4006-ac05-da9fc385574c"/>
                    </packagedElement>
                    <packagedElement xmi:type="uml:Interface" xmi:id="4f3a052d-012e-45ff-a975-fba6c0130bcb" name="XSAttributeDeclaration" isAbstract="true">
                      <ownedComment xmi:id="d6ecde1d-e178-4f87-8a73-04874161775e" body="The interface represents the Attribute Declaration schema component.&#xA;" annotatedElement="4f3a052d-012e-45ff-a975-fba6c0130bcb"/>
                      <generalization xmi:id="dbba78d6-c00c-4bb3-9d27-4f110f0d372c" isSubstitutable="true" general="79baa86a-eb91-4006-ac05-da9fc385574c"/>
                    </packagedElement>
                    <packagedElement xmi:type="uml:Interface" xmi:id="f8efe266-d8de-4090-9dfa-aa16ee874955" name="XSAttributeGroupDefinition" isAbstract="true">
                      <ownedComment xmi:id="2c8596ef-6b82-41db-b751-6813aed53e20" body="This interface represents the Attribute Group Definition schema component.&#xA;" annotatedElement="f8efe266-d8de-4090-9dfa-aa16ee874955"/>
                      <generalization xmi:id="9521dd04-bb73-455f-a2a0-2cd0660e4c6c" isSubstitutable="true" general="79baa86a-eb91-4006-ac05-da9fc385574c"/>
                    </packagedElement>
                    <packagedElement xmi:type="uml:Interface" xmi:id="8cd846cc-3aab-4d7f-bb87-736a2a5dc36f" name="XSAttributeUse" isAbstract="true">
                      <ownedComment xmi:id="04e642da-7259-4a3c-be16-ac0ea4b514c3" body="This interface represents the Attribute Use schema component.&#xA;" annotatedElement="8cd846cc-3aab-4d7f-bb87-736a2a5dc36f"/>
                      <generalization xmi:id="ee88f315-6330-4cc3-9441-11f732bc2ec2" isSubstitutable="true" general="79baa86a-eb91-4006-ac05-da9fc385574c"/>
                    </packagedElement>
                    <packagedElement xmi:type="uml:Interface" xmi:id="007b687d-51db-41c7-9591-3a967630b24c" name="XSComplexTypeDefinition" isAbstract="true">
                      <ownedComment xmi:id="cd85eab8-5f90-4798-a9d4-d7de2db46fe5" body="This interface represents the Complex Type Definition schema component.&#xA;" annotatedElement="007b687d-51db-41c7-9591-3a967630b24c"/>
                      <generalization xmi:id="1c80f434-709a-41ab-a827-7462b0d84386" isSubstitutable="true" general="3088c4cc-6bb8-41e9-9dfb-54fc7b6b4a16"/>
                    </packagedElement>
                    <packagedElement xmi:type="uml:Interface" xmi:id="4da09e46-795f-4dbc-8972-5c56283aaa71" name="XSConstants" isAbstract="true">
                      <ownedComment xmi:id="49da53ea-e344-4b0c-b4bd-27b7c2d65288" body="This interface defines constants used by this specification.&#xA;" annotatedElement="4da09e46-795f-4dbc-8972-5c56283aaa71"/>
                    </packagedElement>
                    <packagedElement xmi:type="uml:Interface" xmi:id="b4d3ab24-4c1a-42e4-b100-f5385cfa736a" name="XSElementDeclaration" isAbstract="true">
                      <ownedComment xmi:id="d626c56d-dc60-451f-af2e-114e13610ed5" body="The interface represents the Element Declaration schema component.&#xA;" annotatedElement="b4d3ab24-4c1a-42e4-b100-f5385cfa736a"/>
                      <generalization xmi:id="6394cca7-c14d-4b2c-b998-b7993a87e26b" isSubstitutable="true" general="2c1b0916-65e9-4a2c-9d1b-1111af0beaf3"/>
                    </packagedElement>
                    <packagedElement xmi:type="uml:Class" xmi:id="c52c8d18-4982-43cc-993f-bbbdd6bd4d4d" name="XSException">
                      <ownedComment xmi:id="0ec269d2-0643-4462-bef6-26c507897554" body="The XML Schema API operations only raise exceptions in &quot;exceptional&quot;&#xA;circumstances, i.e., when an operation is impossible to perform (either&#xA;for logical reasons, because data is lost, or because the implementation&#xA;has become unstable).&#xA;&lt;p>Implementations should raise other exceptions under other circumstances.&#xA;&lt;p>Some languages and object systems do not support the concept of&#xA;exceptions. For such systems, error conditions may be indicated using&#xA;native error reporting mechanisms. For some bindings, for example,&#xA;methods may return error codes similar to those listed in the&#xA;corresponding method descriptions.&#xA;" annotatedElement="c52c8d18-4982-43cc-993f-bbbdd6bd4d4d"/>
                      <generalization xmi:id="ce29c610-38ef-4c23-974b-12e67e183ff0" isSubstitutable="true" general="c2be1008-4fc6-4a94-9ff7-fd4e5cca5f78"/>
                    </packagedElement>
                    <packagedElement xmi:type="uml:Interface" xmi:id="c7e86f3c-9ba0-4ff7-8b16-8ba12de6a9a6" name="XSFacet" isAbstract="true">
                      <ownedComment xmi:id="2399dd60-58ff-42c5-8459-c76aff020c47" body="Describes a constraining facet. Enumeration and pattern facets are exposed&#xA;via &lt;code>XSMultiValueFacet&lt;/code> interface.&#xA;" annotatedElement="c7e86f3c-9ba0-4ff7-8b16-8ba12de6a9a6"/>
                      <generalization xmi:id="922d2b35-577a-427b-ae2c-19e5ee318587" isSubstitutable="true" general="79baa86a-eb91-4006-ac05-da9fc385574c"/>
                    </packagedElement>
                    <packagedElement xmi:type="uml:Interface" xmi:id="d98e69d8-364b-4905-9cd9-d882a90726c3" name="XSIDCDefinition" isAbstract="true">
                      <ownedComment xmi:id="49fed53c-3add-4286-b722-af41809dafdf" body="This interface represents the Identity-constraint Definition schema&#xA;component.&#xA;" annotatedElement="d98e69d8-364b-4905-9cd9-d882a90726c3"/>
                      <generalization xmi:id="8b6b808a-0f83-4705-90a0-2da65e195138" isSubstitutable="true" general="79baa86a-eb91-4006-ac05-da9fc385574c"/>
                    </packagedElement>
                    <packagedElement xmi:type="uml:Interface" xmi:id="552b5301-89e4-49ed-95a6-b894408b371a" name="XSImplementation" isAbstract="true">
                      <ownedComment xmi:id="aa8f4d47-d6cf-4e20-bd91-061549764e92" body="This interface allows one to retrieve an instance of &lt;code>XSLoader&lt;/code>.&#xA;This interface should be implemented on the same object that implements&#xA;DOMImplementation.&#xA;" annotatedElement="552b5301-89e4-49ed-95a6-b894408b371a"/>
                    </packagedElement>
                    <packagedElement xmi:type="uml:Interface" xmi:id="dfc1a3da-a5a7-4959-8b2d-6d70f9a830c2" name="XSLoader" isAbstract="true">
                      <ownedComment xmi:id="e84a6b71-bb1f-4e59-9811-d84c64d94a33" body="An interface that provides a method to load XML Schema documents. This&#xA;interface uses the DOM Level 3 Core and Load and Save interfaces.&#xA;" annotatedElement="dfc1a3da-a5a7-4959-8b2d-6d70f9a830c2"/>
                    </packagedElement>
                    <packagedElement xmi:type="uml:Interface" xmi:id="6b5b03d0-978f-4ed6-a3e1-6d83f14dfba9" name="XSModel" isAbstract="true">
                      <ownedComment xmi:id="4e5a1919-f749-4dbc-bd36-76758d11344d" body="This interface represents an XML Schema.&#xA;" annotatedElement="6b5b03d0-978f-4ed6-a3e1-6d83f14dfba9"/>
                    </packagedElement>
                    <packagedElement xmi:type="uml:Interface" xmi:id="68993692-9d94-42bb-9404-e7c8c82a0ce8" name="XSModelGroup" isAbstract="true">
                      <ownedComment xmi:id="2d4173a1-9704-4c3f-a7d1-557224e7eeb0" body="This interface represents the Model Group schema component.&#xA;" annotatedElement="68993692-9d94-42bb-9404-e7c8c82a0ce8"/>
                      <generalization xmi:id="0fd2331e-1c1e-4deb-9781-3839463a8ebd" isSubstitutable="true" general="2c1b0916-65e9-4a2c-9d1b-1111af0beaf3"/>
                    </packagedElement>
                    <packagedElement xmi:type="uml:Interface" xmi:id="59aee8f4-debf-44ec-b34b-831645f1ac64" name="XSModelGroupDefinition" isAbstract="true">
                      <ownedComment xmi:id="1a4d6a86-3804-4a21-9aff-d9f3274103a4" body="This interface represents the Model Group Definition schema component.&#xA;" annotatedElement="59aee8f4-debf-44ec-b34b-831645f1ac64"/>
                      <generalization xmi:id="d723fc5d-70e1-4211-ad25-273f560fef1e" isSubstitutable="true" general="79baa86a-eb91-4006-ac05-da9fc385574c"/>
                    </packagedElement>
                    <packagedElement xmi:type="uml:Interface" xmi:id="6ab7ea31-40c7-4cfa-982c-166b8b1db9f9" name="XSMultiValueFacet" isAbstract="true">
                      <ownedComment xmi:id="6fa1cc9e-f886-4c05-90a4-d939b8d7c3db" body="Describes a multi-value constraining facets: pattern and enumeration.&#xA;" annotatedElement="6ab7ea31-40c7-4cfa-982c-166b8b1db9f9"/>
                      <generalization xmi:id="0212227b-bf6e-4398-b69f-08440c04121c" isSubstitutable="true" general="79baa86a-eb91-4006-ac05-da9fc385574c"/>
                    </packagedElement>
                    <packagedElement xmi:type="uml:Interface" xmi:id="7c3c9695-c3c4-4f1f-994c-5e1529c6f6bb" name="XSNamedMap" isAbstract="true">
                      <ownedComment xmi:id="1c827cac-981f-41e5-8c94-fb44f5125681" body="Objects implementing the &lt;code>XSNamedMap&lt;/code> interface are used to&#xA;represent immutable collections of XML Schema components that can be&#xA;accessed by name. Note that &lt;code>XSNamedMap&lt;/code> does not inherit from&#xA;&lt;code>XSObjectList&lt;/code>. The &lt;code>XSObject&lt;/code>s in&#xA;&lt;code>XSNamedMap&lt;/code>s are not maintained in any particular order.&#xA;" annotatedElement="7c3c9695-c3c4-4f1f-994c-5e1529c6f6bb"/>
                    </packagedElement>
                    <packagedElement xmi:type="uml:Interface" xmi:id="bcced0f2-2af7-4633-a7d0-23b3a17338e1" name="XSNamespaceItem" isAbstract="true">
                      <ownedComment xmi:id="08133cc1-d8e5-4ce9-b379-8c17af3f8c31" body="The interface represents the namespace schema information information item.&#xA;Each namespace schema information information item corresponds to an XML&#xA;Schema with a unique namespace name.&#xA;" annotatedElement="bcced0f2-2af7-4633-a7d0-23b3a17338e1"/>
                    </packagedElement>
                    <packagedElement xmi:type="uml:Interface" xmi:id="207466ba-0a88-440c-a9a8-7a636d909e9a" name="XSNamespaceItemList" isAbstract="true">
                      <ownedComment xmi:id="87b46945-7e31-46ad-b330-d17ae556d37d" body="The &lt;code>XSNamesaceItemList&lt;/code> interface provides the abstraction of&#xA;an immutable ordered collection of &lt;code>XSNamespaceItem&lt;/code>s, without&#xA;defining or constraining how this collection is implemented.&#xA;" annotatedElement="207466ba-0a88-440c-a9a8-7a636d909e9a"/>
                      <generalization xmi:id="37023545-ddfb-4922-bb3e-52cf8607ca49" isSubstitutable="true" general="ff2480c1-357b-4498-9fd4-9f5ce08413c9"/>
                    </packagedElement>
                    <packagedElement xmi:type="uml:Interface" xmi:id="b9624b27-0ee8-4a8e-b0e1-b986fa07bca2" name="XSNotationDeclaration" isAbstract="true">
                      <ownedComment xmi:id="a90686a2-4647-446d-87f5-3ccd2e0d1027" body="This interface represents the Notation Declaration schema component.&#xA;" annotatedElement="b9624b27-0ee8-4a8e-b0e1-b986fa07bca2"/>
                      <generalization xmi:id="8792bb10-2f88-4576-a73e-ea402c61007d" isSubstitutable="true" general="79baa86a-eb91-4006-ac05-da9fc385574c"/>
                    </packagedElement>
                    <packagedElement xmi:type="uml:Interface" xmi:id="79baa86a-eb91-4006-ac05-da9fc385574c" name="XSObject" isAbstract="true">
                      <ownedComment xmi:id="07f92918-02fb-4a13-8242-36a5872804e3" body="The &lt;code>XSObject&lt;/code> is a base object for the XML Schema component&#xA;model.&#xA;" annotatedElement="79baa86a-eb91-4006-ac05-da9fc385574c"/>
                    </packagedElement>
                    <packagedElement xmi:type="uml:Interface" xmi:id="1f9921db-0fc6-4f50-bfda-3281dc5a3b2e" name="XSObjectList" isAbstract="true">
                      <ownedComment xmi:id="3a1b665a-7106-48a4-aade-8b272b8089dd" body="The &lt;code>XSObjectList&lt;/code> interface provides the abstraction of an&#xA;immutable ordered collection of &lt;code>XSObject&lt;/code>s, without defining&#xA;or constraining how this collection is implemented.&#xA;" annotatedElement="1f9921db-0fc6-4f50-bfda-3281dc5a3b2e"/>
                      <generalization xmi:id="a070b7fa-29a6-43ab-b245-aecc2f6029b2" isSubstitutable="true" general="ff2480c1-357b-4498-9fd4-9f5ce08413c9"/>
                    </packagedElement>
                    <packagedElement xmi:type="uml:Interface" xmi:id="9d84f498-daf6-4d59-b1ff-ac75266a4aa5" name="XSParticle" isAbstract="true">
                      <ownedComment xmi:id="c8734254-1360-41c7-9c0b-f8540bffa729" body="This interface represents the Particle schema component.&#xA;" annotatedElement="9d84f498-daf6-4d59-b1ff-ac75266a4aa5"/>
                      <generalization xmi:id="b2efea1f-dad5-477e-9829-9a7a0d94f8f4" isSubstitutable="true" general="79baa86a-eb91-4006-ac05-da9fc385574c"/>
                    </packagedElement>
                    <packagedElement xmi:type="uml:Interface" xmi:id="c08030e4-f6b3-47e5-bb91-6bfec6ea8775" name="XSSimpleTypeDefinition" isAbstract="true">
                      <ownedComment xmi:id="3239c81c-6155-457d-8794-ab5e4e8f8ffb" body="This interface represents the Simple Type Definition schema component. This&#xA;interface provides several query operations for facet components. Users&#xA;can either retrieve the defined facets as XML Schema components, using&#xA;the &lt;code>facets&lt;/code> and the &lt;code>multiValueFacets&lt;/code> attributes;&#xA;or users can separately query a facet's properties using methods such as&#xA;&lt;code>getLexicalFacetValue&lt;/code>, &lt;code>isFixedFacet&lt;/code>, etc.&#xA;" annotatedElement="c08030e4-f6b3-47e5-bb91-6bfec6ea8775"/>
                      <generalization xmi:id="cfcc7a33-5cfe-4415-98aa-852ce479cc58" isSubstitutable="true" general="3088c4cc-6bb8-41e9-9dfb-54fc7b6b4a16"/>
                    </packagedElement>
                    <packagedElement xmi:type="uml:Interface" xmi:id="2c1b0916-65e9-4a2c-9d1b-1111af0beaf3" name="XSTerm" isAbstract="true">
                      <ownedComment xmi:id="cbcb6f89-63c7-4fb5-9969-7ed612047af8" body="Describes a term that can be one of a model group, a wildcard, or an&#xA;element declaration. Objects implementing&#xA;&lt;code>XSElementDeclaration&lt;/code>, &lt;code>XSModelGroup&lt;/code> and&#xA;&lt;code>XSWildcard&lt;/code> interfaces also implement this interface.&#xA;" annotatedElement="2c1b0916-65e9-4a2c-9d1b-1111af0beaf3"/>
                      <generalization xmi:id="bfc4d43e-561f-4ea7-b56f-1603ab39ba7f" isSubstitutable="true" general="79baa86a-eb91-4006-ac05-da9fc385574c"/>
                    </packagedElement>
                    <packagedElement xmi:type="uml:Interface" xmi:id="3088c4cc-6bb8-41e9-9dfb-54fc7b6b4a16" name="XSTypeDefinition" isAbstract="true">
                      <ownedComment xmi:id="4ae9b552-0d3a-48ed-9fc8-5e8f21c9b4ba" body="This interface represents a complex or simple type definition.&#xA;" annotatedElement="3088c4cc-6bb8-41e9-9dfb-54fc7b6b4a16"/>
                      <generalization xmi:id="5d77dbf1-14ac-40a3-9456-73babef79b42" isSubstitutable="true" general="79baa86a-eb91-4006-ac05-da9fc385574c"/>
                    </packagedElement>
                    <packagedElement xmi:type="uml:Interface" xmi:id="932b0380-03b0-49c4-a5c9-449d7cd9b3a5" name="XSWildcard" isAbstract="true">
                      <ownedComment xmi:id="d0f9f379-7c26-4d6c-ba54-99d6b94e2bfa" body="This interface represents the Wildcard schema component.&#xA;" annotatedElement="932b0380-03b0-49c4-a5c9-449d7cd9b3a5"/>
                      <generalization xmi:id="32e18338-c390-498e-8595-cc2bdefc17f3" isSubstitutable="true" general="2c1b0916-65e9-4a2c-9d1b-1111af0beaf3"/>
                    </packagedElement>
                  </packagedElement>
                </packagedElement>
              </packagedElement>
              <packagedElement xmi:type="uml:Package" xmi:id="ea305dcf-4de4-4798-b17c-6346cd434bc9" name="xml">
                <packagedElement xmi:type="uml:Package" xmi:id="2b39f351-403c-47d6-a56c-e32f4782eec5" name="internal">
                  <packagedElement xmi:type="uml:Package" xmi:id="f57bbab6-428d-4e5b-b329-417ec60802c6" name="dtm">
                    <packagedElement xmi:type="uml:Package" xmi:id="51f1c6bd-875f-4dfb-bb2e-45bab0849d4b" name="ref">
                      <packagedElement xmi:type="uml:Package" xmi:id="1047d780-0c47-42b2-b858-b087ed0577aa" name="dom2dtm">
                        <packagedElement xmi:type="uml:Class" xmi:id="6ebb886b-f0ee-49e0-b821-02340386c478" name="DOM2DTM">
                          <ownedComment xmi:id="b2bfff3b-3dba-4228-ad44-875378944196" body="The &lt;code>DOM2DTM&lt;/code> class serves up a DOM's contents via the&#xA;DTM API.&#xA;&#xA;Note that it doesn't necessarily represent a full Document&#xA;tree. You can wrap a DOM2DTM around a specific node and its subtree&#xA;and the right things should happen. (I don't _think_ we currently&#xA;support DocumentFrgment nodes as roots, though that might be worth&#xA;considering.)&#xA;&#xA;Note too that we do not currently attempt to track document&#xA;mutation. If you alter the DOM after wrapping DOM2DTM around it,&#xA;all bets are off.&#xA;" annotatedElement="6ebb886b-f0ee-49e0-b821-02340386c478"/>
                          <generalization xmi:id="e2b861c3-5d7a-437b-9fac-dcd0c4a8355e" isSubstitutable="true" general="4ad727dc-8cdb-47a2-83bd-e738ccaba3a6"/>
                          <nestedClassifier xmi:type="uml:Interface" xmi:id="d5dbb5a2-e9a7-4b3c-84fd-02fdfe14c8ae" name="CharacterNodeHandler" isAbstract="true"/>
                        </packagedElement>
                        <packagedElement xmi:type="uml:Class" xmi:id="37cf57c3-e71f-4cb9-85d6-1e5136ddb425" name="DOM2DTMdefaultNamespaceDeclarationNode" clientDependency="08668f25-559c-4023-a126-4f1ce7fe9687 3ab95ae2-225a-40ad-a222-02750c739e5d">
                          <ownedComment xmi:id="f9ee500a-ad09-4292-8b4a-32585425e2d1" body="This is a kluge to let us shove a declaration for xml: into the&#xA;DOM2DTM model.  Basically, it creates a proxy node in DOM space to&#xA;carry the additional information. This is _NOT_ a full DOM&#xA;implementation, and shouldn't be one since it sits alongside the&#xA;DOM rather than becoming part of the DOM model.&#xA;&#xA;(This used to be an internal class within DOM2DTM. Moved out because&#xA;I need to perform an instanceof operation on it to support a temporary&#xA;workaround in DTMManagerDefault.)&#xA;&#xA;%REVIEW% What if the DOM2DTM was built around a DocumentFragment and&#xA;there isn't a single root element? I think this fails that case...&#xA;&#xA;%REVIEW% An alternative solution would be to create the node _only_&#xA;in DTM space, but given how DOM2DTM is currently written I think&#xA;this is simplest.&#xA;" annotatedElement="37cf57c3-e71f-4cb9-85d6-1e5136ddb425"/>
                          <interfaceRealization xmi:id="08668f25-559c-4023-a126-4f1ce7fe9687" name="" supplier="3f1de027-219f-4381-99ef-bb109fdc39e1" client="37cf57c3-e71f-4cb9-85d6-1e5136ddb425" contract="3f1de027-219f-4381-99ef-bb109fdc39e1"/>
                          <interfaceRealization xmi:id="3ab95ae2-225a-40ad-a222-02750c739e5d" name="" supplier="c8e502bc-b08d-457e-8f5a-cb3f97b6958e" client="37cf57c3-e71f-4cb9-85d6-1e5136ddb425" contract="c8e502bc-b08d-457e-8f5a-cb3f97b6958e"/>
                        </packagedElement>
                      </packagedElement>
                      <packagedElement xmi:type="uml:Package" xmi:id="91856d43-9426-4e69-a2f5-effd8ed89596" name="sax2dtm">
                        <packagedElement xmi:type="uml:Class" xmi:id="f6dd5bb6-0740-478a-940d-499c9604377a" name="SAX2DTM" clientDependency="d33d9ced-b38b-4e19-a9d8-67c56e0ee032 d6cc7b5e-117b-48fe-9258-b47aec65cf56 6703d5cd-3587-4fe3-b925-f179e99a8466 5368efdf-cb21-47e5-aa1c-aa5c4f11407d 5f4a08b6-9744-4cb0-bffa-7d83db2bd54b 7b966aa8-cac6-489a-9721-7dd2c385af96">
                          <ownedComment xmi:id="381edd8e-6e19-4fbc-bb35-a54801341fbf" body="This class implements a DTM that tends to be optimized more for speed than&#xA;for compactness, that is constructed via SAX2 ContentHandler events.&#xA;" annotatedElement="f6dd5bb6-0740-478a-940d-499c9604377a"/>
                          <generalization xmi:id="e00a2775-89e1-4a76-9eb9-c7f16b1d0295" isSubstitutable="true" general="4ad727dc-8cdb-47a2-83bd-e738ccaba3a6"/>
                          <interfaceRealization xmi:id="d33d9ced-b38b-4e19-a9d8-67c56e0ee032" name="" supplier="ddb934f5-fe18-4e64-8655-6621fcdfff7d" client="f6dd5bb6-0740-478a-940d-499c9604377a" contract="ddb934f5-fe18-4e64-8655-6621fcdfff7d"/>
                          <interfaceRealization xmi:id="d6cc7b5e-117b-48fe-9258-b47aec65cf56" name="" supplier="4035121a-78e9-4e11-bd96-66685990e1a3" client="f6dd5bb6-0740-478a-940d-499c9604377a" contract="4035121a-78e9-4e11-bd96-66685990e1a3"/>
                          <interfaceRealization xmi:id="5368efdf-cb21-47e5-aa1c-aa5c4f11407d" name="" supplier="c1ba9edb-3b3b-4e75-a057-ba7df9208c25" client="f6dd5bb6-0740-478a-940d-499c9604377a" contract="c1ba9edb-3b3b-4e75-a057-ba7df9208c25"/>
                          <interfaceRealization xmi:id="6703d5cd-3587-4fe3-b925-f179e99a8466" name="" supplier="c2d55e37-54a2-46f7-ab39-94511166fc94" client="f6dd5bb6-0740-478a-940d-499c9604377a" contract="c2d55e37-54a2-46f7-ab39-94511166fc94"/>
                          <interfaceRealization xmi:id="5f4a08b6-9744-4cb0-bffa-7d83db2bd54b" name="" supplier="4259219a-95e0-485a-9579-c3ae71836ac0" client="f6dd5bb6-0740-478a-940d-499c9604377a" contract="4259219a-95e0-485a-9579-c3ae71836ac0"/>
                          <interfaceRealization xmi:id="7b966aa8-cac6-489a-9721-7dd2c385af96" name="" supplier="4ced7e8f-069f-4000-b177-b7124a2c522c" client="f6dd5bb6-0740-478a-940d-499c9604377a" contract="4ced7e8f-069f-4000-b177-b7124a2c522c"/>
                        </packagedElement>
                        <packagedElement xmi:type="uml:Class" xmi:id="eec353fa-9d80-48ac-8e09-ac8dd4a342d2" name="SAX2DTM2">
                          <ownedComment xmi:id="baac9bb6-765c-4ad2-999f-83123e4bf204" body="SAX2DTM2 is an optimized version of SAX2DTM which is used in non-incremental situation.&#xA;It is used as the super class of the XSLTC SAXImpl. Many of the interfaces in SAX2DTM&#xA;and DTMDefaultBase are overridden in SAX2DTM2 in order to allow fast, efficient&#xA;access to the DTM model. Some nested iterators in DTMDefaultBaseIterators&#xA;are also overridden in SAX2DTM2 for performance reasons.&#xA;&lt;p>&#xA;Performance is the biggest consideration in the design of SAX2DTM2. To make the code most&#xA;efficient, the incremental support is dropped in SAX2DTM2, which means that you should not&#xA;use it in incremental situation. To reduce the overhead of pulling data from the DTM model,&#xA;a few core interfaces in SAX2DTM2 have direct access to the internal arrays of the&#xA;SuballocatedIntVectors.&#xA;&lt;p>&#xA;The design of SAX2DTM2 may limit its extensibilty. If you have a reason to extend the&#xA;SAX2DTM model, please extend from SAX2DTM instead of this class.&#xA;&lt;p>&#xA;TODO: This class is currently only used by XSLTC. We need to investigate the possibility&#xA;of also using it in Xalan-J Interpretive. Xalan's performance is likely to get an instant&#xA;boost if we use SAX2DTM2 instead of SAX2DTM in non-incremental case.&#xA;&lt;p>&#xA;%MK% The code in this class is critical to the XSLTC_DTM performance. Be very careful&#xA;when making changes here!&#xA;" annotatedElement="eec353fa-9d80-48ac-8e09-ac8dd4a342d2"/>
                          <generalization xmi:id="59274e89-db1a-4254-a516-bcdef6d4312b" isSubstitutable="true" general="f6dd5bb6-0740-478a-940d-499c9604377a"/>
                          <nestedClassifier xmi:type="uml:Class" xmi:id="5c0d4f26-46ab-4c42-a3fa-abbbfaadbbc6" name="ChildrenIterator">
                            <ownedComment xmi:id="d0cb00a3-4c90-4857-a11b-8b33ce031922" body="Iterator that returns all immediate children of a given node&#xA;" annotatedElement="5c0d4f26-46ab-4c42-a3fa-abbbfaadbbc6"/>
                            <generalization xmi:id="204004cf-8414-437d-9924-e954620c3ac2" isSubstitutable="true" general="21904ab6-0d7d-432b-8fbc-2b3c83338b4c"/>
                          </nestedClassifier>
                          <nestedClassifier xmi:type="uml:Class" xmi:id="36e9f144-c5e4-4963-965d-240e999ca650" name="ParentIterator">
                            <ownedComment xmi:id="0b97a7c5-9089-4ca0-a5a9-b989c6b3ed60" body="Iterator that returns the parent of a given node. Note that&#xA;this delivers only a single node; if you want all the ancestors,&#xA;see AncestorIterator.&#xA;" annotatedElement="36e9f144-c5e4-4963-965d-240e999ca650"/>
                            <generalization xmi:id="1a36a4f1-1424-480c-9ee8-9837dac598b1" isSubstitutable="true" general="21904ab6-0d7d-432b-8fbc-2b3c83338b4c"/>
                          </nestedClassifier>
                          <nestedClassifier xmi:type="uml:Class" xmi:id="0b37e50a-fa11-4c79-a182-c9c169e0d713" name="TypedChildrenIterator">
                            <ownedComment xmi:id="4516edf2-2cce-4e8a-9cc3-54101ffa076a" body="Iterator that returns children of a given type for a given node.&#xA;The functionality chould be achieved by putting a filter on top&#xA;of a basic child iterator, but a specialised iterator is used&#xA;for efficiency (both speed and size of translet).&#xA;" annotatedElement="0b37e50a-fa11-4c79-a182-c9c169e0d713"/>
                            <generalization xmi:id="c81f129d-5758-4209-9fb2-b49b2a37c8cf" isSubstitutable="true" general="21904ab6-0d7d-432b-8fbc-2b3c83338b4c"/>
                          </nestedClassifier>
                          <nestedClassifier xmi:type="uml:Class" xmi:id="26ed0dea-cddc-4f77-88db-426d952a14d4" name="TypedRootIterator">
                            <ownedComment xmi:id="ed240dd5-a85e-4bb2-b996-9108a02beeba" body="Iterator that returns the namespace nodes as defined by the XPath data model&#xA;for a given node, filtered by extended type ID.&#xA;" annotatedElement="26ed0dea-cddc-4f77-88db-426d952a14d4"/>
                            <generalization xmi:id="038656ff-6588-4be8-98b4-301d5d8a9895" isSubstitutable="true" general="4d01079e-5b33-418b-901a-b99569c2f83a"/>
                          </nestedClassifier>
                          <nestedClassifier xmi:type="uml:Class" xmi:id="e960b0ea-d9b1-449a-bc20-f31f48c45bb9" name="FollowingSiblingIterator">
                            <ownedComment xmi:id="50995e0b-3f16-4254-bc53-e45376006ed7" body="Iterator that returns all siblings of a given node.&#xA;" annotatedElement="e960b0ea-d9b1-449a-bc20-f31f48c45bb9"/>
                            <generalization xmi:id="7add08ce-0bb0-442e-bae7-40daee75a9c1" isSubstitutable="true" general="21904ab6-0d7d-432b-8fbc-2b3c83338b4c"/>
                          </nestedClassifier>
                          <nestedClassifier xmi:type="uml:Class" xmi:id="9bad33b3-b96d-495c-ab16-26956e36160b" name="TypedFollowingSiblingIterator">
                            <ownedComment xmi:id="6ba69675-45a0-4c5c-b2e6-3abed91eb134" body="Iterator that returns all following siblings of a given node.&#xA;" annotatedElement="9bad33b3-b96d-495c-ab16-26956e36160b"/>
                            <generalization xmi:id="60d58248-c4ad-4d77-8864-2cd8fbaf13f1" isSubstitutable="true" general="e960b0ea-d9b1-449a-bc20-f31f48c45bb9"/>
                          </nestedClassifier>
                          <nestedClassifier xmi:type="uml:Class" xmi:id="7a6386a2-50dd-4820-b7e4-3863dc6f874a" name="AttributeIterator">
                            <ownedComment xmi:id="07cca07b-8f37-4f6b-b09f-3e140ad477d0" body="Iterator that returns attribute nodes (of what nodes?)&#xA;" annotatedElement="7a6386a2-50dd-4820-b7e4-3863dc6f874a"/>
                            <generalization xmi:id="36985212-7c84-4d04-8537-f340812098ee" isSubstitutable="true" general="21904ab6-0d7d-432b-8fbc-2b3c83338b4c"/>
                          </nestedClassifier>
                          <nestedClassifier xmi:type="uml:Class" xmi:id="6748a19f-01cf-4cc7-b620-75fdd26e3e23" name="TypedAttributeIterator">
                            <ownedComment xmi:id="efa7c252-7dd4-4be2-9208-533b59cdecff" body="Iterator that returns attribute nodes of a given type&#xA;" annotatedElement="6748a19f-01cf-4cc7-b620-75fdd26e3e23"/>
                            <generalization xmi:id="5f808575-5a8d-49fc-998c-88d3baf144d4" isSubstitutable="true" general="21904ab6-0d7d-432b-8fbc-2b3c83338b4c"/>
                          </nestedClassifier>
                          <nestedClassifier xmi:type="uml:Class" xmi:id="57b6ff31-c3ef-4f19-8c4e-3e8e4ff972d3" name="PrecedingSiblingIterator">
                            <ownedComment xmi:id="2c740487-9d1f-461d-bd49-b27bb3f64584" body="Iterator that returns preceding siblings of a given node&#xA;" annotatedElement="57b6ff31-c3ef-4f19-8c4e-3e8e4ff972d3"/>
                            <generalization xmi:id="2918d4f3-c6dd-42e6-9698-e9913d27d88a" isSubstitutable="true" general="21904ab6-0d7d-432b-8fbc-2b3c83338b4c"/>
                          </nestedClassifier>
                          <nestedClassifier xmi:type="uml:Class" xmi:id="0119bf71-15a5-4915-81e1-63b42a33c721" name="TypedPrecedingSiblingIterator">
                            <ownedComment xmi:id="afd8cefd-80be-40e9-8f2f-434701d69d7c" body="Iterator that returns preceding siblings of a given type for&#xA;a given node&#xA;" annotatedElement="0119bf71-15a5-4915-81e1-63b42a33c721"/>
                            <generalization xmi:id="1d22d65f-e04d-480f-9247-6df56fcea6b3" isSubstitutable="true" general="57b6ff31-c3ef-4f19-8c4e-3e8e4ff972d3"/>
                          </nestedClassifier>
                          <nestedClassifier xmi:type="uml:Class" xmi:id="412a4029-f08d-4c24-a33b-11c2c3aa5af8" name="PrecedingIterator">
                            <ownedComment xmi:id="81db3de5-cd8a-4c73-9694-e59057d0c950" body="Iterator that returns preceding nodes of a given node.&#xA;This includes the node set {root+1, start-1}, but excludes&#xA;all ancestors, attributes, and namespace nodes.&#xA;" annotatedElement="412a4029-f08d-4c24-a33b-11c2c3aa5af8"/>
                            <generalization xmi:id="fc5cd952-4ed6-415f-be56-5a7031f43bc4" isSubstitutable="true" general="21904ab6-0d7d-432b-8fbc-2b3c83338b4c"/>
                          </nestedClassifier>
                          <nestedClassifier xmi:type="uml:Class" xmi:id="af827736-9bcc-4e57-aa4b-574bb62ec0a7" name="TypedPrecedingIterator">
                            <ownedComment xmi:id="4eb9db9a-439b-4b6f-8b16-b9911b5d1bd7" body="Iterator that returns preceding nodes of agiven type for a&#xA;given node. This includes the node set {root+1, start-1}, but&#xA;excludes all ancestors.&#xA;" annotatedElement="af827736-9bcc-4e57-aa4b-574bb62ec0a7"/>
                            <generalization xmi:id="0081a7c9-957a-4370-8183-cba3724a2167" isSubstitutable="true" general="412a4029-f08d-4c24-a33b-11c2c3aa5af8"/>
                          </nestedClassifier>
                          <nestedClassifier xmi:type="uml:Class" xmi:id="fa5d4378-a1e9-4f72-8aec-5cdeedcde98f" name="FollowingIterator">
                            <ownedComment xmi:id="b1ae6b5c-7d3e-47d5-a4b8-cbf199e0deeb" body="Iterator that returns following nodes of for a given node.&#xA;" annotatedElement="fa5d4378-a1e9-4f72-8aec-5cdeedcde98f"/>
                            <generalization xmi:id="e9529b39-533d-4a8c-afd6-10d6ef71b1f7" isSubstitutable="true" general="21904ab6-0d7d-432b-8fbc-2b3c83338b4c"/>
                          </nestedClassifier>
                          <nestedClassifier xmi:type="uml:Class" xmi:id="50d40563-1177-4007-849d-a77e18a422c6" name="TypedFollowingIterator">
                            <ownedComment xmi:id="5edab572-180f-46d3-a65e-2153c5e45ac3" body="Iterator that returns following nodes of a given type for a given node.&#xA;" annotatedElement="50d40563-1177-4007-849d-a77e18a422c6"/>
                            <generalization xmi:id="ec04776d-6df0-4cee-8b6b-8f116fff33c0" isSubstitutable="true" general="fa5d4378-a1e9-4f72-8aec-5cdeedcde98f"/>
                          </nestedClassifier>
                          <nestedClassifier xmi:type="uml:Class" xmi:id="dcb2bbdc-1c70-4a99-9d1b-9c16bf460b38" name="AncestorIterator">
                            <ownedComment xmi:id="83760ffd-4401-4135-a0fc-1ae3a979e337" body="Iterator that returns the ancestors of a given node in document&#xA;order.  (NOTE!  This was changed from the XSLTC code!)&#xA;" annotatedElement="dcb2bbdc-1c70-4a99-9d1b-9c16bf460b38"/>
                            <generalization xmi:id="2186d6cf-b990-4b9f-902c-c2a52fc2be45" isSubstitutable="true" general="21904ab6-0d7d-432b-8fbc-2b3c83338b4c"/>
                          </nestedClassifier>
                          <nestedClassifier xmi:type="uml:Class" xmi:id="e2c58eae-d6a0-4291-9e86-0696646ab982" name="TypedAncestorIterator">
                            <ownedComment xmi:id="19f84281-dc0a-4e74-a06d-627a969ffc98" body="Typed iterator that returns the ancestors of a given node.&#xA;" annotatedElement="e2c58eae-d6a0-4291-9e86-0696646ab982"/>
                            <generalization xmi:id="c1fe772a-1ecf-434e-9d38-790a2f66504f" isSubstitutable="true" general="dcb2bbdc-1c70-4a99-9d1b-9c16bf460b38"/>
                          </nestedClassifier>
                          <nestedClassifier xmi:type="uml:Class" xmi:id="c6e7f65c-c3a2-4b73-82f1-09ba63f16753" name="DescendantIterator">
                            <ownedComment xmi:id="0c1af29c-7089-4232-8052-adc0692843f0" body="Iterator that returns the descendants of a given node.&#xA;" annotatedElement="c6e7f65c-c3a2-4b73-82f1-09ba63f16753"/>
                            <generalization xmi:id="21fd6c76-d0be-46bb-849a-2a699646a8bd" isSubstitutable="true" general="21904ab6-0d7d-432b-8fbc-2b3c83338b4c"/>
                          </nestedClassifier>
                          <nestedClassifier xmi:type="uml:Class" xmi:id="70ea9ca5-1845-49a6-9ff8-804f6ba039cc" name="TypedDescendantIterator">
                            <ownedComment xmi:id="580cf24c-3aa6-4ec7-a293-adaa7b30c4f7" body="Typed iterator that returns the descendants of a given node.&#xA;" annotatedElement="70ea9ca5-1845-49a6-9ff8-804f6ba039cc"/>
                            <generalization xmi:id="5df4d9ed-78be-4192-9641-f64b9364282a" isSubstitutable="true" general="c6e7f65c-c3a2-4b73-82f1-09ba63f16753"/>
                          </nestedClassifier>
                          <nestedClassifier xmi:type="uml:Class" xmi:id="6a4f4563-6097-49c2-b2e8-0222831a851b" name="TypedSingletonIterator">
                            <ownedComment xmi:id="f2204d26-42df-4ff4-b639-c6d30b0befcb" body="Iterator that returns a given node only if it is of a given type.&#xA;" annotatedElement="6a4f4563-6097-49c2-b2e8-0222831a851b"/>
                            <generalization xmi:id="31cf0c6c-0c5b-416c-85e5-9ba05a81d4a5" isSubstitutable="true" general="082e0147-6d1c-4573-92cb-45a9ae44f108"/>
                          </nestedClassifier>
                        </packagedElement>
                        <packagedElement xmi:type="uml:Class" xmi:id="134cc472-68e0-4098-a49e-ded061caf6f8" name="SAX2RTFDTM">
                          <ownedComment xmi:id="f14940c8-d721-4704-9cb0-250feaca4a37" body="This is a subclass of SAX2DTM which has been modified to meet the needs of&#xA;Result Tree Frameworks (RTFs). The differences are:&#xA;&#xA;1) Multiple XML trees may be appended to the single DTM. This means&#xA;that the root node of each document is _not_ node 0. Some code has&#xA;had to be deoptimized to support this mode of operation, and an&#xA;explicit mechanism for obtaining the Node Handle of the root node&#xA;has been provided.&#xA;&#xA;2) A stack of these documents is maintained, allowing us to &quot;tail-prune&quot; the&#xA;most recently added trees off the end of the DTM as stylesheet elements&#xA;(and thus variable contexts) are exited.&#xA;&#xA;PLEASE NOTE that this class may be _heavily_ dependent upon the&#xA;internals of the SAX2DTM superclass, and must be maintained in&#xA;parallel with that code.  Arguably, they should be conditionals&#xA;within a single class... but they have deen separated for&#xA;performance reasons. (In fact, one could even argue about which is&#xA;the superclass and which is the subclass; the current arrangement&#xA;is as much about preserving stability of existing code during&#xA;development as anything else.)&#xA;&#xA;%REVIEW% In fact, since the differences are so minor, I think it&#xA;may be possible/practical to fold them back into the base&#xA;SAX2DTM. Consider that as a future code-size optimization.&#xA;" annotatedElement="134cc472-68e0-4098-a49e-ded061caf6f8"/>
                          <generalization xmi:id="c1f575b9-e2f4-4d05-941d-285c713854c8" isSubstitutable="true" general="f6dd5bb6-0740-478a-940d-499c9604377a"/>
                        </packagedElement>
                      </packagedElement>
                      <packagedElement xmi:type="uml:Class" xmi:id="4710acef-3ac0-4d4b-86c6-ee9fa7207249" name="ChunkedIntArray" visibility="package">
                        <ownedComment xmi:id="50f0f360-b757-4d19-9966-4566ef429e65" body="&lt;code>ChunkedIntArray&lt;/code> is an extensible array of blocks of integers.&#xA;(I'd consider Vector, but it's unable to handle integers except by&#xA;turning them into Objects.)&#xA;&lt;p>Making this a separate class means some call-and-return overhead. But&#xA;doing it all inline tends to be fragile and expensive in coder time,&#xA;not to mention driving up code size. If you want to inline it, feel free.&#xA;The Java text suggest that private and Final methods may be inlined,&#xA;and one can argue that this beast need not be made subclassable...&lt;/p>&#xA;&#xA;&lt;p>%REVIEW% This has strong conceptual overlap with the IntVector class.&#xA;It would probably be a good thing to merge the two, when time permits.&lt;p>&#xA;" annotatedElement="4710acef-3ac0-4d4b-86c6-ee9fa7207249"/>
                        <nestedClassifier xmi:type="uml:Class" xmi:id="8b29601a-14ba-46d0-bdc4-b69f51d413d4" name="ChunksVector" visibility="package"/>
                      </packagedElement>
                      <packagedElement xmi:type="uml:Class" xmi:id="b4e53c0a-a3c6-4f02-ab96-c1a39e4be8ff" name="CoroutineManager">
                        <ownedComment xmi:id="92723a53-91b7-4fa1-b8f6-067428105185" body="&lt;p>Support the coroutine design pattern.&lt;/p>&#xA;&#xA;&lt;p>A coroutine set is a very simple cooperative non-preemptive&#xA;multitasking model, where the switch from one task to another is&#xA;performed via an explicit request. Coroutines interact according to&#xA;the following rules:&lt;/p>&#xA;&#xA;&lt;ul>&#xA;&lt;li>One coroutine in the set has control, which it retains until it&#xA;either exits or resumes another coroutine.&lt;/li>&#xA;&lt;li>A coroutine is activated when it is resumed by some other coroutine&#xA;for the first time.&lt;/li>&#xA;&lt;li>An active coroutine that gives up control by resuming another in&#xA;the set retains its context -- including call stack and local variables&#xA;-- so that if/when it is resumed, it will proceed from the point at which&#xA;it last gave up control.&lt;/li>&#xA;&lt;/ul>&#xA;&#xA;&lt;p>Coroutines can be thought of as falling somewhere between pipes and&#xA;subroutines. Like call/return, there is an explicit flow of control&#xA;from one coroutine to another. Like pipes, neither coroutine is&#xA;actually &quot;in charge&quot;, and neither must exit in order to transfer&#xA;control to the other. &lt;/p>&#xA;&#xA;&lt;p>One classic application of coroutines is in compilers, where both&#xA;the parser and the lexer are maintaining complex state&#xA;information. The parser resumes the lexer to process incoming&#xA;characters into lexical tokens, and the lexer resumes the parser&#xA;when it has reached a point at which it has a reliably interpreted&#xA;set of tokens available for semantic processing. Structuring this&#xA;as call-and-return would require saving and restoring a&#xA;considerable amount of state each time. Structuring it as two tasks&#xA;connected by a queue may involve higher overhead (in systems which&#xA;can optimize the coroutine metaphor), isn't necessarily as clear in&#xA;intent, may have trouble handling cases where data flows in both&#xA;directions, and may not handle some of the more complex cases where&#xA;more than two coroutines are involved.&lt;/p>&#xA;&#xA;&lt;p>Most coroutine systems also provide a way to pass data between the&#xA;source and target of a resume operation; this is sometimes referred&#xA;to as &quot;yielding&quot; a value.  Others rely on the fact that, since only&#xA;one member of a coroutine set is running at a time and does not&#xA;lose control until it chooses to do so, data structures may be&#xA;directly shared between them with only minimal precautions.&lt;/p>&#xA;&#xA;&lt;p>&quot;Note: This should not be taken to mean that producer/consumer&#xA;problems should be always be done with coroutines.&quot; Queueing is&#xA;often a better solution when only two threads of execution are&#xA;involved and full two-way handshaking is not required. It's a bit&#xA;difficult to find short pedagogical examples that require&#xA;coroutines for a clear solution.&lt;/p>&#xA;&#xA;&lt;p>The fact that only one of a group of coroutines is running at a&#xA;time, and the control transfer between them is explicit, simplifies&#xA;their possible interactions, and in some implementations permits&#xA;them to be implemented more efficiently than general multitasking.&#xA;In some situations, coroutines can be compiled out entirely;&#xA;in others, they may only require a few instructions more than a&#xA;simple function call.&lt;/p>&#xA;&#xA;&lt;p>This version is built on top of standard Java threading, since&#xA;that's all we have available right now. It's been encapsulated for&#xA;code clarity and possible future optimization.&lt;/p>&#xA;&#xA;&lt;p>(Two possible approaches: wait-notify based and queue-based. Some&#xA;folks think that a one-item queue is a cleaner solution because it's&#xA;more abstract -- but since coroutine _is_ an abstraction I'm not really&#xA;worried about that; folks should be able to switch this code without&#xA;concern.)&lt;/p>&#xA;&#xA;&lt;p>%TBD% THIS SHOULD BE AN INTERFACE, to facilitate building other&#xA;implementations... perhaps including a true coroutine system&#xA;someday, rather than controlled threading. Arguably Coroutine&#xA;itself should be an interface much like Runnable, but I think that&#xA;can be built on top of this.&lt;/p>&#xA;" annotatedElement="b4e53c0a-a3c6-4f02-ab96-c1a39e4be8ff"/>
                      </packagedElement>
                      <packagedElement xmi:type="uml:Interface" xmi:id="97264b58-0604-462e-a354-e9d0b19faa9c" name="CoroutineParser" isAbstract="true">
                        <ownedComment xmi:id="f2a0b479-f39a-4bba-8e1c-ac30cddc3b27" body="&lt;p>CoroutineParser is an API for parser threads that operate as&#xA;coroutines. See CoroutineSAXParser and CoroutineSAXParser_Xerces&#xA;for examples.&lt;/p>&#xA;&#xA;&lt;p>&amp;lt;grumble&amp;gt; I'd like the interface to require a specific form&#xA;for either the base constructor or a static factory method. Java&#xA;doesn't allow us to specify either, so I'll just document them&#xA;here:&#xA;&#xA;&lt;ul>&#xA;&lt;li>public CoroutineParser(CoroutineManager co, int appCoroutine);&lt;/li>&#xA;&lt;li>public CoroutineParser createCoroutineParser(CoroutineManager co, int appCoroutine);&lt;/li>&#xA;&lt;/ul>&#xA;&#xA;&amp;lt;/grumble&amp;gt;&lt;/p>&#xA;&#xA;@deprecated Since the ability to start a parse via the&#xA;coroutine protocol was not being used and was complicating design.&#xA;See {@link IncrementalSAXSource}.&#xA;" annotatedElement="97264b58-0604-462e-a354-e9d0b19faa9c"/>
                      </packagedElement>
                      <packagedElement xmi:type="uml:Class" xmi:id="7914c477-80d8-4708-8128-ce5b7b412c6e" name="CustomStringPool">
                        <ownedComment xmi:id="1dcec687-86c9-4353-9b49-f57cf1b42607" body="&lt;p>CustomStringPool is an example of appliction provided data structure&#xA;for a DTM implementation to hold symbol references, e.g. elelment names.&#xA;It will follow the DTMDStringPool interface and use two simple methods&#xA;indexToString(int i) and stringToIndex(Sring s) to map between a set of&#xA;string values and a set of integer index values.  Therefore, an application&#xA;may improve DTM processing speed by substituting the DTM symbol resolution&#xA;tables with application specific quick symbol resolution tables.&lt;/p>&#xA;&#xA;%REVIEW% The only difference between this an DTMStringPool seems to be that&#xA;it uses a java.lang.Hashtable full of Integers rather than implementing its&#xA;own hashing. Joe deliberately avoided that approach when writing&#xA;DTMStringPool, since it is both much more memory-hungry and probably slower&#xA;-- especially in JDK 1.1.x, where Hashtable is synchronized. We need to&#xA;either justify this implementation or discard it.&#xA;&#xA;&lt;p>Status: In progress, under discussion.&lt;/p>&#xA;" annotatedElement="7914c477-80d8-4708-8128-ce5b7b412c6e"/>
                        <generalization xmi:id="6f2b3110-61fb-4e60-8bcd-30146eb87e06" isSubstitutable="true" general="2fe5d115-d8e2-4ec0-a1fd-3f0a1a305434"/>
                      </packagedElement>
                      <packagedElement xmi:type="uml:Class" xmi:id="59ccc38a-d7f7-42b4-ab67-fed330dbe0f9" name="DTMAxisIteratorBase" clientDependency="456d81ee-c8ea-4568-bf53-fba663751cd5" isAbstract="true">
                        <ownedComment xmi:id="48027585-a17d-4a9e-aa02-76216b15fc59" body="This class serves as a default base for implementations of mutable&#xA;DTMAxisIterators.&#xA;" annotatedElement="59ccc38a-d7f7-42b4-ab67-fed330dbe0f9"/>
                        <interfaceRealization xmi:id="456d81ee-c8ea-4568-bf53-fba663751cd5" name="" supplier="d6783634-64e5-48e5-87ae-8b9bc3e05831" client="59ccc38a-d7f7-42b4-ab67-fed330dbe0f9" contract="d6783634-64e5-48e5-87ae-8b9bc3e05831"/>
                      </packagedElement>
                      <packagedElement xmi:type="uml:Class" xmi:id="00d80817-daa5-4ceb-a40a-18cb56a2f5fd" name="DTMAxisIterNodeList">
                        <ownedComment xmi:id="fa06409e-de80-40eb-ab6e-29c6933567e4" body="&lt;code>DTMAxisNodeList&lt;/code> gives us an implementation of the DOM's&#xA;NodeList interface wrapped around a DTM Iterator. The author&#xA;considers this something of an abominations, since NodeList was not&#xA;intended to be a general purpose &quot;list of nodes&quot; API and is&#xA;generally considered by the DOM WG to have be a mistake... but I'm&#xA;told that some of the XPath/XSLT folks say they must have this&#xA;solution.&#xA;&#xA;Please note that this is not necessarily equivlaent to a DOM&#xA;NodeList operating over the same document. In particular:&#xA;&lt;ul>&#xA;&#xA;&lt;li>If there are several Text nodes in logical succession (ie,&#xA;across CDATASection and EntityReference boundaries), we will return&#xA;only the first; the caller is responsible for stepping through&#xA;them.&#xA;(%REVIEW% Provide a convenience routine here to assist, pending&#xA;proposed DOM Level 3 getAdjacentText() operation?) &lt;/li>&#xA;&#xA;&lt;li>Since the whole XPath/XSLT architecture assumes that the source&#xA;document is not altered while we're working with it, we do not&#xA;promise to implement the DOM NodeList's &quot;live view&quot; response to&#xA;document mutation. &lt;/li>&#xA;&#xA;&lt;/ul>&#xA;&#xA;&lt;p>State: In progress!!&lt;/p>&#xA;" annotatedElement="00d80817-daa5-4ceb-a40a-18cb56a2f5fd"/>
                        <generalization xmi:id="b0639efc-4b0e-4bbd-9524-7199e6ec549d" isSubstitutable="true" general="0e543fe3-3afb-4982-8b5f-a544b88481db"/>
                      </packagedElement>
                      <packagedElement xmi:type="uml:Class" xmi:id="5d544f11-5bed-4753-bb4b-b10dce7192b6" name="DTMChildIterNodeList">
                        <ownedComment xmi:id="e6942925-47a3-4450-9efe-311ddfa219b6" body="&lt;code>DTMNodeList&lt;/code> gives us an implementation of the DOM's&#xA;NodeList interface wrapped around a DTM Iterator. The author&#xA;considers this something of an abominations, since NodeList was not&#xA;intended to be a general purpose &quot;list of nodes&quot; API and is&#xA;generally considered by the DOM WG to have be a mistake... but I'm&#xA;told that some of the XPath/XSLT folks say they must have this&#xA;solution.&#xA;&#xA;Please note that this is not necessarily equivlaent to a DOM&#xA;NodeList operating over the same document. In particular:&#xA;&lt;ul>&#xA;&#xA;&lt;li>If there are several Text nodes in logical succession (ie,&#xA;across CDATASection and EntityReference boundaries), we will return&#xA;only the first; the caller is responsible for stepping through&#xA;them.&#xA;(%REVIEW% Provide a convenience routine here to assist, pending&#xA;proposed DOM Level 3 getAdjacentText() operation?) &lt;/li>&#xA;&#xA;&lt;li>Since the whole XPath/XSLT architecture assumes that the source&#xA;document is not altered while we're working with it, we do not&#xA;promise to implement the DOM NodeList's &quot;live view&quot; response to&#xA;document mutation. &lt;/li>&#xA;&#xA;&lt;/ul>&#xA;&#xA;&lt;p>State: In progress!!&lt;/p>&#xA;" annotatedElement="5d544f11-5bed-4753-bb4b-b10dce7192b6"/>
                        <generalization xmi:id="e8a44152-4141-4201-bf72-047490b3e16a" isSubstitutable="true" general="0e543fe3-3afb-4982-8b5f-a544b88481db"/>
                      </packagedElement>
                      <packagedElement xmi:type="uml:Class" xmi:id="b8d74ca2-6325-446d-914b-ba2eee22c2d1" name="DTMDefaultBase" clientDependency="e48f475c-dc03-4709-bbf9-81cd1884dd88" isAbstract="true">
                        <ownedComment xmi:id="f0da3964-11c1-427e-85f5-39b5c2a0ca2b" body="The &lt;code>DTMDefaultBase&lt;/code> class serves as a helper base for DTMs.&#xA;It sets up structures for navigation and type, while leaving data&#xA;management and construction to the derived classes.&#xA;" annotatedElement="b8d74ca2-6325-446d-914b-ba2eee22c2d1"/>
                        <interfaceRealization xmi:id="e48f475c-dc03-4709-bbf9-81cd1884dd88" name="" supplier="c7d7311d-0067-4490-8e4f-336672c94b2c" client="b8d74ca2-6325-446d-914b-ba2eee22c2d1" contract="c7d7311d-0067-4490-8e4f-336672c94b2c"/>
                      </packagedElement>
                      <packagedElement xmi:type="uml:Class" xmi:id="4ad727dc-8cdb-47a2-83bd-e738ccaba3a6" name="DTMDefaultBaseIterators" isAbstract="true">
                        <ownedComment xmi:id="c6174b2e-b9e5-4315-9d80-07acbe9fc8b9" body="This class implements the traversers for DTMDefaultBase.&#xA;" annotatedElement="4ad727dc-8cdb-47a2-83bd-e738ccaba3a6"/>
                        <generalization xmi:id="1bad98a5-db7e-458f-b317-855ee76bc7da" isSubstitutable="true" general="6c082fb9-beb7-4493-bcf2-6c8a6b952a3b"/>
                        <nestedClassifier xmi:type="uml:Class" xmi:id="21904ab6-0d7d-432b-8fbc-2b3c83338b4c" name="InternalAxisIteratorBase" isAbstract="true">
                          <ownedComment xmi:id="ede7b14a-a6ef-412e-b18f-bd5d2bd90833" body="Abstract superclass defining behaviors shared by all DTMDefault's&#xA;internal implementations of DTMAxisIterator. Subclass this (and&#xA;override, if necessary) to implement the specifics of an&#xA;individual axis iterator.&#xA;&#xA;Currently there isn't a lot here&#xA;" annotatedElement="21904ab6-0d7d-432b-8fbc-2b3c83338b4c"/>
                          <generalization xmi:id="dafc1d4a-ffd3-4dc3-a634-32415823b475" isSubstitutable="true" general="59ccc38a-d7f7-42b4-ab67-fed330dbe0f9"/>
                        </nestedClassifier>
                        <nestedClassifier xmi:type="uml:Class" xmi:id="20b2d1f6-0696-44c1-88e1-a45e86b52de5" name="ChildrenIterator">
                          <ownedComment xmi:id="27eb7a02-7c63-4897-bed8-5313a697f61c" body="Iterator that returns all immediate children of a given node&#xA;" annotatedElement="20b2d1f6-0696-44c1-88e1-a45e86b52de5"/>
                          <generalization xmi:id="4b45d738-666d-4a55-8bdd-df22e7ce7999" isSubstitutable="true" general="21904ab6-0d7d-432b-8fbc-2b3c83338b4c"/>
                        </nestedClassifier>
                        <nestedClassifier xmi:type="uml:Class" xmi:id="d029abce-1454-446d-8b5c-d58d5bdce46a" name="ParentIterator">
                          <ownedComment xmi:id="19df3b68-8ec1-4d41-a931-4a4ff492be56" body="Iterator that returns the parent of a given node. Note that&#xA;this delivers only a single node; if you want all the ancestors,&#xA;see AncestorIterator.&#xA;" annotatedElement="d029abce-1454-446d-8b5c-d58d5bdce46a"/>
                          <generalization xmi:id="f70bfc9a-e94f-4045-b4f2-aa6d174bfc6a" isSubstitutable="true" general="21904ab6-0d7d-432b-8fbc-2b3c83338b4c"/>
                        </nestedClassifier>
                        <nestedClassifier xmi:type="uml:Class" xmi:id="2c236096-2b0c-41b6-bacb-024200ffca72" name="TypedChildrenIterator">
                          <ownedComment xmi:id="fd6e2acd-e6f0-4c37-a73f-a8ea9cfe6da5" body="Iterator that returns children of a given type for a given node.&#xA;The functionality chould be achieved by putting a filter on top&#xA;of a basic child iterator, but a specialised iterator is used&#xA;for efficiency (both speed and size of translet).&#xA;" annotatedElement="2c236096-2b0c-41b6-bacb-024200ffca72"/>
                          <generalization xmi:id="7af63a3e-478e-4387-93e0-3b159093b5ae" isSubstitutable="true" general="21904ab6-0d7d-432b-8fbc-2b3c83338b4c"/>
                        </nestedClassifier>
                        <nestedClassifier xmi:type="uml:Class" xmi:id="08cde2a7-b2bb-4349-b86a-4fa7f93d11d9" name="NamespaceChildrenIterator">
                          <ownedComment xmi:id="9d2ebee2-cfd7-4f8e-b6a2-90ca3eefe21b" body="Iterator that returns children within a given namespace for a&#xA;given node. The functionality chould be achieved by putting a&#xA;filter on top of a basic child iterator, but a specialised&#xA;iterator is used for efficiency (both speed and size of translet).&#xA;" annotatedElement="08cde2a7-b2bb-4349-b86a-4fa7f93d11d9"/>
                          <generalization xmi:id="64572d3c-d531-41d2-8c92-8698c173e108" isSubstitutable="true" general="21904ab6-0d7d-432b-8fbc-2b3c83338b4c"/>
                        </nestedClassifier>
                        <nestedClassifier xmi:type="uml:Class" xmi:id="b9304187-7f28-48bf-be75-30d8512deced" name="NamespaceIterator">
                          <ownedComment xmi:id="caf81e50-37f2-45ac-934b-4bd88ee0803a" body="Iterator that returns the namespace nodes as defined by the XPath data model&#xA;for a given node.&#xA;" annotatedElement="b9304187-7f28-48bf-be75-30d8512deced"/>
                          <generalization xmi:id="b141aa2f-0d98-4805-ab1e-46fca13667aa" isSubstitutable="true" general="21904ab6-0d7d-432b-8fbc-2b3c83338b4c"/>
                        </nestedClassifier>
                        <nestedClassifier xmi:type="uml:Class" xmi:id="ba900828-b7c5-4e02-aae0-64d4d69f7a37" name="TypedNamespaceIterator">
                          <ownedComment xmi:id="1f979d38-f3b9-4b96-be86-3542b6c16b80" body="Iterator that returns the namespace nodes as defined by the XPath data model&#xA;for a given node, filtered by extended type ID.&#xA;" annotatedElement="ba900828-b7c5-4e02-aae0-64d4d69f7a37"/>
                          <generalization xmi:id="43e24804-0db5-4e0b-bcf4-70f9810c5073" isSubstitutable="true" general="b9304187-7f28-48bf-be75-30d8512deced"/>
                        </nestedClassifier>
                        <nestedClassifier xmi:type="uml:Class" xmi:id="4d01079e-5b33-418b-901a-b99569c2f83a" name="RootIterator">
                          <ownedComment xmi:id="924862aa-10d9-4036-a9b5-355ec870c7e6" body="Iterator that returns the the root node as defined by the XPath data model&#xA;for a given node.&#xA;" annotatedElement="4d01079e-5b33-418b-901a-b99569c2f83a"/>
                          <generalization xmi:id="8d0a6d5a-6ad9-4a7e-ad0a-d1895ee25313" isSubstitutable="true" general="21904ab6-0d7d-432b-8fbc-2b3c83338b4c"/>
                        </nestedClassifier>
                        <nestedClassifier xmi:type="uml:Class" xmi:id="74cd280e-d0ec-4add-a53d-50627d5aedf9" name="TypedRootIterator">
                          <ownedComment xmi:id="070b5695-7272-4615-8de1-060ce8638ed6" body="Iterator that returns the namespace nodes as defined by the XPath data model&#xA;for a given node, filtered by extended type ID.&#xA;" annotatedElement="74cd280e-d0ec-4add-a53d-50627d5aedf9"/>
                          <generalization xmi:id="7b042b4a-efc5-46db-8de9-12dba440db9f" isSubstitutable="true" general="4d01079e-5b33-418b-901a-b99569c2f83a"/>
                        </nestedClassifier>
                        <nestedClassifier xmi:type="uml:Class" xmi:id="e6d951b2-fd00-49ff-b3e5-08cd2391b7e4" name="NamespaceAttributeIterator">
                          <ownedComment xmi:id="5f31a057-03ae-4f7d-a97f-8baf78d38115" body="Iterator that returns attributes within a given namespace for a node.&#xA;" annotatedElement="e6d951b2-fd00-49ff-b3e5-08cd2391b7e4"/>
                          <generalization xmi:id="56fdd7ba-95c9-45e3-b6ea-90cdcf6ef067" isSubstitutable="true" general="21904ab6-0d7d-432b-8fbc-2b3c83338b4c"/>
                        </nestedClassifier>
                        <nestedClassifier xmi:type="uml:Class" xmi:id="df33a80b-7d46-41ab-be77-fb1f57390bd3" name="FollowingSiblingIterator">
                          <ownedComment xmi:id="a86c6692-85f3-469a-9725-dfd60e92f786" body="Iterator that returns all siblings of a given node.&#xA;" annotatedElement="df33a80b-7d46-41ab-be77-fb1f57390bd3"/>
                          <generalization xmi:id="71acfcac-7754-4f97-af47-0afbd3fb032e" isSubstitutable="true" general="21904ab6-0d7d-432b-8fbc-2b3c83338b4c"/>
