                    <generalization xmi:id="d50b5e1f-f26c-42b4-8224-6e0411a65162" isSubstitutable="true" general="1dbe73ca-3cac-457d-8b1d-a3bccb4b35ae"/>
                  </packagedElement>
                  <packagedElement xmi:type="uml:Class" xmi:id="ee36df24-9063-4087-8310-3bcbc27ac917" name="CDROutputStream" clientDependency="0c4e1e42-da1a-452c-bc77-2c87b2aa7020 567dd5e2-3553-4187-a50f-bf0fe4681b0e 5664ca37-4218-43d8-b75e-460e98a15feb" isAbstract="true">
                    <ownedComment xmi:id="df9894f7-1bf0-417d-a6c7-41449d7b709c" body="This is delegates to the real implementation.&#xA;" annotatedElement="ee36df24-9063-4087-8310-3bcbc27ac917"/>
                    <generalization xmi:id="28bd3dbc-fcd1-43ef-87ce-919bb183590f" isSubstitutable="true" general="91e9f8b0-667f-45ff-ad40-e3abf67c7439"/>
                    <interfaceRealization xmi:id="567dd5e2-3553-4187-a50f-bf0fe4681b0e" name="" supplier="92601c42-dc0a-4db4-84b0-5b1ac3d77d03" client="ee36df24-9063-4087-8310-3bcbc27ac917" contract="92601c42-dc0a-4db4-84b0-5b1ac3d77d03"/>
