                <interfaceRealization xmi:id="4b4c0755-b791-43ab-b2ba-32cbfe58fb77" name="" supplier="1e72bb21-e6c3-4a01-b9f9-0d2920aea021" client="b880b07b-8594-47a9-b565-bf337dc7c214" contract="1e72bb21-e6c3-4a01-b9f9-0d2920aea021"/>
