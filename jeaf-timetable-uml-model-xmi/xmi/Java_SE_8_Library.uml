                </templateBinding>
              </packagedElement>
              <packagedElement xmi:type="uml:Class" xmi:id="7f84592f-72e1-4dc3-a8fd-eea3f6e137b0" name="WeakReference&lt;ListenerWrapper>">
                <templateBinding xmi:id="df74b663-bc72-47f1-9d46-1e1bdfbb86c0" signature="9252aca1-1101-47b8-ba29-36de36616b9a">
                  <parameterSubstitution xmi:id="7ea58549-11f0-4eb3-a50a-cf71974b1a5b" formal="89715b01-615a-40f1-937e-932b5ec2604a" actual="2e54ef3a-da31-430d-be37-f9f4ddb7c617"/>
                </templateBinding>
              </packagedElement>
              <packagedElement xmi:type="uml:Interface" xmi:id="02bc9024-1607-4c08-95a4-755e0785ab1f" name="Set&lt;ObjectName>">
                <templateBinding xmi:id="60855ddb-9c57-4879-b716-d6174c38b23f" signature="e404761f-aaaa-437f-91d9-939fcff0d8fe">
                  <parameterSubstitution xmi:id="3881e389-abd0-4669-ba08-818db85cbf85" formal="cab8b42e-6617-48ac-bb01-a30fdf8de7ba" actual="17ae18be-0ef8-451d-8142-dad651cebc36"/>
                </templateBinding>
              </packagedElement>
              <packagedElement xmi:type="uml:Interface" xmi:id="4e4798c3-70d3-4963-ac41-690defec4c39" name="Set&lt;ObjectInstance>">
                <templateBinding xmi:id="aec4534f-a0f2-4f72-84b7-86e326a3ad2b" signature="e404761f-aaaa-437f-91d9-939fcff0d8fe">
                  <parameterSubstitution xmi:id="bca371f6-a8d3-4527-a325-ab3fcb211e78" formal="cab8b42e-6617-48ac-bb01-a30fdf8de7ba" actual="33fa2c70-6b1a-4793-815e-2664a7cc0b9a"/>
