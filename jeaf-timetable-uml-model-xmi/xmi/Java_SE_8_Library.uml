                  <ownedTemplateSignature xmi:type="uml:RedefinableTemplateSignature" xmi:id="5dae9ec2-8741-453c-bf02-af104a118df7" name="" visibility="public" parameter="1d5966d0-8271-404d-bd82-25e1d0235cc5">
                    <ownedParameter xmi:type="uml:ClassifierTemplateParameter" xmi:id="1d5966d0-8271-404d-bd82-25e1d0235cc5" parameteredElement="e88ca772-6270-4473-be6d-5674f044b638">
                      <ownedParameteredElement xmi:type="uml:Class" xmi:id="e88ca772-6270-4473-be6d-5674f044b638" name="M" templateParameter="1d5966d0-8271-404d-bd82-25e1d0235cc5"/>
                    </ownedParameter>
                  </ownedTemplateSignature>
                </nestedClassifier>
                <nestedClassifier xmi:type="uml:Class" xmi:id="a20a7960-924b-46e5-a388-9b0dd6d3800c" name="AttrMethods" visibility="private">
                  <ownedTemplateSignature xmi:type="uml:RedefinableTemplateSignature" xmi:id="78fcc6a7-e514-4df0-b830-ce60d72f81d7" name="" visibility="public" parameter="e94eb7b7-28cd-45a8-9c77-d64d478e85f0">
                    <ownedParameter xmi:type="uml:ClassifierTemplateParameter" xmi:id="e94eb7b7-28cd-45a8-9c77-d64d478e85f0" parameteredElement="58ed7cb8-d33f-4f6a-a4ee-5201326b82fb">
