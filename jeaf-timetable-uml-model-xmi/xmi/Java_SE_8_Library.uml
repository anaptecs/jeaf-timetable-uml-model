                <ownedComment xmi:id="34e6dc88-80b0-490d-8272-92f452f9de94" body="This is a writer for HTMLDocuments.&#xA;&#xA;@author  Sunita Mani&#xA;" annotatedElement="2bfa564a-2cda-4b31-938b-2357ba659660"/>
                <generalization xmi:id="b284af6c-1afa-4e20-967a-1e7edb71d2d9" isSubstitutable="true" general="a75549f0-7947-40a9-98bc-de56bff2371c"/>
