              <packagedElement xmi:type="uml:Class" xmi:id="0744f394-f326-419d-99b0-1ea1d1cb0d70" name="HTMLFrameHyperlinkEvent">
                <ownedComment xmi:id="3018da37-a8ec-40c4-b740-7f1bb10601eb" body="HTMLFrameHyperlinkEvent is used to notify interested&#xA;parties that link was activated in a frame.&#xA;&#xA;@author Sunita Mani&#xA;" annotatedElement="0744f394-f326-419d-99b0-1ea1d1cb0d70"/>
                <generalization xmi:id="64b8eaa0-0d9e-4a45-8816-184317269f80" isSubstitutable="true" general="4185e335-7cd4-469b-a413-8c3f1671fc8a"/>
