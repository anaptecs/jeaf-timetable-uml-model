                </templateBinding>
              </packagedElement>
              <packagedElement xmi:type="uml:Interface" xmi:id="77c374f7-1420-484f-8ce9-9f2af2f7eb18" name="List&lt;AclEntry>">
                <templateBinding xmi:id="cb15ae8a-23aa-4b04-9e8b-b56d3cce3900" signature="3e71fc6e-9a72-4a79-82dc-c9a0ddc40a6d">
                  <parameterSubstitution xmi:id="d3e3762a-3c01-42f5-894d-628e6e0f7f56" formal="5d8b8a6a-c59b-4de0-9ece-820c205828df" actual="6fac324b-a9c8-42e9-87da-73d29a113642"/>
                </templateBinding>
              </packagedElement>
              <packagedElement xmi:type="uml:Interface" xmi:id="995a4cb8-cc39-426d-bab7-350a5f307833" name="Set&lt;PosixFilePermission>">
                <templateBinding xmi:id="d950692f-67e0-44d6-aed8-e8d72af3c9c7" signature="e404761f-aaaa-437f-91d9-939fcff0d8fe">
                  <parameterSubstitution xmi:id="3a712b80-f66c-401f-bddd-d35634affb00" formal="cab8b42e-6617-48ac-bb01-a30fdf8de7ba" actual="48c16b8a-027b-41bb-97a0-ecf0aa96933c"/>
