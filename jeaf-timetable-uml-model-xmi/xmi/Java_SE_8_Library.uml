            <nestedClassifier xmi:type="uml:Class" xmi:id="e20931f4-8a75-4d24-9b9f-77edae35bf20" name="AccessibleJToolBar" visibility="protected">
              <ownedComment xmi:id="3ba00ef0-7ef7-4a21-be41-a7a2d71bb12e" body="This class implements accessibility support for the&#xA;&lt;code>JToolBar&lt;/code> class.  It provides an implementation of the&#xA;Java Accessibility API appropriate to toolbar user-interface elements.&#xA;" annotatedElement="e20931f4-8a75-4d24-9b9f-77edae35bf20"/>
              <generalization xmi:id="a4b2fda3-d5a1-4126-a859-7f8996d24deb" isSubstitutable="true" general="68e47b36-9d7c-40f8-88ff-0e6dd14e72ad"/>
