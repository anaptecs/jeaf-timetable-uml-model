                </ownedParameter>
                <ownedParameter xmi:type="uml:ClassifierTemplateParameter" xmi:id="2c403483-d1be-41f3-9763-c9489e5d536f" parameteredElement="22094017-7bf6-46df-ac1b-8af696686496">
