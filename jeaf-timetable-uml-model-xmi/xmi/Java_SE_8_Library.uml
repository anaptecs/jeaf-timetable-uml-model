                <ownedComment xmi:id="d0eef876-fa44-4eb1-ae90-6545db3f13d8" body="Key-value entry.  This class is never exported out as a&#xA;user-mutable Map.Entry (i.e., one supporting setValue; see&#xA;MapEntry below), but can be used for read-only traversals used&#xA;in bulk tasks.  Subclasses of Node with a negative hash field&#xA;are special, and contain null keys and values (but are never&#xA;exported).  Otherwise, keys and vals are never null.&#xA;" annotatedElement="3d9c28e4-8cda-44ea-af46-f7e175594e13"/>
                <ownedTemplateSignature xmi:type="uml:RedefinableTemplateSignature" xmi:id="00c942f9-e317-4092-be6e-ed8f26a36dff" name="" visibility="public" parameter="56f7d442-c78d-45f6-b8e2-db5a1231d7fa 03669a8e-7d6f-4a4c-b2cb-4f3e1c90c11c">
