                      </nestedClassifier>
                      <nestedClassifier xmi:type="uml:Interface" xmi:id="685a6046-aa44-44e5-94ec-b0211967ace5" name="ClassFile" isAbstract="true">
                        <ownedComment xmi:id="0a2f5f2d-eb77-40b1-ac4a-d08e5368c5a3" body="Contains information about file/ZIP entry of the Java class.&#xA;" annotatedElement="685a6046-aa44-44e5-94ec-b0211967ace5"/>
                      </nestedClassifier>
                      <nestedClassifier xmi:type="uml:Class" xmi:id="ee701093-d75a-45c7-af8c-a2d0f47e5a7c" name="Dir" visibility="private">
                        <generalization xmi:id="b6515055-9d0e-463d-8559-53d965e67d33" isSubstitutable="true" general="2e2b063b-9ef9-4533-8a47-12b5a55aa0eb"/>
                      </nestedClassifier>
                      <nestedClassifier xmi:type="uml:Class" xmi:id="af14afc4-e44c-48af-b7d3-eb039e7df0ae" name="Zip" visibility="private">
                        <generalization xmi:id="7ef44d5e-f37d-4312-b34a-a9c7b455ffc5" isSubstitutable="true" general="2e2b063b-9ef9-4533-8a47-12b5a55aa0eb"/>
                      </nestedClassifier>
                    </packagedElement>
                    <packagedElement xmi:type="uml:Class" xmi:id="5c0da286-7978-4f4c-a3d7-572d52dd18b3" name="ClassQueue" clientDependency="116879e9-fb74-4414-9257-f5897a395fb9">
                      <ownedComment xmi:id="5d015327-3860-4f9c-92c7-575b3fcd61af" body="Utility class implementing a (typesafe) queue of JavaClass&#xA;objects.&#xA;&#xA;@author &lt;A HREF=&quot;mailto:markus.dahm@berlin.de&quot;>M. Dahm&lt;/A>&#xA;@see ClassVector&#xA;" annotatedElement="5c0da286-7978-4f4c-a3d7-572d52dd18b3"/>
                      <interfaceRealization xmi:id="116879e9-fb74-4414-9257-f5897a395fb9" name="" supplier="41f4a654-a713-47bf-a391-e112be100ec5" client="5c0da286-7978-4f4c-a3d7-572d52dd18b3" contract="41f4a654-a713-47bf-a391-e112be100ec5"/>
                    </packagedElement>
                    <packagedElement xmi:type="uml:Class" xmi:id="d3b6e974-c471-4657-8dad-cd2d16201468" name="ClassSet" clientDependency="1cc8c31b-6fda-43ff-9fd2-f15774576716">
                      <ownedComment xmi:id="fb081a43-89f7-40a2-97e7-052c14d6b4a5" body="Utility class implementing a (typesafe) set of JavaClass objects.&#xA;Since JavaClass has no equals() method, the name of the class is&#xA;used for comparison.&#xA;&#xA;@author &lt;A HREF=&quot;mailto:markus.dahm@berlin.de&quot;>M. Dahm&lt;/A>&#xA;@see ClassStack&#xA;" annotatedElement="d3b6e974-c471-4657-8dad-cd2d16201468"/>
                      <interfaceRealization xmi:id="1cc8c31b-6fda-43ff-9fd2-f15774576716" name="" supplier="41f4a654-a713-47bf-a391-e112be100ec5" client="d3b6e974-c471-4657-8dad-cd2d16201468" contract="41f4a654-a713-47bf-a391-e112be100ec5"/>
                    </packagedElement>
                    <packagedElement xmi:type="uml:Class" xmi:id="e9119912-052f-4730-aa66-222eba7f719c" name="ClassStack" clientDependency="747a3833-6f9d-4b8a-9d78-58b2bf103c67">
                      <ownedComment xmi:id="ff89d9e5-c96f-4730-b735-989d13ba92e5" body="Utility class implementing a (typesafe) stack of JavaClass objects.&#xA;&#xA;@author &lt;A HREF=&quot;mailto:markus.dahm@berlin.de&quot;>M. Dahm&lt;/A>&#xA;@see Stack&#xA;" annotatedElement="e9119912-052f-4730-aa66-222eba7f719c"/>
                      <interfaceRealization xmi:id="747a3833-6f9d-4b8a-9d78-58b2bf103c67" name="" supplier="41f4a654-a713-47bf-a391-e112be100ec5" client="e9119912-052f-4730-aa66-222eba7f719c" contract="41f4a654-a713-47bf-a391-e112be100ec5"/>
                    </packagedElement>
                    <packagedElement xmi:type="uml:Class" xmi:id="08696d51-7a8f-4e31-bb8f-2a754c12c516" name="ClassVector" clientDependency="3df597c9-5fa0-46e4-8fd1-d0fc864d951f">
                      <ownedComment xmi:id="f03ca2f6-7655-4922-ad6d-498256d781f7" body="Utility class implementing a (typesafe) collection of JavaClass&#xA;objects. Contains the most important methods of a Vector.&#xA;&#xA;@author &lt;A HREF=&quot;mailto:markus.dahm@berlin.de&quot;>M. Dahm&lt;/A>&#xA;@see ClassQueue&#xA;" annotatedElement="08696d51-7a8f-4e31-bb8f-2a754c12c516"/>
                      <interfaceRealization xmi:id="3df597c9-5fa0-46e4-8fd1-d0fc864d951f" name="" supplier="41f4a654-a713-47bf-a391-e112be100ec5" client="08696d51-7a8f-4e31-bb8f-2a754c12c516" contract="41f4a654-a713-47bf-a391-e112be100ec5"/>
                    </packagedElement>
                    <packagedElement xmi:type="uml:Class" xmi:id="4502c9bb-98ab-4914-87ad-5ab5753f3109" name="CodeHTML" visibility="package" clientDependency="9e1e4b60-592f-47e3-b5ad-d13bbba3b642">
                      <ownedComment xmi:id="ed876fba-c545-4386-a6fd-2e84393a44df" body="Convert code into HTML file.&#xA;&#xA;@author  &lt;A HREF=&quot;mailto:markus.dahm@berlin.de&quot;>M. Dahm&lt;/A>&#xA;&#xA;" annotatedElement="4502c9bb-98ab-4914-87ad-5ab5753f3109"/>
                      <interfaceRealization xmi:id="9e1e4b60-592f-47e3-b5ad-d13bbba3b642" name="" supplier="588427ec-cd74-469c-9883-2910b062295c" client="4502c9bb-98ab-4914-87ad-5ab5753f3109" contract="588427ec-cd74-469c-9883-2910b062295c"/>
                    </packagedElement>
                    <packagedElement xmi:type="uml:Class" xmi:id="e43f2838-f082-4dc7-aa36-f7a003c474ac" name="ConstantHTML" visibility="package" clientDependency="2c3210ea-1d34-4a4c-80ee-4f129545a7e1">
                      <ownedComment xmi:id="6b6c81d0-7fa9-4c0b-8d29-86f8b1d351a2" body="Convert constant pool into HTML file.&#xA;&#xA;@author  &lt;A HREF=&quot;mailto:markus.dahm@berlin.de&quot;>M. Dahm&lt;/A>&#xA;&#xA;" annotatedElement="e43f2838-f082-4dc7-aa36-f7a003c474ac"/>
                      <interfaceRealization xmi:id="2c3210ea-1d34-4a4c-80ee-4f129545a7e1" name="" supplier="588427ec-cd74-469c-9883-2910b062295c" client="e43f2838-f082-4dc7-aa36-f7a003c474ac" contract="588427ec-cd74-469c-9883-2910b062295c"/>
                    </packagedElement>
                    <packagedElement xmi:type="uml:Class" xmi:id="a38c52f8-5717-4ece-ae11-e67b7d97a386" name="InstructionFinder">
                      <ownedComment xmi:id="7459d164-bf8b-4845-8b14-ea174c5d3f6a" body="InstructionFinder is a tool to search for given instructions patterns,&#xA;i.e., match sequences of instructions in an instruction list via&#xA;regular expressions. This can be used, e.g., in order to implement&#xA;a peep hole optimizer that looks for code patterns and replaces&#xA;them with faster equivalents.&#xA;&#xA;&lt;p>This class internally uses the &lt;a href=&quot;http://jakarta.apache.org/regexp/&quot;>&#xA;Regexp&lt;/a> package to search for regular expressions.&#xA;&#xA;A typical application would look like this:&#xA;&lt;pre>&#xA;InstructionFinder f   = new InstructionFinder(il);&#xA;String            pat = &quot;IfInstruction ICONST_0 GOTO ICONST_1 NOP (IFEQ|IFNE)&quot;;&#xA;for(Iterator i = f.search(pat, constraint); i.hasNext(); ) {&#xA;InstructionHandle[] match = (InstructionHandle[])i.next();&#xA;...&#xA;il.delete(match[1], match[5]);&#xA;...&#xA;}&#xA;&lt;/pre>&#xA;@author  &lt;A HREF=&quot;http://www.berlin.de/~markus.dahm/&quot;>M. Dahm&lt;/A>&#xA;@see Instruction&#xA;@see InstructionList&#xA;" annotatedElement="a38c52f8-5717-4ece-ae11-e67b7d97a386"/>
                      <nestedClassifier xmi:type="uml:Interface" xmi:id="72a7f536-c750-483b-9eac-93286d9fe66a" name="CodeConstraint" isAbstract="true">
                        <ownedComment xmi:id="e6dd0fd1-3a93-4d71-9989-7f7fda1b3b75" body="Code patterns found may be checked using an additional&#xA;user-defined constraint object whether they really match the needed criterion.&#xA;I.e., check constraints that can not expressed with regular expressions.&#xA;&#xA;" annotatedElement="72a7f536-c750-483b-9eac-93286d9fe66a"/>
                      </nestedClassifier>
                    </packagedElement>
                    <packagedElement xmi:type="uml:Class" xmi:id="d5f033b4-4686-4bfa-bc5f-ca5f89f0d141" name="JavaWrapper">
                      <ownedComment xmi:id="fa82ec35-3204-42ee-a669-ee2f6abc2735" body="Java interpreter replacement, i.e., wrapper that uses its own ClassLoader&#xA;to modify/generate classes as they're requested. You can take this as a template&#xA;for your own applications.&lt;br>&#xA;Call this wrapper with&#xA;&lt;pre>java com.sun.org.apache.bcel.internal.util.JavaWrapper &amp;lt;real.class.name&amp;gt; [arguments]&lt;/pre>&#xA;&lt;p>&#xA;To use your own class loader you can set the &quot;bcel.classloader&quot; system property&#xA;which defaults to &quot;com.sun.org.apache.bcel.internal.util.ClassLoader&quot;, e.g., with&#xA;&lt;pre>java com.sun.org.apache.bcel.internal.util.JavaWrapper -Dbcel.classloader=foo.MyLoader &amp;lt;real.class.name&amp;gt; [arguments]&lt;/pre>&#xA;&lt;/p>&#xA;&#xA;@version $Id: JavaWrapper.java,v 1.3 2007-07-19 04:34:52 ofung Exp $&#xA;@author  &lt;A HREF=&quot;mailto:markus.dahm@berlin.de&quot;>M. Dahm&lt;/A>&#xA;@see ClassLoader&#xA;" annotatedElement="d5f033b4-4686-4bfa-bc5f-ca5f89f0d141"/>
                    </packagedElement>
                    <packagedElement xmi:type="uml:Class" xmi:id="33289e92-b0ec-4927-992e-ab72530e405b" name="MethodHTML" visibility="package" clientDependency="1f21c34f-7289-4a5f-a168-cd119c06cb09">
                      <ownedComment xmi:id="f98b8ce1-1102-4903-82f1-035aabc5f30b" body="Convert methods and fields into HTML file.&#xA;&#xA;@author  &lt;A HREF=&quot;mailto:markus.dahm@berlin.de&quot;>M. Dahm&lt;/A>&#xA;&#xA;" annotatedElement="33289e92-b0ec-4927-992e-ab72530e405b"/>
                      <interfaceRealization xmi:id="1f21c34f-7289-4a5f-a168-cd119c06cb09" name="" supplier="588427ec-cd74-469c-9883-2910b062295c" client="33289e92-b0ec-4927-992e-ab72530e405b" contract="588427ec-cd74-469c-9883-2910b062295c"/>
                    </packagedElement>
                    <packagedElement xmi:type="uml:Interface" xmi:id="0b165e61-7d05-4739-83ba-3312bb7c1fed" name="Repository" isAbstract="true">
                      <ownedComment xmi:id="2f2ce0e9-ae5b-41a3-877d-7bf0282cc989" body="Abstract definition of a class repository. Instances may be used&#xA;to load classes from different sources and may be used in the&#xA;Repository.setRepository method.&#xA;&#xA;@see com.sun.org.apache.bcel.internal.Repository&#xA;@author &lt;A HREF=&quot;mailto:markus.dahm@berlin.de&quot;>M. Dahm&lt;/A>&#xA;@author David Dixon-Peugh&#xA;" annotatedElement="0b165e61-7d05-4739-83ba-3312bb7c1fed"/>
                      <generalization xmi:id="96bbc1dc-f686-470a-815b-58210b16fb34" isSubstitutable="true" general="41f4a654-a713-47bf-a391-e112be100ec5"/>
                    </packagedElement>
                    <packagedElement xmi:type="uml:Class" xmi:id="82f6e58d-82f3-4654-8d7d-eb612177dcdc" name="SecuritySupport">
                      <ownedComment xmi:id="1a86233c-4383-4f0c-b7b3-2d21be41faa6" body="This class is duplicated for each subpackage so keep it in sync. It is&#xA;package private and therefore is not exposed as part of any API.&#xA;&#xA;@xerces.internal&#xA;" annotatedElement="82f6e58d-82f3-4654-8d7d-eb612177dcdc"/>
                    </packagedElement>
                    <packagedElement xmi:type="uml:Class" xmi:id="e196026c-4d41-4640-adf3-2615001906b2" name="SyntheticRepository" clientDependency="15743d22-bb4e-4ffe-9c92-eca48bc61cb3">
                      <ownedComment xmi:id="724cd6c7-08b5-46a7-9af8-54b649e13f02" body="This repository is used in situations where a Class is created&#xA;outside the realm of a ClassLoader. Classes are loaded from&#xA;the file systems using the paths specified in the given&#xA;class path. By default, this is the value returned by&#xA;ClassPath.getClassPath().&#xA;&lt;br>&#xA;It is designed to be used as a singleton, however it&#xA;can also be used with custom classpaths.&#xA;&#xA;&#xA;Abstract definition of a class repository. Instances may be used&#xA;to load classes from different sources and may be used in the&#xA;Repository.setRepository method.&#xA;&#xA;@see com.sun.org.apache.bcel.internal.Repository&#xA;&#xA;@author &lt;A HREF=&quot;mailto:markus.dahm@berlin.de&quot;>M. Dahm&lt;/A>&#xA;@author David Dixon-Peugh&#xA;" annotatedElement="e196026c-4d41-4640-adf3-2615001906b2"/>
                      <interfaceRealization xmi:id="15743d22-bb4e-4ffe-9c92-eca48bc61cb3" name="" supplier="0b165e61-7d05-4739-83ba-3312bb7c1fed" client="e196026c-4d41-4640-adf3-2615001906b2" contract="0b165e61-7d05-4739-83ba-3312bb7c1fed"/>
                    </packagedElement>
                  </packagedElement>
                  <packagedElement xmi:type="uml:Interface" xmi:id="588427ec-cd74-469c-9883-2910b062295c" name="Constants" isAbstract="true">
