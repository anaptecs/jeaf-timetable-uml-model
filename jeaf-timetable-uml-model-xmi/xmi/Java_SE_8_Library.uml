              <packagedElement xmi:type="uml:Class" xmi:id="f633cdcb-a322-4fb2-8e73-1677af4b13ed" name="AtomicReferenceArray" clientDependency="6efaf017-c42b-48ef-a4cb-48a6383630be">
                <ownedComment xmi:id="74c25116-abc2-4571-a51f-317a63929c4f" body="An array of object references in which elements may be updated&#xA;atomically.  See the {@link java.util.concurrent.atomic} package&#xA;specification for description of the properties of atomic&#xA;variables.&#xA;@since 1.5&#xA;@author Doug Lea&#xA;@param &lt;E> The base class of elements held in this array&#xA;" annotatedElement="f633cdcb-a322-4fb2-8e73-1677af4b13ed"/>
