            </nestedClassifier>
            <nestedClassifier xmi:type="uml:Class" xmi:id="d5e47f05-9150-442a-a2f2-fd06a4d1ee05" name="MaxSpring" visibility="private">
              <generalization xmi:id="1764953d-aff9-4a2d-bf6b-3a93c5f66d75" isSubstitutable="true" general="8bd06abe-d96e-43c7-aca3-234cc6da9962"/>
