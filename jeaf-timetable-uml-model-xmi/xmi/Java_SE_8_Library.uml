              <nestedClassifier xmi:type="uml:Class" xmi:id="e231bff6-39e2-4b64-ae30-5c52a6c761aa" name="PostorderEnumeration" visibility="package" clientDependency="0e15bfab-3090-4796-bfe5-53842a1361e9">
                <interfaceRealization xmi:id="0e15bfab-3090-4796-bfe5-53842a1361e9" name="" supplier="4fbc5aef-74ff-42a7-9902-e07beddfba92" client="e231bff6-39e2-4b64-ae30-5c52a6c761aa" contract="4fbc5aef-74ff-42a7-9902-e07beddfba92"/>
              </nestedClassifier>
              <nestedClassifier xmi:type="uml:Class" xmi:id="26420f1c-b0d1-4c40-891b-cd61ae10f5a3" name="BreadthFirstEnumeration" visibility="package" clientDependency="12bf32e9-ac0e-49ce-8db1-5e24d02046f9">
                <interfaceRealization xmi:id="12bf32e9-ac0e-49ce-8db1-5e24d02046f9" name="" supplier="4fbc5aef-74ff-42a7-9902-e07beddfba92" client="26420f1c-b0d1-4c40-891b-cd61ae10f5a3" contract="4fbc5aef-74ff-42a7-9902-e07beddfba92"/>
