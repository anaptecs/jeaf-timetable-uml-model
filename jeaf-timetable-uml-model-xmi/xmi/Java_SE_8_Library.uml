            <nestedClassifier xmi:type="uml:Class" xmi:id="62b52bfd-96f0-4b1a-8833-946e782f3695" name="LLSpliterator" visibility="package" clientDependency="75c75dd2-d7ef-46cd-b9cc-37e882b0145e">
              <ownedComment xmi:id="735f5020-f802-44b7-b02b-ffd6a24fc5c4" body="A customized variant of Spliterators.IteratorSpliterator" annotatedElement="62b52bfd-96f0-4b1a-8833-946e782f3695"/>
              <ownedTemplateSignature xmi:type="uml:RedefinableTemplateSignature" xmi:id="a7feca86-9cbe-4563-8d8b-52bac016e72b" name="" visibility="public" parameter="7674e0f3-554d-43d0-811b-8fe69541f276">
                <ownedParameter xmi:type="uml:ClassifierTemplateParameter" xmi:id="7674e0f3-554d-43d0-811b-8fe69541f276" parameteredElement="3e6d3523-f657-4bfb-8231-0062897547fb">
