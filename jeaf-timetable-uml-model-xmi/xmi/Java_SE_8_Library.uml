                    <packagedElement xmi:type="uml:Interface" xmi:id="92ad2641-010e-4ffd-9182-ef6f6d4cd73b" name="Visitor" isAbstract="true">
                      <ownedComment xmi:id="0fe5fbd1-e283-4932-93ec-80455049154a" body="Interface to make use of the Visitor pattern programming style.&#xA;I.e. a class that implements this interface can traverse the contents of&#xA;a Java class just by calling the `accept' method which all classes have.&#xA;&#xA;Implemented by wish of&#xA;&lt;A HREF=&quot;http://www.inf.fu-berlin.de/~bokowski&quot;>Boris Bokowski&lt;/A>.&#xA;&#xA;@author  &lt;A HREF=&quot;mailto:markus.dahm@berlin.de&quot;>M. Dahm&lt;/A>&#xA;" annotatedElement="92ad2641-010e-4ffd-9182-ef6f6d4cd73b"/>
