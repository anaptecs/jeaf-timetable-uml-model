            <packagedElement xmi:type="uml:Interface" xmi:id="f94cadb7-5cc1-4586-98e9-436c6fedd2bd" name="DynAny" isAbstract="true">
              <ownedComment xmi:id="aafb1c20-50f1-4e54-9337-477c53a1f47b" body="Enables &lt;tt>org.omg.CORBA.Any&lt;/tt> values to be dynamically&#xA;interpreted (traversed) and&#xA;constructed. A &lt;tt>DynAny&lt;/tt> object is associated with a data value&#xA;which may correspond to a copy of the value inserted into an &lt;tt>Any&lt;/tt>.&#xA;The &lt;tt>DynAny&lt;/tt> APIs enable traversal of the data value associated with an&#xA;Any at runtime and extraction of the primitive constituents of the&#xA;data value.&#xA;@deprecated Use the new &lt;a href=&quot;../DynamicAny/DynAny.html&quot;>DynAny&lt;/a> instead&#xA;" annotatedElement="f94cadb7-5cc1-4586-98e9-436c6fedd2bd"/>
              <generalization xmi:id="c12f5e5c-6617-4dfb-877c-7acdc323ef0e" isSubstitutable="true" general="b9b8a38d-9489-45b5-8efa-c474c2cb87d3"/>
            </packagedElement>
            <packagedElement xmi:type="uml:Interface" xmi:id="e6110553-8724-4c65-8653-52abb2b3af4e" name="DynArray" isAbstract="true">
              <ownedComment xmi:id="9a62a8d8-9b2a-48ee-a235-229324dcf140" body="Represents a &lt;tt>DynAny&lt;/tt> object associated&#xA;with an array.&#xA;@deprecated Use the new &lt;a href=&quot;../DynamicAny/DynArray.html&quot;>DynArray&lt;/a> instead&#xA;" annotatedElement="e6110553-8724-4c65-8653-52abb2b3af4e"/>
              <generalization xmi:id="68143a0c-87f7-4be6-b214-28107b07c6d1" isSubstitutable="true" general="b9b8a38d-9489-45b5-8efa-c474c2cb87d3"/>
              <generalization xmi:id="b6a93934-db10-4f07-ad49-b1cbe4f24f25" isSubstitutable="true" general="f94cadb7-5cc1-4586-98e9-436c6fedd2bd"/>
            </packagedElement>
            <packagedElement xmi:type="uml:Interface" xmi:id="3b3ce807-e3fd-4d99-9333-42dbeffac982" name="DynEnum" isAbstract="true">
              <ownedComment xmi:id="f3e9a8c1-2e65-438c-885c-34a411bfbeca" body="Represents a &lt;tt>DynAny&lt;/tt> object  associated&#xA;with an IDL enum.&#xA;@deprecated Use the new &lt;a href=&quot;../DynamicAny/DynEnum.html&quot;>DynEnum&lt;/a> instead&#xA;" annotatedElement="3b3ce807-e3fd-4d99-9333-42dbeffac982"/>
