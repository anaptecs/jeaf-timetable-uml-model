                        <packagedElement xmi:type="uml:Class" xmi:id="10eb37b7-c87d-4514-be9a-97e99d1d4558" name="DTDDVFactoryImpl">
                          <ownedComment xmi:id="ae7e2d47-9610-47fd-b768-2ed92710db28" body="the factory to create/return built-in schema DVs and create user-defined DVs&#xA;&#xA;@xerces.internal&#xA;&#xA;@author Sandy Gao, IBM&#xA;&#xA;" annotatedElement="10eb37b7-c87d-4514-be9a-97e99d1d4558"/>
                          <generalization xmi:id="b5baa2f0-3723-42d8-a234-52acb78cf3ea" isSubstitutable="true" general="9b13c690-92bb-4f8b-b651-1cbb78f7dac7"/>
