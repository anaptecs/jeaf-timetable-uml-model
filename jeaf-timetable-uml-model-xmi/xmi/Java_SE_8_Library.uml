                    <generalization xmi:id="34ca34e6-5b44-4cf5-9582-ab0a0bedad9b" isSubstitutable="true" general="3a9e1eef-5990-41d3-ac9f-6d3e387409b6"/>
                  </nestedClassifier>
                </nestedClassifier>
