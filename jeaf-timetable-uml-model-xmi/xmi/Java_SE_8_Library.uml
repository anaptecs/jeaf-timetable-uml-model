            <packagedElement xmi:type="uml:Class" xmi:id="f0a6b12f-30d3-45c4-8107-cdc1d5f0dd04" name="Ellipse2D" isAbstract="true">
              <ownedComment xmi:id="e08df69c-9e81-4359-82d9-003cb97c0fd0" body="The &lt;code>Ellipse2D&lt;/code> class describes an ellipse that is defined&#xA;by a framing rectangle.&#xA;&lt;p>&#xA;This class is only the abstract superclass for all objects which&#xA;store a 2D ellipse.&#xA;The actual storage representation of the coordinates is left to&#xA;the subclass.&#xA;&#xA;@author      Jim Graham&#xA;@since 1.2&#xA;" annotatedElement="f0a6b12f-30d3-45c4-8107-cdc1d5f0dd04"/>
