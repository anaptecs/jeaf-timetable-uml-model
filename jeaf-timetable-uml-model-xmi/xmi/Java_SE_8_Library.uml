                <nestedClassifier xmi:type="uml:Class" xmi:id="167ab8e7-48b3-458d-874e-30f6271ce57e" name="ButtonAreaLayout" visibility="private" clientDependency="e023d584-edbb-4608-914e-608a2f6aa167">
