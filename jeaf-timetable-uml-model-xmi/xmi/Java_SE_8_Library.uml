                        <nestedClassifier xmi:type="uml:Class" xmi:id="07341531-2490-40a2-9cb2-081e41c88ded" name="TypedFollowingSiblingIterator">
                          <ownedComment xmi:id="12561353-dd22-476b-bbb0-84d97a51be27" body="Iterator that returns all following siblings of a given node.&#xA;" annotatedElement="07341531-2490-40a2-9cb2-081e41c88ded"/>
                          <generalization xmi:id="cbce0b8b-1619-4250-9759-c460e51fb540" isSubstitutable="true" general="df33a80b-7d46-41ab-be77-fb1f57390bd3"/>
                        </nestedClassifier>
                        <nestedClassifier xmi:type="uml:Class" xmi:id="71c006dd-9f86-4c43-8734-46cf28852a45" name="AttributeIterator">
                          <ownedComment xmi:id="402043c6-db18-438d-b4d9-525235e75ea9" body="Iterator that returns attribute nodes (of what nodes?)&#xA;" annotatedElement="71c006dd-9f86-4c43-8734-46cf28852a45"/>
                          <generalization xmi:id="399208eb-5a63-47c4-b743-22f45db0a3f2" isSubstitutable="true" general="21904ab6-0d7d-432b-8fbc-2b3c83338b4c"/>
                        </nestedClassifier>
                        <nestedClassifier xmi:type="uml:Class" xmi:id="717bbe77-15c7-4434-aca2-80457a758110" name="TypedAttributeIterator">
                          <ownedComment xmi:id="569117c5-95f1-46a4-823c-7b4b72945faf" body="Iterator that returns attribute nodes of a given type&#xA;" annotatedElement="717bbe77-15c7-4434-aca2-80457a758110"/>
                          <generalization xmi:id="c01720c3-11f8-4e32-b58f-1fe18dcd608b" isSubstitutable="true" general="21904ab6-0d7d-432b-8fbc-2b3c83338b4c"/>
                        </nestedClassifier>
                        <nestedClassifier xmi:type="uml:Class" xmi:id="9e5ad8bd-459b-4dde-8cfa-7dc791014ae9" name="PrecedingSiblingIterator">
                          <ownedComment xmi:id="b175d147-6093-490e-b858-7c1736502d23" body="Iterator that returns preceding siblings of a given node&#xA;" annotatedElement="9e5ad8bd-459b-4dde-8cfa-7dc791014ae9"/>
                          <generalization xmi:id="0141f2f4-216f-4622-b978-c709c7d85b1b" isSubstitutable="true" general="21904ab6-0d7d-432b-8fbc-2b3c83338b4c"/>
                        </nestedClassifier>
                        <nestedClassifier xmi:type="uml:Class" xmi:id="6337a984-3c3b-43b5-8b85-8e729be0fd3e" name="TypedPrecedingSiblingIterator">
                          <ownedComment xmi:id="dc524267-1a6e-48ad-9fb7-ab0d87224d14" body="Iterator that returns preceding siblings of a given type for&#xA;a given node&#xA;" annotatedElement="6337a984-3c3b-43b5-8b85-8e729be0fd3e"/>
                          <generalization xmi:id="14d0874b-dbf2-46a3-9464-d99678cb03ac" isSubstitutable="true" general="9e5ad8bd-459b-4dde-8cfa-7dc791014ae9"/>
                        </nestedClassifier>
                        <nestedClassifier xmi:type="uml:Class" xmi:id="8f82a934-71e1-4f77-a528-fcaaca5ad15a" name="PrecedingIterator">
                          <ownedComment xmi:id="1b7e3353-fe00-4c8c-9c21-048fc3597373" body="Iterator that returns preceding nodes of a given node.&#xA;This includes the node set {root+1, start-1}, but excludes&#xA;all ancestors, attributes, and namespace nodes.&#xA;" annotatedElement="8f82a934-71e1-4f77-a528-fcaaca5ad15a"/>
                          <generalization xmi:id="873d1f79-17c6-49ad-b562-9d11c6cc8057" isSubstitutable="true" general="21904ab6-0d7d-432b-8fbc-2b3c83338b4c"/>
                        </nestedClassifier>
                        <nestedClassifier xmi:type="uml:Class" xmi:id="06383b32-fad8-4da6-a497-d283b8ef349a" name="TypedPrecedingIterator">
