              <generalization xmi:id="72c7b6db-3228-4259-9b33-d32e4c0e700e" isSubstitutable="true" general="3533332d-4e81-489b-ab32-4addbaed0156"/>
              <generalization xmi:id="dbbb5465-6228-406d-8a1c-ad06d04c4580" isSubstitutable="true" general="39dc6961-1bc5-414d-b50b-d2129de5f5cc"/>
