              </nestedClassifier>
              <nestedClassifier xmi:type="uml:Class" xmi:id="fe937bc8-9a49-4079-b7e8-313ae724047a" name="ProxyClassFactory" visibility="private" clientDependency="ee7ab125-3dc8-42da-9f13-6b31b04e19d8">
                <ownedComment xmi:id="a62d8050-2a1d-4192-ab62-ffc5ca5926f6" body="A factory function that generates, defines and returns the proxy class given&#xA;the ClassLoader and array of interfaces.&#xA;" annotatedElement="fe937bc8-9a49-4079-b7e8-313ae724047a"/>
