                  <generalization xmi:id="046599ad-5432-4f86-9838-93b610517fe7" isSubstitutable="true" general="c15504bb-c7e6-4bfb-aeab-fad059cb0243"/>
                </packagedElement>
                <packagedElement xmi:type="uml:Class" xmi:id="458f5ea4-5189-4e63-be56-9304930fdb3d" name="JFIFMarkerSegment" visibility="package">
                  <ownedComment xmi:id="6e315ec8-55ba-42d3-9aa1-f7302283a26e" body="A JFIF (JPEG File Interchange Format) APP0 (Application-Specific)&#xA;marker segment.  Inner classes are included for JFXX extension&#xA;marker segments, for different varieties of thumbnails, and for&#xA;ICC Profile APP2 marker segments.  Any of these secondary types&#xA;that occur are kept as members of a single JFIFMarkerSegment object.&#xA;" annotatedElement="458f5ea4-5189-4e63-be56-9304930fdb3d"/>
                  <generalization xmi:id="5d0366aa-16dc-4d6b-8171-f71f07a0f230" isSubstitutable="true" general="c15504bb-c7e6-4bfb-aeab-fad059cb0243"/>
                  <nestedClassifier xmi:type="uml:Class" xmi:id="c2da801a-47e2-4d76-bb7a-e1157cef6b7d" name="IllegalThumbException" visibility="private">
