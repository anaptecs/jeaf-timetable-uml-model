                      </packagedElement>
                      <packagedElement xmi:type="uml:Class" xmi:id="0441d07e-3830-4f0c-8b89-f3d22312a13b" name="NodeIteratorBase" clientDependency="4059212b-e3d4-4339-871f-5c6cfdf09903" isAbstract="true">
