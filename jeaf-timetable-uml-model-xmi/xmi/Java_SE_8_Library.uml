                <ownedComment xmi:id="ea15ebb9-f5cc-439c-852c-fb01852cb1a6" body="Simple highlight painter that fills a highlighted area with&#xA;a solid color.&#xA;" annotatedElement="3a9e1eef-5990-41d3-ac9f-6d3e387409b6"/>
                <generalization xmi:id="4895b419-e68b-49bf-a1b0-9d3851a77fd4" isSubstitutable="true" general="7e90d078-1b4d-4f9b-a6ac-517904225bf6"/>
