              <packagedElement xmi:type="uml:Class" xmi:id="33563133-60e3-4a83-a027-8843468c7a58" name="AtomicStampedReference">
                <ownedComment xmi:id="b7d0c843-9e2f-4120-8e71-87db1dc3286b" body="An {@code AtomicStampedReference} maintains an object reference&#xA;along with an integer &quot;stamp&quot;, that can be updated atomically.&#xA;&#xA;&lt;p>Implementation note: This implementation maintains stamped&#xA;references by creating internal objects representing &quot;boxed&quot;&#xA;[reference, integer] pairs.&#xA;&#xA;@since 1.5&#xA;@author Doug Lea&#xA;@param &lt;V> The type of object referred to by this reference&#xA;" annotatedElement="33563133-60e3-4a83-a027-8843468c7a58"/>
