              <interfaceRealization xmi:id="95a30eda-313a-446a-976c-7a12aa6d0aea" name="" supplier="351d738c-b38b-49d3-b4b5-e99e202d16ba" client="969362ef-e598-460d-bf8a-7ccacc050f99" contract="351d738c-b38b-49d3-b4b5-e99e202d16ba"/>
              <interfaceRealization xmi:id="b22b39cb-5b18-4713-acea-dc4adc840454" name="" supplier="157caddf-a166-42dd-aeee-51e517c24af2" client="969362ef-e598-460d-bf8a-7ccacc050f99" contract="157caddf-a166-42dd-aeee-51e517c24af2"/>
