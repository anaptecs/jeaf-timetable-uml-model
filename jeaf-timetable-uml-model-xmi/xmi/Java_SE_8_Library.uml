              <nestedClassifier xmi:type="uml:Class" xmi:id="0afc3b3f-195c-4b96-80c0-c28e29e7a050" name="IntrinsicMethodHandle" visibility="private">
                <ownedComment xmi:id="cb392c5e-8c0b-4123-9197-6a7179823e40" body="Mark arbitrary method handle as intrinsic.&#xA;InvokerBytecodeGenerator uses this info to produce more efficient bytecode shape." annotatedElement="0afc3b3f-195c-4b96-80c0-c28e29e7a050"/>
