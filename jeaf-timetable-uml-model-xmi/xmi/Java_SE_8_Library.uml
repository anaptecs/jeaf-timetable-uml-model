            <interfaceRealization xmi:id="ed44710f-c991-41cb-8ebd-86f49d5d1d49" name="" supplier="af41d975-30f5-4ca2-9f69-6cae8e15d59a" client="13c27d2d-3687-41bd-af9f-31a9cd86201b" contract="af41d975-30f5-4ca2-9f69-6cae8e15d59a"/>
