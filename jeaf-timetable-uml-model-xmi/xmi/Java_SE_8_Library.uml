                <interfaceRealization xmi:id="fb517423-bfc6-4351-9d8b-450d008a6def" name="" supplier="48cc3f20-62b3-4f28-9b0f-1a6b930a4f86" client="4a51c4a6-7e0d-4b25-91b4-ba924002a1f7" contract="48cc3f20-62b3-4f28-9b0f-1a6b930a4f86"/>
                <interfaceRealization xmi:id="90dd1b32-61f1-4c3b-9614-12b3aac083d5" name="" supplier="e7d270f6-49ea-46a6-a95b-f7913dc33446" client="4a51c4a6-7e0d-4b25-91b4-ba924002a1f7" contract="e7d270f6-49ea-46a6-a95b-f7913dc33446"/>
                <interfaceRealization xmi:id="0ddb08b4-5c44-41a3-927d-4460b471da1f" name="" supplier="3ce6dc57-d314-4a29-b3eb-6626a13979fb" client="4a51c4a6-7e0d-4b25-91b4-ba924002a1f7" contract="3ce6dc57-d314-4a29-b3eb-6626a13979fb"/>
                <interfaceRealization xmi:id="8f484111-18e1-413f-97e9-e08ef54c53e1" name="" supplier="218dcb88-1af4-4569-8567-c68558c1a9c4" client="4a51c4a6-7e0d-4b25-91b4-ba924002a1f7" contract="218dcb88-1af4-4569-8567-c68558c1a9c4"/>
