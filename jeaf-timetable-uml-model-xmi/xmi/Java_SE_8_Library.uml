                  <nestedClassifier xmi:type="uml:Class" xmi:id="e1ee754a-0076-430d-84eb-e640f4e76662" name="JFIFThumbPalette" visibility="package">
                    <ownedComment xmi:id="535ff720-2f77-4d39-8a4e-88bbc32502c2" body="A JFIF thumbnail stored as an indexed palette image&#xA;using an RGB palette.&#xA;" annotatedElement="e1ee754a-0076-430d-84eb-e640f4e76662"/>
                    <generalization xmi:id="2c645203-f7f8-4a9d-a564-81cc64f9ccb8" isSubstitutable="true" general="f7093d7f-4b2d-46e2-b552-1e5c06d5921a"/>
                  </nestedClassifier>
                  <nestedClassifier xmi:type="uml:Class" xmi:id="6c16fdd2-1339-4213-8b8d-53c15876ac44" name="JFIFThumbJPEG" visibility="package">
                    <ownedComment xmi:id="b4379537-eed7-471c-803d-ca15d649b7cb" body="A JFIF thumbnail stored as a JPEG stream.  No JFIF or&#xA;JFIF extension markers are permitted.  There is no need&#xA;to clip these, but the entire image must fit into a&#xA;single JFXX marker segment.&#xA;" annotatedElement="6c16fdd2-1339-4213-8b8d-53c15876ac44"/>
                    <generalization xmi:id="926cd3ef-d1ad-4265-88a7-8a3f6a94537c" isSubstitutable="true" general="8bd91a04-bfad-436d-a292-e0e48b40d815"/>
