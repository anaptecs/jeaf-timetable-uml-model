              <ownedTemplateSignature xmi:type="uml:RedefinableTemplateSignature" xmi:id="aab99a3c-d5b8-414f-8a68-f8d6b4924efc" name="" visibility="public" parameter="e8b93a69-e966-4818-b458-347ddf37aed5">
                <ownedParameter xmi:type="uml:ClassifierTemplateParameter" xmi:id="e8b93a69-e966-4818-b458-347ddf37aed5" parameteredElement="cc965910-2242-49d3-909a-c65a32710114">
                  <ownedParameteredElement xmi:type="uml:Class" xmi:id="cc965910-2242-49d3-909a-c65a32710114" name="E" templateParameter="e8b93a69-e966-4818-b458-347ddf37aed5"/>
