          <packagedElement xmi:type="uml:Class" xmi:id="e839d530-26c6-4a47-a01f-b4790cb72147" name="CompareTabOrderComparator" visibility="package" clientDependency="e7a38804-f4b9-4399-802c-257332b26517">
