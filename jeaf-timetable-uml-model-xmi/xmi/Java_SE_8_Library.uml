                <ownedComment xmi:id="c495c12a-b98d-41ba-a700-aa655a4c330f" body="Added to all the Styles. When instances of this receive a&#xA;stateChanged method, styleChanged is invoked.&#xA;" annotatedElement="3a0af123-3c3f-43be-b0b6-9fa1d0b953ae"/>
