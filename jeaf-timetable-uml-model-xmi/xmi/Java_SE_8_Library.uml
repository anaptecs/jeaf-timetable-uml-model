              <interfaceRealization xmi:id="1cb12ca0-4bb6-4f92-8606-8ae9f63288ab" name="" supplier="e7d270f6-49ea-46a6-a95b-f7913dc33446" client="40fdebc5-0259-4b86-87ee-d990a58b0764" contract="e7d270f6-49ea-46a6-a95b-f7913dc33446"/>
              <nestedClassifier xmi:type="uml:Class" xmi:id="fdf24283-253d-419a-aeb8-44a0b6ce6ec0" name="AccessibleAWTComponentHandler" visibility="protected" clientDependency="4e91f73c-fa09-44bc-acdd-e68c2cf70a2a">
                <ownedComment xmi:id="8088c9b3-df31-46c1-bdb2-219cad129e37" body="Fire PropertyChange listener, if one is registered,&#xA;when shown/hidden..&#xA;@since 1.3&#xA;" annotatedElement="fdf24283-253d-419a-aeb8-44a0b6ce6ec0"/>
