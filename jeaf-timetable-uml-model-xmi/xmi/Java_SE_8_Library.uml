              </nestedClassifier>
              <nestedClassifier xmi:type="uml:Class" xmi:id="1d0a4f1a-bc78-4359-ab15-7a7327575278" name="TableStack" visibility="package">
                <ownedComment xmi:id="2d8c0229-6ff7-4206-9926-a887bad97baf" body="Records the table, its length, and current traversal index for a&#xA;traverser that must process a region of a forwarded table before&#xA;proceeding with current table.&#xA;" annotatedElement="1d0a4f1a-bc78-4359-ab15-7a7327575278"/>
                <ownedTemplateSignature xmi:type="uml:RedefinableTemplateSignature" xmi:id="876f7e72-4524-48d9-80bb-26996e8fe634" name="" visibility="public" parameter="967cbbdb-402c-4e27-86f6-5b98401d53d1 072d06f5-4e69-4d69-a992-828fecafa8e4">
                  <ownedParameter xmi:type="uml:ClassifierTemplateParameter" xmi:id="967cbbdb-402c-4e27-86f6-5b98401d53d1" parameteredElement="f69360cb-3db2-42a3-aea9-e9b26cb859e9">
                    <ownedParameteredElement xmi:type="uml:Class" xmi:id="f69360cb-3db2-42a3-aea9-e9b26cb859e9" name="K" templateParameter="967cbbdb-402c-4e27-86f6-5b98401d53d1"/>
                  </ownedParameter>
                  <ownedParameter xmi:type="uml:ClassifierTemplateParameter" xmi:id="072d06f5-4e69-4d69-a992-828fecafa8e4" parameteredElement="76f22a06-4511-45c9-833b-912e40aed5e6">
