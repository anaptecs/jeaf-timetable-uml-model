            <packagedElement xmi:type="uml:Class" xmi:id="5bd93c19-cb0a-4f51-8ba7-59c682692c77" name="SoftCache&lt;String, DataFlavor>">
              <templateBinding xmi:id="d35ede5e-06aa-498f-a0c9-601b7c88f660" signature="bf1ab832-38e4-42f0-997e-264a3d3dd6e9">
                <parameterSubstitution xmi:id="39ac959e-6741-4c2d-8933-a19a16ebac01" formal="a19d3548-cb19-4602-8d99-53956dfef4c2" actual="50286478-8b56-42c9-9375-a6f40dbd4c8c"/>
