                  <interfaceRealization xmi:id="475063da-46c6-4c5b-b2a6-60b7de2058e9" name="" supplier="be636250-2979-401d-87bf-99dc9b569330" client="83e96784-c22e-4e10-8749-471fe32a518b" contract="be636250-2979-401d-87bf-99dc9b569330"/>
                </nestedClassifier>
                <nestedClassifier xmi:type="uml:Class" xmi:id="cf3d90ce-63f9-4da7-ad25-45d0e7e8d660" name="ListDataHandler" clientDependency="24392c47-34d4-4707-877b-0352453050c3">
                  <ownedComment xmi:id="58a7e25c-da92-4a03-8b4d-071a8c5945ce" body="As of 1.4, this class is now obsolete, doesn't do anything, and&#xA;is only included for backwards API compatibility. Do not call or&#xA;override.&#xA;&lt;p>&#xA;The functionality has been migrated into &lt;code>ItemHandler&lt;/code>.&#xA;&#xA;@see #createItemListener&#xA;" annotatedElement="cf3d90ce-63f9-4da7-ad25-45d0e7e8d660"/>
                  <interfaceRealization xmi:id="24392c47-34d4-4707-877b-0352453050c3" name="" supplier="f0cebf17-2a30-4f0e-b617-9193d2677866" client="cf3d90ce-63f9-4da7-ad25-45d0e7e8d660" contract="f0cebf17-2a30-4f0e-b617-9193d2677866"/>
