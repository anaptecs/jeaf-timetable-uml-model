          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="64100c42-0a43-4fc8-aa31-80e4ad153844" name="UnknownServiceException">
            <ownedComment xmi:id="dc0cd94f-d836-40d7-a7a7-92cdbea375e4" body="Thrown to indicate that an unknown service exception has&#xA;occurred. Either the MIME type returned by a URL connection does&#xA;not make sense, or the application is attempting to write to a&#xA;read-only URL connection.&#xA;&#xA;@author  unascribed&#xA;@since   JDK1.0&#xA;" annotatedElement="64100c42-0a43-4fc8-aa31-80e4ad153844"/>
