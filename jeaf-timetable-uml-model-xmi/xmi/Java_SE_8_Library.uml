                <nestedClassifier xmi:type="uml:Class" xmi:id="4e2c6170-ee7a-4ac7-affd-7099a86e8cca" name="ButtonHandler" visibility="private" clientDependency="4cd8fbe5-ac50-4d58-893c-86e99354c432 18ec4b5a-629a-4541-8b39-b3096e61fa05">
                  <ownedComment xmi:id="4ed76c98-3b17-441b-8e48-bb1983b9b81c" body="Handles all the logic for treating the combo as a button when it is&#xA;not editable, and when shouldActLikeButton() is true. This class is a&#xA;special ButtonModel, and installed on the arrowButton when appropriate.&#xA;It also is installed as a mouse listener and mouse motion listener on&#xA;the combo box. In this way, the state between the button and combo&#xA;are in sync. Whenever one is &quot;over&quot; both are. Whenever one is pressed,&#xA;both are.&#xA;" annotatedElement="4e2c6170-ee7a-4ac7-affd-7099a86e8cca"/>
                  <generalization xmi:id="61788834-1605-48bc-8240-2ba92d53fcbd" isSubstitutable="true" general="c323ffcd-0aa4-4545-94fe-76bcf027b3eb"/>
