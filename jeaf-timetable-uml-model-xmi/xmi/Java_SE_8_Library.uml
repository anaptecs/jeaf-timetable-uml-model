                <generalization xmi:id="77087333-022c-43d9-aeee-bbb3d2dc9794" isSubstitutable="true" general="29cdb228-2cf1-48ee-a98e-e0c8d4f6346e"/>
              </nestedClassifier>
              <nestedClassifier xmi:type="uml:Class" xmi:id="463a10a0-a119-4c8e-8ff5-d69f954de6d5" name="UnixDot" visibility="package">
