                <nestedClassifier xmi:type="uml:Class" xmi:id="54bc58b8-5ae0-433e-86e6-99eefda2986e" name="MBeanInfoMaker" visibility="private" clientDependency="a11613b1-aec6-4b82-bf7a-98a4340eb989">
                  <ownedComment xmi:id="fb964cff-b9ab-44fb-8819-42b48a475116" body="A visitor that constructs the per-interface MBeanInfo." annotatedElement="54bc58b8-5ae0-433e-86e6-99eefda2986e"/>
