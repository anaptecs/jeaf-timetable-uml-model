                    </packagedElement>
                    <packagedElement xmi:type="uml:Class" xmi:id="27ca6189-d1e0-4429-91cc-f9f6fec2047a" name="EmptyVisitor" clientDependency="4df5c326-ecec-4e8a-a867-59724e6de0c8">
                      <ownedComment xmi:id="e559ddf9-eb59-4746-b8a0-4af746405276" body="Visitor with empty method bodies, can be extended and used in conjunction with the&#xA;DescendingVisitor class, e.g.&#xA;&#xA;By courtesy of David Spencer.&#xA;&#xA;@see DescendingVisitor&#xA;&#xA;" annotatedElement="27ca6189-d1e0-4429-91cc-f9f6fec2047a"/>
                      <interfaceRealization xmi:id="4df5c326-ecec-4e8a-a867-59724e6de0c8" name="" supplier="92ad2641-010e-4ffd-9182-ef6f6d4cd73b" client="27ca6189-d1e0-4429-91cc-f9f6fec2047a" contract="92ad2641-010e-4ffd-9182-ef6f6d4cd73b"/>
                    </packagedElement>
                    <packagedElement xmi:type="uml:Class" xmi:id="9281f0ba-bda9-4bc0-b095-069721701069" name="ExceptionTable">
                      <ownedComment xmi:id="7a69f0fa-8f18-4141-8153-447de8fa211c" body="This class represents the table of exceptions that are thrown by a&#xA;method. This attribute may be used once per method.  The name of&#xA;this class is &lt;em>ExceptionTable&lt;/em> for historical reasons; The&#xA;Java Virtual Machine Specification, Second Edition defines this&#xA;attribute using the name &lt;em>Exceptions&lt;/em> (which is inconsistent&#xA;with the other classes).&#xA;&#xA;@author  &lt;A HREF=&quot;mailto:markus.dahm@berlin.de&quot;>M. Dahm&lt;/A>&#xA;@see     Code&#xA;" annotatedElement="9281f0ba-bda9-4bc0-b095-069721701069"/>
                      <generalization xmi:id="e5467d9b-81ee-4f7a-a18d-32e31a374b77" isSubstitutable="true" general="3036d890-e66d-41b1-8ecb-9977d68690f1"/>
                    </packagedElement>
