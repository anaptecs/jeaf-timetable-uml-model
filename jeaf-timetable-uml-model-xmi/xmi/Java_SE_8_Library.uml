            <nestedClassifier xmi:type="uml:Class" xmi:id="dd50e78d-9366-4674-9b88-ede299e41c69" name="Enumerator" visibility="private" clientDependency="e8497c3e-823e-4f59-9770-c586666e7458 f3851461-e413-4770-bdd2-c974d9f9a294">
              <ownedComment xmi:id="92f2131d-d4c4-46a6-ba47-429b94ad2a0f" body="A hashtable enumerator class.  This class implements both the&#xA;Enumeration and Iterator interfaces, but individual instances&#xA;can be created with the Iterator methods disabled.  This is necessary&#xA;to avoid unintentionally increasing the capabilities granted a user&#xA;by passing an Enumeration.&#xA;" annotatedElement="dd50e78d-9366-4674-9b88-ede299e41c69"/>
