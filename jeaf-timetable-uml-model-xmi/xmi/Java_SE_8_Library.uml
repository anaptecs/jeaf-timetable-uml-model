            <packagedElement xmi:type="uml:Interface" xmi:id="e71e2621-6c45-4233-9cec-758a34277002" name="DynEnum" isAbstract="true">
              <ownedComment xmi:id="f565720e-9283-45b0-ae44-7129d8ca06c2" body="DynEnum objects support the manipulation of IDL enumerated values.&#xA;The current position of a DynEnum is always -1.&#xA;" annotatedElement="e71e2621-6c45-4233-9cec-758a34277002"/>
              <generalization xmi:id="d6327beb-3882-4434-91dd-8b6b176a036f" isSubstitutable="true" general="fdff36c0-8eba-40bd-92b2-eb7026bef82c"/>
              <generalization xmi:id="99c695f6-be32-42df-bb45-8a2b51024fa4" isSubstitutable="true" general="b7693357-1dfc-4cb4-85ba-9256e289b3d2"/>
              <generalization xmi:id="c4f28e2b-ee77-4bb3-a31a-44c34860afca" isSubstitutable="true" general="b38468cc-c261-4f52-86ea-658766759ede"/>
