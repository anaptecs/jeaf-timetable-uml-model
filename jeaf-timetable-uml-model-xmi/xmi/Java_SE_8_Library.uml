              <nestedClassifier xmi:type="uml:Class" xmi:id="e78ee924-5fc7-4206-9fda-17d384ac5306" name="LBDSpliterator" visibility="package" clientDependency="dd573214-7493-41ee-968d-604f6f7fdb71">
                <ownedComment xmi:id="020023e0-76cb-4ecc-a3b2-db18867e4d46" body="A customized variant of Spliterators.IteratorSpliterator" annotatedElement="e78ee924-5fc7-4206-9fda-17d384ac5306"/>
                <ownedTemplateSignature xmi:type="uml:RedefinableTemplateSignature" xmi:id="bdb7c906-4ca8-4312-8e82-0eeffd546fe8" name="" visibility="public" parameter="c9936e10-d004-4826-94d1-f7e164b0bfb6">
                  <ownedParameter xmi:type="uml:ClassifierTemplateParameter" xmi:id="c9936e10-d004-4826-94d1-f7e164b0bfb6" parameteredElement="2ddb035d-2b97-4404-9ec8-94405c9ea13c">
