                        <packagedElement xmi:type="uml:Class" xmi:id="ece12237-dae8-4816-8ed7-0902e09df67d" name="XSDAbstractTraverser" visibility="package" isAbstract="true">
                          <ownedComment xmi:id="4231ee93-bb89-4670-9a6c-0c2b622f12db" body="Class &lt;code>XSDAbstractTraverser&lt;/code> serves as the base class for all&#xA;other &lt;code>XSD???Traverser&lt;/code>s. It holds the common data and provide&#xA;a unified way to initialize these data.&#xA;&#xA;@xerces.internal&#xA;&#xA;@author Elena Litani, IBM&#xA;@author Rahul Srivastava, Sun Microsystems Inc.&#xA;@author Neeraj Bajaj, Sun Microsystems Inc.&#xA;&#xA;@version $Id: XSDAbstractTraverser.java,v 1.8 2010-11-01 04:40:02 joehw Exp $&#xA;" annotatedElement="ece12237-dae8-4816-8ed7-0902e09df67d"/>
