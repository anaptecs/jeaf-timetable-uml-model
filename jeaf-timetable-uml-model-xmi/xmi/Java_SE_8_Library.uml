            <packagedElement xmi:type="uml:Interface" xmi:id="e2ff51cb-4634-49f9-aa7e-2d3953297f7f" name="ObjLongConsumer" isAbstract="true">
              <ownedComment xmi:id="424d8ef3-17dd-43b9-b294-db2ae544027f" body="Represents an operation that accepts an object-valued and a&#xA;{@code long}-valued argument, and returns no result.  This is the&#xA;{@code (reference, long)} specialization of {@link BiConsumer}.&#xA;Unlike most other functional interfaces, {@code ObjLongConsumer} is&#xA;expected to operate via side-effects.&#xA;&#xA;&lt;p>This is a &lt;a href=&quot;package-summary.html&quot;>functional interface&lt;/a>&#xA;whose functional method is {@link #accept(Object, long)}.&#xA;&#xA;@param &lt;T> the type of the object argument to the operation&#xA;&#xA;@see BiConsumer&#xA;@since 1.8&#xA;" annotatedElement="e2ff51cb-4634-49f9-aa7e-2d3953297f7f"/>
              <ownedTemplateSignature xmi:type="uml:RedefinableTemplateSignature" xmi:id="35877eee-1c25-43a7-b302-e590229ace5d" name="" visibility="public" parameter="693bc838-1387-4738-9c56-8b432d889c33">
