                        <packagedElement xmi:type="uml:Class" xmi:id="d5871152-162c-445b-8526-340195a0a806" name="MarkerInstruction" visibility="package" isAbstract="true">
                          <ownedComment xmi:id="010a7bb9-029b-4984-9393-aa6e03c8116d" body="A special abstract dummy subclass of&#xA;{@link org.apache.bcel.generic.Instruction} used to mark locations of&#xA;interest in an {@link com.sun.org.apache.bcel.internal.generic.InstructionList}.  It and&#xA;its subclasses are only used as placeholders, and do not contribute to the&#xA;actual byte code instruction stream.&#xA;" annotatedElement="d5871152-162c-445b-8526-340195a0a806"/>
