            <nestedClassifier xmi:type="uml:Class" xmi:id="67c45f5b-1776-44f8-a256-bf94927418f6" name="NameComparator" visibility="private" clientDependency="a72e50eb-2032-4f38-9c07-785793c84f2d">
              <interfaceRealization xmi:id="a72e50eb-2032-4f38-9c07-785793c84f2d" name="" supplier="4546c25e-ba78-478f-ac0e-48f61502e6a8" client="67c45f5b-1776-44f8-a256-bf94927418f6" contract="4546c25e-ba78-478f-ac0e-48f61502e6a8"/>
