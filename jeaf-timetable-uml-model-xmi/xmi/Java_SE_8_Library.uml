              <packagedElement xmi:type="uml:Interface" xmi:id="da7cdc2b-f6a6-4d03-864b-e280ad71cddd" name="SourcePositions" isAbstract="true">
                <ownedComment xmi:id="6c5d9bdd-6cc2-4605-a8bf-0e6aaaf0ebb0" body="Provides methods to obtain the position of a Tree within a CompilationUnit.&#xA;A position is defined as a simple character offset from the start of a&#xA;CompilationUnit where the first character is at offset 0.&#xA;&#xA;@author Peter von der Ah&amp;eacute;&#xA;@since 1.6&#xA;" annotatedElement="da7cdc2b-f6a6-4d03-864b-e280ad71cddd"/>
              </packagedElement>
