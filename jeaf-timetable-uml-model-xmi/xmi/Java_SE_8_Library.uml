              <nestedClassifier xmi:type="uml:Class" xmi:id="8939cc3a-44c7-4e57-afd6-4d395f51a286" name="DropLocation">
                <ownedComment xmi:id="9e58c511-0ec2-49d9-ad6e-72b183973601" body="Represents a drop location for &lt;code>JTextComponent&lt;/code>s.&#xA;&#xA;@see #getDropLocation&#xA;@since 1.6&#xA;" annotatedElement="8939cc3a-44c7-4e57-afd6-4d395f51a286"/>
