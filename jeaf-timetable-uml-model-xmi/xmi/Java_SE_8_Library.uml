          <packagedElement xmi:type="uml:Class" xmi:id="b9ce76fa-727b-40f3-bb0a-41210a154795" name="UnknownHostException">
            <ownedComment xmi:id="f8d15e76-a061-4d5e-95d7-974d7d37ab6a" body="Thrown to indicate that the IP address of a host could not be determined.&#xA;&#xA;@author  Jonathan Payne&#xA;@since   JDK1.0&#xA;" annotatedElement="b9ce76fa-727b-40f3-bb0a-41210a154795"/>
