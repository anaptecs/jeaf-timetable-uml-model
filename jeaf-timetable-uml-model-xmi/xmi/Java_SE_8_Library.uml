            <packagedElement xmi:type="uml:Interface" xmi:id="96fa611f-cb17-4934-b5ba-7988a3b1dab5" name="RobotPeer" isAbstract="true">
              <ownedComment xmi:id="6251cd19-5a0e-4611-9d29-a25e2532dd7c" body="RobotPeer defines an interface whereby toolkits support automated testing&#xA;by allowing native input events to be generated from Java code.&#xA;&#xA;This interface should not be directly imported by code outside the&#xA;java.awt.* hierarchy; it is not to be considered public and is subject&#xA;to change.&#xA;&#xA;@author      Robi Khan&#xA;" annotatedElement="96fa611f-cb17-4934-b5ba-7988a3b1dab5"/>
            </packagedElement>
