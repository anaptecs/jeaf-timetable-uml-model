S&lt;/TD>&#xA;&lt;TD WIDTH=&quot;15%&quot;>&#xA;&lt;P ALIGN=&quot;CENTER&quot;>Shift_JIS&#xA;&lt;/TD>&#xA;&lt;TD WIDTH=&quot;12%&quot;>&#xA;&lt;P ALIGN=&quot;CENTER&quot;>MIME&#xA;&lt;/TD>&#xA;&lt;TD WIDTH=&quot;31%&quot;>&#xA;&lt;P ALIGN=&quot;CENTER&quot;>SJIS&#xA;&lt;/TD>&#xA;&lt;/TR>&#xA;&lt;TR>&#xA;&lt;TD WIDTH=&quot;33%&quot;>Chinese: Big5&lt;/TD>&#xA;&lt;TD WIDTH=&quot;15%&quot;>&#xA;&lt;P ALIGN=&quot;CENTER&quot;>Big5&#xA;&lt;/TD>&#xA;&lt;TD WIDTH=&quot;12%&quot;>&#xA;&lt;P ALIGN=&quot;CENTER&quot;>MIME&#xA;&lt;/TD>&#xA;&lt;TD WIDTH=&quot;31%&quot;>&#xA;&lt;P ALIGN=&quot;CENTER&quot;>Big5&#xA;&lt;/TD>&#xA;&lt;/TR>&#xA;&lt;TR>&#xA;&lt;TD WIDTH=&quot;33%&quot;>Extended Unix Code, packed for Korean&lt;/TD>&#xA;&lt;TD WIDTH=&quot;15%&quot;>&#xA;&lt;P ALIGN=&quot;CENTER&quot;>euc-kr&#xA;&lt;/TD>&#xA;&lt;TD WIDTH=&quot;12%&quot;>&#xA;&lt;P ALIGN=&quot;CENTER&quot;>MIME&#xA;&lt;/TD>&#xA;&lt;TD WIDTH=&quot;31%&quot;>&#xA;&lt;P ALIGN=&quot;CENTER&quot;>iso2022kr&#xA;&lt;/TD>&#xA;&lt;/TR>&#xA;&lt;TR>&#xA;&lt;TD WIDTH=&quot;33%&quot;>Cyrillic&lt;/TD>&#xA;&lt;TD WIDTH=&quot;15%&quot;>&#xA;&lt;P ALIGN=&quot;CENTER&quot;>koi8-r&#xA;&lt;/TD>&#xA;&lt;TD WIDTH=&quot;12%&quot;>&#xA;&lt;P ALIGN=&quot;CENTER&quot;>MIME&#xA;&lt;/TD>&#xA;&lt;TD WIDTH=&quot;31%&quot;>&#xA;&lt;P ALIGN=&quot;CENTER&quot;>koi8-r&#xA;&lt;/TD>&#xA;&lt;/TR>&#xA;&lt;/TABLE>&#xA;&#xA;@author TAMURA Kent, IBM&#xA;@author Andy Clark, IBM&#xA;&#xA;" annotatedElement="cfad1c24-9838-4a4e-989c-40206e82306e"/>
