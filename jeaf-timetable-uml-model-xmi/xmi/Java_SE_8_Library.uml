              <nestedClassifier xmi:type="uml:Class" xmi:id="41ca25f2-dace-440e-9d02-b10dde553259" name="IntStreamBuilderImpl" visibility="package" clientDependency="aced342c-c13a-42cd-a415-1b683e8fbc73">
