                <nestedClassifier xmi:type="uml:Class" xmi:id="89002a6d-ec74-47ae-99b5-6250b7bb2443" name="RootView" visibility="package">
                  <ownedComment xmi:id="302e8ba8-f74b-48ef-ab2c-d6a4fd382ae2" body="Root view that acts as a gateway between the component&#xA;and the View hierarchy.&#xA;" annotatedElement="89002a6d-ec74-47ae-99b5-6250b7bb2443"/>
                  <generalization xmi:id="596d604f-1b43-4f84-8b15-78e9068f3c3c" isSubstitutable="true" general="ab032086-ff26-45b9-97ab-5ef382d9c93a"/>
