              <nestedClassifier xmi:type="uml:Class" xmi:id="0d161e46-706e-4d91-aee0-85ca7cd10b2f" name="ForEachOrderedTask" visibility="package">
                <ownedComment xmi:id="893f4891-7dda-475c-bb20-73d3ea6293c8" body="A {@code ForkJoinTask} for performing a parallel for-each operation&#xA;which visits the elements in encounter order&#xA;" annotatedElement="0d161e46-706e-4d91-aee0-85ca7cd10b2f"/>
                <ownedTemplateSignature xmi:type="uml:RedefinableTemplateSignature" xmi:id="2ab69a10-ecfe-4b57-8225-c9a27ed73b1b" name="" visibility="public" parameter="9e0840b9-82d5-41b4-9cb5-23ecf5776f32 1a2b29a5-08b7-44e0-929f-fb87e8cd49d9">
