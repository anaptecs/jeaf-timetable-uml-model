                    <packagedElement xmi:type="uml:Class" xmi:id="7c40a718-4802-4c50-97d4-d510c71fce17" name="DOMEntityResolverWrapper" clientDependency="af541b74-62b7-4195-b141-d0154557b103">
                      <ownedComment xmi:id="219438e9-f9d6-4c37-926e-88da24201f68" body="This class wraps DOM entity resolver to XNI entity resolver.&#xA;&#xA;@see LSResourceResolver&#xA;&#xA;@author Gopal Sharma, SUN MicroSystems Inc.&#xA;@author Elena Litani, IBM&#xA;@author Ramesh Mandava, Sun Microsystems&#xA;" annotatedElement="7c40a718-4802-4c50-97d4-d510c71fce17"/>
