            <packagedElement xmi:type="uml:Interface" xmi:id="022c3b5a-b74d-4371-8efa-8753a819e61b" name="IdAssignmentPolicy" isAbstract="true">
              <ownedComment xmi:id="6a40f77c-475a-44c3-85cb-0e0b1c45168a" body="IdAssignmentPolicy specifies whether Object Ids in&#xA;the created POA are generated by the application or&#xA;by the ORB. The default is SYSTEM_ID.&#xA;" annotatedElement="022c3b5a-b74d-4371-8efa-8753a819e61b"/>
              <generalization xmi:id="8f576793-dd85-4da0-8761-f7e104465468" isSubstitutable="true" general="52e26c97-2e5f-4a11-9479-894b7a0f11d3"/>
