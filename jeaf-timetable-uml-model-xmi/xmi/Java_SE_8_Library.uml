            <interfaceRealization xmi:id="e531310c-c160-493d-a419-d6b22f89bb0d" name="" supplier="438b27aa-8197-4598-8828-b921edd58265" client="6cd2f943-b9a9-42ee-a624-06dd34613ae2" contract="438b27aa-8197-4598-8828-b921edd58265"/>
            <nestedClassifier xmi:type="uml:Class" xmi:id="5d195c03-0e10-4e75-83f1-953ce5b0f56f" name="SharedOwnerFrame" visibility="package" clientDependency="3ef7e1b0-4f93-4cd2-bd1c-ca28fcd526c2">
              <generalization xmi:id="adb4ee0d-46b4-4e19-afbd-8a35b39a7a42" isSubstitutable="true" general="b63d59ab-bfab-4285-abdc-504710a8f77b"/>
              <interfaceRealization xmi:id="3ef7e1b0-4f93-4cd2-bd1c-ca28fcd526c2" name="" supplier="a555795b-0df9-4e62-935b-190926cba9b5" client="5d195c03-0e10-4e75-83f1-953ce5b0f56f" contract="a555795b-0df9-4e62-935b-190926cba9b5"/>
