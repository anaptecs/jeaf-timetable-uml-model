          <packagedElement xmi:type="uml:Package" xmi:id="778113ad-ce23-4b0f-b6af-b92bff64746c" name="ref">
            <packagedElement xmi:type="uml:Class" xmi:id="33b890fa-39a9-4d5c-8509-55b63fad648e" name="Finalizer" visibility="package">
              <generalization xmi:id="55d85d25-bd9c-4078-8223-4d93d244f973" isSubstitutable="true" general="bf9abfb2-664f-419f-9b61-1225f5f0aaa5"/>
              <nestedClassifier xmi:type="uml:Class" xmi:id="9dc5432c-a4bc-4706-a779-a22510b0c551" name="FinalizerThread" visibility="private">
