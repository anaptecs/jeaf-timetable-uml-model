                    <ownedComment xmi:id="3ea32c46-318e-4d01-bd52-66794d8214da" body="Action used for the actual element form tag. This is named such&#xA;as there was already a public class named FormAction.&#xA;" annotatedElement="fa7b45f8-dcfd-40f1-9b06-8e7e2149ebce"/>
                    <generalization xmi:id="ac8dfabe-7b13-4f69-b6e0-8c73d9271c69" isSubstitutable="true" general="2bf9d0a9-d94a-4fcd-afea-ab28040972eb"/>
                  </nestedClassifier>
