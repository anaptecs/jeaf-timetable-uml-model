                      <ownedComment xmi:id="469dabdc-e8ba-49fe-a1eb-038d916ff3b1" body="This class takes SAX events (in addition to some extra events&#xA;that SAX doesn't handle yet) and adds the result to a document&#xA;or document fragment.&#xA;@xsl.usage general&#xA;" annotatedElement="d02d4321-ff84-4c9c-8a31-2f0b8c4a7876"/>
                      <interfaceRealization xmi:id="db9e2bdc-623c-4d53-aa06-a17609691b95" name="" supplier="c1ba9edb-3b3b-4e75-a057-ba7df9208c25" client="d02d4321-ff84-4c9c-8a31-2f0b8c4a7876" contract="c1ba9edb-3b3b-4e75-a057-ba7df9208c25"/>
