                      <packagedElement xmi:type="uml:Class" xmi:id="3963c031-27b8-4ba3-ad19-7d9580f61e2e" name="SortSettings" visibility="package">
                        <ownedComment xmi:id="f009a13f-90b1-48f0-866f-8524f108b079" body="Class for carrying settings that are to be used for a particular set&#xA;of &lt;code>xsl:sort&lt;/code> elements.&#xA;" annotatedElement="3963c031-27b8-4ba3-ad19-7d9580f61e2e"/>
                      </packagedElement>
                      <packagedElement xmi:type="uml:Class" xmi:id="955af52e-f3ce-4c87-9b3b-46bd91ae59b9" name="StepIterator">
                        <ownedComment xmi:id="ebf350f3-232c-4c6d-8d90-da389e9fecd0" body="A step iterator is used to evaluate expressions like &quot;BOOK/TITLE&quot;.&#xA;A better name for this iterator would have been ParentIterator since&#xA;both &quot;BOOK&quot; and &quot;TITLE&quot; are steps in XPath lingo. Step iterators are&#xA;constructed from two other iterators which we are going to refer to&#xA;as &quot;outer&quot; and &quot;inner&quot;. Every node from the outer iterator (the one&#xA;for BOOK in our example) is used to initialize the inner iterator.&#xA;After this initialization, every node from the inner iterator is&#xA;returned (in essence, implementing a &quot;nested loop&quot;).&#xA;@author Jacek Ambroziak&#xA;@author Santiago Pericas-Geertsen&#xA;@author Erwin Bolwidt &lt;ejb@klomp.org>&#xA;@author Morten Jorgensen&#xA;" annotatedElement="955af52e-f3ce-4c87-9b3b-46bd91ae59b9"/>
                        <generalization xmi:id="d10592f1-ee7f-4292-afbb-acb85e7114f0" isSubstitutable="true" general="59ccc38a-d7f7-42b4-ab67-fed330dbe0f9"/>
                      </packagedElement>
                      <packagedElement xmi:type="uml:Interface" xmi:id="44dc0bb3-52c3-4035-94a0-1c2dbdb89e0d" name="StripWhitespaceFilter" isAbstract="true">
                        <ownedComment xmi:id="0a16ae0f-af24-4cb3-ab34-6c7ba6e32ebf" body="@author Jacek Ambroziak&#xA;@author Santiago Pericas-Geertsen&#xA;" annotatedElement="44dc0bb3-52c3-4035-94a0-1c2dbdb89e0d"/>
                      </packagedElement>
                      <packagedElement xmi:type="uml:Class" xmi:id="ef608afb-566b-4151-8859-04cc98e6676d" name="UnionIterator">
                        <ownedComment xmi:id="048cc303-b7b7-4d5b-bcb4-396876d39865" body="UnionIterator takes a set of NodeIterators and produces&#xA;a merged NodeSet in document order with duplicates removed&#xA;The individual iterators are supposed to generate nodes&#xA;in document order&#xA;@author Jacek Ambroziak&#xA;@author Santiago Pericas-Geertsen&#xA;" annotatedElement="ef608afb-566b-4151-8859-04cc98e6676d"/>
                        <generalization xmi:id="3015d64d-7e26-47b6-880a-8393f56a0d39" isSubstitutable="true" general="ba080260-e705-41ac-8246-0e6bd37fcf26"/>
                        <nestedClassifier xmi:type="uml:Class" xmi:id="1d16c9ce-9b13-40cb-bc06-b402043077cd" name="LookAheadIterator" visibility="private">
                          <generalization xmi:id="5ad30a4a-6fe4-4f5f-a6c2-1fc390f0395f" isSubstitutable="true" general="1d85e690-8aae-4435-865f-5c8b6caa429f"/>
                        </nestedClassifier>
                      </packagedElement>
                      <packagedElement xmi:type="uml:Class" xmi:id="77b22bc4-9826-43d1-94f5-7e906a87fb37" name="XSLTCDTMManager">
                        <ownedComment xmi:id="0f0ab787-80bb-449c-b57d-0249742339ae" body="The default implementation for the DTMManager.&#xA;" annotatedElement="77b22bc4-9826-43d1-94f5-7e906a87fb37"/>
                        <generalization xmi:id="84bcf443-9889-46c4-bd64-37e1175fd97f" isSubstitutable="true" general="7e2cc030-8b70-4144-996a-2600ee84622b"/>
                      </packagedElement>
                    </packagedElement>
                    <packagedElement xmi:type="uml:Package" xmi:id="4e3b09f3-231e-4ef0-8561-460963459384" name="runtime">
                      <packagedElement xmi:type="uml:Package" xmi:id="cf9e45ba-3732-4881-9f67-70067c608c4d" name="output">
                        <packagedElement xmi:type="uml:Interface" xmi:id="e829f8a0-1eab-4c09-8b0c-d42f3d00316e" name="OutputBuffer" visibility="package" isAbstract="true">
                          <ownedComment xmi:id="0105cd51-bea7-4d21-bd40-5f4057dab2e1" body="@author Santiago Pericas-Geertsen&#xA;" annotatedElement="e829f8a0-1eab-4c09-8b0c-d42f3d00316e"/>
