                      <interfaceRealization xmi:id="d3922891-3999-4a69-ad0e-7bf3931274a8" name="" supplier="5f4d5977-ca94-4370-9e9e-9e7024236e8d" client="ccf0f01d-54b6-4cff-b6ed-7284e93b0982" contract="5f4d5977-ca94-4370-9e9e-9e7024236e8d"/>
                      <nestedClassifier xmi:type="uml:Class" xmi:id="53ac84da-b7c4-4ff1-bc9a-64b750159847" name="Element" visibility="protected">
                        <ownedComment xmi:id="ccb776b5-c812-46ec-b5be-81bc333cff56" body="@author Neeraj Bajaj, Sun Microsystems.&#xA;" annotatedElement="53ac84da-b7c4-4ff1-bc9a-64b750159847"/>
                      </nestedClassifier>
                      <nestedClassifier xmi:type="uml:Class" xmi:id="4e3900d8-e723-454c-b1b8-53f0c53c1bfd" name="ElementStack2" visibility="protected">
                        <ownedComment xmi:id="5c7ac2e4-ba0c-4244-a095-e9fa6ea4c07e" body="Element stack.&#xA;&#xA;@author Neeraj Bajaj, Sun Microsystems.&#xA;" annotatedElement="4e3900d8-e723-454c-b1b8-53f0c53c1bfd"/>
                      </nestedClassifier>
                      <nestedClassifier xmi:type="uml:Class" xmi:id="befc2814-2fea-4dba-960a-5854e6bd632a" name="ElementStack" visibility="protected">
                        <ownedComment xmi:id="6b044c8d-617e-4da0-b117-7640b5cf56b5" body="Element stack. This stack operates without synchronization, error&#xA;checking, and it re-uses objects instead of throwing popped items&#xA;away.&#xA;&#xA;@author Andy Clark, IBM&#xA;" annotatedElement="befc2814-2fea-4dba-960a-5854e6bd632a"/>
                      </nestedClassifier>
                      <nestedClassifier xmi:type="uml:Interface" xmi:id="2f75a097-d042-41c2-b4fd-a1a605af6b44" name="Driver" visibility="protected" isAbstract="true">
                        <ownedComment xmi:id="83e4a831-3399-48fa-9701-bb8091635144" body="Drives the parser to the next state/event on the input. Parser is guaranteed&#xA;to stop at the next state/event.&#xA;&#xA;Internally XML document is divided into several states. Each state represents&#xA;a sections of XML document. When this functions returns normally, it has read&#xA;the section of XML document and returns the state corresponding to section of&#xA;document which has been read. For optimizations, a particular driver&#xA;can read ahead of the section of document (state returned) just read and&#xA;can maintain a different internal state.&#xA;&#xA;&#xA;@author Neeraj Bajaj, Sun Microsystems&#xA;" annotatedElement="2f75a097-d042-41c2-b4fd-a1a605af6b44"/>
                      </nestedClassifier>
                      <nestedClassifier xmi:type="uml:Class" xmi:id="5385fe9c-3126-40e3-82ff-59cca2bc381d" name="FragmentContentDriver" visibility="protected" clientDependency="f9dbfb3c-1734-4493-a3cd-dea1b6f13945">
                        <ownedComment xmi:id="346cbd5c-b6c2-4c82-a263-897d9d898a94" body="Driver to handle content scanning. This driver is capable of reading&#xA;the fragment of XML document. When it has finished reading fragment&#xA;of XML documents, it can pass the job of reading to another driver.&#xA;&#xA;This class has been modified as per the new design which is more suited to&#xA;efficiently build pull parser. Lot of performance improvements have been done and&#xA;the code has been added to support stax functionality/features.&#xA;&#xA;@author Neeraj Bajaj, Sun Microsystems&#xA;&#xA;&#xA;@author Andy Clark, IBM&#xA;@author Eric Ye, IBM&#xA;" annotatedElement="5385fe9c-3126-40e3-82ff-59cca2bc381d"/>
                        <interfaceRealization xmi:id="f9dbfb3c-1734-4493-a3cd-dea1b6f13945" name="" supplier="2f75a097-d042-41c2-b4fd-a1a605af6b44" client="5385fe9c-3126-40e3-82ff-59cca2bc381d" contract="2f75a097-d042-41c2-b4fd-a1a605af6b44"/>
                      </nestedClassifier>
                    </packagedElement>
