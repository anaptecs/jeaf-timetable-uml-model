              <packagedElement xmi:type="uml:Class" xmi:id="6669e75f-009b-4a20-be64-ea3e97ec0854" name="AtomicMarkableReference">
                <ownedComment xmi:id="b3fd1fb6-6828-4ff5-8994-973c129842b0" body="An {@code AtomicMarkableReference} maintains an object reference&#xA;along with a mark bit, that can be updated atomically.&#xA;&#xA;&lt;p>Implementation note: This implementation maintains markable&#xA;references by creating internal objects representing &quot;boxed&quot;&#xA;[reference, boolean] pairs.&#xA;&#xA;@since 1.5&#xA;@author Doug Lea&#xA;@param &lt;V> The type of object referred to by this reference&#xA;" annotatedElement="6669e75f-009b-4a20-be64-ea3e97ec0854"/>
