                    <packagedElement xmi:type="uml:Class" xmi:id="bb3d28bc-5bf1-447c-91a6-9735de04d74d" name="ConstantUtf8">
                      <ownedComment xmi:id="ca1904a8-81bf-4825-ba35-9b51c6024cc6" body="This class is derived from the abstract&#xA;&lt;A HREF=&quot;com.sun.org.apache.bcel.internal.classfile.Constant.html&quot;>Constant&lt;/A> class&#xA;and represents a reference to a Utf8 encoded string.&#xA;&#xA;@author  &lt;A HREF=&quot;mailto:markus.dahm@berlin.de&quot;>M. Dahm&lt;/A>&#xA;@see     Constant&#xA;" annotatedElement="bb3d28bc-5bf1-447c-91a6-9735de04d74d"/>
