              <nestedClassifier xmi:type="uml:Class" xmi:id="09b8105f-8c57-4286-84e7-ea17055a1b37" name="LayeredHighlightInfo" visibility="package">
                <ownedComment xmi:id="987a8499-9587-4e6e-9b11-5e84122f8150" body="LayeredHighlightPainter is used when a drawsLayeredHighlights is&#xA;true. It maintains a rectangle of the region to paint.&#xA;" annotatedElement="09b8105f-8c57-4286-84e7-ea17055a1b37"/>
