                <ownedComment xmi:id="437cb424-e7d6-4791-9c32-d4d0bbdba0d2" body="Common type of value suppliers that are holding a referent.&#xA;The {@link #equals} and {@link #hashCode} of implementations is defined&#xA;to compare the referent by identity.&#xA;" annotatedElement="213dbf38-a913-4134-84b1-72d25203a416"/>
                <ownedTemplateSignature xmi:type="uml:RedefinableTemplateSignature" xmi:id="87438824-15f2-4f23-a726-c01891fcf27d" name="" visibility="public" parameter="20be817e-19a4-4b2b-ac2d-e29b3b5184bf">
