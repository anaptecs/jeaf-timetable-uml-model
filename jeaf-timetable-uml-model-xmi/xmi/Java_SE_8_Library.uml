                  <interfaceRealization xmi:id="18ba5965-2139-4a22-894a-af3cb4782c58" name="" supplier="173264b4-47e0-46ca-9b92-afd51f39a577" client="7a9eb410-d8d5-4c9b-adb9-654e3899bd2a" contract="173264b4-47e0-46ca-9b92-afd51f39a577"/>
                  <interfaceRealization xmi:id="1c512c3e-ecff-47a0-a5f8-b90aedd0cb6a" name="" supplier="157caddf-a166-42dd-aeee-51e517c24af2" client="7a9eb410-d8d5-4c9b-adb9-654e3899bd2a" contract="157caddf-a166-42dd-aeee-51e517c24af2"/>
                </nestedClassifier>
                <nestedClassifier xmi:type="uml:Class" xmi:id="e398fd3a-b71d-4712-9744-07d89d2a6b55" name="TextActionWrapper" visibility="package">
                  <ownedComment xmi:id="1c874976-4a45-4a74-a230-4afcff5a9d39" body="Wrapper for text actions to return isEnabled false in case editor is non editable&#xA;" annotatedElement="e398fd3a-b71d-4712-9744-07d89d2a6b55"/>
                  <generalization xmi:id="b214d47d-863a-4e3a-80f6-935c8ee42ebd" isSubstitutable="true" general="09df9205-894f-4bf9-a75f-6d8341a8db7f"/>
