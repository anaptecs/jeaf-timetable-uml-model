                  <packagedElement xmi:type="uml:Class" xmi:id="5b21e573-fbbd-489c-850a-b2afdc7e6b40" name="ServerProvider" clientDependency="2afce900-90ac-4f99-a238-300bb9b07b07">
                    <interfaceRealization xmi:id="2afce900-90ac-4f99-a238-300bb9b07b07" name="" supplier="9571163b-07ef-445a-b620-2d30d4d178bc" client="5b21e573-fbbd-489c-850a-b2afdc7e6b40" contract="9571163b-07ef-445a-b620-2d30d4d178bc"/>
